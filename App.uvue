		/* 阴影 */
		--shadow-sm: 0 2px 12px rgba(17, 23, 24, 0.04);
		--shadow-md: 0 4px 16px rgba(17, 23, 24, 0.08);
		--shadow-lg: 0 8px 24px rgba(17, 23, 24, 0.10);

		/* 字体 */
		--serif: ui-serif, "Songti SC", "STSong", "Noto Serif SC", serif;
		--sans: Inter, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;

		background-color: var(--canvas);
		color: var(--ink);
		font-family: var(--sans);
		font-size: 14px;
		line-height: 1.6;
	}

	/* 每个页面公共 css */
