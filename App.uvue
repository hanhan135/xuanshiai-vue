<script setup lang="uts">
	import {
		FASTAPI_AUTO_ENTER_COMMUNITY,
		FASTAPI_DEV_ACCESS_TOKEN,
		FASTAPI_DEV_USER_ID,
		getAccessToken,
		setAuthTokens
	} from './api/config.uts'

	const tryAutoEnterFastApiCommunity = (): boolean => {
		if (FASTAPI_AUTO_ENTER_COMMUNITY != true) return false
		if (FASTAPI_DEV_ACCESS_TOKEN == '' || FASTAPI_DEV_USER_ID <= 0) return false

		setAuthTokens(FASTAPI_DEV_ACCESS_TOKEN)
		if (getAccessToken() != FASTAPI_DEV_ACCESS_TOKEN) return false

		try {
			uni.setStorageSync('xsa_user_id', FASTAPI_DEV_USER_ID)
		} catch (e) {
			return false
		}

		uni.switchTab({
			url: '/pages/community/community'
		})
		return true
	}

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		console.log('App Launch')
		uni.setStorageSync('xsa_new_app_launch', true)
		tryAutoEnterFastApiCommunity()
	})

	onShow(() => {
		console.log('App Show')
	})

	onHide(() => {
		console.log('App Hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('App Exit')
	})
	// #endif
</script>

<style>
	/* 全局 Token：必须写在 App 全局样式，才能进入微信 app.wxss。
	 * 与 uni.scss 保持同一套 hex/rgba 语义 Token（方案 A：全端统一）。
	 */
	page {
