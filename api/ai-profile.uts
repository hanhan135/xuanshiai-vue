/**
 * M04 AI 画像前端服务。
 * 对接后端 /api/v1/ai/profile-sessions、/profile-drafts、/profile-revisions、/profiles。
 * 幂等键自动生成;异步任务通过 GET /ai/tasks/{task_id} 轮询。
 */

import { request } from './request.uts'
import { getAccessToken, buildApiUrl, resolveMediaUrl } from './config.uts'
/** 画像主体:关于我 / 关于对方 */
export type ProfileSubject = 'personal' | 'ideal_partner'

/** 字段确认状态 */
export type FieldConfirmationStatus = 'suggested' | 'confirmed' | 'rejected' | 'deleted'

/** 字段操作类型 */
export type FieldPatchAction = 'confirm' | 'replace' | 'reject' | 'delete'

/** 生成幂等键:8-128 位 ASCII [A-Za-z0-9._:-] */
export function genIdempotencyKey(): string {
  return 'portrait-' + Date.now() + '-' + Math.floor(Math.random() * 1000000)
}

/** 画像字段标签映射 */
export const FIELD_KEY_LABELS: Map<string, string> = new Map()
FIELD_KEY_LABELS.set('age', '年龄')
FIELD_KEY_LABELS.set('city_code', '城市')
FIELD_KEY_LABELS.set('marriage_status', '婚姻状态')
FIELD_KEY_LABELS.set('education_level', '学历')
FIELD_KEY_LABELS.set('height_cm', '身高')
FIELD_KEY_LABELS.set('income_band', '收入区间')
FIELD_KEY_LABELS.set('occupation_group', '职业')
FIELD_KEY_LABELS.set('interest_tags', '兴趣爱好')
FIELD_KEY_LABELS.set('lifestyle_tags', '生活方式')
FIELD_KEY_LABELS.set('relationship_goal', '关系期待')

/** 枚举字段:以选项按钮展示,点选直接生成 confirmed */
export const ENUM_FIELDS: string[] = ['marriage_status', 'education_level', 'income_band']

/** 枚举字段可选值 */
export const ENUM_OPTIONS: Map<string, string[]> = new Map()
ENUM_OPTIONS.set('marriage_status', ['未婚', '离异', '丧偶'])
ENUM_OPTIONS.set('education_level', ['高中及以下', '大专', '本科', '硕士', '博士'])
ENUM_OPTIONS.set('income_band', ['10万以下', '10-20万', '20-30万', '30-50万', '50万以上'])

export function fieldLabel(key: string): string {
  const label = FIELD_KEY_LABELS.get(key)
  return label != null ? label : key
}

/** 创建或复用画像会话 */
export async function createProfileSession(subject: string, consentVersion: string = 'profile-text-v1'): Promise<any> {
  return request({
    url: '/ai/profile-sessions',
    method: 'POST',
    data: { subject: subject, consent_version: consentVersion, input_mode: 'text' },
    headers: { 'Idempotency-Key': genIdempotencyKey() }
  })
}

/** 查询本人的画像会话 */
export async function getProfileSession(sessionId: string): Promise<any> {
  return request({ url: '/ai/profile-sessions/' + sessionId, method: 'GET' })
}

/** 提交一条文字回答,返回 turn + task */
export async function submitProfileTurn(sessionId: string, answerText: string): Promise<any> {
  return request({
    url: '/ai/profile-sessions/' + sessionId + '/turns',
    method: 'POST',
    data: { client_turn_id: genIdempotencyKey(), answer_text: answerText },
    headers: { 'Idempotency-Key': genIdempotencyKey() }
  })
}

/** 软删除画像会话 */
export async function deleteProfileSession(sessionId: string): Promise<any> {
  return request({
    url: '/ai/profile-sessions/' + sessionId,
    method: 'DELETE',
    headers: { 'Idempotency-Key': genIdempotencyKey() }
  })
}

/** 暂停画像会话(后端已契约 /ai/profile-sessions/{id}/pause) */
export async function pauseProfileSession(sessionId: string): Promise<any> {
  return request({
    url: '/ai/profile-sessions/' + sessionId + '/pause',
    method: 'POST',
    headers: { 'Idempotency-Key': genIdempotencyKey() }
  })
}

/** 恢复画像会话(后端已契约 /ai/profile-sessions/{id}/resume) */
export async function resumeProfileSession(sessionId: string): Promise<any> {
  return request({
    url: '/ai/profile-sessions/' + sessionId + '/resume',
    method: 'POST',
    headers: { 'Idempotency-Key': genIdempotencyKey() }
  })
}

/** 跳过当前问题(不确认该字段,本次会话不再追问,进度不变) */
export async function skipProfileQuestion(sessionId: string, fieldKey: string): Promise<any> {
  return request({
    url: '/ai/profile-sessions/' + sessionId + '/skip-question',
    method: 'POST',
    data: { field_key: fieldKey },
    headers: { 'Idempotency-Key': genIdempotencyKey() }
  })
}

/** 查询草稿字段 */
export async function getProfileDraft(draftId: string): Promise<any> {
  return request({ url: '/ai/profile-drafts/' + draftId, method: 'GET' })
}

/** 逐项确认/修改/拒绝/删除草稿字段 */
export async function patchProfileDraft(draftId: string, actions: any[], expectedRevision: number): Promise<any> {
  return request({
    url: '/ai/profile-drafts/' + draftId,
    method: 'PATCH',
    data: { expected_revision: expectedRevision, actions: actions },
    headers: { 'Idempotency-Key': genIdempotencyKey() }
  })
}

/** 构造单个字段确认动作 */
export function fieldAction(fieldKey: string, action: string, value: any = null, expectedRevision: number = 0): any {
  const obj: any = { field_key: fieldKey, action: action, expected_revision: expectedRevision }
  if (value != null) obj.value = value
  return obj
}

/**
	 * 发布已确认字段。
 * 注意:后端契约要求 expected_revision 作为 query 参数传递(非 body),
 * 缺失会返回 400 AI_INPUT_INVALID。
 */
export async function publishProfileDraft(draftId: string, expectedRevision: number): Promise<any> {
  return request({
    url: '/ai/profile-drafts/' + draftId + '/publish?expected_revision=' + expectedRevision,
    method: 'POST',
    data: {},
    headers: { 'Idempotency-Key': genIdempotencyKey() }
  })
}

/** 查询发布版本历史 */
export async function listProfileRevisions(cursor: string = '', limit: number = 20): Promise<any> {
  const params: any = { limit: limit }
  if (cursor != '') params.cursor = cursor
  return request({ url: '/ai/profile-revisions', method: 'GET', data: params })
}

/** 从历史版本恢复为新草稿 */
export async function restoreProfileRevision(revisionId: number): Promise<any> {
  return request({
    url: '/ai/profile-revisions/' + revisionId + '/restore',
    method: 'POST',
    headers: { 'Idempotency-Key': genIdempotencyKey() }
  })
}

/** 删除整个画像 */
export async function deleteAiProfile(subject: string): Promise<any> {
  return request({
    url: '/ai/profiles/' + subject,
    method: 'DELETE',
    headers: { 'Idempotency-Key': genIdempotencyKey() }
