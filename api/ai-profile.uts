/** 轮询异步任务状态 */
export async function pollTask(taskId: string): Promise<any> {
  if (USE_MOCK) return mockPollTask(taskId)
  return request({ url: '/ai/tasks/' + taskId, method: 'GET' })
}

/**
 * 轮询抽取任务直到完成,然后拉取草稿。
 * 返回 { success, draft, error }
 */
export async function pollExtractionAndLoadDraft(taskId: string, draftId: string, maxAttempts: number = 30): Promise<any> {
  for (let i = 0; i < maxAttempts; i++) {
    const taskRes = await pollTask(taskId)
    if (!taskRes.success || taskRes.data == null) {
      return { success: false, draft: null, error: '任务状态查询失败' }
    }
    const status = String(taskRes.data.status != null ? taskRes.data.status : '')
    if (status == 'succeeded') {
      const draftRes = await getProfileDraft(draftId)
      if (!draftRes.success || draftRes.data == null) {
        return { success: false, draft: null, error: '草稿拉取失败' }
      }
      return { success: true, draft: draftRes.data, error: '' }
    }
    if (status == 'failed') {
      const msg = taskRes.data.error_message != null ? String(taskRes.data.error_message) : 'AI 抽取失败,请重新回答'
      return { success: false, draft: null, error: msg }
    }
    const pollAfter = Number(taskRes.data.poll_after_ms != null ? taskRes.data.poll_after_ms : 1000)
    await sleep(pollAfter)
  }
  return { success: false, draft: null, error: 'AI 处理超时,请稍后重试' }
}

/** 映射后端错误码到用户可读文案 */
export function mapProfileError(code: string, fallback: string): string {
  if (code == 'AI_FEATURE_DISABLED') return 'AI 画像功能当前不可用'
  if (code == 'AI_CONSENT_REQUIRED') return '需要授权后才能使用画像功能'
  if (code == 'AI_INPUT_INVALID') return '输入内容有误,请检查后重试'
  if (code == 'PROFILE_SESSION_NOT_FOUND') return '画像会话不存在,请重新开始'
  if (code == 'PROFILE_SESSION_STALE') return '资料已更新,请重新创建画像会话'
  if (code == 'DRAFT_VERSION_CONFLICT') return '草稿已被更新,请刷新后合并'
  if (code == 'AI_QUOTA_EXCEEDED') return 'AI 额度已用完,请稍后再试'
  if (code == 'AI_TEMPORARILY_UNAVAILABLE') return 'AI 服务暂时不可用,请稍后重试'
  if (code == 'AI_POLICY_DENIED') return '内容包含敏感信息,请修改后重试'
  return fallback
}

function sleep(ms: number): Promise<void> {
  return new Promise((resolve) => setTimeout(() => resolve(), ms))
}

/**
 * 语音转写(首期 mock,后期接入真实 ASR 服务)。
 * 参数:音频临时文件路径 + 当前问题文本 + 字段 key(用于 mock 精准匹配)
 * 返回 { success, text, error }
 *
 * 真实分支:上传音频到 /voice/transcribe → 拿 task_id → 轮询 /ai/tasks/{id}
 * → status=succeeded 时从 result_payload.transcript 取转写文本。
 */
export async function transcribeAudio(audioPath: string, questionText: string = '', questionFieldKey: string = ''): Promise<any> {
  if (USE_MOCK) {
    return mockTranscribe(questionText, questionFieldKey)
  }
  // 真实 ASR:上传音频文件 → 创建转写任务 → 轮询任务结果
  return await transcribeAudioReal(audioPath, questionFieldKey)
}

/**
 * 真实 ASR 转写:上传音频 → 轮询任务 → 返回转写文本。
 * 复用 ai_task 异步轮询模式,与画像抽取 pollExtractionAndLoadDraft 同构。
 */
async function transcribeAudioReal(audioPath: string, questionFieldKey: string): Promise<any> {
  // 1. 上传音频文件,创建异步转写任务
  const uploadResult = await uploadAudioForTranscribe(audioPath, questionFieldKey)
  if (!uploadResult.success || uploadResult.data == null) {
    const msg = uploadResult.message != null ? ('' + uploadResult.message) : '转写请求失败'
    return { success: false, text: '', error: msg }
  }
  const taskId = uploadResult.data.task_id != null ? ('' + uploadResult.data.task_id) : ''
  if (taskId == '') {
    return { success: false, text: '', error: '转写任务创建失败' }
  }

  // 2. 轮询任务直到终态(最多 30 次,每次间隔 poll_after_ms)
  for (let i = 0; i < 30; i++) {
    const taskRes = await pollTask(taskId)
    if (!taskRes.success || taskRes.data == null) {
      return { success: false, text: '', error: '转写任务状态查询失败' }
    }
    const status = String(taskRes.data.status != null ? taskRes.data.status : '')
    if (status == 'succeeded') {
      // 从 result_payload.transcript 取转写文本
      const payload = taskRes.data.result_payload
      const transcript = payload != null && payload.transcript != null ? ('' + payload.transcript) : ''
      if (transcript == '') {
        return { success: false, text: '', error: '转写结果为空' }
      }
      return { success: true, text: transcript, error: '' }
    }
    if (status == 'failed') {
      const msg = taskRes.data.error_message != null ? String(taskRes.data.error_message) : '转写失败,请重试'
      return { success: false, text: '', error: msg }
    }
    // queued/leased/running/retry_wait:等待后继续轮询
    const pollAfter = taskRes.data.poll_after_ms != null ? Number(taskRes.data.poll_after_ms) : 1000
    await sleep(Math.min(Math.max(pollAfter, 1000), 5000))
  }
  return { success: false, text: '', error: '转写超时,请重试' }
}

/**
 * 上传音频文件到 /voice/transcribe,创建异步转写任务。
 * 使用 uni.uploadFile(multipart),带 Idempotency-Key header。
 * 返回 { success, data: { task_id, status, poll_after_ms }, message }
 */
async function uploadAudioForTranscribe(audioPath: string, questionFieldKey: string): Promise<any> {
  if (audioPath == null || ('' + audioPath).length == 0) {
    return { success: false, data: null, message: '音频文件为空' }
  }
  const url = buildApiUrl('/voice/transcribe')
  const token = getAccessToken()
  const idempotencyKey = genIdempotencyKey()
  const headers: any = {}
  if (token != '') {
    headers['Authorization'] = 'Bearer ' + token
  }
  headers['Idempotency-Key'] = idempotencyKey

  return new Promise<any>((resolve) => {
    uni.uploadFile({
      url: url,
      filePath: audioPath,
      name: 'audio',
      formData: { question_field_key: questionFieldKey },
      header: headers,
      success: (res: any) => {
        const status = res.statusCode != null ? (res.statusCode as number) : 0
        let data: any = null
        try {
          data = JSON.parse('' + res.data)
        } catch (e) {
          resolve({ success: false, data: null, message: '转写响应解析失败' })
          return
        }
        if (status >= 200 && status < 300) {
          resolve({ success: true, data: data, message: 'success' })
        } else {
          const msg = data != null && data.detail != null && data.detail.message != null
            ? ('' + data.detail.message)
            : '转写请求失败'
          resolve({ success: false, data: null, message: msg })
        }
      },
      fail: (err: any) => {
        const msg = err != null && err.errMsg != null ? ('' + err.errMsg) : '上传失败,请检查网络'
        resolve({ success: false, data: null, message: msg })
      }
    })
  })
}

function mockTranscribe(questionText: string, fieldKey: string = ''): any {
  // 优先用 field_key 精准匹配
  if (fieldKey == 'age') return { success: true, text: '我今年28岁，从事产品设计工作', error: '' }
  if (fieldKey == 'city_code') return { success: true, text: '我现在生活在上海，在浦东新区工作', error: '' }
  if (fieldKey == 'marriage_status') return { success: true, text: '我是未婚状态', error: '' }
  if (fieldKey == 'education_level') return { success: true, text: '我的最高学历是本科，毕业于一所985院校', error: '' }
  if (fieldKey == 'height_cm') return { success: true, text: '我的身高是178厘米', error: '' }
  if (fieldKey == 'income_band') return { success: true, text: '我的年收入大概在20到30万之间', error: '' }
  if (fieldKey == 'occupation_group') return { success: true, text: '我从事产品设计工作，在一家互联网公司', error: '' }
  if (fieldKey == 'interest_tags') return { success: true, text: '平时喜欢摄影和徒步，周末经常去郊外拍风景', error: '' }
  if (fieldKey == 'lifestyle_tags') return { success: true, text: '平时生活比较规律，早睡早起，周末喜欢户外活动', error: '' }
  if (fieldKey == 'relationship_goal') return { success: true, text: '希望找到一个也喜欢户外活动、生活节奏接近的人', error: '' }

  // 回退到问题文本关键字匹配
  const q = questionText
  let text = '这个问题我想想，大概是这样一个情况'
  if (q.indexOf('城市') >= 0 || q.indexOf('生活') >= 0) text = '我现在生活在上海，在浦东新区工作'
  else if (q.indexOf('岁') >= 0 || q.indexOf('年龄') >= 0) text = '我今年28岁，从事产品设计工作'
  else if (q.indexOf('兴趣') >= 0 || q.indexOf('投入') >= 0) text = '平时喜欢摄影和徒步，周末经常去郊外拍风景'
  else if (q.indexOf('关系') >= 0 || q.indexOf('期待') >= 0) text = '希望找到一个也喜欢户外活动、生活节奏接近的人'
  else if (q.indexOf('学历') >= 0) text = '我的最高学历是本科，毕业于一所985院校'
  else if (q.indexOf('身高') >= 0) text = '我的身高是178厘米'
  else if (q.indexOf('收入') >= 0) text = '我的年收入大概在20到30万之间'
  else if (q.indexOf('婚姻') >= 0) text = '我是未婚状态'
  else if (q.indexOf('职业') >= 0) text = '我从事产品设计工作，在一家互联网公司'
  else if (q.indexOf('生活方式') >= 0) text = '平时生活比较规律，早睡早起，周末喜欢户外活动'
  return { success: true, text: text, error: '' }
}

/**
 * 语音合成(TTS):将问题文本合成为可播放的音频。
 * 返回 { success, audioUrl, durationMs, error }
 *
 * 真实分支:POST /voice/synthesize { text } → 返回 { audio_url, duration_ms }
 * mock 分支:返回占位 URL,调用方(VoiceRecorder)走计时器模拟播报。
 */
export async function synthesizeSpeech(text: string): Promise<any> {
  if (USE_MOCK) {
    // mock:返回占位 URL,VoiceRecorder 走 setTimeout 模拟播报(向后兼容)
    const estimatedMs = Math.min(5000, Math.max(2000, text.length * 250))
    return { success: true, audioUrl: '', durationMs: estimatedMs, error: '' }
  }
  const res = await request({
    url: '/voice/synthesize',
    method: 'POST',
    data: { text: text },
    headers: { 'Idempotency-Key': genIdempotencyKey() }
  })
  if (!res.success || res.data == null) {
    const msg = res.message != null ? ('' + res.message) : '语音合成失败'
    return { success: false, audioUrl: '', durationMs: 0, error: msg }
  }
  const audioUrl = res.data.audio_url != null ? ('' + res.data.audio_url) : ''
  if (audioUrl == '') {
    return { success: false, audioUrl: '', durationMs: 0, error: '语音合成返回空音频' }
  }
  const durationMs = res.data.duration_ms != null ? Number(res.data.duration_ms) : 0
  return {
    success: true,
    audioUrl: resolveMediaUrl(audioUrl),
    durationMs: durationMs,
    error: ''
  }
}

