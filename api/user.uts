/**
 * 用户相关 API
 * Mock 来源：design-demos/final 高保真嘉宾数据
 * likeUser / applyToMeet：USE_MOCK 双路径；真接口走 social / discovery
 */

import { request } from './request.uts'
import { USE_MOCK, getAccessToken, clearAuthTokens, buildApiUrl } from './config.uts'
import {
  mockRecommendUsers,
  mockSquareUsers,
  mockUserDetail,
  mockMeProfile,
  mockCommunityQuotas,
  mockApplyStates,
  mockLikedUserIds
} from '@/mock'
import { __syncApplyStatus, getCommunityQuotas } from './community.uts'

function okRes(data: any): any {
  return {
    success: true,
    data: data,
    code: 0,
    message: 'success'
  }
}

function failRes(message: string, code: any = -1, extra: any = null): any {
  const data: any = { success: false, code: code, message: message }
  if (extra != null) {
    const keys = Object.keys(extra)
    for (let i = 0; i < keys.length; i++) {
      data[keys[i]] = extra[keys[i]]
    }
  }
  return {
    success: false,
    data: data,
    code: code,
    message: message
  }
}

function extractHttpMessage(res: any, fallback: string): string {
  if (res == null) return fallback
  if (res.message != null && res.message != '' && res.message != '请求失败') {
    return '' + res.message
  }
  const raw = res.data
  if (raw != null && raw.detail != null) {
    if (typeof raw.detail === 'string') return '' + raw.detail
  }
  return fallback
}

function normalizeProfileMedia(raw: any): any {
	if (raw == null || typeof raw !== 'object') return raw
	const data: any = { ...raw }
	if (data.avatar != null) data.avatar = resolveMediaUrl(data.avatar)
	if (data.background_wall != null) data.background_wall = resolveMediaUrl(data.background_wall)
	if (data.photos != null && Array.isArray(data.photos)) {
		data.photos = (data.photos as any[]).map((photo: any) => {
			if (photo == null || typeof photo !== 'object') return resolveMediaUrl(photo)
			return { ...photo, file_url: photo.file_url != null ? resolveMediaUrl(photo.file_url) : photo.file_url, url: photo.url != null ? resolveMediaUrl(photo.url) : photo.url }
		})
	}
	if (data.profile != null && typeof data.profile === 'object') data.profile = normalizeProfileMedia(data.profile)
	if (data.card != null && typeof data.card === 'object') data.card = normalizeProfileMedia(data.card)
	return data
}

const CHAT_FEATURE_UNLOCK_STORAGE_KEY = 'xsa_chat_feature_unlocks_v1'

const defaultMockPreferences: any = {
  user_id: 1,
  age_min: null,
  age_max: null,
  height_min: null,
  height_max: null,
  education_min: null,
  income_min: null,
  marriage_status: 0,
  preferred_province_code: null,
  preferred_city_codes: [],
  accept_long_distance: true,
  accept_cross_province: true,
  housing_requirement: 0,
  smoking_requirement: 0,
  drinking_requirement: 0,
  extra_requirement: null
}
export const CHAT_FEATURE_UNLOCK_COST = 80
let chatFeatureUnlocksLoaded = false
const chatFeatureUnlocks: any = {
  album: false,
  camera: false,
  profile: false
}

function restoreChatFeatureUnlocks() {
  if (chatFeatureUnlocksLoaded) return
  chatFeatureUnlocksLoaded = true
  try {
    const saved = uni.getStorageSync(CHAT_FEATURE_UNLOCK_STORAGE_KEY) as any
    if (saved == null || typeof saved !== 'object') return
    chatFeatureUnlocks.album = saved.album == true
    chatFeatureUnlocks.camera = saved.camera == true
    chatFeatureUnlocks.profile = saved.profile == true
    if (saved.points != null && Number(saved.points) >= 0) {
      mockMeProfile.points = Number(saved.points)
    }
  } catch (e) {
    console.error('恢复聊天功能解锁状态失败', e)
  }
}

function saveChatFeatureUnlocks() {
  uni.setStorageSync(CHAT_FEATURE_UNLOCK_STORAGE_KEY, {
    album: chatFeatureUnlocks.album == true,
    camera: chatFeatureUnlocks.camera == true,
    profile: chatFeatureUnlocks.profile == true,
    points: mockMeProfile.points
  })
}

/** 获取聊天页的付费功能解锁状态及当前积分余额。 */
export async function getChatFeatureUnlocks() {
  restoreChatFeatureUnlocks()
  return request({
    url: '/user/chat-feature-unlocks',
    cloudFunctionName: 'user',
    action: 'getChatFeatureUnlocks',
    method: 'GET',
    mockData: {
      album: chatFeatureUnlocks.album == true,
      camera: chatFeatureUnlocks.camera == true,
      profile: chatFeatureUnlocks.profile == true,
      points: mockMeProfile.points,
      cost: CHAT_FEATURE_UNLOCK_COST
    }
  })
}

/** 首次使用聊天相册、拍摄或查看主页时扣除 80 积分，后续使用不再扣费。 */
export async function unlockChatFeature(feature: string) {
  restoreChatFeatureUnlocks()
  const supported = feature == 'album' || feature == 'camera' || feature == 'profile'
  if (!supported) {
    return request({
      url: '/user/chat-feature-unlocks',
      cloudFunctionName: 'user',
      action: 'unlockChatFeature',
      method: 'POST',
      data: { feature },
      mockData: { success: false, message: '暂不支持该解锁功能' }
    })
  }

  if (chatFeatureUnlocks[feature] == true) {
    return request({
      url: '/user/chat-feature-unlocks',
      cloudFunctionName: 'user',
      action: 'unlockChatFeature',
      method: 'POST',
      data: { feature },
      mockData: { success: true, alreadyUnlocked: true, feature, points: mockMeProfile.points }
    })
  }

  if (mockMeProfile.points < CHAT_FEATURE_UNLOCK_COST) {
    return request({
      url: '/user/chat-feature-unlocks',
      cloudFunctionName: 'user',
      action: 'unlockChatFeature',
      method: 'POST',
      data: { feature },
      mockData: { success: false, code: 'INSUFFICIENT_POINTS', message: '积分不足，无法解锁该功能', points: mockMeProfile.points }
    })
  }

  mockMeProfile.points -= CHAT_FEATURE_UNLOCK_COST
  chatFeatureUnlocks[feature] = true
  saveChatFeatureUnlocks()
  return request({
    url: '/user/chat-feature-unlocks',
    cloudFunctionName: 'user',
    action: 'unlockChatFeature',
    method: 'POST',
    data: { feature },
    mockData: { success: true, feature, points: mockMeProfile.points, cost: CHAT_FEATURE_UNLOCK_COST }
  })
}

/**
 * 获取推荐用户（支持轮换 index）
 */
export async function getRecommendUser(index: number = 0) {
  if (!USE_MOCK) {
    const res = await request({
      url: '/discovery/recommendations',
      method: 'GET',
      data: { page: 1, page_size: 20 }
    })
    if (!res.success) return res
    const rows = res.data != null && Array.isArray(res.data.items) ? res.data.items as any[] : []
    return { success: true, data: rows.length > 0 ? rows[Math.min(index, rows.length - 1)] : null, code: res.code, message: res.message }
  }
  const list = mockRecommendUsers as any[]
  const i = list.length > 0 ? (index % list.length) : 0
  const user = list.length > 0 ? list[i] : mockUserDetail
  return request({
    url: '/user/recommend',
    cloudFunctionName: 'user',
    action: 'getRecommend',
    method: 'GET',
    data: { index: i },
    mockData: user
  })
}

/**
 * 获取推荐用户列表（全量）
 */
export async function getRecommendUsers() {
  if (!USE_MOCK) {
    return request({ url: '/discovery/recommendations', method: 'GET', data: { page: 1, page_size: 20 } })
  }
  return request({
    url: '/user/recommend/list',
    cloudFunctionName: 'user',
    action: 'getRecommendList',
    method: 'GET',
    mockData: mockRecommendUsers
  })
}

