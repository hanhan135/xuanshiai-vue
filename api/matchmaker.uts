/**
 * 获取私人定制方案
 */
export async function getCustomPlans() {
  const result = await request({
    url: '/matchmaker/service-products',
    forceHttp: true,
    skipAuth: true,
    mockFallback: true,
    method: 'GET',
    mockData: mockCustomPlans
  })
  if (result.success && result.data != null && Array.isArray(result.data)) {
    result.data = (result.data as any[]).map((item: any) => toCustomPlan(item))
  }
  return result
}

/**
 * 获取私人定制套餐（兼容旧命名）
 */
export async function getCustomPackages() {
  return getCustomPlans()
}

/** 获取中国省份列表（私人定制所在地选择）。 */
export async function getRegionProvinces() {
  return request({
    url: '/regions/provinces',
    forceHttp: true,
    skipAuth: true,
    method: 'GET'
  })
}

/** 按省份代码获取城市列表（私人定制所在地选择）。 */
export async function getRegionCities(provinceCode: string) {
  return request({
    url: '/regions/cities',
    forceHttp: true,
    skipAuth: true,
    method: 'GET',
    data: { province_code: provinceCode }
  })
}

/**
 * 提交红娘入驻申请（我要做红娘）
 */
export async function submitMatchmakerApplication(data: any) {
  return submitRoleApplication('service_matchmaker', data)
}

/**
 * 提交合伙人入驻申请
 */
export async function submitPartnerApplication(data: any) {
  return submitRoleApplication('partner', data)
}

/**
 * 提交推广红娘入驻申请
 */
export async function submitPromoterApplication(data: any) {
	return submitRoleApplication('promoter', data)
}

export async function submitConnectionApplication(data: any) {
  if (data.orderNo == null || String(data.orderNo).length == 0) {
    return {
      success: false,
      data: null,
      code: 400,
      message: '请选择服务套餐并完成支付后再提交牵线需求'
    }
  }
  return request({
    url: '/matchmaker/service-requests',
    forceHttp: true,
    method: 'POST',
    data: {
      order_no: String(data.orderNo),
      requirement: String(data.requirements)
    }
  })
}

/**
 * 预约红娘服务
 * @param matchmakerId 红娘 ID
 * @param packageId 套餐 ID（可选）
 */
export async function bookMatchmaker(matchmakerId: number, packageId?: number) {
  return {
    success: false,
    data: null,
    code: 400,
    message: packageId == null
      ? '请选择服务套餐后创建订单'
      : '请在服务套餐页完成订单支付'
  }
}
