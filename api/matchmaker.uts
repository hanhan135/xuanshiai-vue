function normalizePromoterCenterSnapshot(data: any) {
  const source = data != null ? data : {}
  const profile = source.profile != null ? source.profile : {}
  const toMember = (item: any) => ({ id: item.user_id, name: item.nickname || '', gender: item.gender == 1 ? '男' : (item.gender == 2 ? '女' : ''), registerAt: formatWorkspaceTime(item.register_at), reviewStatus: item.review_status || 'PENDING' })
  const toLead = (item: any) => ({ id: item.id, name: item.name || '', nickname: item.name || '', realName: item.name || '', phone: item.phone || '', wechat: item.wechat || '', source: item.source || '', status: item.status || 'NEW', createdAt: formatWorkspaceTime(item.created_at) })
  return { profile: { nickname: profile.nickname || '', promotionCode: profile.promotion_code || '', balance: null, points: null, level: '推广红娘' }, teamOptions: [] as any[], leads: (Array.isArray(source.leads) ? source.leads : []).map(toLead), effectiveMembers: (Array.isArray(source.effective_members) ? source.effective_members : []).map(toMember), incompleteMembers: (Array.isArray(source.incomplete_members) ? source.incomplete_members : []).map(toMember), rewards: [] as any[], commissions: [] as any[], withdrawals: [] as any[], offlineOrders: [] as any[], financeAvailable: source.finance_available == true }
}

export async function getPromoterCenterSnapshot() { const result = await request({ url: '/matchmaker/promoter-center', method: 'GET' }); if (!result.success || result.data == null) return result; return { success: true, data: normalizePromoterCenterSnapshot(result.data), code: result.code, message: result.message } }
