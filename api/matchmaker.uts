/**
 * 获取红娘联系信息 Mock。真实联系接口接入前，始终返回测试数据。
 */
export async function getMockMatchmakerContact() {
  return {
    success: true,
    data: Object.assign({}, mockMatchmakerContact),
    code: 0,
    message: 'success'
  }
}

function toMatchmakerCard(item: any) {
  const successCount = item.success_count != null ? Number(item.success_count) : 0
  const cases: any[] = []
  if (item.cases != null) {
    const source = item.cases as any[]
    for (let i = 0; i < source.length; i++) {
      const entry = source[i]
      const description = entry.description != null ? String(entry.description).trim() : ''
      if (description.length == 0) continue
      const images: string[] = []
      if (entry.images != null) {
        const sourceImages = entry.images as any[]
        for (let j = 0; j < sourceImages.length; j++) {
          const image = String(sourceImages[j]).trim()
          if (image.length > 0) images.push(image)
        }
      }
      cases.push({
        _id: 'service-case-' + String(item.user_id) + '-' + String(i),
        image: images.length > 0 ? images[0] : '',
        images: images,
        story: description,
        copy: description,
        feedback: entry.feedback != null ? String(entry.feedback).trim() : '',
        matchmakerComment: '',
        tags: []
      })
    }
  }
  return {
    id: item.user_id != null ? Number(item.user_id) : Number(item.id),
    name: item.nickname != null && String(item.nickname).length > 0 ? String(item.nickname) : '服务红娘',
    avatar: item.avatar != null ? String(item.avatar) : '',
    city: '',
    title: '平台认证服务红娘',
    introduction: item.intro != null ? String(item.intro) : '',
    description: item.intro != null ? String(item.intro) : '',
    serviceCount: successCount,
    successCount,
    successRate: 0,
    tags: item.certification_tags != null ? item.certification_tags : [],
    badge: '平台认证',
    price: null,
    priceUnit: '',
    status: item.is_available === true ? 'online' : 'busy',
    certification: item.certification_tags != null && item.certification_tags.length > 0,
    isOnline: item.is_available === true,
    cases: cases,
    caseRecord: successCount > 0 ? '累计促成 ' + successCount + ' 次有效牵线。' : ''
  }
}

function cleanPlanText(value: any, fallback: string): string {
  const text = value != null ? String(value).trim() : ''
  if (text.length == 0 || text.indexOf('?') >= 0) {
    return fallback
  }
  return text
}

/**
 * 将服务端管理中心访问状态收敛为页面使用的字段。
 * 客户端始终同时校验服务端 can_access、角色 active 与已付款状态；
 * 服务端仍是权限、订单和岗位状态的唯一可信来源。
 */
function normalizeMatchmakerManagementCenterAccess(data: any) {
  const source = data != null ? data : {}
  const roleStatus = source.role_status != null ? String(source.role_status) : (source.roleStatus != null ? String(source.roleStatus) : '')
  const paymentStatus = source.payment_status != null ? String(source.payment_status) : (source.paymentStatus != null ? String(source.paymentStatus) : '')
  const serverCanAccess = source.can_access != null
    ? source.can_access == true || String(source.can_access) == 'true'
    : (source.canAccess == true || String(source.canAccess) == 'true')
  return {
    roleStatus: roleStatus,
    paymentStatus: paymentStatus,
    canAccess: serverCanAccess && roleStatus == 'active' && paymentStatus == 'paid',
    paidAt: source.paid_at != null ? String(source.paid_at) : (source.paidAt != null ? String(source.paidAt) : ''),
    scope: source.scope != null ? String(source.scope) : '',
    source: source.source != null ? String(source.source) : 'api',
    message: source.message != null ? String(source.message) : ''
  }
}

/** 获取总店红娘管理中心开通与权限状态。 */
export async function getMatchmakerManagementCenterAccess() {
  if (MATCHMAKER_MANAGEMENT_CENTER_USE_MOCK) {
    return {
      success: true,
      data: normalizeMatchmakerManagementCenterAccess(mockMatchmakerManagementCenterAccess),
      code: 0,
      message: '框架占位'
    }
  }
  const result = await request({
    url: '/matchmaker/management-center/access',
    forceHttp: true,
    method: 'GET'
  })
  if (!result.success || result.data == null) return result
  return {
    success: true,
    data: normalizeMatchmakerManagementCenterAccess(result.data),
    code: result.code,
    message: result.message
  }
}

/**
 * 获取总店红娘工作台聚合快照。
 * 不返回手机号、微信号等敏感资料；明细和写操作须由各业务接口按 RBAC 单独控制。
 */
export async function getMatchmakerManagementCenterSnapshot() {
  if (MATCHMAKER_MANAGEMENT_CENTER_USE_MOCK) {
    return {
      success: true,
      data: mockMatchmakerManagementCenterSnapshot,
      code: 0,
      message: '框架占位'
    }
  }
  return request({
    url: '/matchmaker/management-center/dashboard',
    forceHttp: true,
    method: 'GET'
  })
}

const PARTNER_CENTER_MOCK_STORAGE_KEY = 'xsa_partner_center_mock_snapshot'

function createPartnerCenterMockSnapshot() {
  return {
    source: 'mock',
    profile: Object.assign({}, mockPartnerCenterSnapshot.profile),
    inviteCode: mockPartnerCenterSnapshot.inviteCode,
    teamMembers: [] as any[],
    effectiveMembers: [] as any[],
    registrationRewards: [] as any[],
    commissionRecords: [] as any[],
    withdrawalRecords: [] as any[]
  }
}

function getPartnerCenterMockSnapshot() {
  try {
    const saved = uni.getStorageSync(PARTNER_CENTER_MOCK_STORAGE_KEY)
    if (saved != null && saved.profile != null) return saved as any
  } catch (e) {}
  const fresh = createPartnerCenterMockSnapshot()
  try { uni.setStorageSync(PARTNER_CENTER_MOCK_STORAGE_KEY, fresh) } catch (e) {}
  return fresh
}

function savePartnerCenterMockSnapshot(snapshot: any) {
  try { uni.setStorageSync(PARTNER_CENTER_MOCK_STORAGE_KEY, snapshot) } catch (e) {}
}

/** 合伙人中心聚合数据：后端接入前只从当前设备本地 Mock 读取。 */
export async function getPartnerCenterSnapshot() {
  if (!PARTNER_CENTER_USE_MOCK) return { success: false, data: null, code: 501, message: '合伙人中心后端接口尚未接入' }
  return { success: true, data: getPartnerCenterMockSnapshot(), code: 0, message: 'success' }
}

/** 修改团队名称，仅保存至当前设备的本地 Mock 数据。 */
export async function updatePartnerTeamName(teamName: string) {
  const value = teamName.trim()
  if (value.length < 2 || value.length > 20) return { success: false, data: null, code: 400, message: '团队名称需为 2-20 个字符' }
  const snapshot = getPartnerCenterMockSnapshot()
  snapshot.profile.teamName = value
  savePartnerCenterMockSnapshot(snapshot)
  return { success: true, data: snapshot, code: 0, message: 'success' }
}

/** 更新账号展示资料，仅保存至当前设备的本地 Mock 数据。 */
export async function updatePartnerAccountProfile(changes: any) {
  const snapshot = getPartnerCenterMockSnapshot()
  snapshot.profile = Object.assign({}, snapshot.profile, changes)
  savePartnerCenterMockSnapshot(snapshot)
  return { success: true, data: snapshot, code: 0, message: 'success' }
}

/** 提交提现申请。余额不足时返回可读校验错误，不产生虚构资金流水。 */
export async function createPartnerWithdrawal(data: any) {
  const snapshot = getPartnerCenterMockSnapshot()
  const amount = Number(data != null ? data.amount : 0)
  if (isNaN(amount) || amount < 1 || amount > 1000) return { success: false, data: null, code: 400, message: '请输入 1-1000 元的提现金额' }
  if (amount > Number(snapshot.profile.balance || 0)) return { success: false, data: null, code: 400, message: '提现金额不能超过可提现余额' }
  const method = data != null && data.method != null ? String(data.method) : ''
  const account = data != null && data.account != null ? String(data.account).trim() : ''
  const payee = data != null && data.payee != null ? String(data.payee).trim() : ''
  if (method == '' || account == '' || payee == '') return { success: false, data: null, code: 400, message: '请完整填写收款方式和收款信息' }
  const record = { id: 'withdraw-' + Date.now(), amount: amount, method: method, status: '审核中', account: account, payee: payee, createdAt: String(Date.now()) }
  snapshot.withdrawalRecords.unshift(record)
  snapshot.profile.balance = Number(snapshot.profile.balance || 0) - amount
  savePartnerCenterMockSnapshot(snapshot)
  return { success: true, data: record, code: 0, message: '提现申请已提交' }
}

const PROMOTER_CENTER_MOCK_STORAGE_KEY = 'xsa_promoter_center_mock_snapshot'
function createPromoterCenterMockSnapshot() { return { source: 'mock', profile: Object.assign({}, mockPromoterCenterSnapshot.profile), teamOptions: [] as any[], leads: [] as any[], effectiveMembers: [] as any[], incompleteMembers: [] as any[], rewards: [] as any[], commissions: [] as any[], withdrawals: [] as any[], offlineOrders: [] as any[], finance: { expenses: [] as any[], balance: [] as any[], points: [] as any[] } } }
function getPromoterCenterMockSnapshot() { try { const saved = uni.getStorageSync(PROMOTER_CENTER_MOCK_STORAGE_KEY); if (saved != null && saved.profile != null) return saved as any } catch (e) {}; const fresh = createPromoterCenterMockSnapshot(); try { uni.setStorageSync(PROMOTER_CENTER_MOCK_STORAGE_KEY, fresh) } catch (e) {}; return fresh }
function savePromoterCenterMockSnapshot(snapshot: any) { try { uni.setStorageSync(PROMOTER_CENTER_MOCK_STORAGE_KEY, snapshot) } catch (e) {} }
export async function getPromoterCenterSnapshot() { if (!PROMOTER_CENTER_USE_MOCK) return { success: false, data: null, code: 501, message: '推广红娘中心后端接口尚未接入' }; return { success: true, data: getPromoterCenterMockSnapshot(), code: 0, message: 'success' } }
export async function updatePromoterCenterProfile(changes: any) { const snapshot = getPromoterCenterMockSnapshot(); snapshot.profile = Object.assign({}, snapshot.profile, changes); savePromoterCenterMockSnapshot(snapshot); return { success: true, data: snapshot, code: 0, message: 'success' } }
export async function addPromoterLead(data: any) { const phone = data != null && data.phone != null ? String(data.phone).trim() : ''; if (!/^1[3-9]\d{9}$/.test(phone)) return { success: false, data: null, code: 400, message: '请输入正确的11位手机号' }; const snapshot = getPromoterCenterMockSnapshot(); const lead = { id: 'lead-' + Date.now(), source: String(data.source || ''), phone: phone, wechat: String(data.wechat || ''), nickname: String(data.nickname || ''), realName: String(data.realName || ''), gender: String(data.gender || '男'), birth: String(data.birth || ''), height: String(data.height || ''), weight: String(data.weight || ''), description: String(data.description || ''), createdAt: String(Date.now()), status: '待审' }; snapshot.leads.unshift(lead); savePromoterCenterMockSnapshot(snapshot); return { success: true, data: lead, code: 0, message: '客源已提交审核' } }
export async function createPromoterWithdrawal(data: any) { const snapshot = getPromoterCenterMockSnapshot(); const amount = Number(data != null ? data.amount : 0); if (isNaN(amount) || amount < 1 || amount > 1000) return { success: false, data: null, code: 400, message: '请输入 1-1000 元的提现金额' }; if (amount > Number(snapshot.profile.balance || 0)) return { success: false, data: null, code: 400, message: '提现金额不能超过可提现余额' }; const account = String(data.account || '').trim(), payee = String(data.payee || '').trim(); if (account == '' || payee == '') return { success: false, data: null, code: 400, message: '请完整填写收款信息' }; snapshot.withdrawals.unshift({ id: 'withdraw-' + Date.now(), amount: amount, method: String(data.method || '微信'), account: account, payee: payee, createdAt: String(Date.now()), status: '审核中' }); snapshot.profile.balance = Number(snapshot.profile.balance || 0) - amount; savePromoterCenterMockSnapshot(snapshot); return { success: true, data: snapshot, code: 0, message: '提现申请已提交' } }

/**
 * 前端 Mock 的资料待审工作台。后端尚未接入前，所有变更仅保留在当前运行实例。
 */
export async function getMatchmakerReviewMembers() {
  return {
    success: true,
    data: mockMatchmakerReviewMembers,
    code: 0,
    message: 'success'
  }
}

/** 更新一名会员的前端暂存资料、审核状态或服务记录。 */
export async function updateMatchmakerReviewMember(id: string, changes: any) {
  let target: any = null
  for (let i = 0; i < mockMatchmakerReviewMembers.length; i++) {
    if (String(mockMatchmakerReviewMembers[i].id) == String(id)) {
      target = mockMatchmakerReviewMembers[i]
      break
    }
  }
  if (target == null) return { success: false, data: null, code: 404, message: '未找到该会员资料' }
  Object.assign(target, changes != null ? changes : {})
  return { success: true, data: target, code: 0, message: '已保存到本地 Mock 数据' }
}

function toCustomPlan(item: any) {
	const serviceType = Number(item.service_type)
	const defaultName = serviceType == 3 ? '私人定制套餐' : '牵线服务套餐'
	const defaultDescription = serviceType == 3 ? '红娘一对一陪伴，帮助你梳理关系期待。' : '平台红娘一对一牵线服务。'
	const description = cleanPlanText(item.description, defaultDescription)
  return {
    id: Number(item.id),
    name: cleanPlanText(item.name, defaultName),
    price: Number(item.price),
    originalPrice: Number(item.price),
    duration: serviceType == 3 ? '私人定制服务' : '牵线服务',
    services: [description],
    features: [description],
    matchmakerCount: 1,
    description: description,
    isHot: false,
    tag: serviceType == 3 ? '私人定制' : '服务红娘'
  }
}

/**
 * 管理员创建红娘服务商品。
 * 仅管理员令牌可调用；普通用户调用会由后端返回 403。
 */
export async function createMatchmakerServiceProduct(data: any) {
  const source = data != null ? data : {}
  const serviceType = source.service_type != null ? source.service_type : source.serviceType
  return request({
    url: '/matchmaker/service-products',
    method: 'POST',
    data: {
      code: source.code != null ? String(source.code).trim() : '',
      name: source.name != null ? String(source.name).trim() : '',
      service_type: serviceType != null ? Number(serviceType) : 0,
      price: source.price != null ? Number(source.price) : 0,
      description: source.description != null ? String(source.description).trim() : '',
      active: source.active != null ? source.active == true : true
    }
  })
}

function toRoleApplication(applicationType: string, data: any) {
  const certImages: string[] = []
  const specialties: string[] = []
  const successCases: any[] = []
  const avatar = data.avatar != null ? String(data.avatar).trim() : ''

  if (avatar.length > 0) certImages.push(avatar)
  if (data.specialties != null) {
    const source = data.specialties as any[]
    for (let i = 0; i < source.length && specialties.length < 5; i++) {
      const specialty = String(source[i]).trim()
      if (specialty.length > 0 && specialties.indexOf(specialty) < 0) specialties.push(specialty)
    }
  }
  if (data.cases != null) {
    const cases = data.cases as any[]
    for (let i = 0; i < cases.length && successCases.length < 3; i++) {
      const description = cases[i].description != null ? String(cases[i].description).trim() : ''
      if (description.length == 0) continue
      const images: string[] = []
      const caseImages = cases[i].images as string[]
      if (caseImages != null) {
        for (let j = 0; j < caseImages.length && images.length < 3; j++) {
          const image = String(caseImages[j]).trim()
          if (image.length == 0) continue
          images.push(image)
          if (certImages.length < 6) certImages.push(image)
        }
      }
      successCases.push({ description: description, images: images })
    }
  }

  let expectedPrice: number | null = null
  if (data.price != null && String(data.price).length > 0) {
    const price = Number(data.price)
    if (!isNaN(price) && price >= 0) expectedPrice = price
  }

  return {
    application_type: applicationType,
    real_name: String(data.realName).trim(),
    phone: String(data.phone).trim(),
    intro: String(data.introduction).trim(),
    wechat: data.wechat != null ? String(data.wechat).trim() : '',
    avatar: avatar.length > 0 ? avatar : null,
    specialties: specialties,
    expected_price: expectedPrice,
    success_cases: successCases,
    cert_images: certImages
  }
}

const ROLE_APPLICATION_MOCK_STORAGE_KEY = 'xsa_role_application_mock_records'

function maskMockPhone(phone: string): string {
  if (phone.length < 7) return phone
  return phone.substring(0, 3) + '****' + phone.substring(phone.length - 4)
}

function restoreMockRoleApplications() {
  try {
    const saved = uni.getStorageSync(ROLE_APPLICATION_MOCK_STORAGE_KEY)
    if (saved == null || !Array.isArray(saved)) return
    mockRoleApplications.splice(0, mockRoleApplications.length)
    const records = saved as any[]
    for (let i = 0; i < records.length; i++) mockRoleApplications.push(records[i])
  } catch (e) {}
}

function persistMockRoleApplications() {
  try {
    uni.setStorageSync(ROLE_APPLICATION_MOCK_STORAGE_KEY, mockRoleApplications)
  } catch (e) {}
}

function createMockRoleApplication(applicationType: string, data: any) {
  restoreMockRoleApplications()
  const payload = toRoleApplication(applicationType, data)
  const now = new Date().toISOString()
  const record = {
    id: Date.now(),
    application_type: payload.application_type,
    status: 0,
    real_name: payload.real_name,
    phone_masked: maskMockPhone(payload.phone),
    intro: payload.intro,
    cert_images: payload.cert_images,
    application_details: {
      wechat: payload.wechat,
      avatar: payload.avatar,
      specialties: payload.specialties,
      expected_price: payload.expected_price,
      success_cases: payload.success_cases
    },
    fail_reason: null,
    created_at: now,
    reviewed_at: null,
    source: 'mock'
  }
  mockRoleApplications.unshift(record)
  persistMockRoleApplications()
  return {
    success: true,
    data: record,
    code: 0,
    message: '模拟申请已提交'
  }
}

async function submitRoleApplication(applicationType: string, data: any) {
  if (ROLE_APPLICATION_USE_MOCK) return createMockRoleApplication(applicationType, data)
  return request({
    url: '/matchmaker/applications',
    forceHttp: true,
    method: 'POST',
    data: toRoleApplication(applicationType, data)
  })
}

const CUSTOM_SERVICE_DRAFT_STORAGE_KEY = 'xsa_custom_service_application_draft'
const CUSTOM_SERVICE_PAYMENT_STORAGE_KEY = 'xsa_custom_service_payment_order'

/** Create a real pending-payment private-customization order. */
export async function createCustomServiceOrder(data: any) {
  const source = data != null ? data : {}
  const productId = source.planId != null ? Number(source.planId) : 0
  const requirement = source.requirements != null ? String(source.requirements).trim() : ''
  const realName = source.realName != null ? String(source.realName).trim() : ''
  const phone = source.phone != null ? String(source.phone).trim() : ''
  const city = source.city != null ? String(source.city).trim() : ''
  if (productId <= 0 || requirement.length < 10) {
    return { success: false, data: null, code: 400, message: '请补充至少 10 个字的牵线需求' }
  }
  if (realName.length < 2 || !/^1[3-9]\d{9}$/.test(phone) || city.length == 0) {
    return { success: false, data: null, code: 400, message: '请完整填写真实姓名、手机号和所在城市' }
  }
  const idempotencyKey = 'xsa-custom-' + Date.now() + '-' + Math.floor(Math.random() * 100000000)
  return request({
    url: '/matchmaker/service-requests/orders',
    forceHttp: true,
    method: 'POST',
    headers: { 'Idempotency-Key': idempotencyKey },
    data: {
      product_id: productId,
      real_name: realName,
      phone: phone,
      city: city,
      requirement: requirement
    }
  })
}

/** Read the current user's service order and recover the payment screen state. */
export async function getCustomServiceOrder(orderNo: string) {
  if (orderNo == null || String(orderNo).trim().length == 0) {
    return { success: false, data: null, code: 400, message: '订单号不能为空' }
  }
  return request({
    url: '/matchmaker/service-requests/orders/' + encodeURIComponent(String(orderNo).trim()),
    forceHttp: true,
    method: 'GET'
  })
}

function readCustomServiceDraft(): any {
  try {
    const draft = uni.getStorageSync(CUSTOM_SERVICE_DRAFT_STORAGE_KEY)
    return draft != null && typeof draft === 'object' ? draft : null
  } catch (e) {
    return null
  }
}

function saveCustomServiceDraft(draft: any) {
  try {
    uni.setStorageSync(CUSTOM_SERVICE_DRAFT_STORAGE_KEY, draft)
  } catch (e) {}
}

function rememberMockPaymentOrder(order: any) {
  let found = -1
  for (let i = 0; i < mockCustomServicePaymentOrders.length; i++) {
    if (mockCustomServicePaymentOrders[i].draftId == order.draftId) {
      found = i
      break
    }
  }
  if (found >= 0) {
    mockCustomServicePaymentOrders[found] = order
  } else {
    mockCustomServicePaymentOrders.unshift(order)
  }
  try {
    uni.setStorageSync(CUSTOM_SERVICE_PAYMENT_STORAGE_KEY, order)
  } catch (e) {}
}

/** 保存私人定制资料，等待用户完成付款后再正式提交牵线申请。 */
export function saveCustomServiceApplicationDraft(data: any) {
  const planId = data != null && data.planId != null ? Number(data.planId) : 0
  const planName = data != null && data.planName != null ? String(data.planName) : ''
  const amount = data != null && data.planPrice != null ? Number(data.planPrice) : 0
  if (planId <= 0 || planName.length == 0 || amount <= 0) {
    return { success: false, data: null, code: 400, message: '请选择有效的服务套餐' }
  }

  const draft = {
    draftId: 'custom-service-' + Date.now(),
    planId: planId,
    planName: planName,
    planDuration: data.planDuration != null ? String(data.planDuration) : '',
    planPrice: amount,
    realName: data.realName != null ? String(data.realName) : '',
    phone: data.phone != null ? String(data.phone) : '',
    city: data.city != null ? String(data.city) : '',
    gender: data.gender != null ? String(data.gender) : '',
    description: data.description != null ? String(data.description) : '',
    requirements: data.requirements != null ? String(data.requirements) : '',
    paymentStatus: 'unpaid',
    applicationStatus: 'pending_payment',
    createdAt: Date.now()
  }
  saveCustomServiceDraft(draft)
  return { success: true, data: draft, code: 0, message: '资料已保存' }
}

/** 读取待付款的私人定制申请资料。 */
export function getCustomServiceApplicationDraft(draftId: string) {
  const draft = readCustomServiceDraft()
  if (draft == null || draft.draftId != draftId) {
    return { success: false, data: null, code: 404, message: '未找到待付款的私人定制申请' }
  }
  return { success: true, data: draft, code: 0, message: 'success' }
}

/**
 * 支付联调 Mock：写入已付款订单，并将牵线申请状态置为已提交。
 * 真实支付合同接入前不发起外部扣款。
 */
export async function payCustomServiceApplication(draftId: string) {
  const current = getCustomServiceApplicationDraft(draftId)
  if (!current.success || current.data == null) return current

  const draft = current.data
  if (draft.paymentStatus == 'paid' && draft.applicationStatus == 'submitted') {
    return { success: true, data: draft, code: 0, message: '申请已提交' }
  }

  const paidAt = new Date().toISOString()
  const order = {
    orderNo: 'MOCK-PAY-' + Date.now(),
    draftId: draft.draftId,
    planId: draft.planId,
    planName: draft.planName,
    planDuration: draft.planDuration,
    amount: draft.planPrice,
    paymentStatus: 'paid',
    applicationStatus: 'submitted',
    paidAt: paidAt
  }
  draft.orderNo = order.orderNo
  draft.paymentStatus = 'paid'
  draft.applicationStatus = 'submitted'
  draft.paidAt = paidAt
  saveCustomServiceDraft(draft)
  rememberMockPaymentOrder(order)
  return { success: true, data: draft, code: 0, message: '支付成功，牵线申请已提交' }
}

/**
 * 获取红娘详情
 */
export async function getMatchmakerDetail(id: number) {
  const result = await request({
    url: '/matchmakers/' + id,
    forceHttp: true,
    skipAuth: true,
    method: 'GET',
    mockData: null
  })
  if (result.success && result.data != null) result.data = toMatchmakerCard(result.data)
  return result
}

/**
 * 获取服务红娘列表
 */
export async function getServiceMatchmakers() {
  const result = await request({
    url: '/matchmakers',
    forceHttp: true,
    skipAuth: true,
    mockFallback: true,
    method: 'GET',
    mockData: mockServiceMatchmakers
  })
  if (result.success && result.data != null && result.data.items != null) {
    result.data = (result.data.items as any[]).map((item: any) => toMatchmakerCard(item))
  }
  return result
}

