/**
 * 获取红娘详情
 */
export async function getMatchmakerDetail(id: number) {
  const result = await request({
    url: '/matchmakers/' + id,
    forceHttp: true,
    skipAuth: true,
    method: 'GET',
    mockData: null
  })
  if (result.success && result.data != null) result.data = toMatchmakerCard(result.data)
  return result
}

/**
 * 获取服务红娘列表
 */
export async function getServiceMatchmakers(internalMock: boolean = false) {
  if (internalMock) return internalMockListResponse(mockServiceMatchmakers as any[])
  const result = await request({
    url: '/matchmakers',
    forceHttp: true,
    skipAuth: true,
    method: 'GET'
  })
  if (result.success && result.data != null && result.data.items != null) {
    result.data = (result.data.items as any[]).map((item: any) => toMatchmakerCard(item))
  }
  return result
}

