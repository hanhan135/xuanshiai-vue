/**
 * AI 分身前端服务。
 * 当前实现完全本地化，后续接入真实 AI 或转交能力时只替换本文件的服务实现。
 */

import { getUserDetail } from './user.uts'
import { getAccessToken } from './config.uts'
import {
  AI_AVATAR_QUICK_QUESTIONS,
  buildMockAiAvatarReply,
  buildMockAiAvatarPersonReply
} from '@/mock/ai-avatar.uts'

export const AI_AVATAR_STORAGE_PREFIX = 'xsa-ai-avatar-conversations-v1-'
export const AI_AVATAR_HANDOFF_DELAY = 6000
const AI_AVATAR_PROFILE_PREFIX = 'xsa-ai-avatar-profile-v1-'
const SELF_AVATAR = '/static/portraits/profile-man-light.jpg'

function success(data: any = null, message: string = 'success'): any {
  return { success: true, data: data, code: 0, message: message }
}

function failure(message: string, code: any = -1): any {
  return { success: false, data: null, code: code, message: message }
}

function textValue(value: any, fallback: string = ''): string {
  if (value == null) return fallback
  const text = String(value).trim()
  return text.length > 0 ? text : fallback
}

function pick(source: any, keys: string[], fallback: any = null): any {
  if (source == null) return fallback
  for (let i = 0; i < keys.length; i++) {
    const value = source[keys[i]]
    if (value != null && String(value).trim() != '') return value
  }
  return fallback
}

function listValue(value: any): string[] {
  if (!Array.isArray(value)) return []
  const result: string[] = []
  for (let i = 0; i < value.length; i++) {
    const item = String(value[i]).trim()
    if (item.length > 0 && result.indexOf(item) < 0) result.push(item)
  }
  return result
}

function unwrapProfile(raw: any): any {
  if (raw == null || typeof raw != 'object') return {}
  const envelope = raw.data != null && typeof raw.data == 'object' ? raw.data : raw
  const profile = envelope.profile != null && typeof envelope.profile == 'object' ? envelope.profile : envelope
  const card = envelope.card != null && typeof envelope.card == 'object' ? envelope.card : envelope
  return { envelope: envelope, profile: profile, card: card }
}

function educationLabel(value: any): string {
  const labels = ['', '高中及以下', '大专', '本科', '硕士', '博士']
  const index = value != null ? Number(value) : 0
  return index > 0 && index < labels.length ? labels[index] : ''
}

function normalizeAiAvatarProfile(raw: any, restricted: boolean): any {
  const parts = unwrapProfile(raw)
  const envelope = parts.envelope
  const profile = parts.profile
  const card = parts.card
  const account = envelope.user != null && typeof envelope.user == 'object'
    ? envelope.user
    : (envelope.account != null && typeof envelope.account == 'object' ? envelope.account : {})
  const tags = listValue(pick(card, ['tags'], pick(profile, ['interest_tags'], [])))
  const tagSelections = profile.tag_selections != null && typeof profile.tag_selections == 'object' ? profile.tag_selections : {}
  const expect = listValue(pick(tagSelections, ['relationship_expectation'], pick(card, ['expect', 'expectations'], pick(profile, ['expectations'], []))))
  const dynamics = listValue(pick(envelope, ['dynamicSummary', 'dynamicsSummary', 'interests'], []))
  const allowExpectations = restricted !== true
  const directCity = textValue(pick(card, ['city'], pick(profile, ['city', 'city_name'], '')), '')
  const directEducation = textValue(pick(card, ['education', 'edu'], pick(profile, ['education'], '')), '')
  const resolvedEducation = directEducation.length > 0 ? directEducation : educationLabel(profile.education_level)
  return {
    id: Number(pick(envelope, ['user_id'], pick(card, ['id', 'user_id'], pick(profile, ['id', 'user_id'], 0)))),
    name: textValue(pick(card, ['name', 'nickname'], pick(profile, ['name', 'nickname'], pick(envelope, ['name', 'nickname'], pick(account, ['name', 'nickname'], 'Ta')))), 'Ta'),
    avatar: textValue(pick(card, ['avatar'], pick(profile, ['avatar'], pick(envelope, ['avatar'], pick(account, ['avatar'], SELF_AVATAR)))), SELF_AVATAR),
    age: textValue(pick(card, ['age'], pick(profile, ['age'], '暂未填写')), '暂未填写'),
    city: textValue(directCity, '暂未填写'),
    job: textValue(pick(card, ['job', 'occupation'], pick(profile, ['job', 'occupation'], '暂未填写')), '暂未填写'),
    education: textValue(resolvedEducation, '暂未填写'),
    tags: tags,
    bio: textValue(pick(card, ['intro', 'introduction', 'bio'], pick(profile, ['self_intro', 'introduction', 'bio'], '')), ''),
    interests: tags.concat(dynamics),
    expectations: expect,
    allowExpectations: allowExpectations,
    restricted: restricted === true
  }
}

function storageKey(userId: number): string {
  return AI_AVATAR_STORAGE_PREFIX + String(userId)
}

function profileStorageKey(userId: number): string {
  return AI_AVATAR_PROFILE_PREFIX + String(userId)
}

function readProfileSnapshot(userId: number): any {
  try {
    const saved = uni.getStorageSync(profileStorageKey(userId))
    return saved != null && typeof saved == 'object' ? saved : null
  } catch (e) {
    return null
  }
}

function readMessages(userId: number): any[] {
  try {
    const saved = uni.getStorageSync(storageKey(userId))
    return Array.isArray(saved) ? saved as any[] : []
  } catch (e) {
    return []
  }
}

function writeMessages(userId: number, messages: any[]) {
  try { uni.setStorageSync(storageKey(userId), messages) } catch (e) { console.error('AI 分身记录保存失败', e) }
}

function message(content: string, isMine: boolean, profile: any, source: string = 'ai-avatar', extra: any = {}): any {
  return {
    id: 'ai-avatar-' + Date.now() + '-' + Math.floor(Math.random() * 1000),
    type: 'text',
    content: content,
    time: Date.now(),
    showTime: false,
    isMine: isMine,
    avatar: isMine ? SELF_AVATAR : profile.avatar,
    source: source,
    ...extra
  }
}

function initialMessage(profile: any): any {
  return message(`你好，我是 ${profile.name} 的 AI 分身。这里只参考 Ta 当前公开填写的资料，不是真人聊天，Ta 也不会收到提醒。你可以问我基本资料、兴趣爱好、择偶标准或平台规则。`, false, profile)
}

function resolvePendingMessages(messages: any[], profile: any, force: boolean = false): any[] {
  const result = messages.slice()
  const now = Date.now()
  const pending: any[] = []
  for (let i = 0; i < result.length; i++) {
    const item = result[i]
    if (item.handoffStatus == 'pending') pending.push(item)
  }
  for (let i = 0; i < pending.length; i++) {
    const handoff = pending[i]
    const dueAt = handoff.handoffDueAt != null ? Number(handoff.handoffDueAt) : 0
    if (!force && dueAt > now) continue
    handoff.handoffStatus = 'answered'
    const answer = buildMockAiAvatarPersonReply(profile, handoff.handoffQuestion != null ? String(handoff.handoffQuestion) : '')
    result.push(message(answer, false, profile, 'mock-person', {
      handoffStatus: 'answered',
      handoffQuestion: handoff.handoffQuestion,
      isMockPersonReply: true
    }))
  }
  return result
}

export async function getAiAvatarProfile(userId: number, restricted: boolean = false): Promise<any> {
  if (getAccessToken() == '') return failure('请先登录后使用 AI 分身', 'AUTH_REQUIRED')
  if (userId <= 0) return failure('用户资料不存在', 'USER_NOT_FOUND')
  const saved = readProfileSnapshot(userId)
  if (saved != null) {
    const profile = normalizeAiAvatarProfile(saved, restricted)
    profile.id = userId
    if (restricted === true) profile.expectations = []
    return success(profile)
  }
  const res = await getUserDetail(userId)
  if (!res.success || res.data == null) return failure(res.message != null ? String(res.message) : '用户资料暂时无法打开', res.code)
  return success(normalizeAiAvatarProfile(res.data, restricted))
}

export function saveAiAvatarProfileSnapshot(userId: number, snapshot: any, restricted: boolean = false): any {
  if (userId <= 0 || snapshot == null || typeof snapshot != 'object') return failure('用户资料不存在', 'USER_NOT_FOUND')
  const profile = normalizeAiAvatarProfile(snapshot, restricted)
  profile.id = userId
  if (restricted === true) profile.expectations = []
  try {
    uni.setStorageSync(profileStorageKey(userId), profile)
  } catch (e) {
    return failure('公开资料快照保存失败')
  }
  return success(profile)
}

export function getAiAvatarQuickQuestions(): any {
  return success(AI_AVATAR_QUICK_QUESTIONS)
}

export function getAiAvatarConversation(userId: number, profile: any): any {
  if (userId <= 0) return failure('用户资料不存在', 'USER_NOT_FOUND')
  let messages = readMessages(userId)
  if (messages.length == 0) {
    messages = [initialMessage(profile)]
    writeMessages(userId, messages)
  }
  const resolved = resolvePendingMessages(messages, profile)
  if (resolved.length != messages.length || JSON.stringify(resolved) != JSON.stringify(messages)) writeMessages(userId, resolved)
  return success(resolved)
}

export function sendAiAvatarMessage(userId: number, content: string, profile: any): any {
  const question = content != null ? String(content).trim() : ''
  if (question.length == 0) return failure('请输入问题', 'EMPTY_MESSAGE')
  if (question.length > 300) return failure('问题不能超过 300 个字', 'MESSAGE_TOO_LONG')
  let messages = readMessages(userId)
  if (messages.length == 0) messages = [initialMessage(profile)]
  messages = resolvePendingMessages(messages, profile)
  messages.push(message(question, true, profile, 'user'))
  const result = buildMockAiAvatarReply(profile, question)
  const extra: any = {}
  if (result.handoffRequired === true) {
    extra.handoffStatus = 'pending'
    extra.handoffQuestion = question
    extra.handoffDueAt = Date.now() + AI_AVATAR_HANDOFF_DELAY
  }
  messages.push(message(result.reply, false, profile, result.source, extra))
  writeMessages(userId, messages)
  return success({ messages: messages, result: result })
}

export function resolveAiAvatarHandoffs(userId: number, profile: any): any {
  const messages = readMessages(userId)
  const resolved = resolvePendingMessages(messages, profile)
  if (JSON.stringify(resolved) != JSON.stringify(messages)) writeMessages(userId, resolved)
  return success(resolved)
}

export function clearAiAvatarConversation(userId: number): any {
  if (userId <= 0) return failure('用户资料不存在', 'USER_NOT_FOUND')
  try { uni.removeStorageSync(storageKey(userId)) } catch (e) { return failure('清空记录失败') }
  return success([], 'AI 分身聊天记录已清空')
}
