/**
 * API 配置文件
 *
 * 🔧 开发阶段默认 USE_MOCK = true
 * 🚀 联调 FastAPI：USE_MOCK = false，并配置可达的 API_BASE_URL
 */

// ⚠️ 唯一需要修改的开关：启用/禁用 Mock 数据
// 关 Mock 联调时改为 false，并确认下方 API_BASE_URL 可达；演示/默认请保持 true
// 不要只靠关 Mock 宣称生产完成
// 默认预览使用本地 Mock；需要 FastAPI 联调时显式改为 false
export const USE_MOCK = true

// FastAPI 服务根地址（不含 /api/v1）
// 后端项目：xuanshiai-backend，默认端口 8000
export const API_BASE_URL = 'http://127.0.0.1:8000'

// 后端数据库恢复前，角色申请单独使用本地 Mock，避免提交时等待不可达的 API。
// MySQL 和 FastAPI 恢复后改为 false，即会重新写入后端数据库。
export const ROLE_APPLICATION_USE_MOCK = false

// 纸飞机的”获取次数”接口尚未在 FastAPI 中提供，暂使用本地 Mock，避免在小程序中请求超时。
// 后端补齐 POST /community/paper-planes/chances 后改为 false。
export const PAPER_PLANE_CHANCE_USE_MOCK = true

// 真机联调时将 API_BASE_URL 改为此局域网地址，并确认 8000 已向本地子网放行。
export const LAN_API_BASE_URL = 'http://192.168.112.247:8000'

// API 统一前缀
export const API_PREFIX = '/api/v1'

// 本地 Token 存储 key
export const ACCESS_TOKEN_KEY = 'xsa_access_token'
export const REFRESH_TOKEN_KEY = 'xsa_refresh_token'

// FastAPI 开发态直达社区。仅在本地调试时填写真实测试身份，禁止提交有效 token。
export const FASTAPI_AUTO_ENTER_COMMUNITY = false
export const FASTAPI_DEV_ACCESS_TOKEN = ''
export const FASTAPI_DEV_USER_ID = 0

// API 基础配置
export const API_CONFIG = {
  // 请求超时配置
  timeout: 15000,

  // 是否显示加载提示
  showLoading: true,

  // 加载提示文案
  loadingText: '加载中...'
}

// Mock 延迟配置（模拟网络延迟，单位：毫秒）
export const MOCK_DELAY = 300

/** 读取本地 access token */
export function getAccessToken(): string {
  try {
    const token = uni.getStorageSync(ACCESS_TOKEN_KEY)
    if (token != null && token !== '') return '' + token
  } catch (e) {}
  return ''
}

/** 写入 access / refresh token */
export function setAuthTokens(accessToken: string, refreshToken: string = '') {
  try {
    if (accessToken != null && accessToken !== '') {
      uni.setStorageSync(ACCESS_TOKEN_KEY, accessToken)
    }
    if (refreshToken != null && refreshToken !== '') {
      uni.setStorageSync(REFRESH_TOKEN_KEY, refreshToken)
    } else {
      uni.removeStorageSync(REFRESH_TOKEN_KEY)
    }
  } catch (e) {}
}

/** 清理本地 token */
export function clearAuthTokens() {
  try {
    uni.removeStorageSync(ACCESS_TOKEN_KEY)
  } catch (e) {}
  try {
    uni.removeStorageSync(REFRESH_TOKEN_KEY)
  } catch (e) {}
}

/** 拼接完整 HTTP URL */
export function buildApiUrl(path: string): string {
  let p = path != null ? ('' + path) : ''
  if (p.indexOf('http://') == 0 || p.indexOf('https://') == 0) return p
  if (p.indexOf('/api/') == 0) return API_BASE_URL + p
  if (p.charAt(0) != '/') p = '/' + p
  return API_BASE_URL + API_PREFIX + p
}

/** 将后端返回的公开媒体路径转换为跨端可加载的地址。 */
export function resolveMediaUrl(value: any): string {
  if (value == null) return ''
  const p = '' + value
  if (p == '') return ''
  if (
    p.indexOf('http://') == 0 ||
    p.indexOf('https://') == 0 ||
    p.indexOf('data:') == 0 ||
    p.indexOf('blob:') == 0 ||
    p.indexOf('wxfile://') == 0 ||
    p.indexOf('/static/') == 0 ||
    p.indexOf('mock://') == 0
  ) return p
  if (p.charAt(0) == '/') return API_BASE_URL + p
  return p
}
