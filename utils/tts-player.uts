/**
 * TTS 分片链式播放器
 *
 * 后端按句切分合成 TTS，逐句推 tts_audio{seq}（每句一个 mp3 URL）。
 * 这里维护一个分片队列，单个 InnerAudioContext 顺序消费：
 * 当前片 onEnded → 播下一片，实现句子间无缝衔接。首音延迟≈第一句
 * 合成耗时，接近流式体验。
 *
 * 兜底：InnerAudioContext.onEnded 跨端版本有差异（Android 4.33+ / iOS
 * 4.41+ 才稳定），低版本可能不触发。每片入队时启动一个 durationMs+800ms
 * 计时器，超时强制播下一片，避免队列卡死在 speaking 态。
 *
 * 这是二期的扩展点：未来可新增 enqueuePCM(bytes) 方法，微信端走
 * wx.createWebAudioContext + createBuffer，原生端走 AudioTrack/AVAudioEngine
 * 插件，调用方（VoiceConversation）不变。
 */

import { resolveMediaUrl } from '@/api/config.uts'
import { estimateSpeakDuration } from '@/utils/sleep.uts'

export interface TTSPlayerHandlers {
	// 播放状态变化：开始播放→true，全部播完/停止→false（驱动 convState）
	onStateChange?: (playing: boolean) => void
	onError?: (code: string, message: string) => void
}

interface TTSChunk {
	url: string
	dur: number
}

const FALLBACK_PADDING_MS = 800

export class TTSPlayer {
	private queue: TTSChunk[] = []
	private current: any = null
	private fallbackTimer: number = -1
	private playing = false
	private stopped = false
	private handlers: TTSPlayerHandlers

	constructor(handlers: TTSPlayerHandlers) {
		this.handlers = handlers
	}

	/**
	 * 入队一个分片。空 URL 仍入队（startNext 会按 dur 计时兜底），
	 * 保证队列顺序与后端 seq 一致。
	 */
	enqueue(url: string, durationMs: number): void {
		if (this.stopped) return
		const dur = durationMs > 0 ? durationMs : estimateSpeakDuration(url)
		this.queue.push({ url: url, dur: dur } as TTSChunk)
		// 当前空闲则立即开始；否则等当前片 onEnded 自然推进。
		if (!this.playing) {
			this.startNext()
		}
	}

	/**
	 * 取队首播放。空/无效 URL → 计时兜底推进到下一片，不卡死。
	 */
	private startNext(): void {
		if (this.stopped) return
		this.clearFallbackTimer()
		this.destroyCurrent()
		if (this.queue.length == 0) {
			this.setPlaying(false)
			return
		}
		const chunk = this.queue.shift() as TTSChunk
		const resolvedUrl = resolveMediaUrl(chunk.url)
		this.setPlaying(true)
		if (resolvedUrl == '') {
			// URL 无效：按时长计时兜底，到点播下一片。
			this.scheduleFallback(chunk.dur)
			return
		}
		this.current = uni.createInnerAudioContext()
		this.current.src = resolvedUrl
		this.current.onEnded(() => {
			this.startNext()
		})
		this.current.onError(() => {
			// 出错不中断队列：按时长兜底，到点播下一片。
			this.scheduleFallback(chunk.dur)
		})
		this.current.play()
		// 主兜底：onEnded 在低版本不触发时，超时强制推进。
		this.scheduleFallback(chunk.dur)
	}

	private scheduleFallback(dur: number): void {
		this.clearFallbackTimer()
		this.fallbackTimer = setTimeout(() => {
			this.startNext()
		}, dur + FALLBACK_PADDING_MS) as any
	}

	private clearFallbackTimer(): void {
		if (this.fallbackTimer != -1) {
			clearTimeout(this.fallbackTimer)
			this.fallbackTimer = -1
		}
	}

	private destroyCurrent(): void {
		if (this.current != null) {
			try {
				this.current.stop()
			} catch (e) {}
			try {
				this.current.destroy()
			} catch (e) {}
			this.current = null
		}
	}

	private setPlaying(value: boolean): void {
		if (this.playing == value) return
		this.playing = value
		this.handlers.onStateChange?.(value)
	}

	/**
	 * 清队列并停当前播放。供 skipSpeaking / reset / onUnmounted 调用。
	 * stop 后的 enqueue 会被忽略，需新建实例才能再次播放。
	 */
	stop(): void {
		this.stopped = true
		this.clearFallbackTimer()
		this.destroyCurrent()
		this.queue = []
		this.setPlaying(false)
	}

	isPlaying(): boolean {
		return this.playing
	}
}
