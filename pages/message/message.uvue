<template>
	<view class="message-page">
		<scroll-view class="scroller" scroll-y @scrolltolower="handleLoadMore">
			<!-- 快捷入口：对齐高保真消息中心 -->
			<view class="shortcuts">
				<view class="shortcut shortcut-application" @click="openApplications">
					<view class="shortcut-notice" v-if="hasApplicationNotice"></view>
					<view class="sc-copy">
						<text class="sc-title">认识申请</text>
						<text class="sc-desc text-muted">{{ applicationHint }}</text>
					</view>
					<text class="sc-arrow">›</text>
					<view class="sc-art sc-art-application">
						<view class="art-chat art-chat-large"></view>
						<view class="art-chat art-chat-small"></view>
					</view>
				</view>
				<view class="shortcut shortcut-plane" @click="openPaperPlane">
					<view class="shortcut-notice" v-if="hasPaperPlaneNotice"></view>
					<view class="sc-copy">
						<text class="sc-title">纸飞机</text>
						<text class="sc-desc text-muted">匿名认真表达</text>
					</view>
					<text class="sc-arrow">›</text>
					<view class="sc-art sc-art-plane">
						<view class="art-plane-wing"></view>
						<view class="art-plane-tail"></view>
					</view>
				</view>
				<view class="shortcut shortcut-dynamic" @click="openDynamicNotice">
					<view class="shortcut-notice" v-if="hasDynamicNotice"></view>
					<view class="sc-copy">
						<text class="sc-title">Ta 的动态</text>
						<text class="sc-desc text-muted">关注的人有更新</text>
					</view>
					<text class="sc-arrow">›</text>
					<view class="sc-art sc-art-dynamic">
						<view class="art-photo art-photo-back"></view>
						<view class="art-photo art-photo-front">
							<view class="art-photo-dot"></view>
						</view>
					</view>
				</view>
				<view class="shortcut shortcut-lab" @click="openHint('情感实验室 · 完善 MBTI 线索')">
					<view class="sc-copy">
						<text class="sc-title">情感实验室</text>
						<text class="sc-desc text-muted">完善匹配线索</text>
					</view>
					<text class="sc-arrow">›</text>
					<view class="sc-art sc-art-lab">
						<view class="art-flask-neck"></view>
						<view class="art-flask-body">
							<view class="art-flask-liquid"></view>
						</view>
						<view class="art-flask-bubble art-flask-bubble-one"></view>
						<view class="art-flask-bubble art-flask-bubble-two"></view>
					</view>
				</view>
			</view>

			<button class="unread-clear-action" aria-label="清除未读" @click="clearUnreadNotices">清除未读</button>

			<XsaEmpty
				v-if="messageList.length === 0 && !loading"
				text="暂无消息"
				description="申请通过后，对话会出现在这里"
				size="large"
			/>

			<view v-else class="list">
				<XsaMessageItem
					v-for="msg in displayMessageList"
					:key="msg.id"
					:message="msg"
					@click="handleMessageClick"
					@longpress="handleMessageLongPress"
				/>
			</view>

			<view class="load-more" v-if="messageList.length > 0">
				<text class="load-text text-muted" v-if="loading">加载中...</text>
				<text class="load-text text-muted" v-else-if="!hasMore">没有更多了</text>
			</view>
		</scroll-view>

		<!-- 申请列表 Sheet -->
		<XsaSheet :visible="appVisible" title="认识申请" @close="appVisible = false">
			<view class="app-list">
				<view class="app-item" v-for="item in applications" :key="item.id">
					<image class="app-avatar" :src="item.avatar" mode="aspectFill"></image>
					<view class="app-meta">
						<text class="app-name">{{ item.name }}</text>
						<text class="app-msg text-muted">{{ item.message }}</text>
					</view>
					<view class="app-actions" v-if="item.direction === 'in'">
						<XsaButton variant="secondary" size="small" @click="rejectApp(item)">拒绝</XsaButton>
						<XsaButton variant="primary" size="small" @click="acceptApp(item)">同意</XsaButton>
					</view>
					<text v-else class="app-status text-muted">{{ item.statusText }}</text>
				</view>
				<view v-if="applications.length === 0" class="empty-apps">
					<text class="text-muted">暂无申请</text>
				</view>
			</view>
		</XsaSheet>

		<XsaSheet :visible="pinVisible" :show-handle="false" @close="closePinSheet">
			<view class="pin-actions">
				<XsaButton
					v-if="selectedMessage != null && selectedMessage.pinned === true"
					variant="primary"
					size="medium"
					@click="togglePin"
				>取消置顶</XsaButton>
				<XsaButton v-else variant="primary" size="medium" @click="togglePin">置顶</XsaButton>
				<XsaButton variant="secondary" size="medium" @click="deleteSelectedMessage">删除</XsaButton>
				<XsaButton variant="secondary" size="medium" @click="closePinSheet">取消</XsaButton>
			</view>
		</XsaSheet>

		<XsaToast :visible="toastVisible" :message="toastMessage" @hide="toastVisible = false" />
	</view>

	<!-- 自定义底部导航栏 -->
	<XsaTabBar />
</template>


<script setup lang="uts">
import XsaTabBar from '@/components/XsaTabBar.uvue'
	import XsaMessageItem from '@/components/XsaMessageItem.uvue'
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import XsaSheet from '@/components/XsaSheet.uvue'
	import XsaButton from '@/components/XsaButton.uvue'
	import XsaToast from '@/components/XsaToast.uvue'
	import { getMessageList, getApplications, handleApplication } from '@/api'
	import {
		createMatchedConversation,
		getMatchedConversations,
		getConversationPreviews
	} from '@/utils/conversation.uts'

	const PINNED_MESSAGE_KEY = 'xsa-pinned-message-ids'
	const READ_MESSAGE_KEY = 'xsa-read-message-ids'
	const READ_SHORTCUT_NOTICE_KEY = 'xsa-read-shortcut-notices'
	const PAPER_PLANE_NOTICE_KEY = 'paper-plane:mock-1'
	const DYNAMIC_NOTICE_KEY = 'dynamic:mock-1'
	const loading = ref(false)
	const hasMore = ref(true)
	const messageList = ref([])
	const applications = ref([])
	const appVisible = ref(false)
	const pinVisible = ref(false)
	const selectedMessage = ref<any>(null)
	const pinnedMessageIds = ref([] as any[])
	const readMessageIds = ref([] as any[])
	const readShortcutNotices = ref([] as any[])
	const toastVisible = ref(false)
	const toastMessage = ref('')

	const displayMessageList = computed(() => {
		const pinned: any[] = []
		const regular: any[] = []
		const source = messageList.value as any[]
		source.forEach((item: any) => {
			if (item.pinned === true) {
				pinned.push(item)
			} else {
				regular.push(item)
			}
		})
		return pinned.concat(regular)
	})

	const applicationHint = computed(() => {
		const n = applications.value.length
		if (n > 0) return `${n} 条待处理`
		return '暂无新申请'
	})

	const applicationNoticeKey = computed(() => {
		const ids: string[] = []
		const list = applications.value as any[]
		list.forEach((item: any) => {
			if (item.direction === 'in') ids.push(item.id.toString())
		})
		return ids.length > 0 ? `application:${ids.join(',')}` : ''
	})

	const hasApplicationNotice = computed(() => {
		const key = applicationNoticeKey.value
		return key.length > 0 && readShortcutNotices.value.indexOf(key) < 0
	})

	const hasPaperPlaneNotice = computed(() => {
		return readShortcutNotices.value.indexOf(PAPER_PLANE_NOTICE_KEY) < 0
	})

	const hasDynamicNotice = computed(() => {
		return readShortcutNotices.value.indexOf(DYNAMIC_NOTICE_KEY) < 0
	})

	onMounted(() => {
		loadPinnedMessageIds()
		loadReadMessageIds()
		loadReadShortcutNotices()
		loadMessages()
		loadApplications()
	})

	const loadPinnedMessageIds = () => {
		try {
			const stored = uni.getStorageSync(PINNED_MESSAGE_KEY)
			if (Array.isArray(stored)) {
				pinnedMessageIds.value = stored as any[]
			}
		} catch (e) {
			pinnedMessageIds.value = []
		}
	}

	const loadReadMessageIds = () => {
		try {
			const stored = uni.getStorageSync(READ_MESSAGE_KEY)
			if (Array.isArray(stored)) {
				readMessageIds.value = stored as any[]
			}
		} catch (e) {
			readMessageIds.value = []
		}
	}

	const loadReadShortcutNotices = () => {
		try {
			const stored = uni.getStorageSync(READ_SHORTCUT_NOTICE_KEY)
			if (Array.isArray(stored)) {
				readShortcutNotices.value = stored as any[]
			}
		} catch (e) {
			readShortcutNotices.value = []
		}
	}

	const showToast = (msg: string) => {
		toastMessage.value = msg
		toastVisible.value = true
	}

	const loadMessages = async () => {
		try {
			loading.value = true
			const res = await getMessageList()
			if (res.success) {
				const apiList = (res.data as any[]).slice()
				const createdList = getMatchedConversations()
				const previewList = getConversationPreviews()
				const list = createdList.concat(apiList.filter((item: any) => {
					return createdList.findIndex((created: any) => created.userId == item.userId) < 0
				}))
				list.forEach((item: any) => {
					const preview = previewList.find((stored: any) => stored.userId == item.userId)
					if (preview != null) {
						item.lastMessage = preview.lastMessage
						item.time = preview.time
						item.messageType = preview.messageType
					}
					item.pinned = pinnedMessageIds.value.indexOf(item.id) >= 0
					if (readMessageIds.value.indexOf(item.id) >= 0) {
						item.unreadCount = 0
					}
				})
				messageList.value = list
			}
		} catch (e) {
			console.error(e)
		} finally {
			loading.value = false
		}
	}

	const markMessageRead = (message: any) => {
		if (message.unreadCount == null || message.unreadCount <= 0) return
		message.unreadCount = 0
		if (readMessageIds.value.indexOf(message.id) < 0) {
			readMessageIds.value.push(message.id)
		}
		try {
			uni.setStorageSync(READ_MESSAGE_KEY, readMessageIds.value)
		} catch (e) {
			console.error(e)
		}
		messageList.value = (messageList.value as any[]).slice()
	}

	const loadApplications = async () => {
		try {
			const res = await getApplications()
			if (res.success) {
				// 兼容 mock 结构
				const data = res.data
				if (Array.isArray(data)) {
					applications.value = data.map((x: any) => normalizeApp(x))
					createAcceptedApplicationConversations()
				} else if (data != null) {
					const list: any[] = []
					if (data.incoming != null) {
						(data.incoming as any[]).forEach((x: any) => list.push(normalizeApp(x, 'in')))
					}
					if (data.outgoing != null) {
						(data.outgoing as any[]).forEach((x: any) => list.push(normalizeApp(x, 'out')))
					}
					if (list.length == 0 && data.list != null) {
						(data.list as any[]).forEach((x: any) => list.push(normalizeApp(x)))
					}
					applications.value = list
					createAcceptedApplicationConversations()
				}
			}
		} catch (e) {
			// mock 可能未实现时给演示数据
			applications.value = [
				{
					id: 1,
					userId: 1,
					name: '苏晚晴',
					avatar: '/static/portraits/profile-woman-main.jpg',
					message: '资料匹配度 92% · 想认真认识你',
					direction: 'out',
					statusText: '待回应'
				}
			]
		}
	}

	const normalizeApp = (x: any, dir: string = 'in') => {
		return {
			id: x.id != null ? x.id : x.userId,
			userId: x.userId != null ? x.userId : x.id,
			name: x.name != null ? x.name : '用户',
			avatar: x.avatar != null ? x.avatar : '/static/portraits/profile-woman-main.jpg',
			message: x.message != null ? x.message : (x.remark != null ? x.remark : '申请认识'),
			direction: x.direction != null ? x.direction : dir,
			status: x.status != null ? x.status : 'pending',
			accepted: x.accepted === true || x.matched === true,
			statusText: x.statusText != null ? x.statusText : '待回应'
		}
	}

	const openApplications = () => {
		markShortcutNoticeRead(applicationNoticeKey.value)
		appVisible.value = true
	}

const openPaperPlane = () => {
			markShortcutNoticeRead(PAPER_PLANE_NOTICE_KEY)
			uni.navigateTo({ url: '/pagesSub/community/paper-plane' })
		}

	const openDynamicNotice = () => {
		markShortcutNoticeRead(DYNAMIC_NOTICE_KEY)
		openHint('Ta 的动态 · 入口已触发')
	}

	const markShortcutNoticeRead = (key: string) => {
		if (key.length == 0 || readShortcutNotices.value.indexOf(key) >= 0) return
		readShortcutNotices.value.push(key)
		try {
			uni.setStorageSync(READ_SHORTCUT_NOTICE_KEY, readShortcutNotices.value)
		} catch (e) {
			console.error(e)
		}
		readShortcutNotices.value = readShortcutNotices.value.slice()
	}

	const clearUnreadNotices = () => {
		uni.showModal({
			title: '全部标记为已读',
			content: '是否将全部未读消息标记为已读？',
			confirmText: '确认',
			cancelText: '取消',
			success: (res) => {
				if (res.confirm) markAllMessagesRead()
			}
		})
	}

	const markAllMessagesRead = () => {
		let cleared = false
		const messages = messageList.value as any[]
		messages.forEach((message: any) => {
			if (message.unreadCount != null && message.unreadCount > 0) {
				message.unreadCount = 0
				cleared = true
				if (readMessageIds.value.indexOf(message.id) < 0) {
					readMessageIds.value.push(message.id)
				}
			}
		})
		const noticeKeys = [applicationNoticeKey.value, PAPER_PLANE_NOTICE_KEY, DYNAMIC_NOTICE_KEY]
		noticeKeys.forEach((key: string) => {
			if (key.length > 0 && readShortcutNotices.value.indexOf(key) < 0) {
				readShortcutNotices.value.push(key)
				cleared = true
			}
		})
		try {
			uni.setStorageSync(READ_MESSAGE_KEY, readMessageIds.value)
			uni.setStorageSync(READ_SHORTCUT_NOTICE_KEY, readShortcutNotices.value)
		} catch (e) {
			console.error(e)
		}
		messageList.value = messages.slice()
		readShortcutNotices.value = readShortcutNotices.value.slice()
		showToast(cleared ? '消息提示已清除' : '暂无消息提示')
	}

	const openHint = (msg: string) => {
		showToast(msg)
	}

	const handleMessageLongPress = (message: any) => {
		selectedMessage.value = message
		pinVisible.value = true
	}

	const closePinSheet = () => {
		pinVisible.value = false
		selectedMessage.value = null
	}

	const togglePin = () => {
		if (selectedMessage.value == null) return
		const message = selectedMessage.value
		message.pinned = message.pinned !== true
		const pinnedIndex = pinnedMessageIds.value.indexOf(message.id)
		if (message.pinned === true && pinnedIndex < 0) {
			pinnedMessageIds.value.push(message.id)
		} else if (message.pinned !== true && pinnedIndex >= 0) {
			pinnedMessageIds.value.splice(pinnedIndex, 1)
		}
		try {
			uni.setStorageSync(PINNED_MESSAGE_KEY, pinnedMessageIds.value)
		} catch (e) {
			console.error(e)
		}
		messageList.value = (messageList.value as any[]).slice()
		showToast(message.pinned === true ? '已置顶该会话' : '已取消置顶')
		closePinSheet()
	}

	const deleteSelectedMessage = () => {
		if (selectedMessage.value == null) return
		const message = selectedMessage.value
		pinVisible.value = false
		uni.showModal({
			title: '删除会话',
			content: `确定删除与${message.name}的会话吗？`,
			confirmText: '删除',
			cancelText: '取消',
			success: (res) => {
				if (res.confirm) {
					messageList.value = (messageList.value as any[]).filter((item: any) => item.id != message.id)
					const pinnedIndex = pinnedMessageIds.value.indexOf(message.id)
					if (pinnedIndex >= 0) pinnedMessageIds.value.splice(pinnedIndex, 1)
					try {
						uni.setStorageSync(PINNED_MESSAGE_KEY, pinnedMessageIds.value)
					} catch (e) {
						console.error(e)
					}
					showToast('已删除该会话')
				}
				selectedMessage.value = null
			}
		})
	}

	// 仅已匹配会话可进入聊天；否则提示申请流程
	const handleMessageClick = (message: any) => {
		markMessageRead(message)
		const matched = message.matched === true || message.canChat === true || message.type === 'chat'
		if (!matched && message.type === 'system') {
			showToast(message.lastMessage != null ? message.lastMessage : '系统消息')
			return
		}
		// 默认允许进入详情（mock 会话视为已通过双方同意）
		uni.navigateTo({
			url: `/pagesSub/chat/detail?userId=${message.userId}&userName=${encodeURIComponent(message.name)}`
		})
	}

	const acceptApp = async (item: any) => {
		try {
			const res = await handleApplication(item.id, 'accept')
			if (res.success) {
				completeMatchedApplication(item)
			}
		} catch (e) {
			completeMatchedApplication(item)
		}
	}

	const completeMatchedApplication = (item: any) => {
		const result = createConversationForApplication(item)
		const created = result.created === true || result.conversation != null
		applications.value = (applications.value as any[]).filter((application: any) => application.id != item.id)
		showToast(created ? '匹配成功，已创建聊天' : '已同意，聊天已开放')
		appVisible.value = false
		uni.navigateTo({
			url: `/pagesSub/chat/detail?userId=${item.userId}&userName=${encodeURIComponent(item.name)}&newConversation=${created ? '1' : '0'}`
		})
	}

	const createConversationForApplication = (item: any): any => {
		const greetingIsMine = item.direction === 'in'
		const result = createMatchedConversation(
			item.userId,
			item.name,
			item.avatar,
			'application',
			greetingIsMine,
			greetingIsMine ? '/static/portraits/profile-man-light.jpg' : item.avatar
		)
		if (result.conversation != null) {
			const currentList = messageList.value as any[]
			const withoutSameUser = currentList.filter((conversation: any) => conversation.userId != item.userId)
			messageList.value = [result.conversation].concat(withoutSameUser)
		}
		return result
	}

	const createAcceptedApplicationConversations = () => {
		const list = applications.value as any[]
		const accepted = list.filter((item: any) => item.accepted === true || item.status === 'accepted')
		accepted.forEach((item: any) => createConversationForApplication(item))
		if (accepted.length > 0) {
			applications.value = list.filter((item: any) => accepted.indexOf(item) < 0)
		}
	}

	const rejectApp = async (item: any) => {
		try {
			await handleApplication(item.id, 'reject')
		} catch (e) {}
		applications.value = applications.value.filter((x: any) => x.id != item.id)
		showToast('已拒绝，不扣除对方次数')
	}

	const handleLoadMore = async () => {
		if (loading.value || !hasMore.value) return
		loading.value = true
		try {
			await loadMessages()
			if (messageList.value.length >= 20) hasMore.value = false
		} finally {
			loading.value = false
		}
	}
</script>

<style scoped>
	.message-page {
		min-height: 100vh;
		background: var(--canvas);
	}

	.scroller {
		height: 100vh;
		padding: 14px 14px 88px;
	}

	.unread-clear-action {
		display: block;
		width: auto;
		min-height: 0;
		height: 24px;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: var(--accent2);
		font-size: 12px;
		line-height: 24px;
		text-align: left;
		box-sizing: border-box;
	}

	.unread-clear-action::after {
		border: 0;
	}

	.unread-clear-action:active {
		color: var(--sage);
	}

	.shortcuts {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px 8px;
		margin-bottom: 18px;
	}

	.shortcut {
		position: relative;
		min-height: 96px;
		padding: 15px 14px;
		border-radius: 12px;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		transition: transform 0.18s ease-out;
	}

	.shortcut:active {
		transform: scale(0.98);
	}

	.shortcut-notice {
		position: absolute;
		top: 7px;
		left: 7px;
		z-index: 4;
		width: 9px;
		height: 9px;
		border: 2px solid var(--paper);
		border-radius: 50%;
		background: var(--accent);
		box-sizing: border-box;
	}

	.shortcut-application {
		background: var(--shortcut-application);
	}

	.shortcut-plane {
		background: var(--shortcut-plane);
	}

	.shortcut-dynamic {
		background: var(--shortcut-dynamic);
	}

	.shortcut-lab {
		background: var(--shortcut-lab);
	}

	.sc-copy {
		position: relative;
		z-index: 2;
		max-width: 76%;
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

	.sc-title {
		font-size: 15px;
		font-family: var(--sans);
		font-weight: 700;
		line-height: 21px;
		color: var(--ink);
	}

	.sc-desc {
		font-size: 11px;
		line-height: 17px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.sc-arrow {
		position: absolute;
		top: 10px;
		right: 12px;
		z-index: 3;
		font-size: 22px;
		line-height: 22px;
		color: var(--muted);
		opacity: 0.72;
