							</view>
							<view class="sq-like-btn" @click.stop="onLike(1)">
								<text class="ic ic-home ic-heart sq-heart"></text>
							</view>
						</view>
					</view>
				</view>
				<view class="scroll-bottom-spacer"></view>
			</scroll-view>

			<!-- 会员专区 Tab -->
			<scroll-view v-if="currentTab === 2" scroll-y class="content-scroll" enhanced show-scrollbar="false">
				<view class="vip-hero">
					<view class="vip-hero-gold-line"></view>
					<view class="vip-hero-content">
						<text class="vip-hero-title">会员专属特权</text>
						<text class="vip-hero-subtitle">解锁全部嘉宾资料，遇见心仪的TA</text>
					</view>
					<view class="vip-hero-badges">
						<view class="vip-hero-badge">
							<text class="ic ic-home ic-star vip-hero-badge-icon"></text>
							<text class="vip-hero-badge-text">VIP标识</text>
						</view>
						<view class="vip-hero-badge">
							<text class="ic ic-home ic-star vip-hero-badge-icon"></text>
							<text class="vip-hero-badge-text">多重认证</text>
						</view>
						<view class="vip-hero-badge">
							<text class="ic ic-home ic-star vip-hero-badge-icon"></text>
							<text class="vip-hero-badge-text">优先匹配</text>
						</view>
					</view>
				</view>

				<view class="vip-cat-tabs">
					<view class="vip-cat-tab" v-for="(cat, ci) in vipCategories" :key="cat" @click="switchVipCat(ci)">
						<text :class="['vip-cat-tab-text', vipCatIndex === ci ? 'active' : '']">{{ cat }}</text>
						<view v-if="vipCatIndex === ci" class="vip-cat-indicator"></view>
					</view>
				</view>

				<view class="vip-filter-row">
					<text class="vip-result-count">共128位嘉宾</text>
					<view class="vip-filter-right">
						<view class="vip-sort-btn">
							<text class="vip-sort-text">综合排序</text>
							<text class="ic ic-sys ic-xiala vip-sort-icon"></text>
						</view>
						<view class="vip-accelerate-btn">
							<text class="ic ic-home ic-star vip-accel-icon"></text>
							<text class="vip-accel-text">加速匹配</text>
						</view>
					</view>
				</view>

				<view class="vip-card-grid">
					<view class="vip-card-row" v-for="(row, ri) in vipCardRows" :key="ri">
						<view class="vip-card-item" v-for="(card, ci) in row" :key="card.id + '-' + ci">
							<view class="vip-card-content" @tap="goUserDetail(card.id)">
								<view class="vip-card-photo">
									<image class="vip-card-photo-img" :src="card.photo" mode="aspectFill"></image>
									<view class="vip-card-crown"><text class="ic ic-vip ic-huiyuan vip-card-crown-icon"></text></view>
									<view :class="['vip-card-gender', card.gender === '女' ? 'female' : 'male']">
										<text :class="['vip-gender-icon', card.gender === '女' ? 'female' : 'male']">{{ card.gender === '女' ? '♀' : '♂' }}</text>
									</view>
								</view>
								<view class="vip-card-bottom">
									<text class="vip-card-name">{{ card.name }}</text>
									<view class="vip-card-meta">
										<text class="vip-card-age">{{ card.age }}</text>
										<view class="vip-card-dot"></view>
										<text class="vip-card-height">{{ card.height }}</text>
									</view>
								</view>
</view>
						</view>
					</view>
				</view>

				<view class="vip-privilege-section">
					<view class="vip-priv-header">
						<text class="vip-priv-title">VIP会员专属特权</text>
						<view class="vip-upgrade-btn" @tap="openVipPage">
							<text class="ic ic-vip ic-huiyuan vip-upgrade-icon"></text>
							<text class="vip-upgrade-text">立即开通</text>
						</view>
					</view>
					<view class="vip-priv-row">
						<view class="vip-priv-card" v-for="priv in vipPrivileges" :key="priv.title">
							<view class="vip-priv-icon-circle">
								<text :class="priv.iconClass + ' vip-priv-icon-text'"></text>
							</view>
							<text class="vip-priv-card-title">{{ priv.title }}</text>
							<text class="vip-priv-card-desc">{{ priv.desc }}</text>
						</view>
					</view>
				</view>

				<view class="divider"></view>

				<view class="vip-spotlight">
					<view class="vip-spot-header">
						<view class="vip-spot-title-group">
							<text class="ic ic-home ic-star vip-spot-icon"></text>
							<text class="vip-spot-title">人气爆灯嘉宾</text>
							<text class="vip-spot-count">32人</text>
						</view>
						<text class="vip-spot-more">查看全部 ›</text>
					</view>
					<text class="vip-spot-desc">爆灯后系统将短信通知对方，头像将显示在对方爆灯栏中</text>
					<view class="vip-spot-row">
						<view class="vip-spot-card" v-for="spot in vipSpots" :key="spot.name">
							<view class="vip-spot-photo">
								<text class="ic ic-social ic-touxiang vip-spot-photo-icon"></text>
							</view>
							<view class="vip-spot-info">
								<text class="vip-spot-name">{{ spot.name }}</text>
								<text class="vip-spot-age">{{ spot.age }} · {{ spot.job }}</text>
							</view>
						</view>
					</view>
				</view>

				<view class="vip-bottom-cta">
					<text class="ic ic-home ic-star vip-cta-icon"></text><text class="vip-cta-title"> 升级VIP会员</text>
					<text class="vip-cta-desc">解锁全部会员资料 · 无限牵线次数 · 优先展示曝光</text>
						<view class="vip-price-row">
							<view class="vip-price-opt">
							<text class="vip-price-period">7天</text>
							<text class="vip-price-value">¥99</text>
						</view>
							<view class="vip-price-opt recommended">
							<view class="vip-price-badge"><text class="vip-price-badge-text">推荐</text></view>
							<text class="vip-price-period">30天</text>
							<text class="vip-price-value">¥299</text>
						</view>
							<view class="vip-price-opt">
							<text class="vip-price-period">90天</text>
							<text class="vip-price-value">¥799</text>
						</view>
					</view>
					<view class="vip-cta-btn" @tap="openVipPage">
						<text class="vip-cta-btn-text">立即开通VIP</text>
					</view>
					<text class="vip-cta-hint">付费即同意《会员服务协议》· 可随时取消</text>
				</view>

				<view class="scroll-bottom-spacer"></view>
			</scroll-view>

			<!-- 底部操作栏（仅推荐页显示） -->
			<view v-if="currentTab === 0" class="bottom-bar">
				<view class="share-btn" @click="shareProfile">
					<text class="ic ic-sys ic-fenxiang share-icon"></text>
				</view>
				<view class="chat-btn" @click="openApplyModal">
					<text class="ic ic-home ic-hello chat-icon"></text>
						<text class="chat-text">申请认识</text>
				</view>
				<view class="like-btn" @click="onLike(recommendUserId)">
					<text class="ic ic-home ic-heart heart-icon"></text>
				</view>
			</view>

			<!-- AI悬浮按钮（仅推荐页显示） -->
			<view v-if="currentTab === 0" class="ai-float-btn" @click="showAiScore">
				<text class="ic ic-home ic-star ai-icon"></text>
			</view>
		</view>

		<!-- ====== Sheets & Modals ====== -->
		<XsaSheet :visible="aiVisible" title="AI 合拍度解读" @close="aiVisible = false">
			<view class="ai-sheet">
				<view class="ai-mbti-row">
					<view class="ai-mbti-card"><text class="ai-mbti-label">你的 MBTI</text><text class="ai-mbti-type">INFP</text></view>
					<text class="ai-mbti-x">×</text>
					<view class="ai-mbti-card you"><text class="ai-mbti-label">TA 的 MBTI</text><text class="ai-mbti-type">ENFJ</text></view>
				</view>
				<view class="ai-score-big"><text>92%</text></view>
				<view class="ai-bars"><view v-for="b in aiBars" :key="b.label" class="ai-bar"><view class="ai-bar-head"><text>{{ b.label }}</text><text>{{ b.value }}%</text></view><view class="ai-bar-trk"><view class="ai-bar-fill" :style="{ width: b.value + '%' }"></view></view></view></view>
				<view class="ai-tip"><text>基于公开资料与兴趣交集生成，不代表平台承诺结果。建议从共同兴趣或城市周末安排开始聊。</text></view>
			</view>
		</XsaSheet>

		<!-- 申请认识：统一 XsaApplySheet（与社区同源） -->
		<XsaApplySheet
			:visible="applyVisible"
			:user-id="applyUserId"
			@close="applyVisible = false"
			@success="onApplySheetSuccess"
		/>

		<XsaModal :visible="successVisible" title="申请已送达" :icon="true" icon-type="success" cancel-text="查看申请" confirm-text="演示对方同意" @close="successVisible = false" @cancel="goMessages" @confirm="simulateMatch">
			<view class="apply-body">
				<text>平台已保护双方联系方式。只有双方都愿意，聊天才会开启。</text>
				<view class="apply-note">
					<text class="apply-desc">1. 申请已通过平台安全检查</text>
					<text class="apply-desc">2. 等待对方回应，通常在 24 小时内</text>
					<text class="apply-desc">3. 双方同意后开放聊天</text>
				</view>
			</view>
		</XsaModal>

		<XsaModal :visible="matchedVisible" title="你们都愿意认识彼此" :icon="true" icon-type="success" :show-cancel="false" confirm-text="开始聊天" @close="matchedVisible = false" @confirm="startChat">
			<view class="apply-body"><text>认真关系从一段真诚对话开始。请注意保护隐私与财产安全。</text></view>
		</XsaModal>

		<view v-if="blockVisible" class="block-mask" @tap="blockVisible = false">
			<view class="block-dialog" @tap.stop>
				<view class="block-dialog-title"><text class="block-success-icon">✓</text><text>您已将 {{ blockedUserName }} 拉入黑名单</text></view>
				<view class="block-dialog-card"><text class="block-dialog-note">黑名单中的人无法查看您的资料页</text><view class="blocked-user-row"><image :src="blockedUserAvatar" mode="aspectFill"></image><view class="blocked-user-info"><text>{{ blockedUserName }}</text><text>用户编号：{{ blockedUserId }}</text></view><view class="unblock-button" @tap="handleUnblock"><text>移除黑名单</text></view></view></view>
				<view class="block-back-button" @tap="blockVisible = false"><text>返回</text></view>
			</view>
		</view>

<!-- 自定义底部导航栏 -->

<XsaTabBar />

<!-- 每日查看配额用尽弹窗 -->
		<XsaModal
			:visible="quotaExhaustedVisible"
			title="今日查看次数已用完"
			:show-cancel="true"
			cancel-text="积分兑换"
			confirm-text="升级VIP"
			@close="quotaExhaustedVisible = false"
			@cancel="quotaExhaustedVisible = false"
			@confirm="handleQuotaUpgrade"
		>
			<view class="apply-body">
				<text>{{ quotaExhaustedMessage }}</text>
			</view>
		</XsaModal>
		<XsaToast :visible="toastVisible" :message="toastMessage" @hide="toastVisible = false" />
	</view>
</template>

<script setup lang="uts">
	const systemInfo = uni.getSystemInfoSync()
	const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20

	import XsaSheet from '@/components/XsaSheet.uvue'
	import XsaModal from '@/components/XsaModal.uvue'
	import XsaToast from '@/components/XsaToast.uvue'
	import XsaApplySheet from '@/components/XsaApplySheet.uvue'
	import XsaTabBar from '@/components/XsaTabBar.uvue'
	import { guardRealName } from '@/utils/realNameGate.uts'
	import { likeUser, blockUser, unblockUser } from '@/api'
	import { mockRecommendUsers } from '@/mock/user.uts'
	import {
		recordProfileView,
		resetDailyIfNeeded,
		getDailyViewRemaining,
		getDailyViewQuota
	} from '@/utils/quota.uts'

	// ========== 欢迎页 ==========
	const welcomeVisible = ref(true)
	const welcomeAgreementVisible = ref(false)
	const WELCOME_AGREEMENT_KEY = 'xsa_welcome_agreed_v2'

	const showWelcomeService = () => { uni.showToast({ title: '客服功能将在完成登录后提供', icon: 'none' }) }
	const openWelcomeAgreement = () => { welcomeAgreementVisible.value = true }
	const closeWelcomeAgreement = () => { welcomeAgreementVisible.value = false }
	const acceptWelcomeAgreement = () => {
		uni.setStorageSync(WELCOME_AGREEMENT_KEY, true)
		uni.setStorageSync('xsa_welcome_agreed', true)
		uni.setStorageSync('xsa_skip_welcome_once', true)
		welcomeAgreementVisible.value = false; welcomeVisible.value = false
		uni.navigateTo({ url: '/pages/auth/login' })
	}

	// ========== 导航 ==========
	const currentTab = ref(0)
	const navTabs = ['推荐', '广场', '会员专区']
	const switchTab = (index: number) => { currentTab.value = index }
	const openVipPage = () => {
		const redirect = '/pages/index/index?tab=' + currentTab.value
		uni.navigateTo({
			url: '/pagesSub/profileExtra/vip?redirect=' + encodeURIComponent(redirect),
			fail: () => { uni.showToast({ title: '会员页面打开失败，请重试', icon: 'none' }) }
		})
	}
	const openTopPlacement = () => {
		uni.navigateTo({
			url: '/pagesSub/userExtra/index/top-placement',
			fail: () => { uni.showToast({ title: '置顶页面打开失败，请重试', icon: 'none' }) }
		})
	}
	const onHistory = () => { uni.navigateTo({ url: '/pagesSub/profileExtra/history' }) }
	const onSearch = () => {
		uni.navigateTo({
			url: '/pagesSub/profileExtra/search',
			fail: () => uni.showToast({ title: '搜索页面打开失败，请重试', icon: 'none' })
		})
	}

	// ========== 推荐页数据 ==========
	const basicInfoRows = [
		[
			{ label: '年龄', value: '26岁' },
			{ label: '身高', value: '168cm' },
			{ label: '体重', value: '52kg' }
		],
		[
			{ label: '星座', value: '天秤座' },
			{ label: '学历', value: '本科' },
			{ label: '职业', value: '产品经理' }
		],
		[
			{ label: '现居', value: '北京朝阳' },
			{ label: '家乡', value: '浙江杭州' },
			{ label: '收入', value: '30-50万' }
		]
	]

	// ========== 会员专区数据 ==========
	const vipCatIndex = ref(0)
	const vipCategories = ['高颜值专区', '高收入专区', '高学历专区', '95后专区']

	const vipCardRows = [
		[
			{ id: 2, isVip: true, name: '林悦', age: '26岁', height: '165cm', gender: '女', photo: '/static/portraits/profile-woman-alt.jpg' },
			{ id: 3, isVip: true, name: '周思涵', age: '24岁', height: '168cm', gender: '女', photo: '/static/portraits/profile-woman-main.jpg' },
			{ id: 4, isVip: true, name: '陈雨晴', age: '28岁', height: '162cm', gender: '女', photo: '/static/portraits/profile-woman-community.jpg' }
		],
		[
			{ id: 1, isVip: true, name: '赵晓雯', age: '25岁', height: '170cm', gender: '女', photo: '/static/portraits/profile-woman-main.jpg' },
			{ id: 5, isVip: true, name: '王梓萱', age: '27岁', height: '163cm', gender: '女', photo: '/static/portraits/profile-woman-alt.jpg' },
			{ id: 6, isVip: true, name: '张俊杰', age: '30岁', height: '180cm', gender: '男', photo: '/static/portraits/profile-man-light.jpg' }
		],
		[
			{ id: 7, isVip: true, name: '李浩然', age: '29岁', height: '178cm', gender: '男', photo: '/static/portraits/profile-man-sea.jpg' },
			{ id: 2, isVip: true, name: '孙悦然', age: '29岁', height: '166cm', gender: '女', photo: '/static/portraits/profile-woman-community.jpg' },
			{ id: 3, isVip: true, name: '刘子轩', age: '32岁', height: '182cm', gender: '男', photo: '/static/portraits/profile-man-light.jpg' }
		]
	]

	const vipPrivileges = [
		{ iconClass: 'ic ic-social ic-paishe', title: 'Ta的瞬间', desc: '查看精彩生活瞬间' },
		{ iconClass: 'ic ic-social ic-pinglun', title: 'Ta的问答怎么样', desc: '了解TA的真实想法' },
		{ iconClass: 'ic ic-home ic-star', title: '爆灯特权', desc: '短信即时通知TA' }
	]

	const vipSpots = [
		{ name: '黄思琪', age: '27岁', job: '空乘' },
		{ name: '马薇薇', age: '31岁', job: '主持人' },
		{ name: '龙斌', age: '33岁', job: '企业主' }
	]

	const switchVipCat = (index: number) => { vipCatIndex.value = index }

	// ========== 推荐页过滤 + 配额 ==========
	const filteredRecommendUsers = computed(() => mockRecommendUsers)
	const currentRecommendIndex = ref(0)
	const currentRecommendUser = computed(() => {
		const list = filteredRecommendUsers.value as any[]
		if (list.length === 0) return (mockRecommendUsers as any[])[0]
		return list[currentRecommendIndex.value % list.length]
	})
	const quotaExhaustedVisible = ref(false)
	const quotaExhaustedMessage = ref('')
	const showQuotaExhausted = () => {
		const quota = getDailyViewQuota()
		if (quota.isVip) {
			quotaExhaustedMessage.value = '今日免费查看次数已用完（' + quota.total + '/' + quota.total + '），可使用积分兑换'
} else {
			quotaExhaustedMessage.value = '今日免费查看次数已用完（' + quota.total + '/' + quota.total + '），升级VIP享每日20次查看，或积分兑换'
}
		quotaExhaustedVisible.value = true
	}
	const handleQuotaUpgrade = () => { quotaExhaustedVisible.value = false; uni.navigateTo({ url: '/pagesSub/profileExtra/vip' }) }
	const switchToNextRecommend = () => {
		if (!recordProfileView()) { showQuotaExhausted(); return }
		const list = filteredRecommendUsers.value as any[]
		if (list.length === 0) return
		currentRecommendIndex.value = (currentRecommendIndex.value + 1) % list.length
	}
	const blockVisible = ref(false)
	const blockedUserId = ref(0)
	const blockedUserName = ref('')
	const blockedUserAvatar = ref('/static/portraits/profile-woman-main.jpg')
	const openReportPage = () => {
		const user = currentRecommendUser.value as any
		const userId = user != null && user.id != null ? Number(user.id) : 0
		const userName = user != null && user.name != null ? '' + user.name : '该用户'
		uni.navigateTo({ url: '/pagesSub/profileExtra/report?userId=' + userId + '&userName=' + encodeURIComponent(userName), fail: () => showToast('举报页面打开失败，请重试') })
	}
	const handleBlockUser = async () => {
		const user = currentRecommendUser.value as any
		const userId = user != null && user.id != null ? Number(user.id) : 0
		blockedUserId.value = userId
		blockedUserName.value = user.name != null ? '' + user.name : '该用户'
		blockedUserAvatar.value = user.avatar != null ? '' + user.avatar : '/static/portraits/profile-woman-main.jpg'
		blockVisible.value = true
		if (userId <= 0) { showToast('当前为演示用户，已展示拉黑结果'); return }
		try {
			const res = await blockUser(userId)
			if (!res.success) showToast(res.message != null ? '' + res.message : '已显示拉黑结果，稍后同步')
		} catch (e) { showToast('已显示拉黑结果，网络恢复后同步') }
	}
	const handleUnblock = async () => {
		const res = await unblockUser(blockedUserId.value)
		if (res.success) { blockVisible.value = false; showToast('已移除黑名单') }
		else showToast('移除失败，请重试')
	}

	// 左滑换一个
	const touchStartX = ref(0)
	const touchStartY = ref(0)
	const onTouchStart = (e: any) => {
		const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
		if (touch != null) {
			touchStartX.value = touch.clientX
			touchStartY.value = touch.clientY
		}
	}
	const onTouchEnd = (e: any) => {
		const touch = e.changedTouches != null && e.changedTouches.length > 0 ? e.changedTouches[0] : null
		if (touch != null) {
			const deltaX = touchStartX.value - touch.clientX
			const deltaY = touchStartY.value - touch.clientY
			// 左滑（deltaX > 60）且水平位移大于垂直位移
			if (deltaX > 60 && Math.abs(deltaX) > Math.abs(deltaY)) {
				switchToNextRecommend()
			}
		}
	}

	// Ta的动态
	const feedDynamics = [
		{ id: 101, avatar: '/static/portraits/profile-woman-main.jpg', name: '苏晚晴', timeText: '2小时前', location: '大理', content: '周末和朋友去了趟大理，洱海边的风真的好舒服！租了一辆小电驴环了半个岛，停下来拍照的时候，感觉整个世界都慢下来了。', photos: ['/static/portraits/profile-woman-alt.jpg', '/static/portraits/profile-woman-community.jpg'], tags: ['#旅行'], likeCount: 89, commentCount: 12 },
		{ id: 102, avatar: '/static/portraits/profile-woman-main.jpg', name: '苏晚晴', timeText: '1天前', location: '杭州', content: '在画室泡了一整天，终于把新系列的第一幅完成了！这次尝试了新的水彩技法，颜色层次比之前丰富了很多。', photos: ['/static/portraits/profile-man-light.jpg', '/static/portraits/profile-man-sea.jpg'], tags: ['#画画', '#日常'], likeCount: 56, commentCount: 8 }
	]
		const viewAllFeed = () => { showToast('查看全部动态') }
		const goPostDetail = (postId: number) => {
			uni.navigateTo({ url: '/pagesSub/community/post-detail?id=' + postId })
		}

	// ========== AI 合拍度 ==========
	const aiVisible = ref(false)
	const aiBars = [{ label: '关系目标', value: 96 }, { label: '生活节奏', value: 89 }, { label: '兴趣交集', value: 86 }]

	const showAiScore = () => { aiVisible.value = true }

	// ========== 申请认识 ==========
	const applyVisible = ref(false)
	const applyUserId = ref(1)
	const successVisible = ref(false)
	const matchedVisible = ref(false)
	const toastVisible = ref(false)
	const toastMessage = ref('')

	const showToast = (m: string) => { toastMessage.value = m; toastVisible.value = true }

	const openApplyModal = async () => {
		const ok = await guardRealName('apply')
		if (!ok) return
		applyUserId.value = recommendUserId.value
		applyVisible.value = true
	}

	const onApplySheetSuccess = (payload: any) => {
		applyVisible.value = false
		// 产品规则：申请后不直接进入聊天
		successVisible.value = true
		if (payload != null && payload.code == 'ALREADY_PENDING') {
			showToast('申请已发送，请等待对方回应')
}
	}

	const goMessages = () => { successVisible.value = false; uni.switchTab({ url: '/pages/message/message' }) }
	const simulateMatch = () => { successVisible.value = false; matchedVisible.value = true }
	const startChat = () => { matchedVisible.value = false; uni.navigateTo({ url: '/pagesSub/chat/detail?userId=user_001&userName=林悦' }) }

	// ========== 通用操作 ==========
	// 推荐卡默认嘉宾 id（与 mock 动态作者对齐，便于验证关注·喜欢）
	const recommendUserId = ref(1)
	const goUserDetail = (userId: number = 1) => {
		const id = userId > 0 ? userId : 1
		uni.navigateTo({ url: '/pagesSub/userExtra/user/detail?userId=' + id })
	}
	const shareProfile = () => { showToast('已生成分享入口') }
	// 用户级喜欢：写入 mockLikedUserIds，供社区「关注·喜欢」使用
	const onLike = async (userId: number = 0) => {
		const id = userId > 0 ? userId : recommendUserId.value
		const ok = await guardRealName('like')
		if (!ok) return
		try {
			const res = await likeUser(id)
			if (res.success && res.data != null) {
				const liked = res.data.liked == true
				showToast(liked ? '已喜欢，仅你自己可见' : '已取消喜欢')
			} else {
				showToast('操作失败，请重试')
			}
} catch (e) {
			showToast('操作失败，请重试')
}
	}

	// ========== 生命周期 ==========
	onMounted(() => {
		const pages = getCurrentPages()
		const currentPage = pages[pages.length - 1]
		const options = currentPage.options
		const skipWelcomeOnce = uni.getStorageSync('xsa_skip_welcome_once') == true
		if (skipWelcomeOnce) uni.removeStorageSync('xsa_skip_welcome_once')
		welcomeVisible.value = !skipWelcomeOnce && (options.tab == null || options.tab == '')
		if (options.tab != null && options.tab != '') {
			const parsedTab = Number(options.tab)
			if (!isNaN(parsedTab) && parsedTab >= 0 && parsedTab < navTabs.length) {
				currentTab.value = parsedTab
			}
		}
		resetDailyIfNeeded()
	})
</script>

<style scoped>
