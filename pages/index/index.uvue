.vip-cat-tabs { display: flex; flex-direction: row; background-color: var(--bg-card); border-radius: var(--radius-lg); padding: 0 8rpx; margin-bottom: 24rpx; }
.vip-cat-tab { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 28rpx 0 20rpx 0; }
.vip-cat-tab-text { font-size: 26rpx; font-weight: 500; color: var(--text-muted); }
.vip-cat-tab-text.active { font-size: 28rpx; font-weight: 700; color: var(--text-primary); }
.vip-cat-indicator { width: 48rpx; height: 6rpx; background-color: var(--accent); border-radius: 3rpx; }

.vip-filter-row { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 24rpx 0; }
.vip-result-count { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.vip-filter-right { display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.vip-sort-btn { display: flex; flex-direction: row; align-items: center; gap: 8rpx; padding: 10rpx 20rpx; border-radius: var(--radius-full); background-color: var(--bg-card); }
.vip-sort-text { font-size: 24rpx; color: var(--text-secondary); }
.vip-sort-icon { font-size: 20rpx; color: var(--text-muted); }
.vip-accelerate-btn { display: flex; flex-direction: row; align-items: center; gap: 8rpx; padding: 10rpx 20rpx; border-radius: var(--radius-full); background-color: var(--accent); }
.vip-accel-icon { font-size: 24rpx; color: var(--text-inverse); }
.vip-accel-text { font-size: 24rpx; color: var(--text-inverse); font-weight: 600; }

.vip-card-grid { display: flex; flex-direction: column; gap: 20rpx; }
.vip-card-row { display: flex; flex-direction: row; gap: 20rpx; }
.vip-card-item { flex: 1; display: flex; flex-direction: column; background-color: var(--bg-card); border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03); }
.vip-card-content { position: relative; display: flex; flex-direction: column; }
.vip-card-photo { width: 100%; height: 280rpx; position: relative; overflow: hidden; }
.vip-card-photo-img { width: 100%; height: 100%; }
.vip-card-crown { position: absolute; top: 12rpx; left: 12rpx; display: flex; align-items: center; padding: 4rpx 10rpx; border-radius: var(--radius-sm); background-color: #C9A96E; }
.vip-card-crown-icon { font-size: 16rpx; }
.vip-card-gender { position: absolute; top: 12rpx; right: 12rpx; display: flex; align-items: center; padding: 4rpx 10rpx; border-radius: var(--radius-sm); }
.vip-card-gender.female { background-color: #FFE4E6; }
.vip-card-gender.male { background-color: #DBEAFE; }
.vip-gender-icon { font-size: 20rpx; font-weight: 700; }
.vip-gender-icon.female { color: #E11D48; }
.vip-gender-icon.male { color: #2563EB; }
.vip-card-bottom { display: flex; flex-direction: column; gap: 8rpx; padding: 20rpx; }
.vip-card-name { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.vip-card-meta { display: flex; flex-direction: row; align-items: center; gap: 8rpx; }
.vip-card-age { font-size: 24rpx; color: var(--text-secondary); }
.vip-card-dot { width: 4rpx; height: 4rpx; border-radius: 50%; background-color: var(--text-muted); }
.vip-card-height { font-size: 24rpx; color: var(--text-secondary); }

.vip-privilege-section { display: flex; flex-direction: column; gap: 24rpx; padding: 32rpx 16rpx; }
.vip-priv-header { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
.vip-priv-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.vip-upgrade-btn { display: flex; flex-direction: row; align-items: center; gap: 8rpx; padding: 16rpx 32rpx; border-radius: var(--radius-full); background-color: var(--accent); }
.vip-upgrade-icon { font-size: 28rpx; }
.vip-upgrade-text { font-size: 26rpx; font-weight: 600; color: var(--text-inverse); }
.vip-priv-row { display: flex; flex-direction: row; gap: 20rpx; }
.vip-priv-card { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 28rpx; border-radius: var(--radius-lg); background-color: var(--bg-card); box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03); }
.vip-priv-icon-circle { width: 88rpx; height: 88rpx; border-radius: 50%; background-color: #FEF9F0; display: flex; align-items: center; justify-content: center; }
.vip-priv-icon-text { font-size: 44rpx; }
.vip-priv-card-title { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
.vip-priv-card-desc { font-size: 22rpx; color: var(--text-muted); text-align: center; }

.vip-spotlight { display: flex; flex-direction: column; gap: 24rpx; padding: 32rpx 16rpx; }
.vip-spot-header { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
.vip-spot-title-group { display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.vip-spot-icon { font-size: 36rpx; }
.vip-spot-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.vip-spot-count { font-size: 24rpx; color: var(--gold); font-weight: 600; }
.vip-spot-more { font-size: 24rpx; color: var(--text-muted); }
.vip-spot-desc { font-size: 24rpx; color: var(--text-muted); line-height: 1.5; }
.vip-spot-row { display: flex; flex-direction: row; gap: 20rpx; }
.vip-spot-card { flex: 1; display: flex; flex-direction: column; background-color: var(--bg-card); border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03); }
.vip-spot-photo { width: 100%; height: 200rpx; background-color: var(--bg-card-soft); display: flex; align-items: center; justify-content: center; }
.vip-spot-photo-icon { font-size: 64rpx; color: var(--text-muted); }
.vip-spot-info { display: flex; flex-direction: column; gap: 4rpx; padding: 20rpx; }
.vip-spot-name { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
.vip-spot-age { font-size: 22rpx; color: var(--text-muted); }

.vip-bottom-cta { display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding: 40rpx 32rpx 48rpx 32rpx; background: linear-gradient(135deg, #2D4A3E, #C9A96E); border-radius: var(--radius-xl); }
.vip-cta-title { font-size: 36rpx; font-weight: 700; color: #FFFFFF; }
.vip-cta-desc { font-size: 24rpx; color: #CCCCCC; text-align: center; line-height: 1.5; }
.vip-price-row { display: flex; flex-direction: row; gap: 16rpx; width: 100%; padding-top: 24rpx; }
.vip-price-opt { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 28rpx 16rpx 16rpx 16rpx; border-radius: var(--radius-md); background-color: rgba(255, 255, 255, 0.1); position: relative; overflow: visible; }
.vip-price-opt.recommended { background-color: rgba(201, 169, 110, 0.2); border: 2rpx solid var(--gold); }
.vip-price-badge { position: absolute; top: -20rpx; left: 50%; transform: translateX(-50%); padding: 6rpx 18rpx; border-radius: var(--radius-sm); background-color: var(--gold); white-space: nowrap; z-index: 2; }
.vip-price-badge-text { font-size: 20rpx; color: #FFFFFF; font-weight: 600; line-height: 1.2; }
.vip-price-period { font-size: 24rpx; color: #CCCCCC; }
.vip-price-value { font-size: 36rpx; font-weight: 700; color: var(--gold); }
.vip-cta-btn { width: 100%; height: 96rpx; border-radius: 48rpx; background-color: var(--accent); display: flex; align-items: center; justify-content: center; }
.vip-cta-btn-text { font-size: 30rpx; font-weight: 700; color: #FFFFFF; }
.vip-cta-hint { font-size: 22rpx; color: #888888; text-align: center; }

/* ============================================================
   AI Sheet
   ============================================================ */
.ai-sheet { display: flex; flex-direction: column; gap: 16px; }
.ai-mbti-row { display: flex; align-items: center; justify-content: center; gap: 14px; }
.ai-mbti-card { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 14px 20px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); }
.ai-mbti-card.you { background: var(--accent-bg); border-color: var(--accent); }
.ai-mbti-label { font-size: 10px; color: var(--muted); }
.ai-mbti-type { font-family: var(--serif); font-size: 22px; font-weight: 700; color: var(--accent2); }
.ai-mbti-x { font-size: 18px; color: var(--ink2); }
.ai-score-big text { font-size: 48px; font-weight: 900; color: var(--accent2); font-family: var(--serif); }
.ai-score-big { text-align: center; }
.ai-bars { display: flex; flex-direction: column; gap: 10px; }
.ai-bar { display: flex; flex-direction: column; gap: 4px; }
.ai-bar-head { display: flex; justify-content: space-between; font-size: 11px; }
.ai-bar-trk { height: 6px; border-radius: 3px; background: var(--warm); overflow: hidden; }
.ai-bar-fill { height: 100%; background: var(--accent); border-radius: 3px; transition: width 0.4s; }
.ai-tip { padding: 12px; background: var(--accent-bg); border-radius: 8px; font-size: 11px; line-height: 1.6; color: var(--ink2); }

/* ============================================================
   Modal
   ============================================================ */
.apply-body { display: flex; flex-direction: column; gap: 10px; }
.apply-desc { font-size: 12px; line-height: 1.6; color: var(--muted); }
.apply-note { padding: 10px; background: var(--warm); border-radius: 8px; font-size: 11px; }
.apply-note .em { color: var(--accent2); font-weight: 800; }
.apply-input { width: 100%; min-height: 72px; padding: 10px; border: 1px solid var(--line); border-radius: 8px; font-size: 12px; }

/* 固定头部 */
.sticky-header { position: fixed; top: 0; left: 0; right: 0; z-index: 20; max-width: 750rpx; margin: 0 auto; background-color: var(--bg-primary); }
.content-scroll { flex: 1; padding: 254rpx 32rpx 0 32rpx; }
/* 屏蔽/举报行 */
.block-row { display: flex; flex-direction: row; justify-content: center; align-items: center; width: 100%; padding: 16rpx 0 8rpx 0; }
.block-action { display: flex; flex-direction: row; align-items: center; justify-content: center; padding: 10rpx 18rpx; }
.block-text { display: block; flex-shrink: 0; white-space: nowrap; font-size: 24rpx; color: var(--text-muted); }
.block-divider { margin: 0 12rpx; font-size: 22rpx; color: var(--line); }
.block-mask { position: fixed; z-index: 80; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 30px; background: rgba(0,0,0,.58); }
.block-dialog { width: 100%; padding: 28px 22px 22px; border-radius: 24px; background: linear-gradient(135deg, #F8FBFF, #F4F0FF); box-sizing: border-box; }
.block-dialog-title { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 6px; font-size: 20px; font-weight: 800; color: var(--ink); text-align: center; }
.block-success-icon { width: 28px; height: 28px; border-radius: 14px; display: flex; align-items: center; justify-content: center; background: #7047F4; color: var(--text-invert); font-size: 18px; }
.block-dialog-card { margin-top: 26px; padding: 18px 14px; border-radius: 10px; background: rgba(255,255,255,.82); }
.block-dialog-note { display: block; text-align: center; font-size: 13px; color: var(--muted); }
.blocked-user-row { display: flex; flex-direction: row; align-items: center; gap: 10px; margin-top: 16px; }
.blocked-user-row image { width: 48px; height: 48px; border-radius: 8px; flex-shrink: 0; }
.blocked-user-info { flex: 1; display: flex; flex-direction: column; gap: 5px; font-size: 14px; color: var(--ink); }
.blocked-user-info text:last-child { font-size: 12px; color: var(--muted); }
.unblock-button { padding: 10px 8px; border: 2px solid #7957C9; border-radius: 6px; color: #7957C9; font-size: 12px; white-space: nowrap; }
.block-back-button { height: 48px; margin-top: 22px; border-radius: 24px; display: flex; align-items: center; justify-content: center; background: linear-gradient(90deg, #8247F3, #4B45F4); color: var(--text-invert); font-size: 18px; font-weight: 800; }
/* 底部操作栏 */

.ai-float-btn { z-index: 55; bottom: 360rpx; }
/* Ta的动态 */
.feed-section { display: flex; flex-direction: column; gap: 20rpx; }
.feed-section-header { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
.feed-more { font-size: 22rpx; font-weight: 500; color: var(--accent-dark); }
.feed-list { display: flex; flex-direction: column; gap: 24rpx; }
.feed-card { display: flex; flex-direction: column; background-color: var(--bg-card); border-radius: var(--radius-lg); box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.02); overflow: hidden; }
.feed-card-header { display: flex; flex-direction: row; align-items: center; gap: 20rpx; padding: 28rpx 28rpx 12rpx 28rpx; }
.feed-card-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background-color: var(--bg-card-soft); }
.feed-card-user-col { flex: 1; display: flex; flex-direction: column; gap: 2rpx; }
.feed-card-name { font-size: 26rpx; font-weight: 700; color: var(--text-primary); }
.feed-card-meta { font-size: 20rpx; color: var(--text-muted); }
.feed-card-content { padding: 0 28rpx 16rpx 28rpx; font-size: 24rpx; color: var(--text-secondary); line-height: 1.55; }
.feed-card-photos { display: flex; flex-direction: row; gap: 10rpx; padding: 0 28rpx 16rpx 28rpx; }
.feed-photo { border-radius: var(--radius-sm); background-color: var(--bg-card-soft); }
.feed-photo-single { width: 100%; height: 320rpx; }
.feed-photo-double { flex: 1; height: 220rpx; }
.feed-card-tags { display: flex; flex-direction: row; gap: 12rpx; padding: 0 28rpx 8rpx 28rpx; }
.feed-tag { padding: 8rpx 24rpx; border-radius: var(--radius-full); background-color: var(--bg-card-soft); font-size: 20rpx; font-weight: 500; color: var(--accent-dark); }
.feed-card-divider { width: 100%; height: 2rpx; background-color: var(--border-soft); }
.feed-card-footer { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 16rpx 28rpx 20rpx 28rpx; }
.feed-date { font-size: 20rpx; color: var(--text-muted); }
.feed-actions { display: flex; flex-direction: row; align-items: center; gap: 28rpx; }
.feed-action { display: flex; flex-direction: row; align-items: center; gap: 8rpx; }
.feed-action-icon { font-size: 26rpx; color: var(--text-muted); }
.feed-action-count { font-size: 20rpx; color: var(--text-muted); }
/* 内联图标 */
.sq-loc-icon { font-size: 24rpx; color: var(--text-muted); margin-right: 2rpx; }
.sq-arrow { font-size: 22rpx; color: var(--text-muted); }
.activity-dot { font-size: 24rpx; color: var(--accent); margin-right: 4rpx; }
.vip-tag-icon { font-size: 24rpx; color: var(--text-inverse); margin-right: 4rpx; }
.vip-cta-icon { font-size: 36rpx; color: var(--gold); margin-right: 8rpx; }

