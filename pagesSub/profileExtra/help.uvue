<template>
  <view class="page">
    <scroll-view class="page-scroll" scroll-y="true" show-scrollbar="false">
      <view class="help-header">
        <view class="help-header-mark"><text>?</text></view>
        <view class="help-header-copy">
          <text class="help-title">帮助与客服</text>
          <text class="help-subtitle">选择问题分类，快速找到答案</text>
        </view>
      </view>

      <view class="quick-heading">
        <text class="section-title">快速入口</text>
        <text class="section-caption">AI 辅助，不替代人工判断</text>
      </view>
      <view class="quick-card ai-card card-hit" @tap="openAiSupport">
        <view class="quick-card-main">
          <view class="quick-icon ai"><text>AI</text></view>
          <view class="quick-copy">
            <text class="quick-title">联系客服</text>
            <text class="quick-desc">咨询平台功能、举报和安全操作</text>
          </view>
          <text class="quick-arrow">›</text>
        </view>
        <view class="quick-note"><text>涉及举报时，客服会引导你前往相关卡片上方的举报入口。</text></view>
      </view>
      <view class="quick-card feedback-card card-hit" @tap="openFeedback">
        <view class="quick-icon feedback"><text>✎</text></view>
        <view class="quick-copy">
          <text class="quick-title light">意见箱</text>
          <text class="quick-desc light">告诉我们使用中的建议或遇到的问题</text>
        </view>
        <text class="quick-arrow light">›</text>
      </view>

      <view class="faq-heading">
        <text class="section-title">常见问题</text>
        <text class="section-caption">点击问题即可咨询</text>
      </view>
      <scroll-view class="category-tabs" scroll-x="true" show-scrollbar="false">
        <view class="category-tabs-inner">
          <view v-for="category in categories" :key="category.id" class="category-tab" :class="{ active: activeCategoryId == category.id }" @tap="selectCategory(category.id)">
            <text class="category-tab-label">{{ category.title.replace('\n', ' ') }}</text>
            <view class="category-indicator"></view>
          </view>
        </view>
      </scroll-view>

      <view class="faq-panel">
        <view v-if="loading" class="state-panel"><text>帮助内容加载中...</text></view>
        <view v-else-if="error != ''" class="state-panel error" @tap="loadHelpCenter"><text>{{ error }}，点击重试</text></view>
        <view v-else-if="activeItems.length == 0" class="state-panel"><text>暂无相关问题</text></view>
        <view v-else class="faq-list">
          <view v-for="(item, index) in activeItems" :key="item.id" class="faq-row" @tap="openFaq(item.prompt)">
            <text class="faq-index">{{ index + 1 }}.</text>
            <text class="faq-question">{{ item.question }}</text>
            <text class="faq-arrow">›</text>
          </view>
        </view>
      </view>
      <view class="safety-tip"><text>没有找到答案？点击上方“联系客服”继续咨询。</text></view>
    </scroll-view>
  </view>

  <XsaSheet :visible="aiVisible" title="AI 客服" :tall="true" @close="closeAiSupport">
    <view class="sheet-intro">
      <text class="sheet-intro-title">先描述你想了解的事情</text>
      <text class="sheet-intro-desc">AI 回复仅供参考；涉及举报时，请按提示前往对应卡片操作。</text>
    </view>
    <scroll-view class="message-list" scroll-y="true" :scroll-into-view="lastMessageId">
      <view v-for="message in messages" :key="message.id" :id="message.id" class="message-row" :class="message.role">
        <view class="message-bubble"><text>{{ message.content }}</text></view>
      </view>
      <view class="message-loading" v-if="aiSending"><text>正在整理回复...</text></view>
      <view class="message-error" v-if="aiError != ''" @tap="retryLastMessage">{{ aiError }}，点击重试</view>
    </scroll-view>
    <view class="sheet-input-row">
      <input class="question-input" :value="draft" maxlength="200" placeholder="请输入想咨询的问题" @input="onDraftInput" @confirm="sendDraft" />
      <XsaButton variant="primary" size="small" :loading="aiSending" :disabled="aiSending" @click="sendDraft">发送</XsaButton>
    </view>
  </XsaSheet>

  <XsaSheet :visible="feedbackVisible" title="意见箱" @close="closeFeedback">
    <view class="sheet-intro">
      <text class="sheet-intro-title">你的意见会帮助我们改进</text>
      <text class="sheet-intro-desc">请尽量描述具体场景，便于我们理解问题。</text>
    </view>
    <textarea class="feedback-input" :value="feedbackDraft" maxlength="1000" placeholder="请输入你的意见或建议" @input="onFeedbackInput"></textarea>
    <view class="feedback-meta"><text>{{ feedbackDraft.length }}/1000</text></view>
    <text class="feedback-error" v-if="feedbackError != ''">{{ feedbackError }}</text>
    <XsaButton variant="primary" size="large" :loading="feedbackSubmitting" :disabled="feedbackSubmitting" @click="submitFeedbackForm">提交意见</XsaButton>
  </XsaSheet>
</template>

<script setup lang="uts">
import XsaButton from '@/components/XsaButton.uvue'
import XsaSheet from '@/components/XsaSheet.uvue'
import { getHelpCenter, sendAiSupportMessage, submitFeedback, HelpCategory, HelpFaqItem } from '@/api/help'

interface SupportMessage {
  id: string
  role: string
  content: string
}

let categories = ref([] as HelpCategory[])
let activeCategoryId = ref('common')
let loading = ref(false)
let error = ref('')
let aiVisible = ref(false)
let feedbackVisible = ref(false)
let messages = ref([] as SupportMessage[])
let draft = ref('')
let lastQuestion = ref('')
let aiSending = ref(false)
let aiError = ref('')
let feedbackDraft = ref('')
let feedbackSubmitting = ref(false)
let feedbackError = ref('')
let openOnLoad = ''

const activeItems = computed(() => {
  const list = categories.value as HelpCategory[]
  for (let i = 0; i < list.length; i++) {
    if (list[i].id == activeCategoryId.value) return list[i].items
  }
  return [] as HelpFaqItem[]
})

const lastMessageId = computed(() => {
  const list = messages.value as SupportMessage[]
  if (list.length == 0) return ''
  return list[list.length - 1].id
})

const loadHelpCenter = async () => {
  loading.value = true
  error.value = ''
  try {
    const res = await getHelpCenter()
    if (!res.success || res.data == null) throw new Error('help unavailable')
    categories.value = res.data.categories as HelpCategory[]
    if (categories.value.length > 0) {
      let exists = false
      for (let i = 0; i < categories.value.length; i++) {
        if (categories.value[i].id == activeCategoryId.value) exists = true
      }
      if (!exists) activeCategoryId.value = categories.value[0].id
    }
  } catch (e) {
    error.value = '帮助内容加载失败'
  } finally {
    loading.value = false
  }
}

onMounted(() => {
  loadHelpCenter()
})

onLoad((options) => {
  openOnLoad = options?.open ?? ''
  if (openOnLoad == 'feedback') {
    setTimeout(() => { openFeedback() }, 100)
  } else if (openOnLoad == 'ai') {
    setTimeout(() => { openAiSupport() }, 100)
  }
})

const selectCategory = (id: string) => {
  activeCategoryId.value = id
}

const openFaq = (question: string) => {
  openAiSupport()
  draft.value = question
  sendDraft()
}

const openAiSupport = () => {
  aiVisible.value = true
  aiError.value = ''
  if (messages.value.length == 0) {
    messages.value.push({ id: 'welcome', role: 'assistant', content: '你好，我是宣誓爱的 AI 客服。你可以从常见问题中选择，也可以直接输入问题。' })
  }
}

const closeAiSupport = () => {
  aiVisible.value = false
}

const openFeedback = () => {
  feedbackVisible.value = true
  feedbackError.value = ''
}

const closeFeedback = () => {
  feedbackVisible.value = false
}

const onDraftInput = (e: any) => {
  draft.value = e.detail.value
}

const onFeedbackInput = (e: any) => {
  feedbackDraft.value = e.detail.value
  feedbackError.value = ''
}

const sendDraft = async () => {
  const question = draft.value.trim()
  if (question.length == 0) {
    uni.showToast({ title: '请输入想咨询的问题', icon: 'none' })
    return
  }
  if (aiSending.value) return
  lastQuestion.value = question
  draft.value = ''
  aiError.value = ''
  messages.value.push({ id: 'user-' + Date.now(), role: 'user', content: question })
  aiSending.value = true
  try {
    const res = await sendAiSupportMessage(question)
    if (!res.success || res.data == null) throw new Error('ai unavailable')
    messages.value.push(res.data as SupportMessage)
  } catch (e) {
    aiError.value = '回复失败'
  } finally {
    aiSending.value = false
  }
}

const retryLastMessage = () => {
  if (lastQuestion.value != '') {
    draft.value = lastQuestion.value
    sendDraft()
  }
}

const submitFeedbackForm = async () => {
  const content = feedbackDraft.value.trim()
  if (content.length == 0) {
    feedbackError.value = '请填写意见内容'
    return
  }
  if (feedbackSubmitting.value) return
  feedbackSubmitting.value = true
  feedbackError.value = ''
  try {
    const res = await submitFeedback(content)
    if (!res.success) throw new Error('feedback unavailable')
    feedbackDraft.value = ''
    feedbackVisible.value = false
    uni.showToast({ title: '意见已提交，感谢你的反馈', icon: 'success' })
  } catch (e) {
    feedbackError.value = '提交失败，请重试'
  } finally {
    feedbackSubmitting.value = false
  }
}
</script>

<style>
.page { min-height: 100vh; height: 100vh; display: flex; flex-direction: column; background: var(--canvas); }
.page-scroll { flex: 1; min-height: 0; padding-bottom: 16px; }
.help-header { display: flex; flex-direction: row; align-items: center; gap: 12px; padding: 20px 16px 14px; background: var(--paper); border-bottom: 1px solid var(--line); }
.help-header-mark { flex-shrink: 0; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 12px; background: var(--accent-bg); color: var(--accent2); font-size: 21px; font-weight: 800; }
.help-header-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 2px; }
.help-title { color: var(--ink); font-family: var(--serif); font-size: 21px; font-weight: 700; }
.help-subtitle { color: var(--muted); font-size: 12px; }
.quick-heading, .faq-heading { display: flex; flex-direction: row; align-items: baseline; justify-content: space-between; gap: 12px; padding: 18px 16px 8px; }
.faq-heading { padding-top: 24px; }
.section-title { color: var(--ink); font-size: 16px; font-weight: 800; }
.section-caption { color: var(--muted); font-size: 11px; }
.card-hit { margin: 0 16px 12px; }
.quick-card { box-sizing: border-box; }
.ai-card { min-height: 142px; padding: 18px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); box-shadow: var(--shadow-sm); }
.quick-card-main { display: flex; flex-direction: row; align-items: center; gap: 12px; }
.feedback-card { min-height: 86px; display: flex; flex-direction: row; align-items: center; gap: 12px; padding: 18px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
.quick-icon { flex-shrink: 0; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border-radius: 12px; font-size: 12px; font-weight: 800; }
.quick-icon.ai { background: var(--accent); color: var(--text-invert); }
.quick-icon.feedback { background: var(--warm); color: var(--accent2); font-size: 21px; }
.quick-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4px; }
.quick-title { color: var(--text-invert); font-size: 16px; font-weight: 800; }
.ai-card .quick-title { color: var(--ink); }
.quick-title.light { color: var(--ink); }
.quick-desc { color: var(--soft); font-size: 12px; line-height: 1.5; }
.ai-card .quick-desc { color: var(--muted); }
.quick-desc.light { color: var(--muted); }
.quick-arrow { flex-shrink: 0; width: 30px; color: var(--text-invert); font-size: 28px; text-align: center; }
.ai-card .quick-arrow { color: var(--muted); }
.quick-arrow.light { color: var(--muted); }
.quick-note { display: block; width: 100%; margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--accent-glow); color: var(--soft); font-size: 11px; line-height: 1.6; }
.ai-card .quick-note { border-top-color: var(--line); color: var(--muted); }
.category-tabs { width: 100%; height: 58px; background: var(--surface); border-bottom: 1px solid var(--line); }
.category-tabs-inner { display: flex; flex-direction: row; align-items: flex-end; gap: 28px; height: 58px; padding: 0 16px; white-space: nowrap; }
.category-tab { flex-shrink: 0; height: 58px; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 9px; color: var(--muted); }
.category-tab.active { color: var(--ink); }
.category-tab-label { font-size: 16px; font-weight: 700; }
.category-indicator { width: 46px; height: 4px; border-radius: 4px; background: transparent; }
.category-tab.active .category-indicator { background: var(--accent); }
.faq-panel { margin: 0 16px; background: var(--surface); }
.faq-list { display: flex; flex-direction: column; }
.faq-row { min-height: 68px; display: flex; flex-direction: row; align-items: center; gap: 7px; padding: 14px 0; border-bottom: 1px solid var(--line); }
.faq-row:active { background: var(--bg-hover); }
.faq-index { flex-shrink: 0; color: var(--ink2); font-size: 14px; }
.faq-question { min-width: 0; flex: 1; color: var(--ink2); font-size: 15px; line-height: 1.55; }
.faq-arrow { flex-shrink: 0; width: 22px; color: var(--muted); font-size: 24px; text-align: center; }
.state-panel { display: flex; align-items: center; justify-content: center; min-height: 180px; padding: 24px; color: var(--muted); font-size: 13px; text-align: center; }
.state-panel.error { color: var(--accent2); }
.safety-tip { padding: 14px 16px 20px; color: var(--muted); font-size: 11px; line-height: 1.6; }
.sheet-intro { display: flex; flex-direction: column; gap: 4px; margin-bottom: 14px; }
.sheet-intro-title { color: var(--ink); font-size: 15px; font-weight: 800; }
.sheet-intro-desc { color: var(--muted); font-size: 12px; line-height: 1.6; }
.message-list { height: 430px; padding: 4px 0; }
.message-row { display: flex; flex-direction: row; margin: 8px 0; }
.message-row.user { justify-content: flex-end; }
.message-bubble { max-width: 82%; padding: 10px 12px; border-radius: 12px; background: var(--warm); color: var(--ink2); font-size: 13px; line-height: 1.6; }
.message-row.user .message-bubble { background: var(--accent); color: var(--text-invert); }
.message-loading { color: var(--muted); font-size: 12px; padding: 8px 0; }
.message-error { padding: 12px; color: var(--accent2); font-size: 12px; text-align: center; }
.sheet-input-row { display: flex; flex-direction: row; align-items: center; gap: 8px; margin-top: 12px; }
.question-input { flex: 1; height: 44px; padding: 0 12px; border: 1px solid var(--line); border-radius: 9px; background: var(--surface); color: var(--ink); font-size: 13px; }
.feedback-input { width: 100%; min-height: 150px; padding: 12px; border: 1px solid var(--line); border-radius: 9px; background: var(--surface); color: var(--ink); font-size: 13px; line-height: 1.6; }
.feedback-meta { color: var(--muted); font-size: 11px; text-align: right; margin: 6px 0 10px; }
.feedback-error { display: block; color: var(--accent2); font-size: 12px; margin-bottom: 10px; }
</style>
