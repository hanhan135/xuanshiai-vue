<template>
	<view class="page">
		<view class="section-card">
			<view class="card-header">
				<view>
					<text class="section-title">申请前置认证</text>
					<text class="section-note">申请红娘或合伙人前需完成以下两项</text>
				</view>
				<text class="progress-text">已完成 {{ completed }}/2</text>
			</view>

			<view class="cert-item">
				<view class="cert-icon-wrap" :class="{ 'cert-done': phoneVerified }"><text class="cert-icon-text">📱</text></view>
				<view class="cert-text-wrap">
					<text class="cert-label">手机号绑定</text>
					<text class="cert-desc">{{ phoneVerified ? phoneMasked : '用于接收审核和服务通知' }}</text>
				</view>
				<text v-if="phoneVerified" class="status passed">已绑定</text>
				<view v-else class="action-pill" @tap="openStep('phone')"><text>去绑定</text></view>
			</view>

			<view class="cert-item">
				<view class="cert-icon-wrap" :class="{ 'cert-done': realnameStatus == 2 }"><text class="cert-icon-text">🛡</text></view>
				<view class="cert-text-wrap">
					<text class="cert-label">实名认证</text>
					<text class="cert-desc">{{ realnameDescription }}</text>
				</view>
				<text v-if="realnameStatus == 2" class="status passed">已通过</text>
				<text v-else-if="realnameStatus == 1" class="status reviewing">审核中</text>
				<text v-else-if="realnameStatus == 4" class="status reviewing">人工复核</text>
				<text v-else-if="realnameStatus == 5" class="status rejected">已撤销</text>
				<view v-else class="action-pill" @tap="openStep('realname')"><text>去认证</text></view>
			</view>
		</view>

		<view v-if="activeStep == 'phone' && !phoneVerified" class="section-card form-card">
			<text class="section-title">绑定手机号</text>
			<text class="section-note">验证码仅用于绑定当前微信账号</text>
			<input class="field-input" type="number" maxlength="11" placeholder="请输入11位手机号" :value="phone" @input="onPhoneInput" />
			<view class="code-row">
				<input class="field-input code-input" type="number" maxlength="6" placeholder="请输入验证码" :value="smsCode" @input="onCodeInput" />
				<view class="code-button" :class="{ disabled: codeSending || countdown > 0 }" @tap="sendBindCode"><text>{{ codeButtonText }}</text></view>
			</view>
			<view class="primary-button" :class="{ disabled: binding }" @tap="confirmBindPhone"><text>{{ binding ? '绑定中…' : '确认绑定' }}</text></view>
		</view>

		<view v-if="activeStep == 'realname' && realnameStatus != 2" class="section-card form-card">
			<text class="section-title">实名认证</text>
			<text v-if="realnameStatus == 1 || realnameStatus == 4" class="review-tip">资料已提交，正在审核。审核通过后即可申请。</text>
			<template v-else>
				<text class="section-note">请填写本人真实姓名和有效身份证号</text>
				<input class="field-input" maxlength="64" placeholder="真实姓名" :value="realName" @input="onRealNameInput" />
				<input class="field-input" maxlength="18" placeholder="18位身份证号" :value="idCard" @input="onIdCardInput" />
				<view class="primary-button" :class="{ disabled: realnameSubmitting }" @tap="confirmRealname"><text>{{ realnameSubmitting ? '提交中…' : '提交实名认证' }}</text></view>
			</template>
		</view>

		<view v-if="returnTo != ''" class="return-link" @tap="backToApplication"><text>返回申请页面</text></view>
		<text class="footer-tip">认证状态以平台审核结果为准，不再使用本地演示状态。</text>
	</view>
</template>

<script setup lang="uts">
import { bindPhone, getMeProfile, sendSms, submitRealname } from '@/api'

const phoneVerified = ref(false)
const phoneMasked = ref('')
const realnameStatus = ref(0)
const activeStep = ref('')
const returnTo = ref('')
const phone = ref('')
const smsCode = ref('')
const realName = ref('')
const idCard = ref('')
const binding = ref(false)
const realnameSubmitting = ref(false)
const codeSending = ref(false)
const countdown = ref(0)

const completed = computed(() => (phoneVerified.value ? 1 : 0) + (realnameStatus.value == 2 ? 1 : 0))
const codeButtonText = computed(() => countdown.value > 0 ? countdown.value + '秒后重试' : (codeSending.value ? '发送中…' : '获取验证码'))
const realnameDescription = computed(() => {
	if (realnameStatus.value == 2) return '已通过平台实名认证'
	if (realnameStatus.value == 1) return '资料正在审核，请耐心等待'
	if (realnameStatus.value == 3) return '认证未通过，请重新提交'
	if (realnameStatus.value == 4) return '当前正在人工复核，请耐心等待'
	if (realnameStatus.value == 5) return '实名认证已撤销，请重新提交'
	return '填写本人真实身份信息后提交审核'
})

const messageOf = (res: any, fallback: string): string => res != null && res.message != null && String(res.message) != '' ? String(res.message) : fallback

const refreshStatus = async () => {
	const res = await getMeProfile()
	if (!res.success || res.data == null) return
	phoneVerified.value = res.data.phone_verified == true
	phoneMasked.value = res.data.phone_masked != null ? String(res.data.phone_masked) : ''
	realnameStatus.value = res.data.realname_status != null ? Number(res.data.realname_status) : 0
}

const openStep = (step: string) => { activeStep.value = step }
const onPhoneInput = (e: any) => { phone.value = e.detail.value }
const onCodeInput = (e: any) => { smsCode.value = e.detail.value }
const onRealNameInput = (e: any) => { realName.value = e.detail.value }
const onIdCardInput = (e: any) => { idCard.value = e.detail.value }

const startCountdown = () => {
	countdown.value = 60
	const timer = setInterval(() => {
		countdown.value -= 1
		if (countdown.value <= 0) clearInterval(timer)
	}, 1000)
}

const sendBindCode = async () => {
	if (codeSending.value || countdown.value > 0) return
	if (!/^1[3-9]\d{9}$/.test(phone.value.trim())) {
		uni.showToast({ title: '请输入正确的11位手机号', icon: 'none' })
		return
	}
	codeSending.value = true
	try {
		const res = await sendSms(phone.value.trim(), 'bind_phone')
		if (!res.success) {
			uni.showToast({ title: messageOf(res, '验证码发送失败'), icon: 'none' })
			return
		}
		startCountdown()
		uni.showToast({ title: '验证码已发送', icon: 'success' })
	} finally { codeSending.value = false }
}

const confirmBindPhone = async () => {
	if (binding.value) return
	if (!/^1[3-9]\d{9}$/.test(phone.value.trim()) || !/^\d{6}$/.test(smsCode.value.trim())) {
		uni.showToast({ title: '请填写手机号和6位验证码', icon: 'none' })
		return
	}
	binding.value = true
	try {
		const res = await bindPhone(phone.value.trim(), smsCode.value.trim())
		if (!res.success) {
			uni.showToast({ title: messageOf(res, '绑定失败'), icon: 'none' })
			return
		}
		uni.showToast({ title: '手机号已绑定', icon: 'success' })
		activeStep.value = 'realname'
		await refreshStatus()
	} finally { binding.value = false }
}

const confirmRealname = async () => {
	if (realnameSubmitting.value) return
	if (realName.value.trim().length < 2 || !/^[1-9]\d{5}(18|19|20)\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\d|3[01])\d{3}[0-9Xx]$/.test(idCard.value.trim())) {
		uni.showToast({ title: '请填写真实姓名和有效身份证号', icon: 'none' })
		return
	}
	realnameSubmitting.value = true
	try {
		const res = await submitRealname(realName.value.trim(), idCard.value.trim())
		if (!res.success) {
			uni.showToast({ title: messageOf(res, '提交失败'), icon: 'none' })
			return
		}
		realnameStatus.value = 1
		uni.showToast({ title: '已提交审核', icon: 'success' })
	} finally { realnameSubmitting.value = false }
}

const backToApplication = () => { uni.navigateBack() }

onLoad((options: any) => {
	if (options != null && options.focus != null) activeStep.value = String(options.focus)
	if (options != null && options.returnTo != null) returnTo.value = String(options.returnTo)
	refreshStatus()
})
onShow(() => { refreshStatus() })
</script>

<style scoped>
.page { min-height: 100vh; background-color: #FAF8F5; padding: 32rpx; box-sizing: border-box; }
.section-card { display: flex; flex-direction: column; gap: 28rpx; padding: 32rpx; background-color: #FFFFFF; border-radius: 32rpx; box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04); margin-bottom: 28rpx; }
.card-header { display: flex; flex-direction: row; justify-content: space-between; align-items: center; gap: 20rpx; }
.section-title { display: block; font-size: 32rpx; font-weight: 700; color: #1A1A1A; }
.section-note, .footer-tip { display: block; margin-top: 8rpx; font-size: 23rpx; color: #A0B0A2; line-height: 1.5; }
.progress-text { font-size: 25rpx; font-weight: 600; color: #E78A9A; white-space: nowrap; }
.cert-item { display: flex; flex-direction: row; align-items: center; gap: 20rpx; padding: 10rpx 0; }
.cert-icon-wrap { width: 76rpx; height: 76rpx; border-radius: 38rpx; background-color: #F8F2F3; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.cert-icon-wrap.cert-done { background-color: #E8F5EE; }
.cert-icon-text { font-size: 34rpx; }
.cert-text-wrap { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.cert-label { font-size: 28rpx; font-weight: 600; color: #1A1A1A; }
.cert-desc { font-size: 22rpx; color: #A0B0A2; }
.status { font-size: 24rpx; font-weight: 600; white-space: nowrap; }.passed { color: #5BAF80; }.reviewing { color: #D89B4A; }.rejected { color: #D85E78; }
.action-pill, .code-button { padding: 12rpx 22rpx; border-radius: 24rpx; background-color: #FCECEF; color: #D85E78; font-size: 24rpx; flex-shrink: 0; }
.form-card { gap: 22rpx; }.field-input { height: 84rpx; padding: 0 24rpx; border-radius: 16rpx; background-color: #FAF8F5; color: #1A1A1A; font-size: 27rpx; box-sizing: border-box; }
.code-row { display: flex; flex-direction: row; gap: 16rpx; align-items: center; }.code-input { flex: 1; }.code-button { min-width: 168rpx; text-align: center; }.disabled { opacity: 0.5; }
.primary-button { height: 88rpx; border-radius: 44rpx; background-color: #D85E78; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 29rpx; font-weight: 600; }
.review-tip { padding: 22rpx; border-radius: 16rpx; background-color: #FFF7E8; color: #B77C2D; font-size: 25rpx; line-height: 1.5; }
.return-link { padding: 18rpx; text-align: center; color: #D85E78; font-size: 27rpx; }.footer-tip { text-align: center; padding: 0 12rpx 48rpx; }
</style>
