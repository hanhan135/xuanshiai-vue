.mbti-tag-cloud text { position: absolute; font-weight: 500; }
.mbti-tag-cloud text:nth-child(1) { top: 16rpx; left: 4%; font-size: 22rpx; }
.mbti-tag-cloud text:nth-child(2) { top: 4rpx; right: 6%; font-size: 28rpx; }
.mbti-tag-cloud text:nth-child(3) { top: 62rpx; left: 38%; font-size: 34rpx; }
.mbti-tag-cloud text:nth-child(4) { right: 20%; bottom: 6rpx; font-size: 24rpx; }
.mbti-tag-cloud text:nth-child(5) { bottom: 18rpx; left: 16%; font-size: 20rpx; }
.mbti-balance-copy { margin: auto 0 24rpx; color: var(--muted); opacity: .78; font-family: var(--serif); font-size: 26rpx; font-weight: 400; letter-spacing: .18em; line-height: 1.8; text-align: center; }
.condition-panel { display: flex; flex-direction: column; gap: 0; padding-top: 4rpx; }
.condition-group { min-height: 112rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 24rpx; border-bottom: 1rpx solid var(--line); }
.condition-label { width: 176rpx; flex-shrink: 0; color: var(--ink); font-size: 24rpx; font-weight: 600; line-height: 1.45; }
.condition-control { min-width: 0; flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 14rpx; }
.location-row .condition-picker, .location-row .condition-add-picker { min-width: 0; flex: 1; }
.picker-value, .condition-add { width: 100%; min-height: 78rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 12rpx; padding: 0 18rpx; border: 1rpx solid transparent; border-radius: 20rpx; background: var(--canvas); color: var(--ink2); font-size: 22rpx; }
.condition-range-picker { min-width: 0; flex: 1; }
.range-control { position: relative; height: 68rpx; margin: 0 18rpx; }
.range-track, .range-active { position: absolute; top: 31rpx; right: 0; left: 0; height: 6rpx; border-radius: 999rpx; }
.range-track { background: var(--line); }
.range-active { background: var(--accent); }
.age-range { right: 14%; left: 18%; }
.full-range { right: 0; left: 0; }
