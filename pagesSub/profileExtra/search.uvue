<template>
	<view class="search-page">
		<view class="search-nav" :style="{ paddingTop: navTop + 'px', paddingRight: (menuButtonSpacing + 8) + 'px' }">
			<view class="nav-side" @tap="goBack"><text class="nav-back">‹</text></view>
			<text class="nav-title" :style="{ top: navTop + 'px' }">搜索</text>
			<view class="nav-side nav-history" @tap="historyVisible = true"><text>历史</text></view>
		</view>

		<view class="search-tabs" role="tablist">
			<view v-for="(tab, index) in tabs" :key="tab" class="search-tab" :class="{ active: activeTab === index }" @tap="activeTab = index"><text>{{ tab }}</text></view>
		</view>

		<scroll-view class="search-scroll" scroll-y enhanced show-scrollbar="false">
			<view v-if="activeTab === 0" class="search-panel ai-panel">
				<view class="ai-input-wrap">
					<textarea class="ai-input" :value="aiQuery" maxlength="300" :placeholder="aiPlaceholder" @input="onAiInput"></textarea>
					<view class="ai-input-foot"><view class="ai-template-trigger" @tap="requestAiSuggestedQuery"><text>猜你喜欢</text></view></view>
				</view>

				<view class="ai-filter-groups">
					<view class="ai-filter-row"><text class="filter-row-label">地域</text><scroll-view class="chip-scroll" :scroll-x="true" :show-scrollbar="false"><view v-for="item in regionOptions" :key="item" class="choice-chip ai-choice-chip" :class="{ selected: aiRegion === item }" @tap="aiRegion = item"><text>{{ item }}</text></view></scroll-view></view>
					<view class="ai-filter-row"><text class="filter-row-label">边界</text><scroll-view class="chip-scroll" :scroll-x="true" :show-scrollbar="false"><view v-for="item in boundaryOptions" :key="item" class="choice-chip ai-choice-chip" :class="{ selected: aiBoundary === item }" @tap="aiBoundary = item"><text>{{ item }}</text></view></scroll-view></view>
					<view class="ai-filter-row"><text class="filter-row-label">兴趣</text><scroll-view class="chip-scroll" :scroll-x="true" :show-scrollbar="false"><view v-for="item in interestOptions" :key="item" class="choice-chip ai-choice-chip" :class="{ selected: aiInterests.indexOf(item) >= 0 }" @tap="toggleInterest(item)"><text>{{ item }}</text></view></scroll-view></view>
				</view>
			</view>

			<view v-else-if="activeTab === 1" class="search-panel mbti-panel">
				<view class="personality-card" @tap="openSelfSheet">
					<text class="personality-label">我是</text>
					<text class="personality-value">{{ ownMbtiSummary }}</text>
					<text class="personality-note">{{ ownMbtiNote }}</text>
					<text class="personality-arrow">›</text>
				</view>
				<view class="personality-card seeking-card" @tap="openTargetSheet">
					<text class="personality-label">寻找</text>
					<text class="personality-value">理想的人格类型</text>
					<view v-if="targetMbtis.length > 0" class="selected-mbti-tags"><XsaTag v-for="item in targetMbtis" :key="item" variant="accent" size="small">{{ item }}</XsaTag></view>
					<text v-else class="personality-note">点击选择</text>
					<text class="personality-arrow">›</text>
				</view>
				<view class="mbti-tag-cloud"><text>INTJ</text><text>ENFP</text><text>INFJ</text><text>ENTP</text><text>ISFJ</text></view>
				<text class="mbti-balance-copy">同频的人，终会相遇</text>
			</view>

			<view v-else class="search-panel condition-panel">
				<view class="condition-group">
					<text class="condition-label">居住地偏好</text>
					<view class="condition-control location-row"><picker class="condition-picker" mode="selector" :range="residenceOptions" :value="residenceIndex" @change="onResidenceChange"><view class="picker-value"><text>{{ residenceOptions[residenceIndex] }}</text><text>⌄</text></view></picker><picker class="condition-add-picker" mode="selector" :range="residenceOptions" :value="residenceIndex" @change="onResidenceChange"><view class="condition-add"><text>＋ 添加</text></view></picker></view>
				</view>
				<view class="condition-group">
					<text class="condition-label">年龄偏好 {{ ageOptions[ageIndex] }}</text>
					<picker class="condition-range-picker" mode="selector" :range="ageOptions" :value="ageIndex" @change="onAgeChange"><view class="range-control"><view class="range-track"></view><view class="range-active age-range"></view><view class="range-handle range-start"></view><view class="range-handle range-end"></view></view></picker>
				</view>
				<view class="condition-group condition-toggle-group">
					<view class="condition-toggle-copy"><text class="condition-label">仅认证用户</text><text class="condition-help">优先展示已认证资料</text></view>
					<button class="condition-toggle" :class="{ active: certificationOnly }" @tap="certificationOnly = !certificationOnly"><view class="toggle-knob"></view></button>
				</view>

				<view class="advanced-heading"><text class="condition-label">高级筛选</text><text class="vip-badge">VIP</text></view>
				<view class="vip-line"><text class="vip-badge small">会员专享</text><text>开通会员后可使用更多筛选条件</text></view>
				<view class="condition-group vip-condition-group">
					<text class="condition-label">身高偏好 {{ heightOptions[heightIndex] }}</text>
					<picker class="condition-range-picker" mode="selector" :range="heightOptions" :value="heightIndex" @change="onHeightChange"><view class="range-control"><view class="range-track"></view><view class="range-active full-range"></view><view class="range-handle full-start"></view><view class="range-handle full-end"></view></view></picker>
				</view>
				<view class="condition-group vip-condition-group">
					<text class="condition-label">收入偏好（年）</text>
					<view class="condition-choice-grid income-grid"><view v-for="item in incomeOptions" :key="item" class="choice-chip" :class="{ selected: income === item }" @tap="income = item"><text>{{ item }}</text></view></view>
				</view>
				<view class="condition-group vip-condition-group">
					<text class="condition-label">家乡偏好</text>
					<picker class="wide-condition-picker" mode="selector" :range="hometownOptions" :value="hometownIndex" @change="onHometownChange"><view class="wide-picker-value"><text>{{ hometownOptions[hometownIndex] }}</text><text>›</text></view></picker>
				</view>
				<view class="condition-group vip-condition-group">
					<text class="condition-label">学历偏好</text>
					<view class="condition-choice-grid education-grid"><view v-for="item in educationOptions" :key="item" class="choice-chip" :class="{ selected: education === item }" @tap="education = item"><text>{{ item }}</text></view></view>
				</view>
				<view class="condition-group vip-condition-group">
					<text class="condition-label">婚况偏好</text>
					<view class="condition-choice-grid marriage-grid"><view v-for="item in marriageOptions" :key="item" class="choice-chip" :class="{ selected: marriage === item }" @tap="marriage = item"><text>{{ item }}</text></view></view>
				</view>
			</view>
		</scroll-view>

		<view class="bottom-actions">
			<button v-if="activeTab === 2" class="reset-button" @tap="resetCondition"><text>重置</text></button>
			<button class="search-button" :class="{ wide: activeTab !== 2 }" @tap="submitSearch"><text>开始搜索</text></button>
		</view>

		<XsaSheet :visible="historyVisible" title="搜索历史" @close="historyVisible = false"><view class="history-list"><view v-if="historyItems.length === 0" class="history-empty"><text>暂无搜索历史</text></view><view v-for="item in historyItems" :key="item.id" class="history-item" @tap="applyHistory(item)"><text>{{ item.label }}</text></view></view></XsaSheet>

		<XsaSheet :visible="mbtiSheetVisible" :title="mbtiSheetMode === 'self' ? '我的 MBTI' : '寻找的人格类型'" @close="closeMbtiSheet">
			<view v-if="mbtiSheetMode === 'self'" class="self-sheet-content"><text class="sheet-copy">可以先完成测评，也可以直接输入已知类型。</text><button class="sheet-secondary-button" @tap="showTestPending"><text>去测评</text></button><view class="manual-mbti-row"><input class="mbti-input" :value="ownMbtiDraft" maxlength="4" placeholder="输入 16 型，如 ENTP" @input="onOwnMbtiInput" /><button class="sheet-save-button" :disabled="savingOwnMbti" @tap="saveOwnMbti"><text>{{ savingOwnMbti ? '保存中' : '确定' }}</text></button></view></view>
			<view v-else class="target-sheet-content"><view class="sheet-selection-head"><text>{{ activeTrait || '轻触人格类型，查看相处标签' }}</text><text class="sheet-limit">最多 5 个</text></view><view class="mbti-grid"><button v-for="item in mbtiTypes" :key="item.code" class="mbti-type-button" :class="{ selected: targetMbtis.indexOf(item.code) >= 0 }" @tap="toggleTargetMbti(item.code, item.trait)"><text>{{ item.code }}</text></button></view><view class="sheet-selected-tags"><XsaTag v-for="item in targetMbtis" :key="item" variant="accent" size="small">{{ item }}</XsaTag><text v-if="targetMbtis.length === 0" class="sheet-empty-text">尚未选择</text></view><button class="sheet-primary-button" @tap="closeMbtiSheet"><text>完成选择</text></button></view>
		</XsaSheet>
	</view>
</template>

<script setup lang="uts">
	import XsaSheet from '@/components/XsaSheet.uvue'
	import XsaTag from '@/components/XsaTag.uvue'
	import { getOwnProfile, updateOwnProfile } from '@/api'

	const systemInfo = uni.getSystemInfoSync()
	const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
	const menuButtonInfo = uni.getMenuButtonBoundingClientRect()
	const navTop = menuButtonInfo != null && menuButtonInfo.top > statusBarHeight ? menuButtonInfo.top : statusBarHeight + 12
	const menuButtonSpacing = menuButtonInfo != null ? (systemInfo.windowWidth - menuButtonInfo.left) : 8

	const tabs = ['AI', 'MBTI', '条件搜索']
	const SEARCH_HISTORY_STORAGE_KEY = 'xsa_search_history_v1'
	const activeTab = ref(0)
	const historyVisible = ref(false)
	const historyItems = ref<any[]>([])

	const aiQuery = ref('')
	const regionOptions = ['同城优先', '全市范围', '不限距离']
	const boundaryOptions = ['独立私人空间', '高频互动陪伴', '适度黏连']
	const interestOptions = ['文艺艺术', '户外运动', '游戏数码', '美食旅行', '阅读学习']
	const aiRegion = ref('同城优先')
	const aiBoundary = ref('')
	const aiInterests = ref<string[]>([])

	const hometownOptions = ['不限', '江苏', '浙江', '上海', '安徽']
	const residenceOptions = ['不限', '南京', '杭州', '上海', '深圳']
	const ageOptions = ['不限年龄', '18-25 岁', '26-30 岁', '31-35 岁', '36-40 岁', '41 岁以上']
	const heightOptions = ['不限身高', '150-160cm', '161-170cm', '171-180cm', '181cm 以上']
	const incomeOptions = ['5w-15w', '15w-30w', '30w-50w', '50w-100w', '100w-500w', '500w以上']
	const educationOptions = ['大专', '本科', '硕士研究生', '博士研究生']
	const marriageOptions = ['未婚', '离异']
	const hometownIndex = ref(0)
	const residenceIndex = ref(0)
	const ageIndex = ref(0)
	const heightIndex = ref(0)
	const income = ref('')
	const education = ref('')
	const marriage = ref('')
	const certificationOnly = ref(true)

	const mbtiSheetVisible = ref(false)
	const mbtiSheetMode = ref('self')
	const ownMbti = ref('')
	const ownMbtiDraft = ref('')
	const ownGender = ref<any>(null)
	const savingOwnMbti = ref(false)
	const targetMbtis = ref<string[]>([])
	const activeTrait = ref('')
	const mbtiTypes = [
		{ code: 'INTJ', trait: 'INTJ 理性搭档' }, { code: 'INTP', trait: 'INTP 好奇探索' }, { code: 'ENTJ', trait: 'ENTJ 目标同行' }, { code: 'ENTP', trait: 'ENTP 思维碰撞' },
		{ code: 'INFJ', trait: 'INFJ 灵魂知己' }, { code: 'INFP', trait: 'INFP 温柔治愈' }, { code: 'ENFJ', trait: 'ENFJ 共情支持' }, { code: 'ENFP', trait: 'ENFP 热情灵感' },
		{ code: 'ISTJ', trait: 'ISTJ 稳定靠谱' }, { code: 'ISFJ', trait: 'ISFJ 细腻守护' }, { code: 'ESTJ', trait: 'ESTJ 执行默契' }, { code: 'ESFJ', trait: 'ESFJ 温暖联结' },
		{ code: 'ISTP', trait: 'ISTP 自在相处' }, { code: 'ISFP', trait: 'ISFP 感受共鸣' }, { code: 'ESTP', trait: 'ESTP 活力同游' }, { code: 'ESFP', trait: 'ESFP 快乐分享' }
	]
	const mbtiNames: any = { INTJ: '建筑师', INTP: '逻辑学家', ENTJ: '指挥官', ENTP: '辩论家', INFJ: '提倡者', INFP: '调停者', ENFJ: '主人公', ENFP: '竞选者', ISTJ: '物流师', ISFJ: '守卫者', ESTJ: '总经理', ESFJ: '执政官', ISTP: '鉴赏家', ISFP: '探险家', ESTP: '企业家', ESFP: '表演者' }
	const ownMbtiSummary = computed(() => ownMbti.value == '' ? '还未设置' : ownMbti.value + ' ' + (mbtiNames[ownMbti.value] != null ? mbtiNames[ownMbti.value] : ''))
	const ownMbtiNote = computed(() => ownMbti.value == '' ? '点击选择我的 MBTI' : '已保存，可随时调整')

	const toText = (value: any): string => value == null ? '' : ('' + value)
	const aiTargetPronoun = computed(() => {
		const gender = toText(ownGender.value).toLowerCase()
		return ownGender.value == 2 || gender == '2' || gender == '女' || gender == 'female' ? '他' : '她'
	})
	const aiPlaceholder = computed(() => '你希望遇见什么样的' + aiTargetPronoun.value + '，一起体验往后的点点滴滴？')
	const validIndex = (value: any, length: number): number => {
		const index = Number(value)
		return index >= 0 && index < length ? index : 0
	}
	const profilePayload = (raw: any): any => raw != null && raw.profile != null ? raw.profile : (raw != null && raw.data != null && raw.data.profile != null ? raw.data.profile : (raw != null ? raw : {}))
	const loadOwnMbti = async () => {
		try {
			const res = await getOwnProfile()
			if (res.success && res.data != null) {
				const data = profilePayload(res.data)
				ownGender.value = data.gender
				const value = toText(data.mbti).toUpperCase()
				if (mbtiNames[value] != null) ownMbti.value = value
			}
		} catch (error) {
			console.error('[Search] own MBTI load failed', error)
		}
	}

	const goBack = () => uni.navigateBack({ delta: 1 })
	const onAiInput = (event: any) => { aiQuery.value = toText(event.detail.value) }
	const requestAiSuggestedQuery = () => {
		// TODO: 接入 AI 档案分析后，将生成的搜索词回填到 aiQuery。
		uni.showToast({ title: 'AI 推荐功能待接入', icon: 'none' })
	}
	const toggleInterest = (item: string) => {
		const next = aiInterests.value.slice()
		const index = next.indexOf(item)
		if (index >= 0) next.splice(index, 1)
		else next.push(item)
		aiInterests.value = next
	}
	const onHometownChange = (event: any) => { hometownIndex.value = Number(event.detail.value) }
	const onResidenceChange = (event: any) => { residenceIndex.value = Number(event.detail.value) }
	const onAgeChange = (event: any) => { ageIndex.value = Number(event.detail.value) }
	const onHeightChange = (event: any) => { heightIndex.value = Number(event.detail.value) }
	const resetCondition = () => { hometownIndex.value = 0; residenceIndex.value = 0; ageIndex.value = 0; heightIndex.value = 0; income.value = ''; education.value = ''; marriage.value = ''; certificationOnly.value = false }
	const loadHistory = () => {
		try {
			const stored = uni.getStorageSync(SEARCH_HISTORY_STORAGE_KEY)
			if (Array.isArray(stored)) historyItems.value = stored as any[]
		} catch (error) {
			console.error('[Search] history load failed', error)
		}
	}
	const buildHistoryRecord = (): any => {
		const record: any = {
			id: '' + Date.now(),
			tab: activeTab.value,
			label: '',
			aiQuery: aiQuery.value,
			aiRegion: aiRegion.value,
			aiBoundary: aiBoundary.value,
			aiInterests: aiInterests.value.slice(),
			targetMbtis: targetMbtis.value.slice(),
			hometownIndex: hometownIndex.value,
			residenceIndex: residenceIndex.value,
			ageIndex: ageIndex.value,
			heightIndex: heightIndex.value,
			income: income.value,
			education: education.value,
			marriage: marriage.value,
			certificationOnly: certificationOnly.value
		}
		if (record.tab == 0) record.label = `AI：${aiQuery.value.trim()}`
		else if (record.tab == 1) record.label = `MBTI：${targetMbtis.value.join(' / ')}`
		else record.label = `条件：${residenceOptions[residenceIndex.value]}，${ageOptions[ageIndex.value]}`
		return record
	}
	const saveHistory = (record: any) => {
		const next: any[] = []
		for (let index = 0; index < historyItems.value.length; index++) {
			const item = historyItems.value[index]
			if (item != null && item.label != record.label) next.push(item)
		}
		next.unshift(record)
		if (next.length > 10) next.splice(10)
		historyItems.value = next
		try {
			uni.setStorageSync(SEARCH_HISTORY_STORAGE_KEY, next)
		} catch (error) {
			console.error('[Search] history save failed', error)
		}
	}
	const submitSearch = () => {
		if (activeTab.value == 0 && aiQuery.value.trim() == '') { uni.showToast({ title: '先写一句你的理想型', icon: 'none' }); return }
		if (activeTab.value == 1 && targetMbtis.value.length == 0) { uni.showToast({ title: '请先选择对方类型', icon: 'none' }); return }
		saveHistory(buildHistoryRecord())
		uni.showToast({ title: '搜索结果页待接入', icon: 'none' })
	}
	const applyHistory = (item: any) => {
		const tab = Number(item != null ? item.tab : 0)
		if (tab == 1) {
			if (Array.isArray(item.targetMbtis)) targetMbtis.value = item.targetMbtis as string[]
			else targetMbtis.value = []
		} else if (tab == 2) {
			hometownIndex.value = validIndex(item.hometownIndex, hometownOptions.length)
			residenceIndex.value = validIndex(item.residenceIndex, residenceOptions.length)
			ageIndex.value = validIndex(item.ageIndex, ageOptions.length)
			heightIndex.value = validIndex(item.heightIndex, heightOptions.length)
			income.value = toText(item.income)
			education.value = toText(item.education)
			marriage.value = toText(item.marriage)
			certificationOnly.value = item.certificationOnly == true
		} else {
			aiQuery.value = toText(item.aiQuery)
			aiRegion.value = toText(item.aiRegion) || regionOptions[0]
			aiBoundary.value = toText(item.aiBoundary)
			if (Array.isArray(item.aiInterests)) aiInterests.value = item.aiInterests as string[]
			else aiInterests.value = []
		}
		activeTab.value = tab >= 0 && tab <= 2 ? tab : 0
		historyVisible.value = false
	}

	const openSelfSheet = () => { ownMbtiDraft.value = ownMbti.value; mbtiSheetMode.value = 'self'; mbtiSheetVisible.value = true }
	const openTargetSheet = () => { activeTrait.value = ''; mbtiSheetMode.value = 'target'; mbtiSheetVisible.value = true }
	const closeMbtiSheet = () => { mbtiSheetVisible.value = false }
	const onOwnMbtiInput = (event: any) => { ownMbtiDraft.value = toText(event.detail.value).toUpperCase() }
	const showTestPending = () => uni.showToast({ title: 'MBTI 测评页面待接入', icon: 'none' })
	const saveOwnMbti = async () => {
		const value = ownMbtiDraft.value.trim().toUpperCase()
		if (mbtiNames[value] == null) { uni.showToast({ title: '请输入 16 型 MBTI，例如 ENTP', icon: 'none' }); return }
		savingOwnMbti.value = true
		try {
			const res = await updateOwnProfile({ mbti: value })
			if (!res.success) { uni.showToast({ title: res.message != null ? toText(res.message) : '保存失败，请重试', icon: 'none' }); return }
			ownMbti.value = value
			closeMbtiSheet()
			uni.showToast({ title: '已保存我的 MBTI', icon: 'success' })
		} catch (error) {
			console.error('[Search] own MBTI save failed', error)
			uni.showToast({ title: '网络不可用，请重试', icon: 'none' })
		} finally {
			savingOwnMbti.value = false
		}
	}
	const toggleTargetMbti = (code: string, trait: string) => {
		const next = targetMbtis.value.slice()
		const index = next.indexOf(code)
		if (index >= 0) next.splice(index, 1)
		else {
			if (next.length >= 5) { uni.showToast({ title: '最多选择 5 个', icon: 'none' }); return }
			next.push(code)
		}
		targetMbtis.value = next
		activeTrait.value = trait
	}

	onMounted(() => { loadOwnMbti(); loadHistory() })
</script>

<style scoped>
.search-page { height: 100vh; display: flex; flex-direction: column; background: var(--paper); color: var(--ink); --accent: var(--action-warm-green); --accent2: var(--action-warm-green-ink); --accent-bg: var(--action-warm-green-soft); --soft: var(--action-warm-green); }
.search-nav { position: relative; flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; padding: 0 40rpx 18rpx; }
.nav-side { z-index: 1; width: 68rpx; height: 68rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface); color: var(--ink2); font-size: 23rpx; }
.nav-history { margin-left: auto; color: var(--accent2); }
.nav-back { font-size: 52rpx; line-height: 1; font-weight: 300; }
.nav-title { position: absolute; right: 0; left: 0; height: 68rpx; font-family: var(--serif); font-size: 42rpx; font-weight: 700; line-height: 68rpx; text-align: center; }
.search-tabs { flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 60rpx; padding: 8rpx 40rpx 20rpx; }
.search-tab { padding: 12rpx 0; color: var(--muted); font-size: 30rpx; }
.search-tab.active { color: var(--ink); font-weight: 700; }
.search-scroll { flex: 1; min-height: 0; touch-action: pan-y; }
.search-panel { min-height: 100%; padding: 24rpx 40rpx 40rpx; box-sizing: border-box; }
.ai-panel { display: flex; flex-direction: column; }
.ai-input-wrap { padding: 24rpx; border: 1rpx solid var(--line); border-radius: 32rpx; background: var(--canvas); }
.ai-input { width: 100%; height: 300rpx; padding: 0; border: 0; background: transparent; color: var(--ink); font-family: var(--sans); font-size: 28rpx; line-height: 1.75; }
.ai-input-foot { display: flex; flex-direction: row; align-items: center; justify-content: flex-end; min-height: 44rpx; }
