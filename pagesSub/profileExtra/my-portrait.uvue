	background: var(--at-card); border: 1px solid var(--at-line); border-radius: 16px;
}
.at-gate-row { display: flex; flex-direction: row; align-items: flex-start; gap: 10px; }
.at-gate-row-icon { font-size: 12px; color: var(--at-honey); margin-top: 2px; }
.at-gate-row-text { flex: 1; font-size: 13px; color: var(--at-ink2); line-height: 1.7; }
.at-gate-msg { font-size: 12px; color: var(--at-danger); margin-top: 12px; }
.at-gate-btn {
	margin-top: 26px; padding: 13px 0; border-radius: 999px;
	background: var(--at-amber-deep); display: flex; align-items: center; justify-content: center;
}
.at-gate-btn-busy { opacity: 0.6; }
.at-gate-btn-text { font-size: 15px; font-weight: 700; color: #FFF6E8; }
.at-gate-skip { margin-top: 14px; display: flex; align-items: center; justify-content: center; padding: 10px 0; }
.at-gate-skip-text { font-size: 13px; color: var(--at-ink2); }

/* ===== 墨案 ===== */
.at-shelf { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 22px 20px 40px; }
/* 入场:墨案在铺纸后缓缓落定(仅 transform/opacity,失败不挡信息) */
.at-shelf-head { display: flex; flex-direction: column; align-items: center; animation: at-shelf-enter 0.5s ease-out both; }
.at-shelf-intro { font-size: 23px; font-weight: 700; color: var(--at-ink); font-family: var(--serif); text-align: center; letter-spacing: -0.01em; }
.at-shelf-intro2 { font-size: 13px; color: var(--at-ink2); margin-top: 10px; text-align: center; font-family: var(--serif); line-height: 1.7; }
.at-bottles {
	display: flex; flex-direction: row; justify-content: center; gap: 14px;
	margin-top: 30px; padding: 26px 18px 22px;
	background: var(--at-card); border: 1px solid var(--at-line); border-radius: 20px;
	align-self: stretch;
	box-shadow: 0 2px 16px rgba(46, 36, 24, 0.05);
	animation: at-shelf-enter 0.5s ease-out 0.08s both;
}
.at-bottle-hit { flex: 1; display: flex; flex-direction: column; align-items: center; }
.at-shelf-note {
	margin-top: 18px; padding: 5px 14px; border-radius: 999px; background: rgba(230, 218, 196, 0.4);
	animation: at-shelf-enter 0.5s ease-out 0.16s both;
}
.at-shelf-note-text { font-size: 11px; color: var(--at-ink2); }
.at-shelf-insight {
	margin-top: 26px; padding: 16px 18px; border-radius: 16px;
	background: var(--at-card); border: 1px solid var(--at-line); align-self: stretch;
	animation: at-shelf-enter 0.5s ease-out 0.24s both;
}
.at-shelf-insight-label { font-size: 11px; color: var(--at-amber-deep); font-weight: 700; }
.at-shelf-insight-text { font-size: 14px; color: var(--at-ink); line-height: 1.7; margin-top: 8px; font-family: var(--serif); }
.at-shelf-insight-more { font-size: 12px; color: var(--at-amber-deep); font-weight: 600; margin-top: 10px; }
@keyframes at-shelf-enter {
	from { transform: translateY(10px); opacity: 0; }
	to { transform: translateY(0); opacity: 1; }
}

/* ===== 主体子导航 ===== */
.at-subject { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.at-subject-bar {
	display: flex; flex-direction: row; align-items: center; justify-content: space-between;
	padding: 6px 12px; background: var(--at-bg);
}
