}
/* 成稿朱印:右上角小印,呼应 PersonaBottle 的"成" */
.at-letter-seal {
	position: absolute; top: 14px; right: 2px;
	width: 28px; height: 28px; border-radius: 3px;
	background: radial-gradient(circle at 40% 35%, #C97B57, #A05A3E);
