<template>
	<view class="persona-root">
			<!-- 顶部导航 -->
			<view class="at-nav" :style="{ paddingTop: navPadTop + 'px', paddingRight: (menuButtonSpacing + 8) + 'px' }">
				<view class="at-nav-side at-nav-back" @tap="navBack">
					<text class="at-back">‹</text>
				</view>
				<text class="at-nav-title" :style="{ top: navPadTop + 'px' }">{{ navTitle }}</text>
				<view class="at-nav-side at-nav-actions">
					<text v-if="viewMode == 'subject'" class="at-nav-action" @tap="manageVisible = true">⋯</text>
				</view>
			</view>

		<!-- 功能门禁关闭 -->
		<view v-if="featureDisabled" class="at-state">
			<view class="at-state-mark"><text class="at-state-mark-text">墨</text></view>
			<text class="at-state-title">墨相暂时不可用</text>
			<text class="at-state-copy">AI 画像功能当前不可用。你可以先完善资料,稍后再来。</text>
			<view class="at-state-btn" @tap="goEditProfile">
				<text class="at-state-btn-text">去编辑资料</text>
			</view>
		</view>

		<!-- 授权门槛 -->
		<view v-else-if="consentRequired" class="at-gate">
			<text class="at-gate-title">使用前需要授权</text>
			<text class="at-gate-sub">需要你授权 AI 理解你确认过的话</text>
			<view class="at-gate-card">
				<view class="at-gate-row">
					<text class="at-gate-row-icon">✦</text>
					<text class="at-gate-row-text">你口述或书写,AI 提出它的理解,并附上你说的原话</text>
				</view>
				<view class="at-gate-row">
					<text class="at-gate-row-icon">✦</text>
					<text class="at-gate-row-text">每一条由你决定:确认、修改、否定或移出</text>
				</view>
				<view class="at-gate-row">
					<text class="at-gate-row-icon">✦</text>
					<text class="at-gate-row-text">AI 只能写入十个画像字段,认证信息永远不由 AI 修改</text>
				</view>
				<view class="at-gate-row">
					<text class="at-gate-row-icon">✦</text>
					<text class="at-gate-row-text">你可以随时删除画像、撤回授权,数据将异步清理</text>
				</view>
			</view>
			<text v-if="consentMessage != ''" class="at-gate-msg">{{ consentMessage }}</text>
			<view class="at-gate-btn" :class="{ 'at-gate-btn-busy': granting }" @tap="doGrantConsent">
				<text class="at-gate-btn-text">{{ granting ? '授权中...' : '授权并开始' }}</text>
			</view>
			<view class="at-gate-skip" @tap="navBack">
				<text class="at-gate-skip-text">暂不授权</text>
			</view>
		</view>

		<!-- 加载态 -->
		<view v-else-if="loading" class="at-state">
			<view class="at-loading-steam">
				<view class="at-steam-dot at-steam-dot-1"></view>
				<view class="at-steam-dot at-steam-dot-2"></view>
				<view class="at-steam-dot at-steam-dot-3"></view>
			</view>
			<text class="at-state-title">正在铺开纸面</text>
		</view>

		<!-- ===== 墨案(首页) ===== -->
		<view v-else-if="viewMode == 'shelf'" class="at-shelf">
			<view class="at-shelf-head">
				<text class="at-shelf-intro">每个人都有一副自己的样子。</text>
				<text class="at-shelf-intro2">说说你自己,AI 帮你落成可以确认的一笔。</text>
			</view>

			<view class="at-bottles">
				<view class="at-bottle-hit" @tap="enterSubject('personal')">
					<PersonaBottle
						:state="bottleState('personal')"
						variant="me"
						:fill="bottleFill('personal')"
						:title="bottleTitle('personal')"
						:sub="bottleSub('personal')"
						:hasChange="bottleHasChange('personal')"
						:active="subject == 'personal'"
						:footNote="bottleFootNote('personal')"
						:changeText="bottleChangeText('personal')"
					/>
				</view>
				<view class="at-bottle-hit" @tap="enterSubject('ideal_partner')">
					<PersonaBottle
						:state="bottleState('ideal_partner')"
						variant="ta"
						:fill="bottleFill('ideal_partner')"
						:title="bottleTitle('ideal_partner')"
						:sub="bottleSub('ideal_partner')"
						:hasChange="bottleHasChange('ideal_partner')"
						:active="subject == 'ideal_partner'"
						:footNote="bottleFootNote('ideal_partner')"
						:changeText="bottleChangeText('ideal_partner')"
					/>
				</view>
			</view>

			<view class="at-shelf-note">
				<text class="at-shelf-note-text">AI 只整理你确认过的话 · 十个画像字段 · 随时删除</text>
			</view>

			<!-- 理解预览 -->
			<view v-if="insightPreview != ''" class="at-shelf-insight" @tap="openInsightSubject">
				<text class="at-shelf-insight-label">{{ insightPreviewLabel }} · AI 的理解</text>
				<text class="at-shelf-insight-text">{{ insightPreview }}</text>
				<text class="at-shelf-insight-more">查看成稿 ›</text>
			</view>
		</view>

		<!-- ===== 主体空间 ===== -->
		<view v-else class="at-subject">
			<!-- 主体子导航 -->
			<view class="at-subject-bar">
				<view class="at-subject-back" @tap="backToShelf">
					<text class="at-subject-back-text">‹ 墨案</text>
				</view>
				<view class="at-seg">
					<view class="at-seg-item" :class="{ 'at-seg-active': subjectPane == 'letter' }" @tap="switchPane('letter')">
						<text class="at-seg-text" :class="{ 'at-seg-text-active': subjectPane == 'letter' }">成稿</text>
					</view>
					<view class="at-seg-item" :class="{ 'at-seg-active': subjectPane == 'dialog' }" @tap="switchPane('dialog')">
						<text class="at-seg-text" :class="{ 'at-seg-text-active': subjectPane == 'dialog' }">落笔</text>
					</view>
				</view>
				<view class="at-subject-bar-side"></view>
			</view>

			<!-- ===== 成稿(成品叙事) ===== -->
				<scroll-view v-if="subjectPane == 'letter'" scroll-y class="at-letter" enhanced :show-scrollbar="false">
					<view class="at-progress at-progress-letter">
						<view class="at-progress-track">
							<view class="at-progress-fill" :style="{ width: progressPercent + '%' }"></view>
						</view>
						<text class="at-progress-text">{{ progressLabel }}</text>
					</view>
					<view v-if="letterReady" class="at-letter-body">
					<view class="at-letter-paper">
						<view class="at-letter-head">
						<text class="at-letter-title">{{ narrative != null && narrative.persona_title != null ? narrative.persona_title : '' }}</text>
						<view v-if="letterTags.length > 0" class="at-letter-tags">
							<text v-for="tag in letterTags" :key="tag" class="at-letter-tag">{{ tag }}</text>
						</view>
						<!-- 成稿朱印:DESIGN.md 规定"已写成稿后出现朱文小印" -->
						<view class="at-letter-seal">
							<text class="at-letter-seal-text">成</text>
						</view>
					</view>

					<view v-if="letterInsight != ''" class="at-letter-block">
						<text class="at-block-label">AI 的理解</text>
						<text class="at-block-serif">{{ letterInsight }}</text>
					</view>

					<!-- 结构(dimensions) -->
					<view v-if="letterDimensions.length > 0" class="at-letter-block">
						<text class="at-block-label">结构</text>
						<view v-for="dim in letterDimensions" :key="dim.key" class="at-dim-row">
							<text class="at-dim-icon at-ic" :class="dim.iconClass"></text>
							<view class="at-dim-main">
								<text class="at-dim-title">{{ dim.title }}</text>
								<text class="at-dim-summary">{{ dim.summary }}</text>
							</view>
						</view>
					</view>

					<!-- 期许配比(ideal_weights,仅愿遇之相) -->
					<view v-if="letterWeights.length > 0" class="at-letter-block">
						<text class="at-block-label">你在意的配比</text>
						<view v-for="w in letterWeights" :key="w.key" class="at-weight-row">
							<text class="at-weight-label">{{ w.label }}</text>
							<view class="at-weight-track">
								<view class="at-weight-fill" :style="{ width: w.percent + '%' }"></view>
							</view>
							<text class="at-weight-percent">{{ w.percent }}%</text>
						</view>
					</view>

					<!-- 新的一笔(recent_change) -->
					<view v-if="letterRecentChange != null" class="at-letter-block at-change-block">
						<text class="at-block-label">新的一笔</text>
						<text class="at-change-summary">{{ letterRecentChange.direction == 'up' ? '↑' : '↓' }} {{ letterRecentChange.summary }}</text>
						<text class="at-change-obs">{{ letterRecentChange.observation }}</text>
					</view>

					<!-- 收束(conclusion) -->
					<view v-if="letterConclusion != ''" class="at-letter-block at-conclusion-block">
						<text class="at-block-label">收束</text>
						<text class="at-block-serif">{{ letterConclusion }}</text>
					</view>

					<view class="at-letter-actions">
						<view class="at-letter-btn at-letter-btn-main" @tap="continueExpressing">
							<text class="at-letter-btn-main-text">继续说,补全这一幅</text>
						</view>
						<view class="at-letter-btn" @tap="openBatch">
							<text class="at-letter-btn-text">往稿</text>
						</view>
					</view>
					<view class="at-letter-foot-space"></view>
					</view>
				</view>

				<!-- 成稿未就绪(pending / 空) -->
				<view v-else class="at-letter-pending">
					<view v-if="hasBottledBefore" class="at-curing-panel">
						<view class="at-curing-steam">
							<view class="at-steam-dot at-steam-dot-1"></view>
							<view class="at-steam-dot at-steam-dot-2"></view>
							<view class="at-steam-dot at-steam-dot-3"></view>
						</view>
						<text class="at-curing-title">正在写下理解</text>
						<text class="at-curing-sub">这一稿已经写下,AI 正在整理对你的理解。通常需要一点时间。</text>
						<view class="at-curing-actions">
							<view class="at-curing-btn" @tap="refreshNarrativeNow">
								<text class="at-curing-btn-text">刷新理解</text>
							</view>
							<view class="at-curing-btn at-curing-btn-plain" @tap="switchPane('dialog')">
								<text class="at-curing-btn-plain-text">回到落笔</text>
							</view>
						</view>
					</view>
					<view v-else class="at-curing-panel">
						<text class="at-curing-title">这篇还没有成稿</text>
						<text class="at-curing-sub">先去落笔,确认足够的字段并写下成稿后,这里会留下 AI 对你的理解。</text>
						<view class="at-curing-actions">
							<view class="at-curing-btn" @tap="switchPane('dialog')">
								<text class="at-curing-btn-text">去落笔</text>
							</view>
						</view>
					</view>
				</view>
			</scroll-view>

			<!-- ===== 落笔(对话) ===== -->
			<view v-else class="at-dialog">
				<!-- 本次会话进度(仅代表本次落笔,不是长期"理解度") -->
				<view class="at-progress">
					<view class="at-progress-track">
						<view class="at-progress-fill" :style="{ width: progressPercent + '%' }"></view>
					</view>
					<text class="at-progress-text">{{ progressLabel }}</text>
					<view v-if="session != null && !extracting && !publishing" class="at-pause" @tap="togglePause">
						<text class="at-pause-text">{{ paused ? '继续' : '暂存' }}</text>
					</view>
				</view>

				<!-- 对话流 -->
				<scroll-view scroll-y class="at-flow" enhanced :show-scrollbar="false" :scroll-into-view="scrollAnchor">
					<view v-if="messages.length == 0 && session == null" class="at-empty">
						<text class="at-empty-title">还没有开始落笔</text>
						<text class="at-empty-sub">AI 会一个字段一个字段地问你</text>
						<text class="at-empty-sub2">打字,或点输入框旁的语音按钮开口说,都可以</text>
						<view v-if="sessionFailed" class="at-empty-retry" @tap="retrySession">
							<text class="at-empty-retry-text">重试连接</text>
						</view>
					</view>

					<view v-for="msg in messages" :key="msg.id" :id="'msg-' + msg.id">
						<!-- AI 提问 -->
						<view v-if="msg.type == 'question'" class="at-msg at-msg-left">
							<view class="at-bubble at-bubble-ai">
								<text class="at-bubble-ai-text">{{ msg.text }}</text>
								<view v-if="msg.options != null && msg.options.length > 0" class="at-options">
									<view
										v-for="opt in msg.options"
										:key="opt"
										class="at-option-chip"
										:class="{ selected: answerText == opt }"
										@tap="onEnumOptionTap(opt, msg.fieldKey)"
									>
										<text class="at-option-chip-text">{{ opt }}</text>
									</view>
								</view>
								<view
									v-if="msg.fieldKey != '' && msg.fieldKey == currentQuestionFieldKey && !extracting && !publishing && !paused"
									class="at-skip"
									@tap="skipCurrentQuestion"
								>
									<text class="at-skip-text">不想答,先问下一问</text>
								</view>
							</view>
						</view>

						<!-- 用户回答(右) -->
						<view v-if="msg.type == 'answer'" class="at-msg at-msg-right">
							<view class="at-bubble at-bubble-user">
								<text class="at-bubble-user-text">{{ msg.text }}</text>
							</view>
						</view>

						<!-- 思考中 -->
						<view v-if="msg.type == 'typing'" class="at-msg at-msg-left">
							<view class="at-bubble at-bubble-ai at-typing">
								<view class="at-dot"></view>
								<view class="at-dot"></view>
								<view class="at-dot"></view>
								<text class="at-typing-text">{{ msg.text }}</text>
							</view>
						</view>

						<!-- 系统提示 -->
						<view v-if="msg.type == 'system'" class="at-msg at-msg-system">
							<text class="at-system-text">{{ msg.text }}</text>
						</view>

						<!-- 待确认理解事件 -->
						<view v-if="msg.type == 'ingredients'" class="at-msg at-msg-ingredients">
							<text class="at-ingredients-title">{{ msg.count }} 条理解待确认</text>
							<view class="at-ingredients-chips">
								<view
									v-for="label in msg.labels"
									:key="label"
									class="at-ingredient-chip"
									@tap="recipeVisible = true"
								>
									<text class="at-ingredient-chip-text">{{ label }}</text>
								</view>
							</view>
							<text class="at-ingredients-more" @tap="recipeVisible = true">打开待确认的理解 ›</text>
						</view>

						<!-- 成稿成功 -->
						<view v-if="msg.type == 'published'" class="at-msg at-msg-system">
							<text class="at-system-text at-published-text">✓ 已写成稿 · 第 {{ msg.revision }} 稿 · 已确认 {{ msg.fieldCount }} 笔</text>
						</view>
					</view>
					<view class="at-flow-spacer"></view>
				</scroll-view>

				<!-- 底部操作区 -->
				<view v-if="!featureDisabled && !consentRequired" class="at-input-bar">
					<!-- 转写确认(普通语音) -->
					<view v-if="voiceMode && transcribeText != ''" class="at-transcribe-card">
						<text class="at-transcribe-label">转写结果(请确认后再提交)</text>
						<textarea
							class="at-transcribe-input"
							:value="transcribeText"
							@input="onTranscribeInput"
							maxlength="2000"
							:show-confirm-bar="false"
							:disable-default-padding="true"
							:cursor-spacing="16"
						/>
						<view class="at-transcribe-foot">
							<view class="at-transcribe-retry" @tap="retryVoice">
								<text class="at-transcribe-retry-text">重新录</text>
							</view>
							<view class="at-transcribe-confirm" @tap="confirmTranscribe">
								<text class="at-transcribe-confirm-text">确认,交给 AI</text>
							</view>
						</view>
					</view>

					<!-- 普通语音区 -->
					<view v-else-if="voiceMode && !extracting && !publishing" class="at-voice-area">
						<VoiceRecorder
							ref="voiceRecorderRef"
							:questionText="currentQuestionText"
							:questionFieldKey="currentQuestionFieldKey"
							theme="atelier"
							@transcribed="onTranscribed"
							@cancelled="onVoiceCancelled"
						/>
						<view class="at-mode-switch" @tap="switchToText">
							<text class="at-mode-switch-text">改用文字</text>
						</view>
					</view>

					<!-- 文字输入区 -->
					<view v-else-if="!voiceMode && !extracting && !publishing" class="at-input-row">
						<input
							class="at-input"
							:value="answerText"
							@input="onAnswerInput"
							:placeholder="inputPlaceholder"
							placeholder-class="at-ph"
							maxlength="2000"
							:cursor-spacing="16"
						/>
						<view
							class="at-round-btn"
							@tap="switchToVoice"
						>
							<text class="at-ic at-ic-yuyin"></text>
						</view>
						<view
							v-if="session != null"
							class="at-round-btn"
							@tap="startConversationSession"
						>
							<text class="at-ic at-ic-pinglun"></text>
						</view>
						<view
							class="at-send-btn"
							:class="{ 'at-send-ready': answerText.trim().length > 0 }"
							@tap="submitAnswer"
						>
							<text class="at-send-text">写上</text>
						</view>
					</view>

					<!-- AI 提取中 -->
					<view v-if="extracting" class="at-bar-status">
						<view class="at-mini-steam">
							<view class="at-steam-dot at-steam-dot-1"></view>
							<view class="at-steam-dot at-steam-dot-2"></view>
						</view>
						<text class="at-bar-status-text">AI 正在整理你刚说的话...</text>
					</view>

					<!-- 写下成稿 -->
					<view v-if="draft != null && !extracting && !publishing" class="at-publish-row">
						<text class="at-publish-info">{{ publishHint }}</text>
						<view v-if="canPublish" class="at-publish-btn" @tap="publishDraft">
							<text class="at-publish-text">写下成稿</text>
						</view>
					</view>
				</view>
			</view>
		</view>

		<!-- ===== 实时语音对话层(沉浸式) ===== -->
		<view v-if="conversationMode" class="at-voice-overlay">
			<view class="at-voice-head" :style="{ paddingTop: navPadTop + 'px', paddingRight: (menuButtonSpacing + 8) + 'px' }">
				<view class="at-voice-exit" @tap="closeConversation">
					<text class="at-voice-exit-text">‹</text>
				</view>
				<text class="at-voice-title" :style="{ top: navPadTop + 'px' }">和 AI 对话</text>
				<view class="at-voice-head-side"></view>
			</view>

			<view class="at-voice-body">
				<VoiceConversation
					ref="conversationRef"
					:sessionId="session != null && session.session_id != null ? String(session.session_id) : ''"
					:fieldKey="currentQuestionFieldKey"
					theme="atelier-dark"
					@transcribed="onConversationTranscribed"
					@aiReply="onConversationAIReply"
					@error="onConversationError"
					@sessionEnd="onConversationEnd"
				/>

				<!-- 最终转写确认:实时对话不自动写入画像 -->
				<view v-if="convReviewShow" class="at-conv-review">
					<text class="at-conv-review-label">转写结果(请确认后再提交)</text>
					<textarea
						class="at-conv-review-input"
						:value="convReview"
						@input="onConvReviewInput"
						maxlength="2000"
						:show-confirm-bar="false"
						:disable-default-padding="true"
					/>
					<view class="at-conv-review-foot">
						<view class="at-conv-review-listen" @tap="listenConvReview">
							<text class="at-conv-review-listen-text">听它读</text>
						</view>
						<view class="at-conv-review-retry" @tap="redoConvReview">
							<text class="at-conv-review-retry-text">重新说</text>
						</view>
						<view class="at-conv-review-confirm" @tap="confirmConvReview">
							<text class="at-conv-review-confirm-text">确认,交给 AI</text>
						</view>
					</view>
				</view>

				<!-- 降级面板 -->
				<view v-if="convDegraded" class="at-conv-degrade">
					<text class="at-conv-degrade-title">实时对话暂时不可用</text>
					<view class="at-conv-degrade-actions">
						<view class="at-conv-degrade-btn" @tap="retryConversation">
							<text class="at-conv-degrade-btn-text">再试一次</text>
						</view>
						<view class="at-conv-degrade-btn" @tap="degradeToRecorder">
							<text class="at-conv-degrade-btn-text">改用普通录音</text>
						</view>
						<view class="at-conv-degrade-btn" @tap="degradeToText">
							<text class="at-conv-degrade-btn-text">改用文字</text>
						</view>
					</view>
				</view>

				<text class="at-voice-hint">像朋友一样聊天。对话内容不会自动写入画像,只有你确认后的话才会进入落笔。</text>
			</view>
		</view>

		<!-- ===== 生成层(写下成稿后真实任务进度) ===== -->
		<view v-if="publishing" class="at-curing-overlay">
			<view class="at-curing-overlay-body">
				<view class="at-curing-steam at-curing-steam-lg">
					<view class="at-steam-dot at-steam-dot-1"></view>
					<view class="at-steam-dot at-steam-dot-2"></view>
					<view class="at-steam-dot at-steam-dot-3"></view>
				</view>
				<text class="at-curing-overlay-title">正在写下成稿</text>
				<view class="at-curing-lines">
					<view v-for="(line, li) in curingLines" :key="li" class="at-cure-line">
						<text class="at-cure-check">✓</text>
						<text class="at-cure-line-text">{{ line }}</text>
					</view>
				</view>
				<text class="at-curing-overlay-sub">{{ curingCurrentText }}</text>
				<view class="at-curing-overlay-secondary" @tap="publishInBackground">
					<text class="at-curing-overlay-secondary-text">后台等待,先去落笔</text>
				</view>
			</view>
		</view>

		<!-- ===== 待确认的理解(协商中心) ===== -->
		<XsaSheet :visible="recipeVisible" title="待确认的理解" theme="atelier" @close="recipeVisible = false">
			<view class="at-recipe-body">
				<text class="at-recipe-sub">AI 提出的理解都在这里。哪一条留下、哪一条拿掉,由你决定。</text>
				<view v-if="recipeFields.length == 0" class="at-recipe-empty">
					<text class="at-recipe-empty-title">还没有需要确认的内容</text>
					<text class="at-recipe-empty-sub">回到对话,回答 AI 的问题</text>
				</view>
				<PersonaIngredient
					v-for="f in recipeFields"
					:key="f.field_key"
					:field="f"
					:fieldLabel="fieldLabel(String(f.field_key))"
					@confirm="onFieldConfirm"
					@replace="onFieldReplace"
					@reject="onFieldReject"
					@delete="onFieldDelete"
				/>
			</view>
		</XsaSheet>

		<!-- ===== 往稿 ===== -->
		<PortraitBatchSheetComponent
			:visible="batchVisible"
			:loading="batchLoading"
			:items="batchItems"
			:subject="subject"
			:observations="historyObservations"
			@close="closeBatch"
			@restore="restoreRevision"
		/>

		<!-- ===== 墨相管理 ===== -->
		<XsaSheet :visible="manageVisible" title="墨相管理" theme="atelier" @close="manageVisible = false">
				<view class="at-manage-body">
					<view class="at-manage-row" @tap="openBatchFromManage">
						<text class="at-manage-row-text">往稿</text>
						<text class="at-manage-row-arrow">›</text>
					</view>
					<view class="at-manage-row" @tap="togglePause">
						<text class="at-manage-row-text">{{ paused ? '继续本次' : '暂存本次' }}</text>
						<text class="at-manage-row-arrow">›</text>
					</view>
				<view class="at-manage-row" @tap="endSession">
					<text class="at-manage-row-text">结束本次</text>
					<text class="at-manage-row-arrow">›</text>
				</view>
				<view class="at-manage-divider"></view>
				<view class="at-manage-row at-manage-danger" @tap="discardBottle">
					<text class="at-manage-row-text at-manage-danger-text">删除画像</text>
					<text class="at-manage-row-arrow">›</text>
				</view>
				<view class="at-manage-row at-manage-danger" @tap="revokeConsent">
					<text class="at-manage-row-text at-manage-danger-text">撤回画像授权</text>
					<text class="at-manage-row-arrow">›</text>
				</view>
				<text class="at-manage-note">删除画像会删除该主体的画像与全部历史版本,并撤回画像授权,数据随后异步清理。已发布版本的元数据保留在历史记录。</text>
			</view>
		</XsaSheet>
	</view>
</template>

<script setup lang="uts">
import {
	createProfileSession,
	getProfileSession,
	submitProfileTurn,
	getProfileDraft,
	patchProfileDraft,
	publishProfileDraft,
	listProfileRevisions,
	restoreProfileRevision,
	pauseProfileSession,
	resumeProfileSession,
	skipProfileQuestion,
	deleteProfileSession,
	deleteAiProfile,
	getPortraitNarrative,
	pollExtractionAndLoadDraft,
	pollTaskUntilTerminal,
	fieldAction,
	fieldLabel,
	mapProfileError,
	getAiConsents,
	grantProfileTextConsent,
	revokeProfileTextConsent,
	ENUM_FIELDS,
	ENUM_OPTIONS
	} from '@/api/ai-profile.uts'
	import { sleep } from '@/utils/sleep.uts'
	import VoiceRecorder from '@/components/VoiceRecorder.uvue'
import VoiceConversation from '@/components/VoiceConversation.uvue'
import PersonaBottle from '@/components/PersonaBottle.uvue'
import PersonaIngredient from '@/components/PersonaIngredient.uvue'
import PortraitBatchSheetComponent from '@/components/PersonaBatchSheet.uvue'
import XsaSheet from '@/components/XsaSheet.uvue'

const systemInfo = uni.getSystemInfoSync()
const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
const menuButtonInfo = uni.getMenuButtonBoundingClientRect()
const navPadTop = menuButtonInfo != null && menuButtonInfo.top > statusBarHeight ? menuButtonInfo.top : statusBarHeight + 6
const menuButtonSpacing = menuButtonInfo != null ? (systemInfo.windowWidth - menuButtonInfo.left) : 8

// 页面存活标记:离场后终止所有异步轮询/延迟任务
let alive = true

// ===== 视图结构 =====
const viewMode = ref('shelf') // shelf | subject
const subject = ref('personal')
const subjectPane = ref('dialog') // letter | dialog
const loading = ref(true)
const featureDisabled = ref(false)
const consentRequired = ref(false)
const consentMessage = ref('')
const granting = ref(false)
let pendingSubject = 'personal'

// ===== 会话与草稿 =====
const session = ref<any>(null)
const draft = ref<any>(null)
const messages = ref<any[]>([])
const answerText = ref('')
const currentQuestion = ref<any>(null)
const extracting = ref(false)
const publishing = ref(false)
const scrollAnchor = ref('')
const paused = ref(false)
const curingLines = ref<string[]>([])
const curingCurrentText = ref('')

// ===== 语音 =====
const voiceMode = ref(false)
const transcribeText = ref('')
const voiceRecorderRef = ref<any>(null)
const conversationMode = ref(false)
const conversationRef = ref<any>(null)
const convReview = ref('')
const convReviewShow = ref(false)
const convDegraded = ref(false)

// ===== 叙事与版本 =====
const narrativeMe = ref<any>(null)
const narrativeTa = ref<any>(null)
const historyObservations = ref<any[]>([])
const sessionInfoMe = ref<any>(null)
const sessionInfoTa = ref<any>(null)
const cleanupPending = ref('')

// ===== 弹层 =====
const recipeVisible = ref(false)
const batchVisible = ref(false)
const batchLoading = ref(false)
const batchItems = ref<any[]>([])
const manageVisible = ref(false)

// ===== 计算属性 =====

const navTitle = computed(() => {
	if (viewMode.value == 'subject') return subject.value == 'personal' ? '我的墨相' : '愿遇之相'
	return '墨相'
})

const narrative = computed(() => subject.value == 'personal' ? narrativeMe.value : narrativeTa.value)

const currentQuestionText = computed(() => {
	const q = currentQuestion.value
	if (q != null && q.text != null) return String(q.text)
	return ''
})

const currentQuestionFieldKey = computed(() => {
	const q = currentQuestion.value
	if (q != null && q.field_key != null) return String(q.field_key)
	return ''
})

const inputPlaceholder = computed(() => {
	if (currentQuestion.value != null) return '用你自己的话回答'
	return '说说你自己'
})

	const confirmedCount = computed(() => {
			if (draft.value == null || !Array.isArray(draft.value.fields)) return 0
			return draft.value.fields.filter((f: any) => f.confirmation_status == 'confirmed').length
		})
		const answeredCount = computed(() => {
			if (draft.value == null || !Array.isArray(draft.value.fields)) return 0
			return draft.value.fields.filter((f: any) => {
				const status = String(f.confirmation_status != null ? f.confirmation_status : '')
				return status != 'deleted' && status != 'rejected'
			}).length
		})
		const totalQuestionCount = 10
		const minPublishCount = 5
		const canPublish = computed(() => confirmedCount.value >= minPublishCount)
		const publishRemain = computed(() => {
			const remain = minPublishCount - confirmedCount.value
			return remain > 0 ? remain : 0
		})
		const publishHint = computed(() => {
			if (canPublish.value) return '已确认 ' + confirmedCount.value + ' / ' + totalQuestionCount + ' 笔，可以写下成稿'
			return '已确认 ' + confirmedCount.value + ' / ' + totalQuestionCount + ' 笔，不足半数，暂不能写下成稿'
		})
			const progressLabel = computed(() => {
				return '第 ' + answeredCount.value + ' / ' + totalQuestionCount + ' 题 · 已确认 ' + confirmedCount.value + ' 笔'
			})

		const progressValue = computed(() => {
		if (totalQuestionCount <= 0) return 0
		return answeredCount.value / totalQuestionCount
	})

const progressPercent = computed(() => Math.round(progressValue.value * 100))

const recipeFields = computed(() => {
	if (draft.value == null || !Array.isArray(draft.value.fields)) return [] as any[]
	return draft.value.fields.filter((f: any) => f.confirmation_status != 'deleted')
})

const letterReady = computed(() => {
	return narrative.value != null && narrative.value.status == 'published'
})

const hasBottledBefore = computed(() => {
	const info = sessionCacheFor(subject.value)
	if (info != null && info.status == 'published') return true
	return false
})

const letterTags = computed(() => {
	const n = narrative.value
	if (n == null || n.persona_tags == null || !Array.isArray(n.persona_tags)) return [] as string[]
	return n.persona_tags
})

const letterInsight = computed(() => {
	const n = narrative.value
	if (n == null || n.insight == null) return ''
	return String(n.insight)
})

const letterDimensions = computed(() => {
		const n = narrative.value
		if (n == null || n.dimensions == null || !Array.isArray(n.dimensions)) return [] as any[]
		// 维度 key → iconfont class(与后端 sanitize_narrative_dimension_icon 白名单 token 对齐,经 iconfont-social 字库渲染)
		// 后端 sanitize_narrative_dimension_icon 已把 emoji/伪标签归一为 token 名
		const iconClass: any = {
			relationship: 'at-ic-love',
			personality: 'at-ic-biaoqing',
			lifestyle: 'at-ic-canyuhuati',
			future: 'at-ic-xianxiahuodong'
		}
		const out: any[] = []
		for (let i = 0; i < n.dimensions.length; i++) {
			const dim = n.dimensions[i]
			if (dim == null) continue
			const key = dim.key != null ? String(dim.key) : ''
			const cls = iconClass[key] != null ? String(iconClass[key]) : 'at-ic-love'
			out.push({ key: key, iconClass: cls, title: dim.title, summary: dim.summary })
		}
		return out
	})

const letterWeights = computed(() => {
	if (subject.value != 'ideal_partner') return [] as any[]
	const n = narrative.value
	if (n == null || n.ideal_weights == null || !Array.isArray(n.ideal_weights)) return [] as any[]
	return n.ideal_weights
})

const letterRecentChange = computed(() => {
	const n = narrative.value
	if (n == null || n.recent_change == null) return null
	return n.recent_change
})

const letterConclusion = computed(() => {
	const n = narrative.value
	if (n == null || n.conclusion == null) return ''
	return String(n.conclusion)
})

const insightPreview = computed(() => {
	if (narrativeMe.value != null && narrativeMe.value.status == 'published' && narrativeMe.value.insight != null && narrativeMe.value.insight != '') {
		return String(narrativeMe.value.insight)
	}
	if (narrativeTa.value != null && narrativeTa.value.status == 'published' && narrativeTa.value.insight != null && narrativeTa.value.insight != '') {
		return String(narrativeTa.value.insight)
	}
	return ''
})

const insightPreviewLabel = computed(() => {
	if (narrativeMe.value != null && narrativeMe.value.status == 'published' && narrativeMe.value.insight != null && narrativeMe.value.insight != '') return '我的墨相'
	return '愿遇之相'
})

// ===== 墨案辅助 =====

function narrativeFor(sub: string): any {
	return sub == 'personal' ? narrativeMe.value : narrativeTa.value
}

function sessionCacheFor(sub: string): any {
	return sub == 'personal' ? sessionInfoMe.value : sessionInfoTa.value
}

function updateSessionCache(sub: string) {
	if (session.value == null) return
	const hasDraft = session.value.draft_id != null && session.value.draft_id != ''
	const info: any = {
		status: String(session.value.status != null ? session.value.status : ''),
		draft_id: session.value.draft_id != null ? String(session.value.draft_id) : '',
		hasDraft: hasDraft,
		profile_revision: session.value.profile_revision != null ? Number(session.value.profile_revision) : 0
	}
	if (sub == 'personal') sessionInfoMe.value = info
	else sessionInfoTa.value = info
}

function bottleState(sub: string): string {
	if (cleanupPending.value == sub) return 'cleanup'
	const narr = narrativeFor(sub)
	const info = sessionCacheFor(sub)
	if (narr != null && narr.status == 'published') return 'bottled'
	if (info != null && info.status == 'published') return 'curing'
	if (info != null && info.hasDraft) return 'mixing'
	return 'empty'
}

function bottleFill(sub: string): number {
	const state = bottleState(sub)
	if (state == 'bottled') return 1
	if (state == 'mixing') {
		if (subject.value == sub && draft.value != null && Array.isArray(draft.value.fields)) {
			const confirmed = draft.value.fields.filter((f: any) => f.confirmation_status == 'confirmed').length
			return Math.max(0.15, Math.min(confirmed / 10, 0.9))
		}
		return 0.18
	}
	return 0.08
}

function bottleTitle(sub: string): string {
	const narr = narrativeFor(sub)
	if (bottleState(sub) == 'bottled' && narr != null && narr.persona_title != null && narr.persona_title != '') {
		return String(narr.persona_title)
	}
	return sub == 'personal' ? '我的墨相' : '愿遇之相'
}

function bottleSub(sub: string): string {
	const state = bottleState(sub)
	if (state == 'cleanup') return '清理中'
	if (state == 'bottled') {
		const info = sessionCacheFor(sub)
		const revNo = info != null && info.profile_revision > 0 ? info.profile_revision : 0
		return revNo > 0 ? '第 ' + revNo + ' 稿 · 已写成稿' : '已写成稿'
	}
	if (state == 'curing') return '正在写下理解'
	if (state == 'mixing') {
		if (subject.value == sub && draft.value != null) return '落笔中 · 已确认 ' + confirmedCount.value + ' 笔'
		return '落笔中'
	}
	return '还没落笔,点这里开始'
}

function bottleHasChange(sub: string): boolean {
	const narr = narrativeFor(sub)
	return narr != null && narr.status == 'published' && narr.recent_change != null
}

/** 纸面底部小字:已成稿显示稿号,落笔中显示确认笔数 */
function bottleFootNote(sub: string): string {
	const state = bottleState(sub)
	if (state == 'bottled') {
		const info = sessionCacheFor(sub)
		const revNo = info != null && info.profile_revision > 0 ? info.profile_revision : 0
		return revNo > 0 ? '第 ' + revNo + ' 稿' : ''
	}
	if (state == 'mixing') {
		if (subject.value == sub && draft.value != null) return '已确认 ' + confirmedCount.value + ' 笔'
	}
	return ''
}

/** 新变化角标的具体文案:取摘要前 4 字 */
function bottleChangeText(sub: string): string {
	const narr = narrativeFor(sub)
	if (narr == null || narr.status != 'published' || narr.recent_change == null) return ''
	const s = narr.recent_change.summary != null ? String(narr.recent_change.summary) : ''
	if (s == '') return ''
	return '新变化·' + (s.length > 4 ? s.substring(0, 4) + '…' : s)
}

// ===== 导航 =====

const navBack = () => {
	if (viewMode.value == 'subject') {
		backToShelf()
		return
	}
	uni.navigateBack({ delta: 1 })
}

const backToShelf = () => {
	if (conversationMode.value) closeConversation()
	voiceMode.value = false
	transcribeText.value = ''
	viewMode.value = 'shelf'
}

const openInsightSubject = () => {
	const sub = insightPreviewLabel.value == '我的墨相' ? 'personal' : 'ideal_partner'
	enterSubject(sub, true)
}

const switchPane = (pane: string) => {
	if (subjectPane.value == pane) return
	subjectPane.value = pane
	if (pane == 'letter') {
		refreshNarrativeNow()
	} else if (pane == 'dialog' && session.value == null) {
		ensureSession()
	}
}

// ===== 叙事层 =====

const loadNarrative = async (sub: string) => {
	try {
		const res = await getPortraitNarrative(sub)
		if (!alive) return
		if (res.success && res.data != null) {
			if (sub == 'personal') narrativeMe.value = res.data
			else narrativeTa.value = res.data
			if (sub == subject.value && res.data.history_observations != null && Array.isArray(res.data.history_observations)) {
				historyObservations.value = res.data.history_observations
			}
		}
	} catch (e) {
		// 叙事层失败不阻断主流程
		console.error('[Atelier] loadNarrative failed', e)
	}
}

const refreshNarrativeNow = async () => {
	await loadNarrative(subject.value)
	if (narrative.value != null && narrative.value.status == 'published') {
		uni.showToast({ title: '理解已就绪', icon: 'none' })
	}
}

// ===== 进入主体 =====

const enterSubject = async (sub: string, toLetter: boolean = false) => {
	subject.value = sub
	viewMode.value = 'subject'
	const narr = narrativeFor(sub)
	if (toLetter || (narr != null && narr.status == 'published')) {
		subjectPane.value = 'letter'
		return
	}
	subjectPane.value = 'dialog'
	await ensureSession()
}

const continueExpressing = async () => {
	subjectPane.value = 'dialog'
	if (session.value == null) {
		await ensureSession()
	} else if (session.value.status == 'published') {
		// 上一会话已发布(终态),创建新会话继续表达
		await ensureSession()
	}
}

// ===== 会话管理 =====

const symbolicCode = (res: any): string => {
	if (res == null) return ''
	if (res.data != null && res.data.detail != null && res.data.detail.code != null) {
		return String(res.data.detail.code)
	}
	if (res.code != null) return String(res.code)
	return ''
}

let staleRetryCount = 0
const MAX_STALE_RETRIES = 3
let ensuringSession = false
const sessionFailed = ref(false)
const retrySession = () => {
	sessionFailed.value = false
	staleRetryCount = 0
	ensureSession()
}

const ensureSession = async () => {
	if (ensuringSession) return
	ensuringSession = true
	loading.value = true
	featureDisabled.value = false
	consentRequired.value = false
	try {
		const res = await createProfileSession(subject.value)
		if (!alive) return
		if (!res.success || res.data == null) {
			const code = symbolicCode(res)
			if (code == 'AI_FEATURE_DISABLED' || res.code == 503) {
				featureDisabled.value = true
			} else if (code == 'AI_CONSENT_REQUIRED' || res.code == 403) {
				consentRequired.value = true
				pendingSubject = subject.value
				consentMessage.value = mapProfileError(code, String(res.message))
			} else if (code == 'PROFILE_SESSION_STALE') {
				// 资料已更新,旧会话过期;有界重试(最多 MAX_STALE_RETRIES 次)
				staleRetryCount++
				if (staleRetryCount > MAX_STALE_RETRIES) {
					staleRetryCount = 0
					sessionFailed.value = true
					uni.showToast({ title: '资料已更新,请稍后重试', icon: 'none' })
					loading.value = false
					return
				}
				uni.showToast({ title: mapProfileError(code, String(res.message)), icon: 'none' })
				ensuringSession = false
				setTimeout(() => { if (alive) ensureSession() }, 900)
				return
			} else {
				sessionFailed.value = true
				uni.showToast({ title: mapProfileError(code, String(res.message)), icon: 'none' })
			}
			loading.value = false
			return
		}
		sessionFailed.value = false
		staleRetryCount = 0
		session.value = res.data
		const status = String(res.data.status != null ? res.data.status : '')
		paused.value = (status == 'paused')
		updateSessionCache(subject.value)
		await loadNarrative(subject.value)
		if (status == 'draft' || status == 'awaiting_confirmation' || status == 'paused') {
			await loadDraftAndRebuildFlow(true)
		} else if (status == 'published') {
			if (res.data.draft_id != null && res.data.draft_id != '') {
				await loadDraftAndRebuildFlow(false)
			} else {
				addSystemMessage('这一稿已经写下。继续说会开启一次新的落笔。')
			}
		}
	} catch (e) {
		if (alive) {
			sessionFailed.value = true
			uni.showToast({ title: '网络异常,请稍后重试', icon: 'none' })
		}
	} finally {
		ensuringSession = false
		if (alive) loading.value = false
	}
}

const loadDraftAndRebuildFlow = async (resumed: boolean) => {
	if (session.value == null) return
	const draftId = session.value.draft_id
	if (draftId == null || draftId == '') {
		if (session.value.current_question != null) {
			currentQuestion.value = session.value.current_question
			addQuestionMessage(session.value.current_question)
		}
		return
	}
	try {
		const draftRes = await getProfileDraft(String(draftId))
		if (!alive) return
		if (draftRes.success && draftRes.data != null) {
			draft.value = draftRes.data
			if (resumed && recipeFields.value.length > 0) {
				addSystemMessage('已恢复上次的落笔进度,待确认的理解还在等你处理')
			}
		}
	} catch (e) {
		console.error('[Atelier] loadDraft failed', e)
	}
	if (session.value.current_question != null) {
		currentQuestion.value = session.value.current_question
		addQuestionMessage(session.value.current_question)
	} else {
		addSystemMessage('问题都问完了。打开待确认的理解,确认后写下成稿。')
	}
}

// ===== 表达循环:提交回答 → 抽取 → 待确认理解 =====

const submitAnswer = async () => {
	const text = answerText.value.trim()
	if (text == '') {
		uni.showToast({ title: '先说点什么', icon: 'none' })
		return
	}
	if (session.value == null) {
		await ensureSession()
		if (session.value == null) return
	}

	addAnswerMessage(text)
	answerText.value = ''
	extracting.value = true
	const typingId = addTypingMessage('正在整理你的回答...', 0)

	try {
		const turnRes = await submitProfileTurn(String(session.value.session_id), text)
		if (!alive) return
		if (!turnRes.success || turnRes.data == null) {
			extracting.value = false
			removeMessage(typingId)
			const code = symbolicCode(turnRes)
			uni.showToast({ title: mapProfileError(code, String(turnRes.message)), icon: 'none' })
			if (code == 'PROFILE_SESSION_STALE') {
				session.value = null
				draft.value = null
				await ensureSession()
			}
			return
		}

		const taskId = String(turnRes.data.task_id != null ? turnRes.data.task_id : '')
		const draftId = String(session.value.draft_id != null ? session.value.draft_id : '')
		const result = await pollExtractionAndLoadDraft(taskId, draftId, 30, () => alive)
		if (!alive) return
		extracting.value = false
		removeMessage(typingId)

			if (!result.success) {
				uni.showToast({ title: result.error, icon: 'none' })
				addSystemMessage('这一句还没记下。换个说法再答一次，或先确认已抽出的理解。')
				return
			}

		const prevDraft = draft.value
		draft.value = result.draft
		announceIngredients(prevDraft, result.draft)
		await refreshSessionAfterTurn()
	} catch (e) {
		if (!alive) return
		extracting.value = false
		removeMessage(typingId)
		uni.showToast({ title: '网络异常,请稍后重试', icon: 'none' })
	}
}

const refreshSessionAfterTurn = async () => {
	if (session.value == null) return
	const sessionRes = await getProfileSession(String(session.value.session_id))
	if (!alive) return
	if (sessionRes.success && sessionRes.data != null) {
		session.value = sessionRes.data
		updateSessionCache(subject.value)
		if (sessionRes.data.current_question != null) {
			currentQuestion.value = sessionRes.data.current_question
			addTypingMessage('正在思考...', 600, () => {
				if (alive && session.value != null && session.value.current_question != null) {
					addQuestionMessage(session.value.current_question)
				}
			})
		} else {
			currentQuestion.value = null
			addSystemMessage('问题都问完了。打开待确认的理解,确认后写下成稿。')
		}
	}
}

/** 新一轮抽取完成后,把新增/变化的待确认字段呈现 */
const announceIngredients = (prevDraft: any, newDraft: any) => {
	if (newDraft == null || !Array.isArray(newDraft.fields)) return
	const prevStatuses: Map<string, string> = new Map()
	if (prevDraft != null && Array.isArray(prevDraft.fields)) {
		for (let i = 0; i < prevDraft.fields.length; i++) {
			const pf = prevDraft.fields[i]
			prevStatuses.set(String(pf.field_key), String(pf.confirmation_status != null ? pf.confirmation_status : ''))
		}
	}
	const labels: string[] = []
	for (let i = 0; i < newDraft.fields.length; i++) {
		const f = newDraft.fields[i]
		if (f.confirmation_status != 'suggested') continue
		const prev = prevStatuses.get(String(f.field_key))
		if (prev == null || prev == '' || prev == 'rejected') {
			labels.push(fieldLabel(String(f.field_key)))
		}
	}
	if (labels.length > 0) {
		messages.value.push({
			id: 'ing-' + Date.now(),
			type: 'ingredients',
			count: labels.length,
			labels: labels
		})
		scrollToBottom()
	}
}

// ===== 语音:普通录音 =====

const switchToVoice = () => {
	voiceMode.value = true
	transcribeText.value = ''
}

const switchToText = () => {
	if (voiceRecorderRef.value != null) voiceRecorderRef.value.reset()
	voiceMode.value = false
	transcribeText.value = ''
}

const onTranscribed = (text: string) => {
	transcribeText.value = text
}

const onVoiceCancelled = () => {
	transcribeText.value = ''
}

const onTranscribeInput = (e: any) => {
	transcribeText.value = e.detail.value
}

const retryVoice = () => {
	transcribeText.value = ''
	if (voiceRecorderRef.value != null) {
		voiceRecorderRef.value.reset()
	}
}

// 枚举选项点选:展示中文标签,提交后端契约 value
const onEnumOptionTap = (label: string, fieldKey: string) => {
	// 与「不想答」链接同款守卫:抽取/发布/暂存中不并发写草稿(防 409)
	if (extracting.value || publishing.value || paused.value) return
	answerText.value = label
	// 枚举字段点选直接提交后端契约 value,跳过 AI 抽取
	// 仅 personal 主体:ideal_partner 的同名字段是 set/range 形状,PATCH 标量会被后端 422(渲染已不挂 chips,此处兜底)
	if (subject.value != 'personal' || fieldKey == '' || ENUM_FIELDS.indexOf(fieldKey) < 0) return
	const options = ENUM_OPTIONS.get(fieldKey)
	if (options == null) return
	let matchedValue: any = null
	for (let i = 0; i < options.length; i++) {
		if (options[i].label == label) { matchedValue = options[i].value; break }
	}
	if (matchedValue == null || draft.value == null) return
	const expectedRev = Number(draft.value.expected_revision != null ? draft.value.expected_revision : 0)
	const act = fieldAction(fieldKey, 'replace', matchedValue, expectedRev)
	patchProfileDraft(String(draft.value.draft_id), [act], expectedRev).then((res: any) => {
		if (!alive) return
		if (res.success && res.data != null) {
			draft.value = res.data
			addAnswerMessage(label)
			advanceToNextQuestion()
		} else {
			uni.showToast({ title: mapProfileError(symbolicCode(res), String(res.message)), icon: 'none' })
		}
	}).catch((e: any) => {
		console.error('[Atelier] enum tap confirm failed', e)
		if (alive) uni.showToast({ title: '操作失败,请重试', icon: 'none' })
	})
}

const confirmTranscribe = async () => {
	const text = transcribeText.value.trim()
	if (text == '') {
		uni.showToast({ title: '转写内容为空,请重新录音', icon: 'none' })
		return
	}
	answerText.value = text
	transcribeText.value = ''

	// 枚举字段:转写匹配选项标签后直接 PATCH replace 为 confirmed(提交后端契约 value),跳过 AI 抽取
	// 仅 personal 主体:ideal_partner 的同名字段是 set/range 形状,PATCH 标量会被后端 422(渲染已不挂 chips,此处兜底)
	const fieldKey = currentQuestion.value != null && currentQuestion.value.field_key != null
		? String(currentQuestion.value.field_key) : ''
	if (subject.value == 'personal' && fieldKey != '' && ENUM_FIELDS.indexOf(fieldKey) >= 0) {
		const options = ENUM_OPTIONS.get(fieldKey)
		if (options != null) {
			let matchedValue: any = null
			let matchedLabel = ''
			for (let i = 0; i < options.length; i++) {
				if (text.indexOf(options[i].label) >= 0) {
					matchedValue = options[i].value
					matchedLabel = options[i].label
					break
				}
			}
			if (matchedValue != null) {
				if (draft.value != null) {
					const expectedRev = Number(draft.value.expected_revision != null ? draft.value.expected_revision : 0)
					const act = fieldAction(fieldKey, 'replace', matchedValue, expectedRev)
					try {
						const res = await patchProfileDraft(String(draft.value.draft_id), [act], expectedRev)
						if (!alive) return
						if (res.success && res.data != null) {
							draft.value = res.data
						}
					} catch (e) {
						console.error('[Atelier] enum voice confirm failed', e)
					}
				}
				addAnswerMessage(matchedLabel != '' ? matchedLabel : text)
				await advanceToNextQuestion()
				return
			}
		}
	}

	await submitAnswer()
}

const advanceToNextQuestion = async () => {
	if (session.value == null) return
	const sessionRes = await getProfileSession(String(session.value.session_id))
	if (!alive) return
	if (sessionRes.success && sessionRes.data != null) {
		session.value = sessionRes.data
		updateSessionCache(subject.value)
		if (sessionRes.data.current_question != null) {
			currentQuestion.value = sessionRes.data.current_question
			addQuestionMessage(sessionRes.data.current_question)
		} else {
			currentQuestion.value = null
			addSystemMessage('问题都问完了。打开待确认的理解,确认后写下成稿。')
		}
	}
}

// 不想答:跳过当前问题,不确认字段,本次会话不再追问
const skipCurrentQuestion = async () => {
	if (extracting.value || publishing.value) return
	if (session.value == null) {
		await ensureSession()
		if (session.value == null) return
	}
	const fieldKey = currentQuestion.value != null && currentQuestion.value.field_key != null
		? String(currentQuestion.value.field_key) : ''
	if (fieldKey == '') return
	try {
		const res = await skipProfileQuestion(String(session.value.session_id), fieldKey)
		if (!alive) return
		if (res.success && res.data != null) {
			session.value = res.data
			updateSessionCache(subject.value)
			if (res.data.current_question != null) {
				currentQuestion.value = res.data.current_question
				addSystemMessage('这一笔先不写,先问下一问。')
				addQuestionMessage(res.data.current_question)
			} else {
				currentQuestion.value = null
				addSystemMessage('问题都问完了。打开待确认的理解,确认后写下成稿。')
			}
		} else {
			const code = symbolicCode(res)
			uni.showToast({ title: mapProfileError(code, String(res.message)), icon: 'none' })
		}
	} catch (e) {
		if (alive) uni.showToast({ title: '操作失败,请重试', icon: 'none' })
	}
}

// ===== 语音:实时对话层(最终转写必须经用户确认) =====

const startConversationSession = async () => {
	if (session.value == null) {
		await ensureSession()
		if (session.value == null) return
	}
	voiceMode.value = false
	transcribeText.value = ''
	convDegraded.value = false
	convReview.value = ''
	convReviewShow.value = false
	conversationMode.value = true
}

const closeConversation = (force: boolean = false) => {
	// 转写还没提交时,退出先确认,避免无声丢弃用户口述的内容
	if (!force && convReview.value.trim() != '') {
		uni.showModal({
			title: '转写还没提交',
			content: '你说的内容还没确认提交,退出会丢弃这段转写。',
			confirmText: '丢弃并退出',
			cancelText: '继续编辑',
			success: (modalRes) => {
				if (modalRes.confirm) closeConversation(true)
			}
		})
		return
	}
	if (conversationRef.value != null) conversationRef.value.reset()
	conversationMode.value = false
	convDegraded.value = false
	convReview.value = ''
	convReviewShow.value = false
}

const onConversationTranscribed = (text: string) => {
	// 不自动提交:实时通道不写画像,先进入用户确认
	convReview.value = text
	convReviewShow.value = true
}

let reviseTimer: number = 0
const onConvReviewInput = (e: any) => {
	convReview.value = e.detail.value
	// 停顿后改字触发重跑回复,让 AI 按新文本重新落墨
	if (reviseTimer != 0) clearTimeout(reviseTimer as any)
	reviseTimer = setTimeout(() => {
		const text = convReview.value.trim()
		if (text != '' && conversationRef.value != null) {
			conversationRef.value.revise(text)
		}
	}, 600) as any
}

const listenConvReview = () => {
	if (conversationRef.value != null) conversationRef.value.listen()
}

const redoConvReview = () => {
	// 重新说:重置组件,清掉纸面与回复缓存,关确认卡
	if (conversationRef.value != null) conversationRef.value.reset()
	convReview.value = ''
	convReviewShow.value = false
}

const confirmConvReview = () => {
	const text = convReview.value.trim()
	if (text == '') {
		uni.showToast({ title: '内容为空,重新说一次', icon: 'none' })
		return
	}
	closeConversation(true)
	answerText.value = text
	submitAnswer()
}

const onConversationAIReply = (text: string, fieldKey: string) => {
	// AI 在实时层的回应以气泡进入对话流
	addQuestionMessage({ text: text, field_key: fieldKey, id: 'ai-' + Date.now() })
}

const onConversationError = (code: string, message: string) => {
	if (code == 'WS_CONNECT_FAILED' || code == 'WS_ERROR' || code == 'AUTH_REQUIRED') {
		convDegraded.value = true
		return
	}
	uni.showToast({ title: message, icon: 'none' })
}

const onConversationEnd = () => {
	// WS 重试耗尽:给出降级入口
	convDegraded.value = true
}

const retryConversation = () => {
	convDegraded.value = false
	convReviewShow.value = false
	convReview.value = ''
	if (conversationRef.value != null) conversationRef.value.reset()
}

const degradeToRecorder = () => {
	closeConversation()
	voiceMode.value = true
	uni.showToast({ title: '已切换为普通录音', icon: 'none' })
}

const degradeToText = () => {
	closeConversation()
	switchToText()
}

// ===== 协商循环:待确认理解操作 =====

const onFieldConfirm = async (fieldKey: string) => {
	await patchField(fieldKey, 'confirm', null)
}

const onFieldReplace = async (fieldKey: string, value: any) => {
	await patchField(fieldKey, 'replace', value)
}

const onFieldReject = async (fieldKey: string) => {
	await patchField(fieldKey, 'reject', null)
}

const onFieldDelete = async (fieldKey: string) => {
	await patchField(fieldKey, 'delete', null)
}

const patchField = async (fieldKey: string, action: string, value: any) => {
	if (draft.value == null) return
	const expectedRev = Number(draft.value.expected_revision != null ? draft.value.expected_revision : 0)
	const act = fieldAction(fieldKey, action, value, expectedRev)
	try {
		const res = await patchProfileDraft(String(draft.value.draft_id), [act], expectedRev)
		if (!alive) return
		if (!res.success || res.data == null) {
			const code = symbolicCode(res)
			uni.showToast({ title: mapProfileError(code, String(res.message)), icon: 'none' })
			if (code == 'DRAFT_VERSION_CONFLICT' || code == 'RESULT_STALE') {
				const draftRes = await getProfileDraft(String(draft.value.draft_id))
				if (!alive) return
				if (draftRes.success && draftRes.data != null) {
					draft.value = draftRes.data
					uni.showToast({ title: '内容已被更新,已为你刷新', icon: 'none' })
				}
			}
			return
		}
		draft.value = res.data
		if (action == 'confirm') {
			uni.showToast({ title: '已确认 · ' + fieldLabel(fieldKey), icon: 'none' })
		}
	} catch (e) {
		uni.showToast({ title: '操作失败,请重试', icon: 'none' })
	}
}

// ===== 成长循环:写下成稿(发布) =====

/** 发布任务本身在后台异步执行:收起遮罩不中断流程,完成时消息流与成稿页会接住结果 */
const publishInBackground = () => {
	publishing.value = false
	uni.showToast({ title: '成稿在后台继续,完成后会在这里告诉你', icon: 'none' })
}

/** narrative task 的 stage → 用户可见文案映射。taskStatus 用于失败/超时兜底。 */
const _narrativeStageText = (stage: string, taskStatus: string): string => {
	if (stage == 'reading_fields') return '正在回顾你的回答…'
	if (stage == 'calling_llm') return 'AI 正在解读…'
	if (stage == 'writing_summary') return '正在写下理解…'
	if (taskStatus == 'failed') return '理解仍在整理,请稍后查看'
	if (taskStatus == 'timeout') return '理解仍在整理,请稍后查看'
	return '正在写下理解…'
}

const publishDraft = async () => {
	if (draft.value == null || publishing.value) return
		if (!canPublish.value) {
			uni.showToast({ title: '已确认字段不足半数，暂不能写下成稿', icon: 'none' })
			return
		}
	publishing.value = true
	curingLines.value = []
	curingCurrentText.value = '正在写下成稿...'
	const expectedRev = Number(draft.value.expected_revision != null ? draft.value.expected_revision : 0)
	try {
		const res = await publishProfileDraft(String(draft.value.draft_id), expectedRev)
		if (!alive) return
		if (!res.success || res.data == null) {
			publishing.value = false
			const code = symbolicCode(res)
			uni.showToast({ title: mapProfileError(code, String(res.message)), icon: 'none' })
			if (code == 'DRAFT_VERSION_CONFLICT' || code == 'RESULT_STALE') {
				const draftRes = await getProfileDraft(String(draft.value.draft_id))
				if (draftRes.success && draftRes.data != null) {
					draft.value = draftRes.data
				}
			}
			return
		}
		curingLines.value.push('成稿已提交')

		// 发布是异步任务:轮询到终态
		curingCurrentText.value = '正在生成这一稿...'
		const taskId = String(res.data.task_id != null ? res.data.task_id : '')
		const taskRes = await pollTaskUntilTerminal(taskId, 40, () => alive)
		if (!alive) return
		if (!taskRes.done || taskRes.status != 'succeeded') {
			publishing.value = false
			uni.showToast({ title: taskRes.error != '' ? taskRes.error : '成稿未完成,请稍后重试', icon: 'none' })
			return
		}

		// 刷新会话与稿号
		let revisionNo = 0
		let fieldCount = confirmedCount.value
		const sessionRes = await getProfileSession(String(session.value.session_id))
		if (!alive) return
		if (sessionRes.success && sessionRes.data != null) {
			session.value = sessionRes.data
			updateSessionCache(subject.value)
			if (sessionRes.data.profile_revision != null) {
				revisionNo = Number(sessionRes.data.profile_revision)
			}
		}
		if (res.data.field_count != null && res.data.field_count != 0) {
			fieldCount = Number(res.data.field_count)
		}
		curingLines.value.push('第 ' + (revisionNo > 0 ? revisionNo : 1) + ' 稿已生成')

		// narrative 由 Worker 异步生成:优先用 narrative_task_id 走标准任务轮询,
		// 兼容旧后端无 task_id 时回退到业务接口轮询(扩大窗口)。
		curingCurrentText.value = '正在写下理解...'
		let narrReady = false
		const narrativeTaskId = res.data.narrative_task_id != null ? String(res.data.narrative_task_id) : ''
		if (narrativeTaskId != '') {
			const narrTaskRes = await pollTaskUntilTerminal(narrativeTaskId, 40, () => alive)
			if (!alive) return
			const stage = narrTaskRes.task != null && narrTaskRes.task.stage != null ? String(narrTaskRes.task.stage) : ''
			if (narrTaskRes.done && narrTaskRes.status == 'succeeded') {
				narrReady = true
			}
			curingCurrentText.value = _narrativeStageText(stage, narrTaskRes.status)
		} else {
			for (let i = 0; i < 20; i++) {
				await loadNarrative(subject.value)
				if (!alive) return
				if (narrative.value != null && narrative.value.status == 'published') {
					narrReady = true
					break
				}
				await sleep(2000)
				if (!alive) return
			}
		}

		publishing.value = false
		messages.value.push({
			id: 'published-' + Date.now(),
			type: 'published',
			revision: revisionNo,
			fieldCount: fieldCount
		})
		scrollToBottom()
		if (narrReady) {
			subjectPane.value = 'letter'
			uni.showToast({ title: '成稿已写下', icon: 'success' })
		} else {
			subjectPane.value = 'letter'
			uni.showToast({ title: '这一稿已生成,理解仍在整理', icon: 'none' })
		}
	} catch (e) {
		if (!alive) return
		publishing.value = false
		uni.showToast({ title: '写下成稿失败,请重试', icon: 'none' })
	}
}

// ===== 往稿 =====

const openBatchFromManage = () => {
	manageVisible.value = false
	openBatch()
}

const openBatch = async () => {
	batchVisible.value = true
	batchLoading.value = true
	if (narrative.value == null) {
		await loadNarrative(subject.value)
		if (!alive) return
	}
	try {
		const res = await listProfileRevisions('', 20)
		if (!alive) return
		if (res.success && res.data != null && Array.isArray(res.data.items)) {
			batchItems.value = res.data.items
		} else {
			batchItems.value = []
		}
	} catch (e) {
		batchItems.value = []
	} finally {
		if (alive) batchLoading.value = false
	}
}

const closeBatch = () => { batchVisible.value = false }

const restoreRevision = async (revisionId: number) => {
	uni.showModal({
		title: '从这稿再写一版',
		content: '将从该稿生成一份新的草稿(全部回到待确认)。你逐条确认后重新写下成稿。原稿不会被修改。',
		confirmText: '再写一版',
		success: async (modalRes) => {
			if (!modalRes.confirm) return
			uni.showLoading({ title: '生成中...' })
			try {
				const res = await restoreProfileRevision(revisionId)
				uni.hideLoading()
				if (!alive) return
				if (!res.success || res.data == null) {
					uni.showToast({ title: '再写一版失败,请重试', icon: 'none' })
					return
				}
				draft.value = res.data
				if (session.value != null) {
					const sessionRes = await getProfileSession(String(session.value.session_id))
					if (!alive) return
					if (sessionRes.success && sessionRes.data != null) {
						session.value = sessionRes.data
						updateSessionCache(subject.value)
					}
				}
				batchVisible.value = false
				subjectPane.value = 'dialog'
				messages.value = []
				addSystemMessage('已从该稿生成新草稿,请逐条确认后重新写下成稿')
				announceIngredients(null, draft.value)
				uni.showToast({ title: '已生成新草稿,等待确认', icon: 'success' })
			} catch (e) {
				uni.hideLoading()
				uni.showToast({ title: '再写一版失败,请重试', icon: 'none' })
			}
		}
	})
}

// ===== 暂停 / 删除 / 授权 =====

const togglePause = async () => {
	manageVisible.value = false
	if (session.value == null) return
	const sid = String(session.value.session_id)
	try {
		if (paused.value) {
			const res = await resumeProfileSession(sid)
			if (!alive) return
			if (res.success && res.data != null) {
				session.value = res.data
				updateSessionCache(subject.value)
				paused.value = false
				uni.showToast({ title: '已继续', icon: 'none' })
			}
		} else {
			const res = await pauseProfileSession(sid)
			if (!alive) return
			if (res.success && res.data != null) {
				session.value = res.data
				updateSessionCache(subject.value)
				paused.value = true
				uni.showToast({ title: '已暂存,随时回来继续', icon: 'none' })
			}
		}
	} catch (e) {
		uni.showToast({ title: '操作失败,请重试', icon: 'none' })
	}
}

const endSession = () => {
	manageVisible.value = false
	if (session.value == null) {
		uni.showToast({ title: '当前没有进行中的落笔', icon: 'none' })
		return
	}
	uni.showModal({
		title: '结束本次',
		content: '本次对话会被取消,未发布的草稿将一并作废。已发布的历史版本不受影响。',
		confirmText: '结束',
		success: async (modalRes) => {
			if (!modalRes.confirm) return
			try {
				const res = await deleteProfileSession(String(session.value.session_id))
				if (!alive) return
				if (res.success) {
					session.value = null
					draft.value = null
					messages.value = []
					currentQuestion.value = null
					if (subject.value == 'personal') sessionInfoMe.value = null
					else sessionInfoTa.value = null
					uni.showToast({ title: '本次已结束', icon: 'none' })
					backToShelf()
				} else {
					uni.showToast({ title: mapProfileError(symbolicCode(res), String(res.message)), icon: 'none' })
				}
			} catch (e) {
				uni.showToast({ title: '操作失败,请重试', icon: 'none' })
			}
		}
	})
}

const discardBottle = () => {
	manageVisible.value = false
	uni.showModal({
		title: '删除画像',
		content: '将删除「' + (subject.value == 'personal' ? '我的墨相' : '愿遇之相') + '」的画像数据与全部历史版本,并撤回画像授权。删除后立即不可读,数据随后异步清理。此操作不可撤销。',
		confirmText: '删除',
		confirmColor: '#B4543E',
		success: async (modalRes) => {
			if (!modalRes.confirm) return
			try {
				const res = await deleteAiProfile(subject.value)
				if (!alive) return
				if (res.success) {
					cleanupPending.value = subject.value
					session.value = null
					draft.value = null
					messages.value = []
					currentQuestion.value = null
					narrativeMe.value = null
					narrativeTa.value = null
					sessionInfoMe.value = null
					sessionInfoTa.value = null
					backToShelf()
					uni.showToast({ title: '已删除,正在清理', icon: 'none' })
					setTimeout(async () => {
						if (!alive) return
						cleanupPending.value = ''
						await loadNarrative('personal')
						await loadNarrative('ideal_partner')
					}, 2000)
				} else {
					uni.showToast({ title: mapProfileError(symbolicCode(res), String(res.message)), icon: 'none' })
				}
			} catch (e) {
				uni.showToast({ title: '操作失败,请重试', icon: 'none' })
			}
		}
	})
}

const revokeConsent = () => {
	manageVisible.value = false
	uni.showModal({
		title: '撤回画像授权',
		content: '撤回后 AI 画像功能将不可用,相关数据会被异步清理。你可以随时重新授权。',
		confirmText: '撤回',
		confirmColor: '#B4543E',
		success: async (modalRes) => {
			if (!modalRes.confirm) return
			try {
				const listRes = await getAiConsents()
				if (!alive) return
				if (!listRes.success || listRes.data == null) {
					uni.showToast({ title: '授权状态查询失败', icon: 'none' })
					return
				}
				const privacyRevision = listRes.data.privacy_revision != null ? Number(listRes.data.privacy_revision) : 0
				const res = await revokeProfileTextConsent(privacyRevision)
				if (!alive) return
				if (res.success) {
					uni.showToast({ title: '授权已撤回', icon: 'none' })
					session.value = null
					draft.value = null
					messages.value = []
					consentRequired.value = true
					pendingSubject = subject.value
					consentMessage.value = ''
				} else {
					const code = symbolicCode(res)
					uni.showToast({ title: mapProfileError(code, String(res.message)), icon: 'none' })
				}
			} catch (e) {
				uni.showToast({ title: '操作失败,请重试', icon: 'none' })
			}
		}
	})
}

const doGrantConsent = async () => {
	if (granting.value) return
	granting.value = true
	try {
		const listRes = await getAiConsents()
		if (!alive) return
		if (!listRes.success || listRes.data == null) {
			uni.showToast({ title: '授权状态查询失败,请重试', icon: 'none' })
			return
		}
		const privacyRevision = listRes.data.privacy_revision != null ? Number(listRes.data.privacy_revision) : 0
		const res = await grantProfileTextConsent(privacyRevision)
		if (!alive) return
		if (res.success) {
			consentRequired.value = false
			consentMessage.value = ''
			uni.showToast({ title: '授权成功', icon: 'success' })
			viewMode.value = 'subject'
			subject.value = pendingSubject
			subjectPane.value = 'dialog'
			await ensureSession()
		} else {
			const code = symbolicCode(res)
			consentMessage.value = mapProfileError(code, String(res.message))
		}
	} catch (e) {
		uni.showToast({ title: '授权失败,请重试', icon: 'none' })
	} finally {
		if (alive) granting.value = false
	}
}

// ===== 消息流辅助 =====

	function addQuestionMessage(question: any) {
		if (question == null) return
		const qId = String(question.id != null ? question.id : '')
		const qText = String(question.text != null ? question.text : '')
		const fieldKey = question.field_key != null ? String(question.field_key) : ''

		for (let i = messages.value.length - 1; i >= 0; i--) {
			const msg = messages.value[i]
			if (msg == null || msg.type != 'question') continue
			const existingText = String(msg.text != null ? msg.text : '')
			if ((qId != '' && String(msg.id).indexOf('q-' + qId + '-') == 0) || existingText == qText) {
				return
			}
			break
		}

		let options: string[] = []
		// 枚举选项只挂在 personal 主体:ideal_partner 的同名字段是 set/range 形状,自由文本交 AI 抽取
		if (subject.value == 'personal' && fieldKey != '' && ENUM_FIELDS.indexOf(fieldKey) >= 0) {
			const opts = ENUM_OPTIONS.get(fieldKey)
			if (opts != null) {
				for (let i = 0; i < opts.length; i++) { options.push(opts[i].label) }
			}
		}

	messages.value.push({
		id: 'q-' + qId + '-' + Date.now(),
		type: 'question',
		text: qText,
		options: options,
		fieldKey: fieldKey
	})
	scrollToBottom()
}

function addAnswerMessage(text: string) {
	messages.value.push({
		id: 'a-' + Date.now(),
		type: 'answer',
		text: text
	})
	scrollToBottom()
}

function addTypingMessage(text: string, durationMs: number, onTimeout: (() => void) | null = null): string {
	const id = 'typing-' + Date.now() + '-' + Math.floor(Math.random() * 1000)
	messages.value.push({
		id: id,
		type: 'typing',
		text: text
	})
	scrollToBottom()
	if (durationMs > 0) {
		setTimeout(() => {
			if (!alive) return
			removeMessage(id)
			if (onTimeout != null) onTimeout()
		}, durationMs)
	}
	return id
}

function addSystemMessage(text: string) {
	messages.value.push({
		id: 'sys-' + Date.now(),
		type: 'system',
		text: text
	})
	scrollToBottom()
}

function removeMessage(id: string) {
	messages.value = messages.value.filter((m: any) => m.id != id)
}

function scrollToBottom() {
	nextTick(() => {
		if (messages.value.length > 0) {
			scrollAnchor.value = 'msg-' + messages.value[messages.value.length - 1].id
		}
	})
}

	const onAnswerInput = (e: any) => { answerText.value = e.detail.value }

	const goEditProfile = () => {
	uni.navigateTo({
		url: '/pagesSub/userExtra/user/edit',
		fail: () => { uni.showToast({ title: '页面打开失败', icon: 'none' }) }
	})
}

// ===== 生命周期:离场释放 =====
onUnmounted(() => {
	alive = false
	try {
		if (voiceRecorderRef.value != null) voiceRecorderRef.value.reset()
	} catch (e) {}
	try {
		if (conversationRef.value != null) conversationRef.value.reset()
	} catch (e) {}
})

// 初始化:并行拉取两个主体的叙事层
const init = async () => {
	loading.value = true
	await Promise.all([loadNarrative('personal'), loadNarrative('ideal_partner')])
	if (alive) loading.value = false
}
init()
</script>

<style>
/* ===== 墨相模块 Token(经用户 2026-08-22 重构授权,独立于全局 uni.scss,已登记 DESIGN.md) ===== */
.persona-root {
	--at-bg: #F7F1E5;
	--at-card: #FFFCF5;
	--at-ink: #2E2418;
	--at-ink2: #5C4F3D;
	--at-mist: #9A8C77;
	--at-line: #E6DAC4;
	--at-amber: #B4762B;
	--at-amber-deep: #8A5A1D;
	--at-honey: #D9A441;
	--at-fixed: #4E7D5B;
	--at-danger: #B4543E;

	min-height: 100vh;
	background: var(--at-bg);
	display: flex;
	flex-direction: column;
}

/* ===== 模块图标(单色描边,复用项目 iconfont 字库:社区互动与信息) ===== */
@font-face {
	font-family: "iconfont-social";
	src: url('/static/婚恋小程序图标/社区互动与信息/iconfont.woff2') format('woff2'),
		url('/static/婚恋小程序图标/社区互动与信息/iconfont.woff') format('woff');
}
.at-ic {
	font-family: "iconfont-social" !important;
	font-style: normal;
	-webkit-font-smoothing: antialiased;
	-moz-osx-font-smoothing: grayscale;
	color: var(--at-amber-deep);
}
.at-ic-yuyin:before { content: "\e888"; font-size: 18px; }
.at-ic-pinglun:before { content: "\e679"; font-size: 18px; }
.at-ic-love:before { content: "\e623"; font-size: 18px; }
.at-ic-biaoqing:before { content: "\e606"; font-size: 18px; }
.at-ic-canyuhuati:before { content: "\e608"; font-size: 18px; }
.at-ic-xianxiahuodong:before { content: "\e704"; font-size: 18px; }

/* ===== 导航 ===== */
.at-nav {
	position: relative;
	box-sizing: content-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding-left: 10px;
	padding-bottom: 8px;
	background: var(--at-bg);
}
.at-nav-side {
	z-index: 1;
	min-width: 66px;
	height: 40px;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	gap: 14px;
}
.at-nav-back { justify-content: flex-start; }
.at-back { font-size: 28px; color: var(--at-ink); padding: 0 8px; }
.at-nav-title {
	position: absolute;
	left: 0;
	right: 0;
	height: 40px;
	line-height: 40px;
	text-align: center;
	font-size: 17px;
	font-weight: 700;
	color: var(--at-ink);
	font-family: var(--serif);
	pointer-events: none;
}
.at-nav-action { font-size: 14px; color: var(--at-amber-deep); }

/* ===== 通用状态页 ===== */
.at-state { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48px 32px; }
.at-state-mark {
	width: 64px; height: 64px; border-radius: 999px; margin-bottom: 14px;
	background: var(--at-card); border: 1px solid var(--at-line);
	display: flex; align-items: center; justify-content: center;
}
.at-state-mark-text { font-size: 28px; color: var(--at-ink); opacity: 0.55; font-family: var(--serif); }
.at-state-title { font-size: 17px; font-weight: 700; color: var(--at-ink); text-align: center; font-family: var(--serif); }
.at-state-copy { font-size: 13px; color: var(--at-ink2); text-align: center; margin-top: 8px; line-height: 1.7; }
.at-state-btn { margin-top: 22px; padding: 11px 28px; background: var(--at-amber-deep); border-radius: 999px; }
.at-state-btn-text { font-size: 14px; font-weight: 700; color: #FFF6E8; }

/* 纸面呼吸点(加载/生成共用) */
.at-loading-steam, .at-curing-steam { display: flex; flex-direction: row; justify-content: center; gap: 10px; margin-bottom: 14px; }
.at-steam-dot {
	width: 10px; height: 10px; border-radius: 999px;
	background: radial-gradient(circle at 50% 50%, rgba(180, 118, 43, 0.45), rgba(180, 118, 43, 0) 70%);
	animation: at-steam-rise 2.6s ease-in-out infinite;
}
.at-steam-dot-2 { animation-delay: 0.85s; }
.at-steam-dot-3 { animation-delay: 1.7s; }
@keyframes at-steam-rise {
	0% { transform: translateY(8px) scale(0.7); opacity: 0; }
	40% { opacity: 0.9; }
	100% { transform: translateY(-16px) scale(1.5); opacity: 0; }
}

/* ===== 授权门槛 ===== */
.at-gate { flex: 1; display: flex; flex-direction: column; padding: 30px 26px; }
.at-gate-title { font-size: 24px; font-weight: 700; color: var(--at-ink); font-family: var(--serif); }
.at-gate-sub { font-size: 13px; color: var(--at-ink2); margin-top: 6px; }
.at-gate-card {
	display: flex; flex-direction: column; gap: 14px;
