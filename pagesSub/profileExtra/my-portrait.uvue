/* 对话流 */
.pp-body { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.pp-chat-flow { flex: 1; padding: 12px 16px; }
.pp-chat-spacer { height: 100px; }

.pp-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 0; }
.pp-empty-title { font-size: 15px; font-weight: 700; color: var(--muted); }
.pp-empty-sub { font-size: 12px; color: var(--muted); margin-top: 6px; }

.pp-msg { margin-bottom: 10px; }
.pp-msg-left { display: flex; flex-direction: row; justify-content: flex-start; }
.pp-msg-right { display: flex; flex-direction: row; justify-content: flex-end; }
.pp-msg-system { display: flex; flex-direction: row; justify-content: center; }
.pp-msg-field { margin: 4px 0; }

.pp-bubble { max-width: 78%; padding: 10px 14px; border-radius: 12px; }
.pp-bubble-ai { background: var(--surface); border: 1px solid var(--line); border-bottom-left-radius: 4px; }
.pp-bubble-user { background: var(--accent); border-bottom-right-radius: 4px; }
.pp-bubble-text { font-size: 14px; line-height: 1.6; }
.pp-bubble-ai .pp-bubble-text { color: var(--ink); }
.pp-bubble-user .pp-bubble-text { color: var(--text-invert); }

/* 枚举选项 */
.pp-options { display: flex; flex-direction: row; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.pp-option-chip { padding: 4px 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--paper); }
.pp-option-chip.selected { background: var(--accent-bg); border-color: var(--accent); }
.pp-option-chip-text { font-size: 12px; color: var(--ink2); }
.pp-option-chip.selected .pp-option-chip-text { color: var(--accent2); }

/* 打字指示器 */
.pp-typing { display: flex; flex-direction: row; align-items: center; gap: 4px; }
.pp-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); animation: pp-bounce 0.6s ease-out infinite alternate; }
.pp-dot:nth-child(2) { animation-delay: 0.15s; }
.pp-dot:nth-child(3) { animation-delay: 0.3s; }
.pp-typing-text { font-size: 12px; color: var(--muted); margin-left: 4px; }
@keyframes pp-bounce { from { opacity: 0.3; transform: translateY(0); } to { opacity: 1; transform: translateY(-4px); } }

/* 系统提示 */
.pp-system-text { font-size: 12px; color: var(--muted); text-align: center; }

/* 底部操作栏 */
.pp-input-bar { padding: 8px 16px; padding-bottom: calc(8px + env(safe-area-inset-bottom)); background: var(--paper); border-top: 1px solid var(--line); }
.pp-input-row { display: flex; flex-direction: row; align-items: center; gap: 8px; }
.pp-input { flex: 1; height: 38px; padding: 0 12px; border: 1px solid var(--line); border-radius: 9px; font-size: 14px; color: var(--ink); background: var(--surface); }
.pp-ph { color: var(--muted); }
.pp-send-btn { padding: 0 16px; height: 38px; display: flex; align-items: center; justify-content: center; border-radius: 9px; background: var(--bg-subtle); }
.pp-send-ready { background: var(--accent); }
.pp-send-text { font-size: 14px; font-weight: 700; color: var(--text-invert); }

.pp-bar-status { flex: 1; display: flex; align-items: center; justify-content: center; height: 38px; }
.pp-bar-status-text { font-size: 13px; color: var(--muted); }

.pp-publish-row { justify-content: space-between; }
.pp-publish-info { font-size: 13px; color: var(--ink2); }
.pp-publish-btn { padding: 0 20px; height: 38px; display: flex; align-items: center; justify-content: center; border-radius: 9px; background: var(--bg-subtle); }
.pp-publish-ready { background: var(--accent); }
.pp-publish-text { font-size: 14px; font-weight: 700; color: var(--text-invert); }

/* 语音输入区 */
.pp-voice-area { display: flex; flex-direction: column; align-items: center; padding: 8px 0; }
.pp-mode-switch { margin-top: 8px; padding: 4px 12px; }
.pp-mode-switch-text { font-size: 12px; color: var(--accent2); font-weight: 600; }
.pp-mode-switch-inline { margin-left: 4px; }

/* 转写确认卡片 */
.pp-transcribe-row { flex-direction: column; align-items: stretch; }
.pp-transcribe-card { background: var(--surface); border: 1px solid var(--line); border-radius: 9px; padding: 10px; }
.pp-transcribe-label { font-size: 11px; color: var(--muted); font-weight: 600; margin-bottom: 4px; }
.pp-transcribe-input { width: 100%; min-height: 48px; font-size: 14px; color: var(--ink); line-height: 1.5; }
.pp-transcribe-foot { display: flex; flex-direction: row; justify-content: flex-end; gap: 8px; margin-top: 8px; }
.pp-transcribe-retry { padding: 6px 14px; border-radius: 8px; border: 1px solid var(--line); }
.pp-transcribe-retry-text { font-size: 12px; font-weight: 700; color: var(--muted); }
.pp-transcribe-confirm { padding: 6px 14px; border-radius: 8px; background: var(--accent); }
.pp-transcribe-confirm-text { font-size: 12px; font-weight: 700; color: var(--text-invert); }
