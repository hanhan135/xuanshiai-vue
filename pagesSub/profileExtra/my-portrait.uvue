	box-shadow: 0 1px 3px rgba(160, 90, 62, 0.35);
	animation: at-seal-in 0.5s cubic-bezier(0.2, 1.4, 0.4, 1) both;
}
.at-letter-seal-text { font-size: 13px; color: #FFF6E8; font-weight: 700; font-family: var(--serif); }
@keyframes at-seal-in { from { transform: scale(0) rotate(-8deg); opacity: 0; } to { transform: scale(1) rotate(0); opacity: 1; } }
.at-letter-block { margin-top: 22px; }
.at-block-label { font-size: 11px; color: var(--at-ink2); font-weight: 700; letter-spacing: 0.12em; }
.at-block-serif { font-size: 15px; color: var(--at-ink); line-height: 1.9; margin-top: 8px; font-family: var(--serif); text-align: justify; }

.at-dim-row {
	display: flex; flex-direction: row; align-items: flex-start; gap: 10px;
	padding: 12px 14px; margin-top: 8px;
	background: var(--at-card); border: 1px solid var(--at-line); border-radius: 12px;
}
.at-dim-icon { font-size: 18px; width: 26px; }
.at-dim-main { flex: 1; display: flex; flex-direction: column; }
.at-dim-title { font-size: 14px; font-weight: 700; color: var(--at-ink); }
.at-dim-summary { font-size: 12px; color: var(--at-ink2); line-height: 1.6; margin-top: 4px; }

.at-weight-row { display: flex; flex-direction: row; align-items: center; gap: 10px; padding: 6px 0; }
.at-weight-label { width: 66px; font-size: 12px; color: var(--at-ink2); }
.at-weight-track { flex: 1; height: 5px; background: rgba(230, 218, 196, 0.6); border-radius: 999px; overflow: hidden; }
.at-weight-fill { height: 100%; background: var(--at-honey); border-radius: 999px; transition: width 0.4s ease-out; }
.at-weight-percent { width: 38px; text-align: right; font-size: 12px; color: var(--at-ink2); }

.at-change-block { padding: 14px 16px; background: var(--at-card); border: 1px solid var(--at-line); border-radius: 12px; }
.at-change-summary { font-size: 14px; color: var(--at-amber-deep); font-weight: 700; margin-top: 8px; line-height: 1.5; }
