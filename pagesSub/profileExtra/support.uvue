<template>
	<view class="support-page"><view class="support-nav"><text class="ic ic-sys ic-fanhui back" @tap="back"></text><view class="nav-title"><text class="ic ic-sys ic-bangzhu"></text><text>帮助与客服</text></view><view class="placeholder"></view></view><view class="support-table"><view v-for="group in groups" :key="group.title" class="support-group"><view class="group-label"><text :class="'ic ic-sys ' + group.icon + ' group-icon'"></text><text>{{ group.title }}</text></view><view class="question-list"><view v-for="question in group.questions" :key="question" class="question" @tap="answer(question)"><text>{{ question }}</text></view></view></view></view><view class="support-footer"><view @tap="contact"><text class="ic ic-sys ic-kefu"></text><text>联系客服</text></view><view @tap="feedback"><text class="ic ic-sys ic-bangzhu"></text><text>意见箱</text></view></view></view>
</template>
<script setup lang="uts">
const groups = [{ title: '常见问题', icon: 'ic-bangzhu', questions: ['喜欢、小纸条后可以取消吗', '我初来乍到，如何在平台交友', '看见心仪的TA，如何开启聊天', '我为什么不能看“谁喜欢我”和“访客”'] }, { title: '完善资料和认证', icon: 'ic-shiming', questions: ['资料和认证审核多久能通过', '为什么我必须要通过身份和学历认证才能聊天', '我提交的认证资料有泄漏风险嘛？', '什么是可信度'] }, { title: '嘉宾推荐', icon: 'ic-peidui', questions: ['为什么每天限量推荐有限嘉宾', '推荐嘉宾数量不足或重复', '推荐的人不符合要求'] }, { title: '其他', icon: 'ic-gengduo', questions: ['脱单了如何修改感情状态', '什么是“小纸条”'] }]
