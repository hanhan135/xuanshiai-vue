<template>
	<view class="top-page">
		<view class="top-nav">
			<view class="nav-back" @tap="goBack"><text class="nav-back-icon">‹</text></view>
			<text class="nav-title">我要置顶</text>
			<view class="nav-placeholder"></view>
		</view>

		<scroll-view scroll-y class="top-scroll" :show-scrollbar="false">
			<view v-if="loading" class="state-panel"><text>正在读取置顶状态...</text></view>
			<view v-else-if="paymentSuccess && successOrder != null" class="success-panel">
				<view class="success-mark"><text>✓</text></view>
				<text class="success-title">置顶已开启</text>
				<text class="success-copy">支付已确认，你的资料将进入广场置顶推荐。</text>
				<view class="remaining-card"><text class="remaining-label">剩余置顶</text><text class="remaining-days">{{ successOrder.remainingDays }} 天</text><text class="remaining-copy">有效期至 {{ formatDate(successOrder.expiresAt) }}</text></view>
				<view class="success-order"><text>套餐 · {{ successOrder.planName }}</text><text>¥{{ successOrder.amount }}</text></view>
				<view class="success-order"><text>订单号</text><text>{{ successOrder.orderNo }}</text></view>
				<view class="success-action" @tap="goBack"><text>返回广场</text></view>
			</view>
			<view v-else class="purchase-content">
					<view class="hero-banner"><text class="hero-title"><text class="hero-icon">↑</text> 置顶尊享特权</text><text class="hero-copy">优先排序在最前，吸引更多关注，增加相亲成功率</text></view>

				<view class="active-status"><text class="active-title">{{ activeStatus.active ? '您当前正在置顶' : '您当前还未置顶' }}</text><text class="active-status-copy">{{ activeStatus.active ? '继续购买会在现有有效期基础上延长' : '置顶可让脱单成功率翻倍哦' }}</text></view>
				<view v-if="recommendImages.length > 0" class="recommend-banner"><view class="recommend-heading"><text>置顶推荐</text><text class="recommend-link">我要置顶 ›</text></view><view class="recommend-images"><image v-for="image in recommendImages" :key="image" :src="image" mode="aspectFill"></image></view></view>

				<view class="plans-section">
					<text class="section-title">选择置顶套餐</text>
					<view class="plans-list">
						<view v-for="(plan, index) in plans" :key="plan.id" class="plan-card" :class="{ selected: selectedPlanIndex === index }" @tap="selectPlan(index)">
							<text class="plan-name">{{ plan.name }}</text><text class="plan-price">¥{{ plan.price }}</text>
						</view>
					</view>
				</view>

				<view class="benefits-section"><view class="benefit-heading"><text class="heading-dot"></text><text>置顶专属权益</text><text class="heading-dot"></text></view><view class="benefit-icons"><view v-for="item in benefits" :key="item.title" class="benefit-item"><view class="benefit-icon"><text>{{ item.icon }}</text></view><text>{{ item.title }}</text><text class="benefit-desc">{{ item.desc }}</text></view></view></view>
				<view class="notice-card"><text class="notice-title">温馨提示</text><text class="notice-copy">置顶用于提升资料展示机会，不承诺匹配或关系结果。购买后可随时查看剩余有效天数。</text></view>
				<view class="bottom-space"></view>
			</view>
		</scroll-view>

		<view v-if="!loading && !paymentSuccess && plans.length > 0" class="footer-safe"><view class="total-row"><text>合计：</text><text class="total-price">¥{{ selectedPlan.price }}</text></view><view class="pay-button" :class="{ disabled: paying }" @tap="openPayment"><text>{{ paying ? '支付确认中…' : '确认支付' }}</text></view></view>
		<XsaPaymentSheet :visible="paymentVisible" :amount="selectedPlan.price" :loading="paying" @close="closePayment" @confirm="confirmPayment" />
	</view>
</template>

<script setup lang="uts">
import { getTopPlacementStatus, getTopPlacementPackages, payTopPlacement, TopPlacementPlan, TopPlacementOrder } from '@/api/top-placement.uts'
import { getDiscoveryPlaza } from '@/api'
import { resolveMediaUrl } from '@/api/config.uts'
import XsaPaymentSheet from '@/components/XsaPaymentSheet.uvue'

const plans = ref<TopPlacementPlan[]>([])
const benefits = [
	{ icon: '↑', title: '优先展示', desc: '推荐列表置顶' },
	{ icon: '◎', title: '精准触达', desc: '推送给高意向用户' },
	{ icon: '✦', title: '更多匹配', desc: '更多用户看到你' }
]
const selectedPlanIndex = ref(0)
const activeStatus = ref<any>({ active: false, remainingDays: 0, expiresAt: 0 })
const loading = ref(true)
const paymentVisible = ref(false)
const paying = ref(false)
const paymentSuccess = ref(false)
const successOrder = ref<TopPlacementOrder | null>(null)
const recommendImages = ref<string[]>([])
const selectedPlan = computed(() => plans.value.length > selectedPlanIndex.value ? plans.value[selectedPlanIndex.value] : { id: '', name: '', days: 0, price: 0, tag: '', recommended: false } as TopPlacementPlan)

const loadStatus = async () => {
	loading.value = true
	try {
		const [statusResult, packageResult] = await Promise.all([getTopPlacementStatus(), getTopPlacementPackages()])
		activeStatus.value = statusResult.success && statusResult.data != null ? statusResult.data : { active: false, remainingDays: 0, expiresAt: 0 }
		if (packageResult.success && packageResult.data != null) {
			plans.value = packageResult.data as TopPlacementPlan[]
			if (selectedPlanIndex.value >= plans.value.length) selectedPlanIndex.value = 0
		}
		const plazaResult = await getDiscoveryPlaza({ page: 1, page_size: 4 })
		if (plazaResult.success && plazaResult.data != null) {
			const items = (plazaResult.data as any).items as any[]
			const images: string[] = []
			for (let i = 0; i < items.length; i++) {
				const image = resolveMediaUrl(items[i] != null ? items[i].avatar : '')
				if (image != '') images.push(image)
				if (images.length >= 2) break
			}
			recommendImages.value = images
		}
	} catch (e) {
		activeStatus.value = { active: false, remainingDays: 0, expiresAt: 0 }
	} finally { loading.value = false }
}
const selectPlan = (index: number) => { if (!paying.value) selectedPlanIndex.value = index }
const openPayment = () => { if (!paying.value && selectedPlan.value.id != '') paymentVisible.value = true }
const closePayment = () => { if (!paying.value) paymentVisible.value = false }
const confirmPayment = async () => {
	if (paying.value) return
	try {
		paying.value = true
		const result = await payTopPlacement(selectedPlan.value)
		if (!result.success || result.data == null) { uni.showToast({ title: result.message, icon: 'none' }); return }
		successOrder.value = result.data
		paymentVisible.value = false
		paymentSuccess.value = true
	} catch (e) { uni.showToast({ title: '付款确认失败，请稍后重试', icon: 'none' }) } finally { paying.value = false }
}
const formatDate = (timestamp: number): string => {
	const date = new Date(timestamp)
	return String(date.getFullYear()) + '年' + String(date.getMonth() + 1) + '月' + String(date.getDate()) + '日'
}
const goBack = () => { uni.navigateBack({}) }
onMounted(() => { loadStatus() })
</script>

<style scoped>
.top-page { min-height: 100vh; background: #F7F7FB; color: #25252A; }
.top-nav { position: relative; z-index: 2; flex-shrink: 0; height: 100px; padding: 44px 16px 0; box-sizing: border-box; display: flex; flex-direction: row; align-items: center; justify-content: space-between; background: #FAFAFC; }.nav-back { width: 40px; height: 40px; display: flex; flex-direction: row; align-items: center; justify-content: center; color: #25252A; font-size: 22px; }.nav-back-icon { font-family: Arial, sans-serif; font-size: 34px; font-weight: 300; line-height: 34px; transform: translateY(-1px); }.nav-title { font-size: 20px; font-weight: 700; }.nav-placeholder { width: 40px; }
.top-scroll { height: calc(100vh - 100px); }.purchase-content { display: flex; flex-direction: column; gap: 0; padding-bottom: 150px; }.hero-banner { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 24px 20px 30px; background: linear-gradient(135deg, #C348E2, #BD3EDB 55%, #D353E9); color: #FFFFFF; }.hero-title { font-size: 27px; font-weight: 800; }.hero-icon { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 8px; background: rgba(255,255,255,.3); font-size: 23px; }.hero-copy { font-size: 14px; }.active-status { margin: -1px 20px 0; padding: 20px 18px; border-radius: 22px 22px 0 0; background: #FFFFFF; color: #2D2D32; display: flex; flex-direction: column; gap: 6px; font-size: 20px; font-weight: 800; }.active-title { display: block; }.active-status-copy { color: #A4A4AA; font-size: 14px; font-weight: 400; }.recommend-banner { margin: 0 20px; padding: 14px 12px 16px; background: #FFFFFF; border-top: 1px solid #ECECF0; }.recommend-heading { display: flex; flex-direction: row; align-items: center; justify-content: space-between; color: #4D3F68; font-size: 17px; font-weight: 800; }.recommend-link { padding: 8px 13px; border-radius: 18px; background: #F7D6F9; color: #C14AD6; font-size: 12px; }.recommend-images { display: flex; flex-direction: row; gap: 8px; margin-top: 12px; overflow: hidden; border-radius: 14px; }.recommend-images image { width: calc(50% - 4px); height: 72px; }.plans-section { padding: 24px 20px 14px; background: #FFFFFF; }.section-title { display: block; margin-bottom: 18px; font-size: 21px; font-weight: 800; }.plans-list { display: flex; flex-direction: column; gap: 16px; }.plan-card { position: relative; width: 100%; min-height: 84px; box-sizing: border-box; display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 20px; border: 1px solid #ECECF0; border-radius: 14px; background: #FFFFFF; }.plan-card.selected { border: 2px solid #E7C4EC; background: #FFF4FF; }.plan-name { margin-top: 0; font-size: 23px; font-weight: 800; }.plan-price { margin-top: 0; font-size: 27px; font-weight: 800; }.plan-price::first-letter { font-size: 17px; }
.benefits-section { padding: 8px 16px 16px; background: #FAF7F0; }.benefit-heading { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 12px; font-size: 17px; font-weight: 600; }.heading-dot { width: 6px; height: 6px; border-radius: 50%; background: #C9A96E; }.benefit-icons { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; gap: 8px; margin-top: 16px; }.benefit-item { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 6px; width: auto; color: #4B5563; font-size: 11px; text-align: center; }.benefit-icon { width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #E2EBE0; color: #627A5F; font-size: 23px; }.benefit-desc { color: #A0B0A2; font-size: 10px; text-align: center; }.notice-card { margin: 0 16px; padding: 16px; border-radius: 16px; background: #F8F9F6; border: 1px solid #DCE8D8; display: flex; flex-direction: column; gap: 8px; }.notice-title { font-size: 14px; font-weight: 600; }.notice-copy { color: #4B5563; font-size: 12px; line-height: 1.6; }.bottom-space { height: 12px; }
.footer-safe { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; display: flex; flex-direction: row; align-items: center; gap: 24px; padding: 14px 16px calc(env(safe-area-inset-bottom) + 14px); background: rgba(255,255,255,.98); border-top: 1px solid #ECECF0; }.total-row { display: flex; flex-direction: row; align-items: baseline; gap: 3px; color: #33333A; font-size: 20px; font-weight: 800; white-space: nowrap; }.total-price { color: #B74DCE; font-size: 26px; font-weight: 800; }.total-days { display: none; }.pay-button { flex: 1; height: 56px; margin-top: 0; border-radius: 28px; display: flex; align-items: center; justify-content: center; background: linear-gradient(90deg, #E5A0F5, #F1B0F5); color: #24172B; font-size: 17px; font-weight: 800; }.pay-button.disabled { opacity: .56; }
.state-panel, .success-panel { margin: 32px 16px; padding: 36px 20px; border-radius: 20px; background: #F8F9F6; border: 1px solid #DCE8D8; display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; color: #4B5563; font-size: 14px; }.success-mark { width: 76px; height: 76px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #E2EBE0; border: 2px solid #A8C0A5; color: #627A5F; font-size: 38px; font-weight: 700; }.success-title { color: #1A1A1A; font-family: 'Playfair Display'; font-size: 28px; font-weight: 700; }.success-copy { color: #4B5563; font-size: 13px; line-height: 1.6; }.remaining-card { width: 100%; padding: 18px 12px; border-radius: 14px; background: linear-gradient(135deg, #E8EDE4, #F0EBE0); display: flex; flex-direction: column; gap: 4px; }.remaining-label { color: #627A5F; font-size: 12px; }.remaining-days { color: #1A1A1A; font-size: 30px; font-weight: 700; }.remaining-copy { color: #4B5563; font-size: 11px; }.success-order { width: 100%; padding: 12px 0; border-top: 1px solid #DCE8D8; display: flex; justify-content: space-between; gap: 12px; color: #4B5563; font-size: 12px; text-align: left; }.success-order text:last-child { color: #1A1A1A; }.success-action { width: 100%; height: 50px; border-radius: 20px; background: linear-gradient(90deg, #E6EBD8, #E8CFA5); color: #1A1A1A; display: flex; align-items: center; justify-content: center; font-size: 17px; font-weight: 700; }
</style>
