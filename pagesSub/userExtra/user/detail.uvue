			<view v-if="!isLockedView && isOwnProfile && !isPreview && !detailLoading && detailError == ''" class="bottom-bar bottom-bar-own">
				<view class="primary-action edit-only-btn" @tap="goEdit"><text class="primary-action-text">编辑资料</text></view>
			</view>
			<view v-if="!isOwnProfile && !isPreview && !detailLoading && detailError == ''" class="bottom-bar">
			<view class="bottom-back" @tap="onBack"><text class="bottom-back-icon">←</text><text class="bottom-back-text">返回</text></view>
			<view class="primary-action" @tap="onMatch"><text class="primary-action-text">♥　申请认识</text></view>
			<view class="like-action" @tap="onLike"><text class="like-action-text">♥</text></view>
		</view>

		<XsaApplySheet :visible="applyVisible" :user-id="applyUserId" @close="applyVisible = false" @success="onApplySuccess" />
		<XsaPaymentSheet :visible="spotlightPaymentVisible" :amount="SPOTLIGHT_AMOUNT" :loading="spotlightPaying" confirm-text="确认支付爆灯" notice="爆灯 9.9 元/次：确认后展示爆灯成功状态。" @close="closeSpotlightPayment" @confirm="confirmSpotlightPayment" />
		<XsaSpotlightSuccessSheet :visible="spotlightSuccessVisible" :target="spotlightTarget" @close="closeSpotlightSuccess" />
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import XsaEmpty from '@/components/XsaEmpty.uvue'
import XsaApplySheet from '@/components/XsaApplySheet.uvue'
import XsaPaymentSheet from '@/components/XsaPaymentSheet.uvue'
import XsaSpotlightSuccessSheet from '@/components/XsaSpotlightSuccessSheet.uvue'
import { getUserDetail, likeUser, getOwnProfile } from '@/api'
import { SPOTLIGHT_AMOUNT, paySpotlight } from '@/api/spotlight.uts'
import { guardRealName } from '@/utils/realNameGate.uts'
import { getCurrentUserVipStatus } from '@/utils/quota.uts'

const isLockedView = ref(false)
const isOwnProfile = ref(false)
const isPreview = ref(false)
const detailLoading = ref(true)
const detailError = ref('')
const applyVisible = ref(false)
const applyUserId = ref(1)
const spotlightPaymentVisible = ref(false)
const spotlightSuccessVisible = ref(false)
const spotlightPaying = ref(false)
const spotlightTarget = ref({ id: 0, name: '', avatar: '', meta: '' })

const user = ref({
	id: 1,
	name: '林悦',
	age: '26',
	avatar: '/static/portraits/profile-woman-main.jpg',
	isVIP: true,
	job: '产品经理',
	edu: '本科',
	city: '北京',
	online: '当前在线',
	distance: '距你 3.2km',
	recentActivity: '近期活跃',
	match: 92,
	tags: ['积极营业', 'ENFJ', '颜控', '旅行', '摄影'],
	bio: '性格温和，热爱生活～ 平时喜欢旅行探索世界，也享受宅家的宁静时光。希望遇到一个真诚的人，一起经营温暖的小日子。',
	photos: [
		'/static/portraits/profile-woman-main.jpg',
		'/static/portraits/profile-woman-alt.jpg'
	],
	lifePhotos: [
		'/static/portraits/profile-woman-community.jpg',
		'/static/portraits/profile-woman-alt.jpg',
		'/static/portraits/profile-woman-main.jpg'
	],
	expect: [
		'愿意把真实想法说清楚，不用猜来猜去',
		'各自有生活，也愿意为共同计划留出时间',
		'把长期关系当作两个人一起完成的作品'
	],
	basicInfo: [
		[{ label: '年龄', value: '26岁' }, { label: '身高', value: '168cm' }, { label: '体重', value: '52kg' }],
		[{ label: '星座', value: '天秤座' }, { label: '学历', value: '本科' }, { label: '职业', value: '产品经理' }],
		[{ label: '现居', value: '北京朝阳' }, { label: '家乡', value: '浙江杭州' }, { label: '收入', value: '30-50万' }]
	]
})

const certs = ref([
	{ icon: '盾', shortLabel: '实名', label: '实名认证', desc: '已通过平台实名认证' },
	{ icon: '学', shortLabel: '学历', label: '学历认证', desc: '学历信息已核验' },
	{ icon: '像', shortLabel: '头像', label: '头像认证', desc: '头像为本人真实照片' },
	{ icon: '房', shortLabel: '房产', label: '房产认证', desc: '房产信息已认证' }
])

const visitors = ref([
	{ name: '张伟', avatar: '/static/portraits/profile-woman-alt.jpg' },
	{ name: '李明', avatar: '/static/portraits/profile-man-light.jpg' },
	{ name: '王强', avatar: '/static/portraits/profile-man-sea.jpg' },
	{ name: '刘洋', avatar: '/static/portraits/profile-woman-community.jpg' }
])

const dynamics = ref([
	{ id: 1, time: '2小时前 · 大理', content: '周末和朋友去了趟大理，洱海边的风真的好舒服。停下来拍照的时候，感觉整个世界都慢下来了。', photo: '/static/portraits/profile-woman-community.jpg', topic: '#旅行', likes: 89, comments: 12 },
	{ id: 2, time: '昨天 18:30 · 奥体中心', content: '完成了人生第一个半马！虽然很累，但冲线的那一刻，一切都值得。', photo: '/static/portraits/profile-woman-alt.jpg', topic: '#健身', likes: 156, comments: 28 },
	{ id: 3, time: '3天前 · 蜂巢剧场', content: '新年第一场脱口秀。笑到腹肌疼，才发现快乐原来这么简单。', photo: '/static/portraits/profile-woman-main.jpg', topic: '#生活', likes: 203, comments: 8 }
])

const textValue = (value: any, fallback: string): string => {
	return value != null && value != '' ? '' + value : fallback
}

const mapDetailUser = (raw: any, id: number) => {
	if (raw == null) return
	const envelope = raw.data != null ? raw.data : raw
	if (envelope == null) return
	const card = envelope.card != null ? envelope.card : envelope
	const profile = envelope.profile != null ? envelope.profile : envelope
	const value = (primary: any, secondary: any, fallback: string): string => {
		return textValue(primary, textValue(secondary, fallback))
	}
	const age = value(card.age, profile.age, user.value.age)
	const educationLabel = (level: any): string => {
		const labels = ['', '高中及以下', '大专', '本科', '硕士', '博士']
		const index = level != null ? Number(level) : 0
		return index > 0 && index < labels.length ? labels[index] : ''
	}
	const edu = value(card.education, profile.education, value(card.edu, educationLabel(profile.education_level), user.value.edu))
	const job = value(card.job, profile.occupation, user.value.job)
	const city = value(card.city, profile.city_code, user.value.city)
	const height = value(card.height, profile.height != null ? '' + profile.height + 'cm' : null, '168cm')
	const weight = value(card.weight, profile.weight != null ? '' + profile.weight + 'kg' : null, '52kg')
	const constellation = value(card.constellation, profile.constellation, '天秤座')
	const hometown = value(card.hometown, profile.hometown, '浙江杭州')
	const income = value(card.income, profile.income, value(card.salary, profile.income, '30-50万'))
	const marriage = value(card.marriage, profile.is_married == 1 ? '未婚' : profile.is_married == 2 ? '离异' : profile.is_married == 3 ? '丧偶' : null, '未填写')
	const mbti = value(card.mbti, profile.mbti, '未填写')
	const activeStatus = value(card.activeStatus, card.active_status, '未填写')
	const avatar = value(card.avatar, profile.avatar, user.value.avatar)
	const rawPhotos = card.photos != null ? card.photos : profile.photos
	const photos = Array.isArray(rawPhotos)
		? (rawPhotos as any[]).map((photo: any) => photo != null && typeof photo === 'object' ? value(photo.url, photo.file_url, avatar) : '' + photo)
		: user.value.photos
	const lifePhotos = Array.isArray(card.lifePhotos) && card.lifePhotos.length >= 3
		? card.lifePhotos as string[]
		: photos.length >= 3 ? photos.slice(0, 3) : user.value.lifePhotos
	const tags = Array.isArray(card.tags) ? card.tags as string[] : Array.isArray(profile.interest_tags) ? profile.interest_tags as string[] : user.value.tags
	const expectations = profile.tag_selections != null && Array.isArray(profile.tag_selections.relationship_expectation)
		? profile.tag_selections.relationship_expectation as string[]
		: Array.isArray(card.expect) && card.expect.length > 0 ? card.expect as string[] : user.value.expect
	const mappedInfo = [
		[{ label: '年龄', value: age + '岁' }, { label: '身高', value: height }, { label: '体重', value: weight }],
		[{ label: '星座', value: constellation }, { label: '学历', value: edu }, { label: '职业', value: job }],
		[{ label: '现居', value: city }, { label: '家乡', value: hometown }, { label: '收入', value: income }],
		[{ label: '婚姻', value: marriage }, { label: 'MBTI', value: mbti }, { label: '状态', value: activeStatus }]
	]
	user.value = {
		...user.value,
		id: envelope.user_id != null ? Number(envelope.user_id) : (card.id != null ? Number(card.id) : id),
		name: value(card.name, card.nickname, user.value.name),
		age,
		avatar,
		isVIP: card.isVip === true || card.isVIP === true || profile.isVip === true || profile.isVIP === true,
		job,
		edu,
		city,
		online: value(card.online, card.online_status, user.value.online),
		distance: value(card.distance, null, user.value.distance),
		recentActivity: value(card.recentActivity, card.activeStatus, user.value.recentActivity),
		match: card.match != null ? Number(card.match) : user.value.match,
		tags,
		bio: value(card.intro, profile.self_intro, value(card.introduction, profile.introduction, user.value.bio)),
		photos: photos.length > 0 ? photos : user.value.photos,
		lifePhotos,
		expect: expectations,
		basicInfo: Array.isArray(card.basicInfo) && card.basicInfo.length > 0 ? card.basicInfo : mappedInfo
	}
	applyUserId.value = user.value.id
}

const load = async () => {
	detailLoading.value = true
	detailError.value = ''
	try {
		let res: any = null
		if (isOwnProfile.value) {
			res = await getOwnProfile()
		} else {
			res = await getUserDetail(user.value.id)
		}
		if (res != null && res.success === true && res.data != null) {
			mapDetailUser(res, user.value.id)
		} else {
			detailError.value = res != null && res.message != null ? '' + res.message : '请稍后重试'
		}
	} catch (e) {
		detailError.value = '网络异常，请稍后重试'
	} finally {
		detailLoading.value = false
		refreshLockedView()
	}
}

const refreshLockedView = () => {
	const viewerIsVip = getCurrentUserVipStatus()
	const targetIsVip = user.value.isVIP === true
	isLockedView.value =
		!isPreview.value &&
		!isOwnProfile.value &&
		viewerIsVip !== true &&
		targetIsVip
}

onMounted(async () => {
	const pages = getCurrentPages()
	const currentPage = pages[pages.length - 1]
	const options = currentPage.options
	isOwnProfile.value = options.own === 'true'
	isPreview.value = options.preview === 'true'

	let parsed = 1
	if (options.userId != null && options.userId != '') {
		const candidate = Number(options.userId)
		if (!isNaN(candidate) && candidate > 0) parsed = candidate
	}
	user.value.id = parsed
	applyUserId.value = parsed
	await load()
})

onShow(() => {
	refreshLockedView()
})

const onBack = () => { uni.navigateBack({ delta: 1 }) }
const onShare = () => { uni.showToast({ title: '分享给朋友', icon: 'none' }) }
const goEdit = () => { uni.navigateTo({ url: '/pagesSub/userExtra/user/edit' }) }
const onSpotlight = () => {
	if (isOwnProfile.value) {
		uni.showToast({ title: '不能向自己爆灯', icon: 'none' })
		return
	}
	if (spotlightPaying.value) return
	spotlightTarget.value = { id: Number(user.value.id), name: '' + user.value.name, avatar: '' + user.value.avatar, meta: '' + user.value.age + '岁 · ' + user.value.job }
	spotlightPaymentVisible.value = true
}
const closeSpotlightPayment = () => { if (!spotlightPaying.value) spotlightPaymentVisible.value = false }
const closeSpotlightSuccess = () => {
	spotlightSuccessVisible.value = false
	spotlightTarget.value = { id: 0, name: '', avatar: '', meta: '' }
}
const confirmSpotlightPayment = async () => {
	if (spotlightPaying.value) return
	spotlightPaying.value = true
	try {
		const res = await paySpotlight(spotlightTarget.value)
		if (res.success !== true) {
			uni.showToast({ title: res.message != null ? '' + res.message : '支付失败，请重试', icon: 'none' })
			return
		}
		spotlightPaymentVisible.value = false
		spotlightSuccessVisible.value = true
	} catch (e) {
		uni.showToast({ title: '网络异常，支付未完成', icon: 'none' })
	} finally {
		spotlightPaying.value = false
	}
}
const openVipUnlock = () => {
	const redirect = '/pagesSub/userExtra/user/detail?userId=' + user.value.id
	uni.navigateTo({
		url: '/pagesSub/profileExtra/vip?source=user-detail&userId=' + user.value.id + '&redirect=' + encodeURIComponent(redirect)
	})
}
const onMatch = async () => {
	if (isOwnProfile.value) {
		uni.showToast({ title: '不能向自己申请认识', icon: 'none' })
		return
	}
	const ok = await guardRealName('apply')
	if (!ok) return
	applyUserId.value = user.value.id
	applyVisible.value = true
}
const onApplySuccess = (_payload: any) => {
	applyVisible.value = false
	uni.showToast({ title: '申请已送达，等待对方回应', icon: 'none' })
}
const onLike = async () => {
	if (isOwnProfile.value) {
		uni.showToast({ title: '不能喜欢自己', icon: 'none' })
		return
	}
	const ok = await guardRealName('like')
	if (!ok) return
	const id = user.value.id != null ? Number(user.value.id) : 1
	try {
		const res = await likeUser(id)
		if (res.success && res.data != null) {
			const liked = res.data.liked == true
			uni.showToast({ title: liked ? '已喜欢，仅你自己可见' : '已取消喜欢', icon: 'none' })
		} else {
			uni.showToast({ title: '操作失败，请重试', icon: 'none' })
		}
	} catch (e) {
		uni.showToast({ title: '操作失败，请重试', icon: 'none' })
	}
}
</script>

