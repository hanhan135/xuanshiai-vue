	font-size: 13px;
	line-height: 20px;
	color: var(--ink2);
}

.wechat-contact {
	margin: 0 14px 14px;
	padding: 10px 12px;
	border: 1px solid var(--line);
	border-radius: 6px;
	background: var(--surface);
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	gap: 10px;
}

.wechat-contact-label {
	font-size: 12px;
	line-height: 18px;
	color: var(--muted);
}

.wechat-contact-value {
	min-width: 0;
	font-size: 13px;
	font-weight: 700;
	line-height: 18px;
	color: var(--accent2);
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.wechat-request-footer {
