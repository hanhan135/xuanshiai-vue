}

.form-field {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
	padding-top: 18rpx;
	border-top: 1px solid var(--line);
}

.field-label {
	font-size: 24rpx;
	font-weight: 700;
	color: var(--ink2);
}

.required {
	color: var(--brown);
}

