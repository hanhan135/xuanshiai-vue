	font-weight: 300;
	color: var(--muted);
}

.avatar-hint {
	font-size: 18rpx;
	color: var(--muted);
}

/* ===== 擅长领域 ===== */
.specialty-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 12rpx;
}

.specialty-chip {
	width: 100%;
	height: 58rpx;
	padding: 0 8rpx;
	box-sizing: border-box;
	border: 1px solid var(--line);
	border-radius: 999rpx;
	background: var(--canvas);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 22rpx;
	line-height: 1;
	color: var(--ink2);
}

.specialty-chip text {
	display: block;
	width: 100%;
	text-align: center;
	line-height: 1;
	white-space: nowrap;
}

.specialty-chip.selected {
	background: var(--accent-bg);
	border-color: var(--accent);
	color: var(--accent2);
	font-weight: 800;
}

/* ===== 价格输入 ===== */
.price-input-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 78rpx;
	padding: 0 20rpx;
	border: 1px solid var(--line);
	border-radius: 14rpx;
	background: var(--canvas);
	gap: 8rpx;
}

.price-prefix {
	font-size: 28rpx;
	font-weight: 800;
	color: var(--brown);
	flex-shrink: 0;
}

.price-input {
	flex: 1;
	min-width: 0;
	font-size: 25rpx;
	color: var(--ink);
}

.price-suffix {
	font-size: 22rpx;
	color: var(--muted);
	flex-shrink: 0;
}

/* ===== 成功案例 ===== */
.case-block {
	padding: 22rpx;
	border: 1px solid var(--line);
	border-radius: 16rpx;
	background: var(--canvas);
	display: flex;
	flex-direction: column;
	gap: 14rpx;
}

.case-block-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.case-block-title {
	font-size: 24rpx;
	font-weight: 800;
	color: var(--ink);
}

.case-delete {
	padding: 8rpx 16rpx;
	border-radius: 8rpx;
	background: rgba(231, 110, 76, 0.12);
}

.case-delete text {
	font-size: 20rpx;
	color: var(--brown);
}

.case-block .form-field {
	border-top: none;
	padding-top: 0;
}

.case-images {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 12rpx;
}

.case-image-item {
	position: relative;
	width: 148rpx;
	height: 148rpx;
	border-radius: 12rpx;
	overflow: hidden;
}

.case-image-preview {
	width: 100%;
	height: 100%;
}

.case-image-delete {
	position: absolute;
	top: 4rpx;
	right: 4rpx;
	width: 36rpx;
	height: 36rpx;
	border-radius: 50%;
	background: rgba(0, 0, 0, 0.5);
	display: flex;
	align-items: center;
	justify-content: center;
}

.case-image-delete text {
	font-size: 24rpx;
	color: var(--paper);
	font-weight: 700;
}

.case-image-add {
	width: 148rpx;
	height: 148rpx;
	border: 2rpx dashed var(--line);
	border-radius: 12rpx;
	background: var(--canvas);
	display: flex;
	align-items: center;
	justify-content: center;
}

.case-add-plus {
	font-size: 48rpx;
	font-weight: 300;
	color: var(--muted);
}

.add-case-button {
	height: 72rpx;
	border: 1px dashed var(--line);
	border-radius: 14rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

.add-case-button text {
	font-size: 24rpx;
	font-weight: 700;
	color: var(--accent2);
}

/* ===== 审核流程 ===== */
.process-card {
	position: relative;
	overflow: visible;
}

.process-steps {
	display: flex;
	flex-direction: column;
	gap: 0;
}

.process-step {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	gap: 18rpx;
	padding-bottom: 28rpx;
}

.process-step:last-child {
	padding-bottom: 0;
}

.step-indicator {
	width: 52rpx;
	height: 52rpx;
	border-radius: 50%;
	border: 2rpx solid var(--line);
	background: var(--canvas);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 18rpx;
	font-weight: 800;
	color: var(--muted);
	flex-shrink: 0;
	z-index: 1;
}

.step-indicator.active {
	background: var(--accent);
	border-color: var(--accent);
	color: var(--paper);
}

.step-indicator.done {
	background: var(--accent-bg);
	border-color: var(--accent);
	color: var(--accent2);
}

.step-copy {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 6rpx;
	padding-top: 4rpx;
}

.step-title {
	font-size: 25rpx;
	font-weight: 700;
	color: var(--ink);
}

.step-desc {
	font-size: 20rpx;
	line-height: 1.5;
	color: var(--muted);
}

.step-line {
	position: absolute;
	left: 25rpx;
	top: 56rpx;
	width: 2rpx;
	height: calc(100% - 38rpx);
	background: var(--line);
}

/* ===== 咨询入口 ===== */
.consult-icons {
	position: absolute;
	/* 保持在审核流程卡片内，避免悬出页面边缘。 */
	right: 30rpx;
