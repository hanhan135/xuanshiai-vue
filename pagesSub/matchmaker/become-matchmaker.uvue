	padding: 0 16rpx;
	border-radius: 14rpx;
	background: var(--accent);
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--paper);
	font-size: 21rpx;
	font-weight: 800;
	white-space: nowrap;
	flex-shrink: 0;
}

.management-entry-action.disabled {
	background: var(--muted);
	opacity: 0.72;
}

/* ===== 管理中心加载骨架 ===== */
.management-center-loading {
	flex: 1;
	height: 0;
	padding: 24rpx 32rpx;
	background: var(--canvas);
	display: flex;
	flex-direction: column;
	gap: 22rpx;
}

.management-loading-card,
.management-loading-heading,
.management-loading-pill {
	background: var(--warm);
	border-radius: 16rpx;
}

.management-loading-identity {
	height: 260rpx;
	border-radius: 20rpx;
}

.management-loading-tabs {
	display: flex;
	flex-direction: row;
	gap: 12rpx;
}

.management-loading-pill {
	width: 142rpx;
	height: 58rpx;
	border-radius: 999rpx;
}

.management-loading-pill.short {
	width: 96rpx;
}

.management-loading-heading {
	width: 186rpx;
	height: 38rpx;
}

.management-loading-grid {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 14rpx;
}

.management-loading-grid .management-loading-card {
	height: 176rpx;
}

/* ===== 表单卡片 ===== */
.form-card {
	padding: 28rpx;
	border-radius: 20rpx;
	background: var(--surface);
	box-shadow: var(--shadow-sm);
	display: flex;
	flex-direction: column;
	gap: 18rpx;
}

.section-title {
	font-size: 34rpx;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.section-title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 12rpx;
}

