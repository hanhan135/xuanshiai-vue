}

.case-textarea {
	min-height: 120rpx;
}

/* ===== 头像上传 ===== */
.avatar-upload {
	width: 160rpx;
	height: 160rpx;
	border-radius: 50%;
	overflow: hidden;
	border: 2rpx dashed var(--line);
	background: var(--canvas);
}

