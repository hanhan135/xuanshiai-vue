/* 微信小程序 uvue 必须显式标记横向 flex，避免文字与操作按钮纵向叠压。 */
.workspace-tabs, .workspace-search, .workspace-promotion > view, .workspace-commission-row > view, .workspace-info-card > view:not(.workspace-actions):not(.workspace-member-header), .workspace-actions, .workspace-match-card > view:first-child, .workspace-match-person, .workspace-member-header, .workspace-entry-card > view:not(.workspace-entry-submit), .workspace-generic-card { flex-direction: row; }
.workspace-tabs, .workspace-search, .workspace-actions, .workspace-match-person, .workspace-member-header, .workspace-generic-card { min-width: 0; }
.workspace-info-card > view, .workspace-match-person > view, .workspace-member-header > view, .workspace-generic-card > view { min-width: 0; }

.page-scroller {
	flex: 1;
	height: 0;
}

.page-content {
	padding: 24rpx 32rpx;
	display: flex;
	flex-direction: column;
	gap: 22rpx;
}

.bottom-spacer {
	height: 148rpx;
}

/* ===== Banner ===== */
.banner-card {
	padding: 34rpx 30rpx;
	border-radius: 22rpx;
	background: linear-gradient(145deg, var(--accent-bg), var(--surface));
	display: flex;
	flex-direction: column;
	justify-content: center;
	min-height: 208rpx;
	box-sizing: border-box;
}

.banner-copy {
	display: flex;
	flex-direction: column;
	gap: 14rpx;
}

.banner-kicker {
	font-size: 20rpx;
	font-weight: 800;
	letter-spacing: 0.08em;
	color: var(--accent2);
}

.banner-title {
	font-size: 40rpx;
	line-height: 1.34;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.banner-desc {
	font-size: 21rpx;
	line-height: 1.55;
	color: var(--ink2);
}

/* ===== 红娘管理中心入口 ===== */
.management-entry {
	padding: 26rpx;
	border: 1px solid var(--line);
	border-radius: 20rpx;
	background: var(--warm);
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	gap: 18rpx;
}

.management-entry.ready {
	background: var(--match-mist);
	border-color: var(--accent);
}

.management-entry-copy {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	gap: 8rpx;
}

.management-entry-title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10rpx;
}

.management-entry-title {
	font-size: 28rpx;
	font-weight: 800;
	color: var(--ink);
}

.management-demo-badge {
	padding: 4rpx 10rpx;
	border-radius: 999rpx;
	background: var(--accent-bg);
	color: var(--accent2);
	font-size: 18rpx;
	font-weight: 800;
}

.management-entry-desc {
	font-size: 21rpx;
	line-height: 1.5;
	color: var(--ink2);
}

.management-entry-action {
	min-width: 136rpx;
