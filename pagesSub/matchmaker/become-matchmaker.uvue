	padding: 0 20rpx;
	border: 1px solid var(--line);
	border-radius: 14rpx;
	background: var(--canvas);
	font-size: 25rpx;
	color: var(--ink);
}

.field-textarea {
	width: 100%;
	min-height: 146rpx;
