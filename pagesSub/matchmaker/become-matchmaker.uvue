<template>
	<view class="become-page">
		<!-- 顶部导航栏 -->
		<view class="nav-bar">
			<view class="nav-back" @click="handlePageBack">
				<view class="nav-back-chevron"></view>
			</view>
			<text class="nav-title">{{ pendingReviewVisible ? '资料待审' : (workspaceVisible ? workspaceTitle : (managementCenterVisible || managementCenterLoading ? '红娘管理中心' : '我要做红娘')) }}</text>
			<view v-if="pendingReviewVisible || workspaceVisible" class="nav-help" @click="closeWorkspace">
				<text class="nav-help-text">返回</text>
			</view>
			<view v-else-if="managementCenterVisible" class="nav-help" @click="exitManagementCenter">
				<text class="nav-help-text">退出</text>
			</view>
			<view v-else-if="!managementCenterLoading" class="nav-help" @click="showHelp">
				<text class="nav-help-text">帮助</text>
			</view>
		</view>

		<MatchmakerPendingReview
			v-if="pendingReviewVisible"
			@action="handleManagementCenterAction"
		/>
		<scroll-view v-else-if="workspaceVisible" scroll-y class="workspace-scroller" :show-scrollbar="false">
			<view class="workspace-content">
				<view class="workspace-heading">
					<text class="workspace-title">{{ workspaceTitle }}</text>
					<text class="workspace-copy">本地 Mock 数据 · 可直接处理工作记录</text>
				</view>
				<view class="workspace-tabs">
					<view v-for="item in workspaceTabs" :key="item" class="workspace-tab" :class="{ active: workspaceActiveTab == item }" @click="selectWorkspaceTab(item)"><text>{{ item }}</text></view>
				</view>
				<view class="workspace-search"><text>搜</text><input :placeholder="workspaceSearchPlaceholder" :value="workspaceKeyword" @input="onWorkspaceKeywordInput"/><view @click="runWorkspaceSearch"><text>搜索</text></view></view>

				<view v-if="workspaceKind == 'commission'">
					<view class="workspace-cash"><text>可提现额度（元）</text><text class="workspace-cash-value">509.00</text><text>芷希老师 · 累计赚了 ¥509</text><view @click="showToast('提现申请已保存到本地')"><text>立即提现</text></view></view>
					<view class="workspace-notice"><text class="workspace-notice-title">温馨提示</text><text>分享平台首页、会员资料海报或专属推广链接后，引流注册的会员会自动纳入您的服务名下。</text></view>
					<view class="workspace-promotion"><text>任何人通过您的专属海报或链接注册，即计入您的名下</text><view><text @click="copyWorkspaceLink">复制我的专属推广链接</text><text @click="showToast('专属推广海报已保存')">下载我的专属推广海报</text></view></view>
					<view v-for="row in workspaceCommissionRows" :key="row.time" class="workspace-commission-row"><text>{{ row.time }}</text><view><image :src="row.avatar" mode="aspectFill"/><view><text>{{ row.name }}</text><text>{{ row.item }}</text></view><text>{{ row.amount }}</text></view></view>
				</view>

				<view v-else-if="workspaceKind == 'lead'">
					<view class="workspace-notice"><text>超级红娘可查看全部客源线索，普通红娘仅查看已分派的客源。</text></view>
					<view v-for="row in workspaceLeads" :key="row.id" class="workspace-info-card"><text>{{ row.name }} · {{ row.gender }}</text><text class="workspace-muted">录入时间：{{ row.time }}</text><view><text>电话</text><text>{{ row.phone }}</text></view><view><text>微信</text><text>{{ row.wechat }}</text></view><view><text>来源</text><text>{{ row.source }}</text></view><view><text>分派跟进</text><text>{{ row.owner }}</text></view><view class="workspace-actions"><text @click="showToast('已打开编辑资料')">编辑</text><text @click="copyWorkspaceText(row.phone)">复制资料</text><text @click="showToast('已放入弃海')">放入弃海</text><text @click="showToast('已一键入库，进入资料待审')">一键入库</text></view></view>
				</view>

				<view v-else-if="workspaceKind == 'match'">
					<view class="workspace-filter-note"><text>已选：优先显示我服务的</text></view>
					<view v-for="row in workspaceMatches" :key="row.id" class="workspace-match-card"><view><text>申请时间：{{ row.time }}</text><text>{{ row.status }}</text></view><view class="workspace-match-person"><image :src="row.a.avatar" mode="aspectFill"/><view><text>{{ row.a.name }} · {{ row.a.gender }}</text><text>编号：{{ row.a.id }}</text></view><text @click="showToast('联系信息已打开')">联系 Ta</text></view><view class="workspace-match-person"><image :src="row.b.avatar" mode="aspectFill"/><view><text>{{ row.b.name }} · {{ row.b.gender }}</text><text>编号：{{ row.b.id }}</text></view><text @click="showToast('联系信息已打开')">联系 Ta</text></view><text>服务红娘：芷希老师</text></view>
				</view>

				<view v-else-if="workspaceKind == 'entry'" class="workspace-entry-card"><text>{{ workspaceTitle }}</text><text class="workspace-muted">资料提交后将进入“资料待审”，审核通过后才会对外展示。</text><view><text>昵称</text><input placeholder="请输入昵称"/></view><view><text>手机号码</text><input placeholder="请输入手机号码" type="number"/></view><view><text>微信号</text><input placeholder="请输入微信号"/></view><view><text>会员类型</text><text>{{ workspaceTitle == '录入会员' ? '线上VIP' : '客源线索' }}</text></view><view class="workspace-entry-submit" @click="showToast('本地 Mock 资料已保存，等待审核')"><text>保存并进入资料待审</text></view></view>

				<view v-else-if="workspaceKind == 'member'">
					<view v-for="member in workspaceMembers" :key="member.id" class="workspace-info-card"><view class="workspace-member-header"><image :src="member.avatar" mode="aspectFill"/><view><text>{{ member.name }} · {{ member.gender }}</text><text>编号：{{ member.id }} · {{ member.type }}</text></view></view><view><text>服务红娘</text><text>{{ member.owner }}</text></view><view><text>资料状态</text><text>{{ member.status }}</text></view><view class="workspace-actions"><text @click="showToast('已打开会员资料')">详细资料</text><text @click="showToast('已打开服务跟进')">服务跟进</text><text @click="showToast('已打开牵线记录')">牵线记录</text></view></view>
				</view>

				<view v-else-if="workspaceKind == 'activity'">
					<view v-for="activity in workspaceActivities" :key="activity.title" class="workspace-info-card"><text>{{ activity.title }}</text><text class="workspace-muted">{{ activity.time }} · {{ activity.city }}</text><view><text>报名人数</text><text>{{ activity.count }} 人</text></view><view><text>审核状态</text><text>{{ activity.status }}</text></view><view class="workspace-actions"><text @click="showToast('已打开报名名单')">报名名单</text><text @click="showToast('已打开活动编辑')">编辑</text><text @click="showToast('报名审核已保存')">报名审核</text></view></view>
				</view>

				<view v-else-if="workspaceKind == 'video'" class="workspace-info-card"><text>视频管理</text><text class="workspace-muted">可维护会员展示视频与审核状态</text><view><text>待审核视频</text><text>2 条</text></view><view><text>已发布视频</text><text>8 条</text></view><view class="workspace-actions"><text @click="showToast('已打开待审核视频')">待审核</text><text @click="showToast('已打开视频资料库')">视频资料库</text></view></view>

				<view v-else-if="workspaceKind == 'account'" class="workspace-info-card"><text>我的账号</text><view><text>账号昵称</text><text>依依</text></view><view><text>服务门店</text><text>南京总店</text></view><view><text>红娘等级</text><text>超级红娘</text></view><view><text>账号权限</text><text>门店服务范围</text></view><view class="workspace-actions"><text @click="showToast('账号资料已打开')">编辑资料</text><text @click="copyWorkspaceLink">复制链接</text></view></view>

				<view v-else><view v-for="row in workspaceGenericRows" :key="row.title" class="workspace-generic-card"><view><text>{{ row.icon }}</text></view><view><text>{{ row.title }}</text><text>{{ row.desc }}</text></view><text @click="showToast(row.action)">{{ row.action }} ></text></view></view>
			</view>
			<view class="workspace-add" @click="showToast('新增记录表单已打开')"><text>+</text><text>添加</text></view>
		</scroll-view>
		<MatchmakerManagementCenter
			v-else-if="managementCenterVisible && managementCenterSnapshot != null"
			:snapshot="managementCenterSnapshot"
			@exit="exitManagementCenter"
			@refresh="refreshManagementCenter"
			@identity="openMatchmakerIdentity"
			@action="handleManagementCenterAction"
		/>
		<view v-else-if="managementCenterLoading" class="management-center-loading">
			<view class="management-loading-card management-loading-identity"></view>
			<view class="management-loading-tabs">
				<view class="management-loading-pill"></view>
				<view class="management-loading-pill"></view>
				<view class="management-loading-pill short"></view>
			</view>
			<view class="management-loading-heading"></view>
			<view class="management-loading-grid">
				<view class="management-loading-card"></view>
				<view class="management-loading-card"></view>
				<view class="management-loading-card"></view>
				<view class="management-loading-card"></view>
			</view>
		</view>

		<scroll-view v-else scroll-y class="page-scroller" :show-scrollbar="false">
			<view class="page-content">
				<!-- Banner 宣传区域 -->
				<view class="banner-card">
					<view class="banner-copy">
						<text class="banner-kicker">红娘招募</text>
						<text class="banner-title">用你的真诚经验，帮助更多人稳稳靠近幸福</text>
						<text class="banner-desc">提交资料后，平台将尽快联系你确认服务信息。</text>
					</view>
				</view>

				<!-- 总店红娘工作台入口：服务端确认已付款且账号激活后才可进入。 -->
				<view class="management-entry" :class="{ ready: canEnterManagementCenter }">
					<view class="management-entry-copy">
					<view class="management-entry-title-row">
						<text class="management-entry-title">红娘管理中心</text>
					</view>
						<text class="management-entry-desc">{{ managementAccessDescription }}</text>
					</view>
					<view
						class="management-entry-action"
						:class="{ disabled: !canEnterManagementCenter || managementAccessLoading || managementCenterLoading }"
						@click="openManagementCenter"
					>
						<text>{{ managementAccessActionText }}</text>
					</view>
				</view>

				<!-- 基本信息 -->
				<view class="form-card">
					<text class="section-title">基本信息</text>
					<text class="section-desc">用于身份核验与平台联系，信息不会对外公开。</text>

					<view class="form-field">
						<text class="field-label">真实姓名 <text class="required">*</text></text>
						<input
							class="field-input"
							:value="realName"
							placeholder="请填写真实姓名"
							@input="onRealNameInput"
						/>
					</view>

					<view class="form-field">
						<text class="field-label">手机号 <text class="required">*</text></text>
						<input
							class="field-input"
							type="number"
							maxlength="11"
							:value="phone"
							placeholder="用于接收审核通知"
							@input="onPhoneInput"
						/>
					</view>

					<view class="form-field">
						<text class="field-label">微信号 <text class="required">*</text></text>
						<input
							class="field-input"
							:value="wechat"
							placeholder="便于平台工作人员后续沟通"
							@input="onWechatInput"
						/>
					</view>
				</view>

				<!-- 红娘资料 -->
				<view class="form-card">
					<text class="section-title">红娘资料</text>
					<text class="section-desc">展示给用户的专业形象，建议完整填写。</text>

					<!-- 上传头像 -->
					<view class="form-field">
						<text class="field-label">上传头像 <text class="required">*</text></text>
						<view class="avatar-upload" @click="uploadAvatar">
							<image
								v-if="avatar.length > 0"
								class="avatar-preview"
								:src="avatar"
								mode="aspectFill"
							></image>
							<view v-else class="avatar-placeholder">
								<text class="avatar-plus">+</text>
								<text class="avatar-hint">点击上传头像</text>
							</view>
						</view>
						<text class="field-hint">建议使用真实、清晰的正面照，裁剪比例 1:1</text>
					</view>

					<!-- 个人简介 -->
					<view class="form-field">
						<text class="field-label">个人简介 <text class="required">*</text></text>
						<textarea
							class="field-textarea"
							:value="introduction"
							maxlength="200"
							placeholder="简短介绍你的背景、经验和风格，例如：专注高知青年牵线服务，已有5年经验。"
							@input="onIntroductionInput"
						/>
						<text class="field-counter">{{ introduction.length }}/200</text>
					</view>

					<!-- 擅长领域 -->
					<view class="form-field">
						<text class="field-label">擅长领域 <text class="required">*</text></text>
						<view class="specialty-grid">
							<view
								v-for="item in specialtyOptions"
								:key="item"
								class="specialty-chip"
								:class="{ selected: specialties.indexOf(item) >= 0 }"
								@click="toggleSpecialty(item)"
							>
								<text>{{ item }}</text>
							</view>
						</view>
					</view>

					<!-- 服务价格 -->
					<view class="form-field">
						<text class="field-label">服务价格 <text class="optional">选填</text></text>
						<view class="price-input-row">
							<text class="price-prefix">¥</text>
							<input
								class="price-input"
								type="digit"
								:value="price"
								placeholder="不填则默认免费咨询"
								@input="onPriceInput"
							/>
							<text class="price-suffix">/次</text>
						</view>
					</view>
				</view>

				<!-- 成功案例 -->
				<view class="form-card">
					<view class="section-title-row">
						<text class="section-title">成功案例</text>
						<text class="optional-label">选填</text>
					</view>
					<text class="section-desc">展示过往牵线经验，增强可信度。内容需脱敏处理，避免泄露用户隐私。</text>

					<view
						v-for="(caseItem, index) in successCases"
						:key="index"
						class="case-block"
					>
						<view class="case-block-header">
							<text class="case-block-title">案例 {{ index + 1 }}</text>
							<view class="case-delete" @click="removeCase(index)">
								<text>删除</text>
							</view>
						</view>

						<view class="form-field">
							<text class="field-label">案例描述</text>
							<textarea
								class="field-textarea case-textarea"
								:value="caseItem.description"
								maxlength="200"
								placeholder="例如：成功帮助一位教师与工程师牵线。"
								@input="(e: any) => onCaseDescriptionInput(index, e)"
							/>
						</view>

						<view class="form-field">
							<text class="field-label">案例图片</text>
							<view class="case-images">
								<view
									v-for="(img, imgIndex) in caseItem.images"
									:key="imgIndex"
									class="case-image-item"
								>
									<image class="case-image-preview" :src="img" mode="aspectFill"></image>
									<view class="case-image-delete" @click="removeCaseImage(index, imgIndex)">
										<text>×</text>
									</view>
								</view>
								<view
									v-if="caseItem.images.length < 3"
									class="case-image-add"
									@click="uploadCaseImage(index)"
								>
									<text class="case-add-plus">+</text>
								</view>
							</view>
						</view>
					</view>

					<view class="add-case-button" @click="addCase" v-if="successCases.length < 3">
						<text>+ 添加案例</text>
					</view>
				</view>

				<!-- 审核流程 -->
				<view class="form-card process-card">
					<text class="section-title">审核流程</text>
					<text class="section-desc">提交申请后，预计 1-3 个工作日内完成审核。</text>

					<view class="process-steps">
						<view
							v-for="(step, index) in processSteps"
							:key="step.title"
							class="process-step"
						>
							<view class="step-indicator" :class="{ active: index === 0, done: index < currentStep }">
								<text v-if="index < currentStep">✓</text>
								<text v-else>0{{ index + 1 }}</text>
							</view>
							<view class="step-copy">
								<text class="step-title">{{ step.title }}</text>
								<text class="step-desc">{{ step.desc }}</text>
							</view>
							<view v-if="index < processSteps.length - 1" class="step-line"></view>
						</view>
					</view>

					<!-- 咨询入口 -->
					<view class="consult-icons">
						<view class="phone-slot" @click="callConsult">
							<image class="phone-brand" src="/static/icons/phone-call.svg" mode="aspectFit"></image>
						</view>
						<view class="wechat-slot" @click="wechatConsult">
							<image class="wechat-brand" src="/static/icons/wechat-bubble.svg" mode="aspectFit"></image>
						</view>
					</view>
				</view>

				<!-- 微信二维码弹窗 -->
				<view class="qr-overlay" v-if="qrVisible" @click="qrVisible = false">
					<view class="qr-card" @click.stop>
						<view class="qr-close" @click="qrVisible = false">
							<text>×</text>
						</view>
						<text class="qr-title">微信扫码咨询</text>
						<text class="qr-subtitle">添加客服微信，备注"红娘入驻咨询"</text>
						<view class="qr-image-wrap">
							<image class="qr-image" src="/static/qrcodes/kefu-wechat.png" mode="aspectFit"></image>
						</view>
						<text class="qr-tip">长按识别二维码添加</text>
					</view>
				</view>

				<!-- 隐私声明 -->
				<view class="privacy-card">
					<text class="privacy-title">隐私与安全</text>
					<text class="privacy-copy">你所提交的全部资料将受到平台隐私协议保护，仅用于红娘资质审核与服务安排。请如实填写，不要提交他人的联系方式或敏感身份信息。审核通过后，你可在个人设置中随时管理展示范围。</text>
				</view>

				<!-- 底部占位 -->
				<view class="bottom-spacer"></view>
			</view>
		</scroll-view>

		<!-- 底部提交按钮 -->
		<view v-if="!pendingReviewVisible && !workspaceVisible && !managementCenterVisible && !managementCenterLoading" class="footer-safe">
			<view
				class="submit-button"
				:class="{ disabled: !canSubmit || submitting }"
				@click="submitApplication"
			>
				<text>{{ submitting ? '提交中…' : (canSubmit ? '提交申请' : '请补全必填信息') }}</text>
			</view>
		</view>

		<XsaToast :visible="toastVisible" :message="toastMessage" @hide="toastVisible = false" />
	</view>
</template>

<script setup lang="uts">
import XsaToast from '@/components/XsaToast.uvue'
import MatchmakerManagementCenter from '@/components/MatchmakerManagementCenter.uvue'
import MatchmakerPendingReview from '@/components/MatchmakerPendingReview.uvue'
import {
	getMatchmakerManagementCenterAccess,
	getMatchmakerManagementCenterSnapshot,
	submitMatchmakerApplication
} from '@/api'

// ===== 基本信息 =====
const realName = ref('')
const phone = ref('')
const wechat = ref('')

// ===== 红娘资料 =====
const avatar = ref('')
const introduction = ref('')
const specialties = ref<string[]>([])
const price = ref('')

// ===== 成功案例 =====
interface CaseItem {
	description: string
	images: string[]
}
const successCases = ref<CaseItem[]>([])

// ===== 状态 =====
const submitting = ref(false)
const toastVisible = ref(false)
const toastMessage = ref('')
const qrVisible = ref(false)
const currentStep = ref(0)
const managementAccess = ref<any>(null)
const managementCenterSnapshot = ref<any>(null)
const managementAccessLoading = ref(true)
const managementCenterLoading = ref(false)
const managementCenterVisible = ref(false)
const pendingReviewVisible = ref(false)
const workspaceVisible = ref(false)
const workspaceTitle = ref('')
const workspaceKind = ref('general')
const workspaceActiveTab = ref('全部')
const workspaceKeyword = ref('')
const workspaceDefaultTabs = ['全部', '进行中', '已完成']
const workspaceCommissionTabs = ['分成明细', '分成标准']
const workspaceLeadTabs = ['客源线索', '弃海客源']
const workspaceMatchTabs = ['全部', '待牵线', '牵线中', '成功', '失败']
const workspaceTabs = computed(() => {
	if (workspaceKind.value == 'commission') return workspaceCommissionTabs
	if (workspaceKind.value == 'lead') return workspaceLeadTabs
	if (workspaceKind.value == 'match') return workspaceMatchTabs
	return workspaceDefaultTabs
})
const workspaceSearchPlaceholder = computed(() => {
	if (workspaceKind.value == 'lead') return '请输入昵称、手机或微信'
	if (workspaceKind.value == 'match') return '请输入申请人昵称、姓名或编号'
	return '请输入关键词'
})
const workspaceAvatarWoman = '/static/portraits/profile-woman-alt.jpg'
const workspaceCommissionRows = [
	{ time: '06-30 20:37', name: '乌龙茶07i', item: '购买了爆灯', amount: '+5.00', avatar: workspaceAvatarWoman },
	{ time: '06-30 11:53', name: '是静香本人没错', item: '购买了爆灯', amount: '+5.00', avatar: '/static/portraits/profile-man-light.jpg' },
	{ time: '06-20 11:18', name: '毛毛', item: '购买了臻爱专享', amount: '+300.00', avatar: '/static/portraits/profile-woman-community.jpg' }
]
const workspaceLeads = [{ id: 'lead-1', time: '2026-08-27 09:36:31', name: 'Lemon', gender: '女', phone: '13777297543', wechat: '未填写', source: '未填写', owner: '依依' }]
const workspaceMatches = [{ id: 'match-1', time: '2026-06-26 17:25:09', status: '待牵线', a: { name: 'Good Ni~李会强', gender: '男', id: 'B134461', avatar: '/static/portraits/profile-man-light.jpg' }, b: { name: '尤宋~尼颜', gender: '女', id: 'G298094', avatar: workspaceAvatarWoman } }]
const workspaceMembers = [{ id: 'G522362', name: '依依', gender: '女', type: '线上VIP', owner: '芷希老师', status: '审核通过', avatar: workspaceAvatarWoman }, { id: 'B053440', name: '胡毓恒', gender: '男', type: '公开相亲', owner: '未分派', status: '待审核', avatar: '/static/portraits/profile-man-light.jpg' }]
const workspaceActivities = [{ title: '认真相亲线下见面会', time: '2026-09-06 14:00', city: '南京', count: 18, status: '待审核' }, { title: '高知青年同城交流活动', time: '2026-09-13 15:00', city: '南京', count: 26, status: '报名中' }]
const workspaceGenericRows = [{ icon: '办', title: '工作记录', desc: '状态、负责人和操作历史已保留在本地 Mock 中。', action: '添加记录' }, { icon: '设', title: '相关设置', desc: '后端接入前，变更仅在当前设备会话中生效。', action: '管理设置' }]

const specialtyOptions = [
	'高知青年', '同城牵线', '离异再婚', '大龄脱单',
	'海归交友', '理工专属', '情感修复', '婚前辅导',
	'沟通指导', '形象建议', '约会策划', '家庭关系'
]

const processSteps = [
	{ title: '填写申请', desc: '填写完整资料并提交' },
	{ title: '平台审核', desc: '运营人员对资料进行审核' },
	{ title: '审核通过', desc: '获得服务红娘身份' },
	{ title: '成为服务红娘', desc: '可正式在平台提供牵线服务' }
]

// ===== 计算属性 =====
const canSubmit = computed(() => {
	return realName.value.trim().length >= 2
		&& realName.value.trim().length <= 64
		&& /^1[3-9]\d{9}$/.test(phone.value.trim())
		&& wechat.value.trim().length > 0
		&& wechat.value.trim().length <= 128
		&& avatar.value.length > 0
		&& avatar.value.length <= 512
		&& introduction.value.trim().length >= 10
		&& introduction.value.trim().length <= 2000
		&& specialties.value.length > 0
		&& isValidOptionalPrice()
})

const canEnterManagementCenter = computed(() => {
	return managementAccess.value != null && managementAccess.value.canAccess == true
})

const managementAccessDescription = computed(() => {
	if (managementAccessLoading.value) return '正在核验服务红娘开通状态…'
	if (managementAccess.value == null) return '暂时无法核验开通状态，请稍后重试。'
	if (canEnterManagementCenter.value) {
		return '服务开通已确认，可进入工作台处理门店服务事项。'
	}
	if (managementAccess.value.paymentStatus != 'paid') return '完成服务开通付款后，即可进入管理中心。'
	if (managementAccess.value.roleStatus != 'active') return '付款已确认，正在等待服务红娘账号激活。'
	return managementAccess.value.message != null && String(managementAccess.value.message).length > 0
		? String(managementAccess.value.message)
		: '当前账号暂未获得管理中心权限。'
})

const managementAccessActionText = computed(() => {
	if (managementAccessLoading.value) return '核验中'
	if (managementCenterLoading.value) return '进入中'
	if (canEnterManagementCenter.value) return '进入中心'
	return '暂不可进入'
})

// ===== Toast =====
const showToast = (msg: string) => {
	toastMessage.value = msg
	toastVisible.value = true
}

const selectWorkspaceTab = (tab: string) => {
	workspaceActiveTab.value = tab
}

const onWorkspaceKeywordInput = (event: any) => {
	workspaceKeyword.value = event.detail.value
}

const runWorkspaceSearch = () => {
	if (workspaceKeyword.value.trim().length == 0) {
		showToast('请输入搜索关键词')
		return
	}
	showToast('已按关键词筛选本地数据')
}

const copyWorkspaceText = (value: string) => {
	uni.setClipboardData({
		data: value,
		success: () => showToast('已复制')
	})
}

const copyWorkspaceLink = () => {
	copyWorkspaceText('https://xuanshiai.example/matchmaker/yiyi')
}

const loadManagementAccess = async () => {
	managementAccessLoading.value = true
	try {
		const result = await getMatchmakerManagementCenterAccess()
		if (result.success && result.data != null) {
			managementAccess.value = result.data
		} else {
			managementAccess.value = null
		}
	} catch (e) {
		managementAccess.value = null
	} finally {
		managementAccessLoading.value = false
	}
}

const openManagementCenter = async () => {
	if (managementAccessLoading.value || managementCenterLoading.value) return
	if (!canEnterManagementCenter.value) {
		showToast(managementAccessDescription.value)
		return
	}
	try {
		managementCenterLoading.value = true
		const result = await getMatchmakerManagementCenterSnapshot()
		if (result.success && result.data != null) {
			managementCenterSnapshot.value = result.data
			managementCenterVisible.value = true
		} else {
			showToast(result.message != null ? String(result.message) : '工作台加载失败，请稍后重试')
		}
	} catch (e) {
		showToast('工作台加载失败，请检查网络后重试')
	} finally {
		managementCenterLoading.value = false
	}
}

const exitManagementCenter = () => {
	pendingReviewVisible.value = false
	workspaceVisible.value = false
	managementCenterVisible.value = false
}

const openPendingReview = () => {
	if (!managementCenterVisible.value) return
	pendingReviewVisible.value = true
}

const closePendingReview = () => {
	pendingReviewVisible.value = false
}

const closeWorkspace = () => {
	if (pendingReviewVisible.value) {
		closePendingReview()
		return
	}
	workspaceVisible.value = false
}

const openWorkspace = (title: string, kind: string) => {
	workspaceTitle.value = title
	workspaceKind.value = kind
	workspaceActiveTab.value = kind == 'commission' ? '分成明细' : (kind == 'lead' ? '客源线索' : '全部')
	workspaceKeyword.value = ''
	workspaceVisible.value = true
}

const refreshManagementCenter = async () => {
	await loadManagementAccess()
	if (!canEnterManagementCenter.value) {
		exitManagementCenter()
		showToast('当前开通状态已变化，已返回申请页')
		return
	}
	try {
		const result = await getMatchmakerManagementCenterSnapshot()
		if (result.success && result.data != null) {
			managementCenterSnapshot.value = result.data
			showToast('工作台已刷新')
		} else {
			showToast(result.message != null ? String(result.message) : '工作台刷新失败')
		}
	} catch (e) {
		showToast('工作台刷新失败，请检查网络后重试')
	}
}

const handleManagementCenterAction = (name: string) => {
	if (name == '资料待审') {
		openPendingReview()
		return
	}
	if (name == '分成明细' || name == '查看分成明细' || name == '财务明细' || name == '查看财务明细') {
		openWorkspace(name.indexOf('财务') >= 0 ? '财务明细' : '线上分成', 'commission')
		return
	}
	if (name == '录入线索' || name == '录入会员') {
		openWorkspace(name == '录入线索' ? '录入客源线索' : '录入会员', 'entry')
		return
	}
	if (name.indexOf('客源') >= 0) {
		openWorkspace('客源线索', 'lead')
		return
	}
	if (name.indexOf('牵线') >= 0 || name.indexOf('约见') >= 0 || name.indexOf('约会') >= 0 || name == '添加牵线' || name == '安排约见') {
		openWorkspace(name == '查看牵线记录' ? '牵线管理' : name, 'match')
		return
	}
	if (name.indexOf('推广') >= 0 || name.indexOf('海报') >= 0 || name.indexOf('链接') >= 0) {
		openWorkspace('专属推广工具', 'commission')
		return
	}
	if (name.indexOf('活动') >= 0) {
		openWorkspace(name, 'activity')
		return
	}
	if (name.indexOf('会员') >= 0 || name.indexOf('我服务的') >= 0) {
		openWorkspace(name.replace('查看', ''), 'member')
		return
	}
	if (name.indexOf('视频') >= 0) {
		openWorkspace('视频管理', 'video')
		return
	}
	if (name.indexOf('账号') >= 0) {
		openWorkspace('我的账号', 'account')
		return
	}
	openWorkspace(name.replace('查看', ''), 'general')
}

const openMatchmakerIdentity = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/certification',
		fail: () => showToast('个人身份信息打开失败，请稍后重试')
	})
}

onShow(() => {
	if (!managementCenterVisible.value && !pendingReviewVisible.value && !workspaceVisible.value) loadManagementAccess()
})

const guideToRequiredVerification = (message: string) => {
	const needsPhone = message.indexOf('绑定手机号') >= 0
	uni.showModal({
		title: needsPhone ? '请先绑定手机号' : '请先完成实名认证',
		content: needsPhone ? '绑定手机号后，还需要完成实名认证才可提交申请。' : '实名认证审核通过后即可提交申请。',
		confirmText: '去完成',
		success: (modal: any) => {
			if (modal.confirm) {
				uni.navigateTo({ url: '/pages/profile/certification?focus=' + (needsPhone ? 'phone' : 'realname') + '&returnTo=matchmaker' })
			}
		}
	})
}

const showExistingApplication = () => {
	uni.showModal({
		title: '申请正在审核',
		content: '你已提交服务红娘申请，请等待平台审核结果，无需重复提交。',
		confirmText: '查看状态',
		success: (modal: any) => {
			if (modal.confirm) uni.redirectTo({ url: '/pagesSub/matchmaker/application-success?type=service_matchmaker' })
		}
	})
}

// ===== 导航 =====
const goBack = () => {
	uni.navigateBack()
}

const handlePageBack = () => {
	if (pendingReviewVisible.value) {
		closePendingReview()
		return
	}
	if (workspaceVisible.value) {
		closeWorkspace()
		return
	}
	goBack()
}

const showHelp = () => {
	uni.showModal({
		title: '申请说明',
		content: '成为平台红娘需要经过实名认证、资料审核和培训流程。审核通常在 1-3 个工作日内完成，审核结果将通过短信通知你。如有问题，请联系客服。',
		showCancel: false,
		confirmText: '知道了'
	})
}

const callConsult = () => {
	uni.showModal({
		title: '电话咨询',
		content: '咨询热线：400-XXX-XXXX（工作时间：周一至周五 9:00-18:00）',
		showCancel: false,
		confirmText: '知道了'
	})
}

const wechatConsult = () => {
	qrVisible.value = true
}

// ===== 表单输入 =====
const onRealNameInput = (e: any) => { realName.value = e.detail.value }
const onPhoneInput = (e: any) => { phone.value = e.detail.value }
const onWechatInput = (e: any) => { wechat.value = e.detail.value }
const onIntroductionInput = (e: any) => { introduction.value = e.detail.value }
const onPriceInput = (e: any) => { price.value = e.detail.value }

const isValidOptionalPrice = (): boolean => {
	const value = price.value.trim()
	if (value.length == 0) return true
	const amount = Number(value)
	return !isNaN(amount) && amount >= 0 && amount <= 1000000
}

// ===== 头像上传 =====
const uploadAvatar = () => {
	uni.chooseImage({
		count: 1,
		sizeType: ['compressed'],
		sourceType: ['album', 'camera'],
		success: (res: any) => {
			if (res.tempFilePaths && res.tempFilePaths.length > 0) {
				avatar.value = res.tempFilePaths[0]
				showToast('头像已上传')
			}
		}
	})
}

// ===== 擅长领域 =====
const toggleSpecialty = (item: string) => {
	const idx = specialties.value.indexOf(item)
	if (idx >= 0) {
		specialties.value.splice(idx, 1)
	} else {
		if (specialties.value.length >= 5) {
			showToast('最多选择 5 个擅长领域')
			return
		}
		specialties.value.push(item)
	}
}

// ===== 成功案例 =====
const addCase = () => {
	if (successCases.value.length >= 3) return
	successCases.value.push({ description: '', images: [] })
}

const removeCase = (index: number) => {
	successCases.value.splice(index, 1)
}

const onCaseDescriptionInput = (index: number, e: any) => {
	if (index >= 0 && index < successCases.value.length) {
		successCases.value[index].description = e.detail.value
	}
}

const uploadCaseImage = (index: number) => {
	uni.chooseImage({
		count: 3 - successCases.value[index].images.length,
		sizeType: ['compressed'],
		sourceType: ['album', 'camera'],
		success: (res: any) => {
			if (res.tempFilePaths && res.tempFilePaths.length > 0) {
				const imgs = res.tempFilePaths as string[]
				for (let i = 0; i < imgs.length; i++) {
					successCases.value[index].images.push(imgs[i])
				}
			}
		}
	})
}

const removeCaseImage = (caseIndex: number, imgIndex: number) => {
	if (caseIndex >= 0 && caseIndex < successCases.value.length) {
		successCases.value[caseIndex].images.splice(imgIndex, 1)
	}
}

// ===== 提交申请 =====
const submitApplication = async () => {
	if (submitting.value) return

	// 基本信息校验
	if (realName.value.trim().length < 2 || realName.value.trim().length > 64) {
		showToast('真实姓名需为 2-64 个字符')
		return
	}
	if (!/^1[3-9]\d{9}$/.test(phone.value.trim())) {
		showToast('请填写正确的 11 位手机号')
		return
	}
	if (wechat.value.trim().length === 0 || wechat.value.trim().length > 128) {
		showToast('微信号需为 1-128 个字符')
		return
	}

	// 红娘资料校验
	if (avatar.value.length === 0 || avatar.value.length > 512) {
		showToast('请上传有效头像')
		return
	}
	if (introduction.value.trim().length < 10 || introduction.value.trim().length > 2000) {
		showToast('个人简介需为 10-2000 个字符')
		return
	}
	if (specialties.value.length === 0) {
		showToast('请至少选择一个擅长领域')
		return
	}
	if (!isValidOptionalPrice()) {
		showToast('服务价格需为 0-1000000 的数字')
		return
	}
	for (let index = 0; index < successCases.value.length; index++) {
		const description = successCases.value[index].description.trim()
		if (description.length > 1000) {
			showToast('成功案例说明最多 1000 个字符')
			return
		}
	}

	try {
		submitting.value = true

		const formData = {
			realName: realName.value.trim(),
			phone: phone.value.trim(),
			wechat: wechat.value.trim(),
			avatar: avatar.value,
			introduction: introduction.value.trim(),
			specialties: specialties.value,
			price: price.value.trim().length > 0 ? Number(price.value.trim()) : undefined,
			cases: successCases.value
				.filter((c: CaseItem) => c.description.trim().length > 0)
				.map((c: CaseItem) => ({
					description: c.description.trim(),
					images: c.images
				}))
		}

		const result = await submitMatchmakerApplication(formData)

		if (result.success) {
			const applicationId = result.data != null && result.data.id != null ? String(result.data.id) : ''
			const isMock = result.data != null && result.data.source == 'mock'
			uni.redirectTo({
				url: '/pagesSub/matchmaker/application-success?type=service_matchmaker&id=' + applicationId + '&mock=' + (isMock ? '1' : '0')
			})
		} else {
			const message = result.message != null ? String(result.message) : '提交失败，请稍后重试'
			if (result.code == 403 && (message.indexOf('绑定手机号') >= 0 || message.indexOf('实名认证') >= 0)) {
				guideToRequiredVerification(message)
			} else if (result.code == 409) {
				showExistingApplication()
			} else {
				showToast(message)
			}
		}
	} catch (e) {
		showToast('提交失败，请稍后重试')
	} finally {
		submitting.value = false
	}
}
</script>

<style scoped>
.become-page {
	min-height: 100vh;
	background: var(--canvas);
	display: flex;
	flex-direction: column;
}

/* ===== 导航栏 ===== */
.nav-bar {
	position: relative;
	height: 88rpx;
	padding: 0 12rpx;
	background: var(--paper);
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	border-bottom: 1px solid var(--line);
	flex-shrink: 0;
}

.nav-back {
	position: absolute;
	left: 12rpx;
	top: 16rpx;
	width: 64rpx;
	height: 56rpx;
	display: flex;
	align-items: center;
	justify-content: flex-start;
}

.nav-back-chevron {
	width: 26rpx;
	height: 26rpx;
	margin-left: 12rpx;
	border-left: 5rpx solid var(--ink);
	border-bottom: 5rpx solid var(--ink);
	transform: rotate(45deg);
}

.nav-title {
	position: absolute;
	left: 120rpx;
	right: 120rpx;
	display: block;
	min-width: 0;
	line-height: 1.3;
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	font-size: 34rpx;
	font-family: var(--sans);
	font-weight: 700;
	color: var(--ink);
}

.nav-help {
	position: absolute;
	right: 20rpx;
	top: 22rpx;
	height: 44rpx;
	padding: 0 14rpx;
	border-radius: 999rpx;
	border: 1px solid var(--line);
	display: flex;
	align-items: center;
}

.nav-help-text {
	font-size: 22rpx;
	color: var(--muted);
}

/* ===== 滚动区域 ===== */
.workspace-scroller { flex: 1; height: 0; background: var(--review-canvas); }
.workspace-content { min-height: 100%; padding: 20rpx 22rpx 130rpx; background: var(--review-canvas); }
.workspace-heading { padding: 8rpx 4rpx 18rpx; display: flex; flex-direction: column; gap: 5rpx; }
.workspace-title { font-size: 32rpx; font-weight: 800; color: var(--ink); }.workspace-copy,.workspace-muted { font-size: 20rpx; color: var(--muted); }
.workspace-tabs { height: 74rpx; display: flex; background: var(--surface); border-radius: 18rpx 18rpx 0 0; }.workspace-tab { flex: 1; position: relative; display: flex; align-items: center; justify-content: center; font-size: 21rpx; white-space: nowrap; }.workspace-tab.active { color: var(--review-deep); font-weight: 800; }.workspace-tab.active:after { content: ''; position: absolute; bottom: 0; width: 42rpx; height: 6rpx; border-radius: 99rpx; background: var(--review-purple); }
.workspace-search { height: 70rpx; margin: 18rpx 0; padding: 0 7rpx 0 18rpx; background: var(--surface); border-radius: 18rpx; display: flex; align-items: center; gap: 10rpx; font-size: 30rpx; color: var(--muted); }.workspace-search input { flex: 1; min-width: 0; font-size: 22rpx; color: var(--ink); }.workspace-search > view { width: 92rpx; height: 56rpx; border-radius: 14rpx; background: var(--review-purple); color: var(--surface); display: flex; align-items: center; justify-content: center; font-size: 21rpx; }
.workspace-cash { min-height: 254rpx; padding: 30rpx; position: relative; border-radius: 28rpx; background: var(--review-pink); display: flex; flex-direction: column; gap: 12rpx; color: var(--ink2); font-size: 23rpx; }.workspace-cash-value { font-size: 56rpx; color: var(--ink); font-weight: 800; }.workspace-cash > view { position: absolute; top: 40rpx; right: 26rpx; padding: 14rpx 24rpx; border-radius: 999rpx; background: var(--surface); color: var(--review-deep); font-size: 21rpx; font-weight: 800; }
.workspace-notice,.workspace-promotion { margin-top: 20rpx; padding: 22rpx; border-radius: 24rpx; background: var(--surface); display: flex; flex-direction: column; gap: 10rpx; color: var(--ink2); font-size: 21rpx; line-height: 1.55; }.workspace-notice-title { font-size: 25rpx; color: var(--ink); font-weight: 800; }.workspace-promotion { background: var(--review-lilac); color: var(--review-deep); font-weight: 800; }.workspace-promotion > view { display: flex; gap: 12rpx; }.workspace-promotion > view text { flex: 1; padding: 12rpx 8rpx; border-radius: 999rpx; background: var(--surface); text-align: center; font-size: 19rpx; }
.workspace-commission-row { margin-top: 18rpx; color: var(--muted); font-size: 20rpx; }.workspace-commission-row > view { margin-top: 8rpx; padding: 20rpx; border-radius: 22rpx; background: var(--surface); display: flex; align-items: center; gap: 16rpx; }.workspace-commission-row image,.workspace-member-header image,.workspace-match-person image { width: 60rpx; height: 60rpx; border-radius: 50%; }.workspace-commission-row > view > view { flex: 1; display: flex; flex-direction: column; gap: 4rpx; color: var(--ink); font-size: 21rpx; }.workspace-commission-row > view > view text:last-child { color: var(--muted); font-size: 19rpx; }.workspace-commission-row > view > text:last-child { color: var(--review-danger); font-size: 27rpx; font-weight: 800; }
.workspace-info-card,.workspace-match-card { margin-top: 18rpx; padding: 22rpx; border-radius: 25rpx; background: var(--surface); display: flex; flex-direction: column; gap: 16rpx; color: var(--ink); font-size: 28rpx; font-weight: 800; }.workspace-info-card > view:not(.workspace-actions):not(.workspace-member-header) { padding-bottom: 13rpx; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; color: var(--ink2); font-size: 21rpx; font-weight: 400; }.workspace-info-card > view:not(.workspace-actions):not(.workspace-member-header) text:last-child { color: var(--ink); }.workspace-actions { display: flex; gap: 9rpx; }.workspace-actions text { flex: 1; padding: 12rpx 4rpx; border-radius: 10rpx; background: var(--review-soft); color: var(--review-deep); text-align: center; font-size: 18rpx; font-weight: 400; }
.workspace-filter-note { padding: 12rpx; color: var(--review-deep); font-size: 22rpx; }.workspace-match-card { font-size: 21rpx; font-weight: 400; }.workspace-match-card > view:first-child { display: flex; justify-content: space-between; color: var(--muted); }.workspace-match-card > view:first-child text:last-child { color: var(--review-orange); }.workspace-match-person { min-height: 64rpx; display: flex; align-items: center; gap: 14rpx; }.workspace-match-person > view { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }.workspace-match-person > view text:last-child { color: var(--muted); font-size: 19rpx; }.workspace-match-person > text { padding: 10rpx; border-radius: 9rpx; background: var(--review-lilac); color: var(--review-deep); font-size: 18rpx; }
