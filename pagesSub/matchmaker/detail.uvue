<template>
	<view class="detail-page">
		<scroll-view scroll-y class="page-scroller" :show-scrollbar="false">
			<view class="page-content">
				<!-- ===== 红娘资料卡：擅长领域与个人介绍连续呈现 ===== -->
				<view class="profile-intro-card">
					<view class="profile-card">
					<view class="profile-main">
						<view class="avatar-wrap">
							<MatchmakerAvatar :src="matchmaker.avatar" :name="matchmaker.name" variant="detail" />
							<view v-if="matchmaker.isOnline" class="online-dot"></view>
						</view>

						<view class="profile-info">
							<view class="name-row">
								<text class="name">{{ matchmaker.name }}</text>
								<view v-if="matchmaker.certification !== false" class="cert-badge">
									<text>平台认证</text>
								</view>
							</view>

							<text v-if="sloganText.length > 0" class="signature">{{ sloganText }}</text>

							<!-- 服务价格 -->
							<view v-if="matchmaker.price != null" class="price-row">
								<text class="price-value">¥{{ matchmaker.price || 199 }}</text>
								<text class="price-unit">/{{ matchmaker.priceUnit || '次' }}</text>
							</view>
							<text v-else class="price-pending">服务套餐定价以支付页为准</text>
						</view>
					</view>

					<!-- 数据统计 -->
					<view class="stats-row">
						<view class="stat-item">
							<text class="stat-value">{{ matchmaker.successCount || 0 }}</text>
							<text class="stat-label">牵线成功</text>
						</view>
						<view class="stat-item">
							<text class="stat-value">{{ matchmaker.serviceCount || 0 }}</text>
							<text class="stat-label">累计服务</text>
						</view>
					</view>

					<!-- 擅长领域 -->
					<view v-if="specialtyTags.length > 0" class="specialty-row">
						<text class="specialty-label">擅长领域</text>
						<view class="specialty-tags">
							<view v-for="tag in specialtyTags" :key="tag" class="specialty-tag">
								<text>{{ tag }}</text>
							</view>
						</view>
					</view>
					</view>

					<!-- ===== 个人介绍 ===== -->
					<view class="intro-card">
						<text class="block-title">个人介绍</text>
						<text class="intro-copy">{{ visibleIntroduction }}</text>
						<view v-if="showIntroToggle" class="intro-toggle" @click="toggleIntro">
							<text>{{ introExpanded ? '收起' : '展开全文' }}</text>
							<text class="toggle-arrow" :class="{ up: introExpanded }">⌄</text>
						</view>
					</view>
				</view>

				<!-- ===== 成功案例 ===== -->
				<view class="section-head">
					<view class="section-title-row">
						<text class="heart-mark">❤</text>
						<text class="section-title">成功案例</text>
					</view>
					<text class="section-link" @click="showMoreCases">查看更多 ›</text>
				</view>

				<scroll-view v-if="displayCases.length > 0" scroll-x enhanced :enable-flex="true" class="case-scroll" :show-scrollbar="false" @scroll="handleCaseScroll" @scrollend="handleCaseScrollEnd">
					<view class="case-list" :style="'width: ' + caseListWidth + 'rpx;'">
						<view v-for="(item, caseIdx) in displayCases" :key="item._id || item.title" class="case-card" @click="viewCaseDetail(item)">
							<image class="case-image" :src="item.image || item.images[0]" mode="aspectFill"></image>
							<view class="case-body">
								<text class="case-copy">{{ caseSummary(item.summary || item.story || item.copy || item.matchmakerComment) }}</text>
							</view>
						</view>
					</view>
				</scroll-view>
				<view v-else class="case-empty">
					<text>该红娘暂未展示成功案例</text>
				</view>

				<!-- 滑动指示点 -->
				<view v-if="displayCases.length > 0" class="case-dots">
					<view
						v-for="(dot, dotIdx) in displayCases"
						:key="'dot-' + dotIdx"
						class="case-dot"
						:class="{ active: currentCaseIndex === dotIdx }"
					></view>
				</view>

				<!-- ===== 全部成功案例 ===== -->
				<view v-if="allCasesModalVisible" class="cases-overlay" @click="closeAllCases">
					<view class="cases-modal" @click.stop>
						<view class="cases-modal-head">
							<view>
								<text class="cases-modal-title">全部成功案例</text>
								<text class="cases-modal-sub">案例展示，人物照片来自公开图库</text>
							</view>
							<view class="cases-modal-close" @click="closeAllCases"><text>×</text></view>
						</view>
						<scroll-view scroll-y class="cases-modal-scroll" :show-scrollbar="false">
							<view class="cases-modal-list">
								<view v-for="item in displayCases" :key="'all-' + (item._id || item.title)" class="cases-modal-card" @click="viewCaseDetail(item)">
									<image class="cases-modal-image" :src="item.image || item.images[0]" mode="aspectFit"></image>
									<view class="cases-modal-body">
										<text class="cases-modal-copy">{{ caseSummary(item.summary || item.story || item.copy || item.matchmakerComment) }}</text>
									</view>
								</view>
							</view>
						</scroll-view>
					</view>
				</view>

				<!-- ===== 服务提醒 ===== -->
				<view class="notice-card">
					<text class="notice-title">服务提醒</text>
					<text class="notice-copy">红娘服务只帮助你梳理资料、匹配对象与安排节奏，不替双方自动同意，也不承诺关系结果。联系方式仅用于本次服务沟通，请勿外泄。</text>
				</view>

				<view class="bottom-spacer"></view>
			</view>
		</scroll-view>

		<!-- 联系方式只在双方授权后的服务流程中由服务端提供。 -->
		<view class="footer-safe">
			<view class="footer-button phone" @click="applyForService">
				<text class="footer-icon">♡</text>
				<view class="footer-copy">
					<text class="footer-title">申请红娘服务</text>
					<text class="footer-desc">提交需求后由平台安排</text>
				</view>
			</view>
		</view>

		<XsaToast :visible="toastVisible" :message="toastMessage" @hide="toastVisible = false" />
	</view>
</template>

<script setup lang="uts">
import XsaToast from '@/components/XsaToast.uvue'
import MatchmakerAvatar from '@/components/MatchmakerAvatar.uvue'
import { getServiceMatchmakers, getCustomMatchmakers, getMatchmakerDetail } from '@/api'

const matchmakerCaseImageA = '/pagesSub/matchmaker/static/cases/wuhan-zhou-zheng.webp'
const matchmakerCaseImageB = '/pagesSub/matchmaker/static/cases/shenzhen-zhang-liu.webp'

const fallbackMatchmaker = {
	id: 1,
	name: '沈知意',
	avatar: '/static/portraits/profile-woman-main.webp',
	gender: 'female',
	age: 35,
	city: '杭州',
	title: '金牌红娘',
	certification: true,
	slogan: '认真牵线，对每一次遇见负责',
	specialties: ['高知青年', '关系澄清', '首次见面', '长期关系'],
	price: 199,
	priceUnit: '次',
	introduction: '国家三级婚姻家庭咨询师，6 年婚恋服务经验。擅长帮助第一次认真使用婚恋产品的用户梳理边界、安排见面节奏。重视资料真实性与沟通质量，不追求快速匹配，更关注双方在关系目标和生活节奏上的契合度。',
	serviceCount: 320,
	successCount: 89,
	isOnline: true,
	status: 'online',
	caseRecord: '近 3 个月帮助 96 位用户进入稳定了解阶段，其中 32 对已进入深入交往。'
}

const matchmaker = ref<any>(fallbackMatchmaker)
const introExpanded = ref(false)
const allCasesModalVisible = ref(false)
const toastVisible = ref(false)
const toastMessage = ref('')

const displayCases = ref<any[]>([
	{
		_id: 'case_001',
		title: '稳步了解后的确定',
		matchTime: '2025-12',
		image: matchmakerCaseImageA,
		images: [matchmakerCaseImageA],
		story: '先明确双方的生活节奏与关系边界，再安排循序渐进的见面，让彼此在稳定沟通中确认长期方向。',
		feedback: '节奏安排得很舒服，我们都能做自己',
		matchmakerComment: '匹配不是催促，而是让合适的节奏自然发生',
		tags: ['节奏匹配', '同城']
	},
	{
		_id: 'case_002',
		title: '异地关系的共同选择',
		matchTime: '2025-10',
		image: matchmakerCaseImageB,
		images: [matchmakerCaseImageB],
		story: '红娘帮助双方把工作安排、城市规划和沟通频率逐项说清，减少猜测后共同做出了下一步选择。',
		feedback: '关键问题说开之后，关系一下清晰了',
		matchmakerComment: '异地不怕距离，怕的是没有共同的行动计划',
		tags: ['异地', '行动计划']
	},
	{
		_id: 'case_003',
		title: '慢热关系的安心感',
		matchTime: '2025-08',
		image: matchmakerCaseImageA,
		images: [matchmakerCaseImageA],
		story: '两位用户都偏慢热，红娘在每次见面后协助复盘，让他们更清楚地感受到彼此的可靠与默契。',
		feedback: '不着急反而更能看见彼此的好',
		matchmakerComment: '好的关系经得起时间，也值得被耐心对待',
		tags: ['慢热', '复盘沟通']
	}
])

const fallbackCasesForMatchmaker = (matchmakerId: number): any[] => {
	if (matchmakerId == 1) return displayCases.value
	if (matchmakerId == 2) {
		return [
			{
				_id: 'service-2-case-1', title: '忙碌生活里的高效匹配', matchTime: '2025-09',
				image: matchmakerCaseImageB, images: [matchmakerCaseImageB],
				story: '双方工作节奏紧凑，红娘先帮助他们确定高质量沟通频率，再安排线下见面。',
				matchmakerComment: '把有限的时间留给真正重要的了解。', tags: ['高效沟通', '同城']
			},
			{
				_id: 'service-2-case-2', title: '从条件清单到真实默契', matchTime: '2025-07',
				image: matchmakerCaseImageA, images: [matchmakerCaseImageA],
				story: '红娘协助双方从条件筛选转向真实相处，慢慢建立起稳定的信任。',
				matchmakerComment: '合适不只在纸面条件，更在相处的舒适感。', tags: ['资料优化', '深度沟通']
			}
		]
	}
	if (matchmakerId == 3) {
		return [
			{
				_id: 'service-3-case-1', title: '第一次见面的安心感', matchTime: '2025-06',
				image: matchmakerCaseImageB, images: [matchmakerCaseImageB],
				story: '从资料准备到见面后的反馈，红娘陪着双方把每一步都讲得清楚、走得踏实。',
				matchmakerComment: '安全感来自清晰沟通和被认真对待。', tags: ['初次见面', '关系边界']
			},
			{
				_id: 'service-3-case-2', title: '共同目标下的双向靠近', matchTime: '2025-04',
				image: matchmakerCaseImageB, images: [matchmakerCaseImageB],
				story: '双方在相处中不断校准期待，最终确认了共同的长期目标。',
				matchmakerComment: '关系的推进，需要两个人都愿意向前一步。', tags: ['长期规划', '双向沟通']
			}
		]
	}
	return []
}

// ===== 计算属性 =====
const specialtyTags = computed(() => {
	const tags = matchmaker.value.specialties || matchmaker.value.tags
	if (tags != null && tags.length > 0) {
		return (tags as string[]).slice(0, 5)
	}
	return ['高知青年', '关系澄清', '首次见面']
})

const sloganText = computed(() => {
	return matchmaker.value.slogan || matchmaker.value.description || ''
})

const fullIntroduction = computed(() => {
	const intro = matchmaker.value.introduction || fallbackMatchmaker.introduction
	const extra = matchmaker.value.caseRecord || ''
	if (extra.length > 0 && intro.indexOf(extra) < 0) {
		return intro + '\n\n' + extra
	}
	return intro
})

const visibleIntroduction = computed(() => {
	const text = fullIntroduction.value
	if (introExpanded.value || text.length <= 72) return text
	return text.slice(0, 72) + '…'
})

const showIntroToggle = computed(() => fullIntroduction.value.length > 72)

// ===== 初始化 =====
onMounted(async () => {
	uni.setNavigationBarTitle({ title: '红娘个人主页' })

	const pages = getCurrentPages()
	const currentPage = pages[pages.length - 1]
	const options = currentPage.options
	const targetId = options != null && options.id != null ? parseInt(options.id) : 1
	displayCases.value = fallbackCasesForMatchmaker(targetId)

	try {
		// 尝试加载详情
		const detailRes = await getMatchmakerDetail(targetId)
		if (detailRes.success && detailRes.data != null) {
			matchmaker.value = Object.assign({}, fallbackMatchmaker, detailRes.data)
			displayCases.value = detailRes.data.cases != null ? detailRes.data.cases as any[] : fallbackCasesForMatchmaker(targetId)
			return
		}
	} catch (e) {
		// 降级到列表查找
	}

	// 降级：从列表匹配
	try {
		const serviceRes = await getServiceMatchmakers()
		const customRes = await getCustomMatchmakers()
		const list = (serviceRes.success ? serviceRes.data as any[] : []).concat(
			customRes.success ? customRes.data as any[] : []
		)
		const item = list.find((entry: any) => entry.id == targetId)
		if (item != null) {
			matchmaker.value = Object.assign({}, fallbackMatchmaker, item)
		}
	} catch (e) {
		uni.showToast({ title: '已展示默认红娘资料', icon: 'none' })
	}
})

// ===== 介绍展开/收起 =====
const toggleIntro = () => { introExpanded.value = !introExpanded.value }


// ===== 案例滑动追踪 =====
const currentCaseIndex = ref(0)
let caseScrollTimer: any = null
let latestCaseScrollLeft = 0

const caseListWidth = computed((): number => {
	const count = displayCases.value.length
	if (count <= 1) return 244
	return count * 244 + (count - 1) * 16 + 84
})

const updateCaseIndex = (scrollLeft: number) => {
	try {
		const count = displayCases.value.length
		if (count <= 1) {
			currentCaseIndex.value = 0
			return
		}
		const info = uni.getSystemInfoSync()
		const windowWidth = info.windowWidth ?? info.screenWidth ?? 375
		const viewportWidth = ((750 - 56) / 750) * windowWidth
		const contentWidth = (caseListWidth.value / 750) * windowWidth
		const maxScroll = contentWidth - viewportWidth
		if (maxScroll <= 0) {
			currentCaseIndex.value = 0
			return
		}
		// 先通过当前卡片的一半，就切换到下一页提示点；初始位置仍为第一张。
		const progress = Math.max(0, Math.min(scrollLeft / maxScroll, 1))
		currentCaseIndex.value = Math.round(progress * (count - 1))
	} catch (_) {
		// 降级：不更新指示点
	}
}

const handleCaseScroll = (e: any) => {
	latestCaseScrollLeft = e.detail?.scrollLeft ?? 0
	if (caseScrollTimer != null) clearTimeout(caseScrollTimer)
	caseScrollTimer = setTimeout(() => {
		caseScrollTimer = null
		updateCaseIndex(latestCaseScrollLeft)
	}, 48)
}

const handleCaseScrollEnd = (e: any) => {
	latestCaseScrollLeft = e.detail?.scrollLeft ?? latestCaseScrollLeft
	if (caseScrollTimer != null) {
		clearTimeout(caseScrollTimer)
		caseScrollTimer = null
	}
	updateCaseIndex(latestCaseScrollLeft)
}
// ===== 成功案例 =====
const caseSummary = (value: any): string => {
	const copy = value != null ? String(value).replace(/\s+/g, '').trim() : ''
	const sentenceEnd = copy.indexOf('。')
	const summary = sentenceEnd >= 0 ? copy.substring(0, sentenceEnd + 1) : copy
	const maxLength = 20
	if (summary.length <= maxLength) return summary

	for (let index = maxLength - 1; index >= 8; index--) {
		const character = summary.charAt(index)
		if (character == '，' || character == '、' || character == '；' || character == '：') {
			return summary.substring(0, index + 1) + '…'
		}
	}
	return summary.substring(0, maxLength - 1) + '…'
}

const viewCaseDetail = (item: any) => {
	const id = item._id || item.title || ''
	let content = item.story || item.copy || ''
	if (item.feedback) {
		content += '\n\n—— 用户反馈：' + item.feedback
	}
	if (item.matchmakerComment) {
		content += '\n\n—— 红娘评语：' + item.matchmakerComment
	}
	uni.showModal({
		title: item.title || '案例详情',
		content: content,
		showCancel: false,
		confirmText: '知道了'
	})
}

const showMoreCases = () => {
	if (displayCases.value.length == 0) {
		uni.showToast({ title: '暂无更多案例', icon: 'none' })
		return
	}
	allCasesModalVisible.value = true
}

const closeAllCases = () => {
	allCasesModalVisible.value = false
}

const applyForService = () => {
	uni.navigateTo({ url: '/pagesSub/matchmaker/custom' })
}

const showToast = (msg: string) => {
	toastMessage.value = msg
	toastVisible.value = true
}
</script>

<style scoped>
.detail-page {
	--rose: #7EC8A0;
	--rose-dark: #5BAF80;
	--rose-soft: #E8F5EE;
	--rose-faint: #F5F9F2;
	--rose-line: #D6EBDD;
	--gold: #F0A332;
	--gold-soft: #FFF0CF;
	--violet: #8B58E8;
	--violet-soft: #EFE2FF;
	--green: #5BAF80;
	--blue: #7EC8A0;
	min-height: 100vh;
	background: linear-gradient(180deg, var(--rose-faint) 0%, var(--paper) 40%, var(--paper) 100%);
}

.page-scroller { height: 100vh; }

.page-content {
	padding: 34rpx 28rpx 216rpx;
	display: flex;
	flex-direction: column;
	gap: 24rpx;
}

.bottom-spacer { height: 8rpx; }

/* ===== 红娘资料卡 ===== */
.profile-intro-card {
	border-radius: 26rpx;
	overflow: hidden;
	background: var(--surface);
	border: 1px solid rgba(255, 210, 226, 0.72);
	box-shadow: 0 10rpx 34rpx rgba(198, 31, 88, 0.08);
}

.profile-card {
	padding: 28rpx 24rpx 22rpx;
	border-radius: 26rpx 26rpx 0 0;
	background: linear-gradient(180deg, rgba(255, 228, 238, 0.86), rgba(255, 255, 255, 0.96));
	display: flex;
	flex-direction: column;
	gap: 22rpx;
}

.profile-main {
	display: flex;
	flex-direction: row;
	gap: 24rpx;
}

.avatar-wrap {
	position: relative;
	width: 172rpx;
	height: 172rpx;
	flex-shrink: 0;
}

.online-dot {
	position: absolute;
	right: 8rpx;
	bottom: 8rpx;
	width: 24rpx;
	height: 24rpx;
	border-radius: 50%;
	background: var(--green);
	border: 4rpx solid var(--surface);
}

.profile-info {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	gap: 10rpx;
}

.name-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10rpx;
	flex-wrap: wrap;
}

.name {
	font-size: 40rpx;
	line-height: 1.18;
	font-family: var(--serif);
	font-weight: 800;
	color: var(--ink);
}

.cert-badge {
	min-height: 34rpx;
	padding: 0 12rpx;
	border-radius: 999rpx;
	background: linear-gradient(90deg, var(--rose), #FF7AA3);
	color: var(--surface);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 19rpx;
	font-weight: 800;
}

.signature {
	font-size: 23rpx;
	line-height: 1.45;
	color: var(--rose-dark);
}

/* 价格 */
.price-row {
	display: flex;
	flex-direction: row;
	align-items: baseline;
	gap: 4rpx;
}
.price-pending { font-size: 22rpx; color: var(--muted); }

.price-value {
	font-size: 38rpx;
	line-height: 1;
	font-weight: 900;
	color: var(--rose-dark);
}

.price-unit {
	font-size: 22rpx;
	color: var(--muted);
}

/* 数据统计 */
.stats-row {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 8rpx;
	padding: 18rpx 0 0;
	border-top: 1px solid var(--rose-line);
}

.stat-item {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 4rpx;
}

.stat-value {
	font-size: 30rpx;
	line-height: 1.2;
	font-weight: 900;
	color: var(--rose-dark);
}

.stat-label {
	font-size: 20rpx;
	color: var(--ink2);
}

/* 擅长领域 */
.specialty-row {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	gap: 10rpx;
}

.specialty-label {
	flex-shrink: 0;
	font-size: 22rpx;
	line-height: 44rpx;
	font-weight: 800;
	color: var(--ink);
}

.specialty-tags {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 10rpx;
}

.specialty-tag {
	min-height: 44rpx;
	padding: 0 18rpx;
	border-radius: 999rpx;
	background: var(--rose-soft);
	color: var(--rose-dark);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 21rpx;
	font-weight: 800;
}

/* ===== 个人介绍 ===== */
.intro-card {
	position: relative;
