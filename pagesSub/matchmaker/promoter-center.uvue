<template>
	<view class="promoter-page">
		<view class="promoter-nav"><view class="back" @click="goBack"><view></view></view><text>{{ title }}</text><view class="menu"><view></view><view></view></view></view>
		<scroll-view scroll-y class="scroll" :show-scrollbar="false">
			<view v-if="loading" class="loading"><view></view><view></view><view></view></view>
			<view v-else-if="page == 'home'" class="content">
				<view class="cash-card"><view><text>可提现额度（元）</text><text>{{ money(profile.balance) }}</text></view><view class="cash-button" @click="open('withdraw')"><text>立即提现</text></view><view class="cash-bottom"><text>推广红娘</text><text>累计赚了：{{ money(totalIncome) }}元</text></view></view>
				<view class="data-card"><view class="metrics"><view><text>{{ pendingCount }}</text><text>待审人数</text></view><view><text>{{ effectiveMembers.length }}</text><text>通过人数</text></view><view><text>0</text><text>未通过人数</text></view></view><view class="hint"><text>温馨提示</text><text>在平台中登录状态下分享或转发会员详情页、会员海报和活动页面，链接会包含专属参数。引流进入的注册会员将计入您的推广名下，资料审核通过后即可获得提成。</text></view></view>
				<view class="promo-card"><text>任何人通过您的专属海报或链接进来注册即计入您名下</text><view><text @click="copyLink">复制我的专属推广链接</text><text @click="savePoster">下载我的专属推广海报</text></view></view>
				<view class="list-card">
					<view class="row" @click="teamPickerVisible = true"><text>隶属团队</text><text>{{ profile.teamName || '暂未加入团队' }}</text><i></i></view>
					<view class="row" @click="open('level')"><text>分成级别</text><text>{{ profile.level }}　还差{{ Math.max(0, 51 - effectiveMembers.length) }}人可升级</text><i></i></view>
					<view class="row" @click="open('rewards')"><text>注册奖励</text><text>男0元 女0元</text><i></i></view>
					<view class="row" @click="open('members')"><text>名下会员</text><text>有效会员{{ effectiveMembers.length }}人</text><i></i></view>
					<view class="row" @click="open('leads')"><text>客源线索</text><text>录入</text><i></i></view>
					<view class="row" @click="open('commission')"><text>消费分成</text><text>会员消费可获分成</text><i></i></view>
					<view class="row" @click="open('merchant')"><text>商家联盟</text><text>会员消费可获分成</text><i></i></view>
					<view class="row" @click="open('offline')"><text>线下开单</text><text>签约线下会员明细</text><i></i></view>
					<view class="row" @click="open('withdraw')"><text>申请提现</text><text>提现到微信零钱</text><i></i></view>
					<view class="row" @click="contactVisible = true"><text>联系客服</text><text>需要帮助请联系</text><i></i></view>
					<view class="row" @click="uni.navigateTo({ url: '/pagesSub/matchmaker/become-partner' })"><text>申请合伙</text><text>申请成为合伙人</text><i></i></view>
					<view class="row last" @click="open('account')"><text>我的账号</text><text>设置</text><i></i></view>
				</view>
			</view>

			<view v-else class="content sub-content">
				<view v-if="page == 'withdraw'" class="section"><view class="cash-card compact"><view><text>可提现额度（元）</text><text>{{ money(profile.balance) }}</text></view><view class="cash-button" @click="withdrawForm = !withdrawForm"><text>申请提现</text></view></view><view v-if="withdrawForm" class="form-card"><input type="digit" placeholder="输入金额(1-1000元)" :value="withdrawAmount" @input="withdrawAmount = $event.detail.value"/><view class="method" v-for="item in methods" :key="item" @click="withdrawMethod = item"><text :class="{ checked: withdrawMethod == item }">{{ withdrawMethod == item ? '选中' : '选择' }}</text><text>提现到{{ item }}</text></view><input placeholder="输入收款账号" :value="withdrawAccount" @input="withdrawAccount = $event.detail.value"/><input placeholder="输入收款人姓名" :value="withdrawPayee" @input="withdrawPayee = $event.detail.value"/><view class="gradient-btn" @click="submitWithdraw"><text>确认提现</text></view></view><view v-else class="empty"><text>什么都还没有哦</text></view></view>
				<view v-else-if="page == 'level'" class="section white"><view class="level-card"><text>{{ profile.level }}</text><text>推广红娘设有4个级别，每个级别可享不同的分成标准，将根据名下的有效会员数自动升级对应级别。</text></view><view v-for="item in levels" :key="item.name" class="level-row"><text>{{ item.name }}</text><text>{{ item.need }}</text><text>会员注册奖励：男会员0元/人　女会员0元/人</text><text>会员消费分成：{{ item.rate }}</text></view></view>
				<view v-else-if="page == 'rewards'" class="section"><view class="summary"><view><text>0</text><text>待审人数</text></view><view><text>{{ rewards.length }}</text><text>通过人数</text></view><view><text>0</text><text>未过人数</text></view><text>资料审核通过后才可获得奖励哦</text></view><view class="search"><input placeholder="请输入会员昵称或编号" :value="keyword" @input="keyword = $event.detail.value"/><text @click="checkSearch">搜索</text></view><view v-if="filteredRewards.length == 0" class="empty"><text>什么都还没有哦</text></view><view v-for="item in filteredRewards" :key="item.id" class="record"><text>{{ item.createdAt }}</text><text>{{ item.memberName }}</text><text class="amount">+{{ money(item.amount) }}</text><text>已通过</text></view></view>
				<view v-else-if="page == 'members'" class="section"><view class="summary"><view><text>{{ effectiveMembers.length }}</text><text>有效会员</text></view><view><text>{{ maleCount }}</text><text>男会员</text></view><view><text>{{ femaleCount }}</text><text>女会员</text></view><text>您发展来的会员在通过平台资料审核后会被纳入到您名下有效会员，您将获得注册奖励和消费分成。</text></view><view class="tabs"><text :class="{ active: memberTab == 'effective' }" @click="memberTab = 'effective'">有效会员</text><text :class="{ active: memberTab == 'incomplete' }" @click="memberTab = 'incomplete'">未完善资料</text></view><view class="search"><input placeholder="请输入会员昵称或ID" :value="keyword" @input="keyword = $event.detail.value"/><text @click="checkSearch">搜索</text></view><view v-if="memberRows.length == 0" class="empty"><text>{{ memberTab == 'effective' ? '暂无有效会员' : '什么都还没有哦' }}</text><text v-if="memberTab == 'incomplete'">向喜欢的新人发起牵线吧</text></view><view v-for="item in memberRows" :key="item.id" class="member"><text>{{ item.name }}　{{ item.gender }}</text><text>会员编号：{{ item.id }}</text><text>注册时间：{{ item.registerAt }}</text><text>审核通过</text></view></view>
				<view v-else-if="page == 'leads'" class="section"><view class="summary"><view><text>{{ pendingCount }}</text><text>待审核</text></view><view><text>{{ leads.length }}</text><text>有效</text></view><view><text>0</text><text>无效</text></view><text>将您获取到的单身信息录入到系统中，待平台核实为有效客源后您将获得奖励。</text><text class="report-link" @click="open('report')">数据报表</text></view><view class="search"><input placeholder="请输入称呼/手机/微信" :value="keyword" @input="keyword = $event.detail.value"/><text @click="checkSearch">搜索</text></view><view v-if="filteredLeads.length == 0" class="empty"><text>还没有任何客源呢</text><view class="gradient-btn" @click="open('lead-form')"><text>立即添加</text></view></view><view v-for="item in filteredLeads" :key="item.id" class="member"><text>{{ item.nickname || item.realName || item.phone }}</text><text>{{ item.phone }}</text><text>{{ item.status }}</text></view><view class="float-add" @click="open('lead-form')"><text>添加</text></view></view>
				<view v-else-if="page == 'lead-form'" class="section form-page"><view class="notice">须知：您录入的信息提交后将被平台进行核实</view><view v-for="field in leadFields" :key="field.key" class="field"><text>{{ field.label }}</text><input :placeholder="field.placeholder" :value="leadForm[field.key]" @input="updateLead(field.key, $event.detail.value)"/></view><view class="field"><text>性别</text><view class="gender"><text :class="{ active: leadForm.gender == '男' }" @click="leadForm.gender = '男'">男</text><text :class="{ active: leadForm.gender == '女' }" @click="leadForm.gender = '女'">女</text></view></view><view class="field column"><text>描述</text><textarea placeholder="尽可能的将了解到的信息进行一段描述，如职业、学历、身高、婚况、收入、择偶需求等" :value="leadForm.description" @input="leadForm.description = $event.detail.value"></textarea></view><view class="gradient-btn" @click="submitLead"><text>确定提交</text></view></view>
				<view v-else-if="page == 'report'" class="section report"><view class="table-head"><text>月份</text><text>有效(男)</text><text>有效(女)</text><text>待审</text><text>无效</text></view><view class="empty"><text>还没有任何报表呢</text></view></view>
				<view v-else-if="page == 'commission'" class="section"><view class="level-card"><text>{{ profile.nickname || '推广红娘' }}</text><text>您的分成级别：{{ profile.level }}</text><text @click="open('level')">分成标准</text><text>您可以获得您名下有效会员在平台中的消费分成。</text></view><view v-if="commissions.length == 0" class="empty"><text>什么都还没有哦</text></view><view v-for="item in commissions" :key="item.id" class="record"><text>{{ item.createdAt }}</text><text>{{ item.itemName }}</text><text class="amount">+{{ money(item.amount) }}</text></view></view>
				<view v-else-if="page == 'merchant'" class="section merchant"><view class="merchant-tabs"><text class="active">在售商品</text><text>订单记录</text><text>核销记录</text></view><view class="empty"><text>同城商家异业联盟合作</text><text>我们推荐优质的商品或服务，您推广我们的婚恋交友服务。</text></view><view class="merchant-bottom"><text @click="open('mall')">商家首页</text><text @click="showToast('请完成商家身份认证后开通店铺')">我的店铺</text><text @click="showToast('请完成商家身份认证后核销订单')">订单核销</text><text @click="open('finance')">分成结算</text></view></view>
				<view v-else-if="page == 'mall'" class="section merchant"><view class="mall-banner"></view><view class="merchant-tabs"><text class="active">全部</text><text>推荐餐饮</text><text>新奇体验</text><text>休闲玩乐</text></view><view class="empty"><text>什么都还没有哦</text></view></view>
				<view v-else-if="page == 'offline'" class="section"><view class="summary"><text>线下签约会员明细</text><text>线下开单记录将在此显示。</text></view><view v-if="offlineOrders.length == 0" class="empty"><text>暂无线下开单记录</text><view class="gradient-btn" @click="showToast('线下开单需由平台完成签约后同步')"><text>申请开单</text></view></view></view>
				<view v-else-if="page == 'finance'" class="section"><view class="funds"><view><text>余额（元）</text><text>{{ money(profile.balance) }}</text><text @click="open('withdraw')">提现</text></view><view><text>积分（金市）</text><text>{{ profile.points }}</text><text @click="showToast('充值功能待后端接入')">充值</text></view></view><view class="tabs"><text :class="{ active: financeTab == 'expense' }" @click="financeTab = 'expense'">支出明细</text><text :class="{ active: financeTab == 'balance' }" @click="financeTab = 'balance'">余额明细</text><text :class="{ active: financeTab == 'points' }" @click="financeTab = 'points'">积分明细</text></view><view class="empty"><text>什么都还没有哦</text></view></view>
				<view v-else-if="page == 'account'" class="section"><view class="funds"><view><text>余额（元）</text><text>{{ money(profile.balance) }}</text><text @click="open('withdraw')">提现</text></view><view><text>积分（金市）</text><text>{{ profile.points }}</text><text @click="open('finance')">财务明细</text></view></view><view class="list-card"><view class="row" @click="accountEditVisible = true"><text>昵称</text><text>{{ profile.nickname || '未完善资料' }}</text><i></i></view><view class="row" @click="accountEditVisible = true"><text>手机</text><text>{{ profile.phone || '未绑定' }}</text><i></i></view><view class="row"><text>微信</text><text>{{ profile.wechatBound ? '已绑定' : '未绑定' }}</text></view><view class="row" @click="open('finance')"><text>财务明细</text><text>查看</text><i></i></view><view class="row" @click="deactivateVisible = true"><text>注销账号</text><text>不可恢复</text><i></i></view></view></view>
			</view>
		</scroll-view>

		<view v-if="teamPickerVisible" class="overlay" @click="teamPickerVisible = false"><view class="dialog bottom" @click.stop><view class="dialog-head"><text>选择合伙人团队</text><text @click="teamPickerVisible = false">关闭</text></view><view class="search"><input placeholder="请输入团队关键词" :value="teamSearch" @input="teamSearch = $event.detail.value"/><text>搜索</text></view><view v-if="teamOptions.length == 0" class="empty"><text>暂无可加入团队</text></view><view v-for="team in teamOptions" :key="team.id" class="team-option" @click="selectTeam(team)"><text>{{ team.name }}</text></view><view class="gradient-btn" @click="showToast('请从上方搜索并选择合伙人团队')"><text>立即加入</text></view></view></view>
		<view v-if="contactVisible" class="overlay" @click="contactVisible = false"><view class="contact" @click.stop><text>联系客服</text><image src="/static/qrcodes/kefu-wechat.png" mode="aspectFit"></image><text>您有任何疑问请联系我们的工作人员</text><view @click="contactVisible = false"><text>关闭</text></view></view></view>
		<view v-if="accountEditVisible" class="overlay" @click="accountEditVisible = false"><view class="dialog" @click.stop><view class="dialog-head"><text>修改账号资料</text><text @click="accountEditVisible = false">关闭</text></view><input placeholder="输入昵称" :value="accountNickname" @input="accountNickname = $event.detail.value"/><input type="number" placeholder="输入手机号" :value="accountPhone" @input="accountPhone = $event.detail.value"/><view class="gradient-btn" @click="saveAccount"><text>保存</text></view></view></view>
		<view v-if="deactivateVisible" class="overlay"><view class="dialog" @click.stop><text>注销账号</text><text>注销后本机保存的推广红娘资料和业务记录将无法恢复。</text><view class="dialog-actions"><text @click="deactivateVisible = false">取消</text><text @click="showToast('账号注销需平台人工核验'); deactivateVisible = false">申请注销</text></view></view></view>
		<XsaToast :visible="toastVisible" :message="toastMessage" @hide="toastVisible = false" />
	</view>
</template>

<script setup lang="uts">
import XsaToast from '@/components/XsaToast.uvue'
import { getPromoterCenterSnapshot, updatePromoterCenterProfile, addPromoterLead, createPromoterWithdrawal } from '@/api'
const page = ref('home'), loading = ref(true), snapshot = ref<any>({ profile: {}, teamOptions: [], leads: [], effectiveMembers: [], incompleteMembers: [], rewards: [], commissions: [], offlineOrders: [] }), toastVisible = ref(false), toastMessage = ref(''), keyword = ref(''), memberTab = ref('effective'), financeTab = ref('balance'), teamPickerVisible = ref(false), contactVisible = ref(false), accountEditVisible = ref(false), deactivateVisible = ref(false), withdrawForm = ref(false), withdrawAmount = ref(''), withdrawAccount = ref(''), withdrawPayee = ref(''), withdrawMethod = ref('微信'), accountNickname = ref(''), accountPhone = ref(''), teamSearch = ref('')
const methods = ['微信', '银行卡', '支付宝']
const leadForm = ref<any>({ source: '', phone: '', wechat: '', nickname: '', realName: '', gender: '男', birth: '1990-01-01', height: '', weight: '', description: '' })
const leadFields = [{ key: 'source', label: '来源', placeholder: '请输入来源' }, { key: 'phone', label: '手机', placeholder: '请输入' }, { key: 'wechat', label: '微信', placeholder: '请输入' }, { key: 'nickname', label: '称呼', placeholder: '请输入' }, { key: 'realName', label: '姓名', placeholder: '请输入' }, { key: 'birth', label: '出生', placeholder: '1990-01-01' }, { key: 'weight', label: '体重', placeholder: '未填写' }, { key: 'height', label: '身高', placeholder: '未填写' }]
const levels = [{ name: '初级', need: '有效会员数<51人', rate: '无分成' }, { name: '推广大师', need: '有效会员数≥51人', rate: '无分成' }, { name: '推广大使', need: '有效会员数≥100人', rate: '无分成' }, { name: '推广天使', need: '有效会员数≥500人', rate: '无分成' }]
const profile = computed(() => snapshot.value.profile || {}), teamOptions = computed(() => snapshot.value.teamOptions || []), leads = computed(() => snapshot.value.leads || []), effectiveMembers = computed(() => snapshot.value.effectiveMembers || []), incompleteMembers = computed(() => snapshot.value.incompleteMembers || []), rewards = computed(() => snapshot.value.rewards || []), commissions = computed(() => snapshot.value.commissions || []), offlineOrders = computed(() => snapshot.value.offlineOrders || [])
const title = computed(() => { const dict:any = { home: '推广红娘管理中心', withdraw: '余额提现', level: '分成级别', rewards: '会员注册奖励', members: '名下会员', leads: '客源线索', 'lead-form': '录入客源', report: '数据报表', commission: '消费分成', merchant: '商家联盟', mall: '优选合作商城', offline: '线下开单', finance: '财务明细', account: '我的账号' }; return dict[page.value] || '推广红娘管理中心' })
const pendingCount = computed(() => leads.value.length), totalIncome = computed(() => { let v = 0; for (let i=0;i<rewards.value.length;i++)v+=Number(rewards.value[i].amount||0); for(let i=0;i<commissions.value.length;i++)v+=Number(commissions.value[i].amount||0); return v }), maleCount = computed(() => effectiveMembers.value.filter((x:any)=>x.gender=='男').length), femaleCount = computed(() => effectiveMembers.value.length-maleCount.value)
function listFilter(list:any[]) { const key=keyword.value.trim().toLowerCase(); return key==''?list:list.filter((x:any)=>(String(x.name||'')+String(x.id||'')+String(x.memberName||'')+String(x.phone||'')).toLowerCase().indexOf(key)>=0) }
const filteredLeads = computed(()=>listFilter(leads.value)), filteredRewards = computed(()=>listFilter(rewards.value)), memberRows = computed(()=>listFilter(memberTab.value=='effective'?effectiveMembers.value:incompleteMembers.value))
const money=(v:any)=>{const n=Number(v||0);return isNaN(n)?'0.00':n.toFixed(2)}, showToast=(v:string)=>{toastMessage.value=v;toastVisible.value=true}, open=(v:string)=>{page.value=v;keyword.value='';withdrawForm.value=false}, goBack=()=>{if(page.value=='home')uni.navigateBack();else page.value='home'}, checkSearch=()=>{if(keyword.value.trim()=='')showToast('请输入搜索关键词')}, updateLead=(key:string,value:string)=>{leadForm.value[key]=value}
const copyLink=()=>uni.setClipboardData({data:'推广链接将在后端接入后按当前账号生成',success:()=>showToast('推广链接说明已复制')}), savePoster=()=>showToast('专属推广海报将在后端接入后生成')
const selectTeam=async(team:any)=>{const r=await updatePromoterCenterProfile({teamName:team.name});if(r.success){snapshot.value=r.data;teamPickerVisible.value=false;showToast('已加入团队；如需变更请联系客服')}}
const submitLead=async()=>{const r=await addPromoterLead(leadForm.value);if(r.success){showToast(r.message);leadForm.value={source:'',phone:'',wechat:'',nickname:'',realName:'',gender:'男',birth:'1990-01-01',height:'',weight:'',description:''};await load();page.value='leads'}else showToast(r.message)}
const submitWithdraw=async()=>{const r=await createPromoterWithdrawal({amount:withdrawAmount.value,method:withdrawMethod.value,account:withdrawAccount.value,payee:withdrawPayee.value});if(r.success){showToast(r.message);withdrawForm.value=false;await load()}else showToast(r.message)}
const saveAccount=async()=>{const p=accountPhone.value.trim();if(p!=''&&!/^1[3-9]\d{9}$/.test(p)){showToast('请输入正确的11位手机号');return};const r=await updatePromoterCenterProfile({nickname:accountNickname.value.trim(),phone:p});if(r.success){snapshot.value=r.data;accountEditVisible.value=false;showToast('账号资料已保存')}else showToast(r.message)}
const load=async()=>{loading.value=true;try{const r=await getPromoterCenterSnapshot();if(r.success&&r.data!=null){snapshot.value=r.data;accountNickname.value=String(profile.value.nickname||'');accountPhone.value=String(profile.value.phone||'')}else showToast(r.message)}catch(e){showToast('本地数据加载失败')}finally{loading.value=false}}
onMounted(()=>load())
</script>

