<template>
	<view class="apply-page">
		<scroll-view class="scroller" scroll-y>
			<view class="page-pad">
				<view v-if="isCustomApplication" class="custom-application">
					<view class="custom-hero">
						<view class="custom-hero-orb hero-orb-one"></view>
						<view class="custom-hero-orb hero-orb-two"></view>
						<view class="custom-hero-content">
							<view class="hero-eyebrow">
								<view class="hero-eyebrow-dot"></view>
								<text>PRIVATE MATCHMAKING</text>
							</view>
							<text class="custom-hero-title">{{ customHeroTitle }}</text>
							<text class="custom-hero-desc">{{ customHeroDesc }}</text>
						</view>
						<view class="hero-privacy">
							<view class="privacy-mark">✓</view>
							<text>资料仅用于本次私人定制服务</text>
						</view>
					</view>

					<view class="custom-section">
						<view class="custom-section-heading">
							<view class="section-number">01</view>
							<view class="section-title-copy">
								<text class="custom-section-title">已选服务</text>
								<text class="custom-section-desc">确认后将进入安全付款页面</text>
							</view>
						</view>
						<view class="custom-plan-card">
							<view class="plan-card-main">
								<text class="plan-card-tag">专属牵线服务</text>
								<text class="custom-plan-name">{{ customPlan.name }}</text>
								<text v-if="customPlan.description" class="custom-plan-desc">{{ customPlan.description }}</text>
								<text class="custom-plan-duration">服务周期：{{ customPlan.duration }}</text>
							</view>
							<view class="plan-price-wrap">
								<text class="plan-price-label">服务费用</text>
								<text class="custom-plan-price"><text class="price-symbol">¥</text>{{ customPlan.price }}</text>
								<text v-if="customPlan.originalPrice > customPlan.price" class="custom-plan-original-price">¥{{ customPlan.originalPrice }}</text>
							</view>
							<view v-if="customPlan.benefits.length > 0" class="custom-plan-benefits">
								<view v-for="(benefit, index) in customPlan.benefits" :key="index" class="custom-plan-benefit">
									<text class="custom-plan-benefit-dot"></text>
									<text class="custom-plan-benefit-text">{{ benefit }}</text>
								</view>
							</view>
						</view>
					</view>

					<view class="custom-section">
						<view class="custom-section-heading">
							<view class="section-number">02</view>
							<view class="section-title-copy">
								<text class="custom-section-title">联系信息</text>
								<text class="custom-section-desc">请如实填写，方便红娘与您联系</text>
							</view>
							<text class="required-tip">* 必填</text>
						</view>
						<view class="form-card custom-form-card">
							<view class="custom-input-row">
								<XsaInput
									label="真实姓名"
									placeholder="请填写您的真实姓名"
									:modelValue="formData.name"
									@update:modelValue="(value: string) => formData.name = value"
								/>
							</view>
							<view class="custom-form-divider"></view>
							<view class="custom-input-row">
								<XsaInput
									label="手机号"
									placeholder="便于专属红娘联系您"
									type="number"
									:modelValue="formData.phone"
									@update:modelValue="(value: string) => formData.phone = value"
								/>
							</view>
							<view class="custom-form-divider"></view>
							<view class="custom-input-row">
								<text class="custom-city-label">所在城市</text>
								<picker
									class="custom-city-picker"
									mode="multiSelector"
									:range="cityPickerRange"
									:value="cityPickerValue"
									:disabled="isCityPickerLoading || cityPickerRange[0].length == 0"
									@columnchange="handleCityPickerColumnChange"
									@change="handleCityPickerChange"
								>
									<view class="custom-city-picker-value">
										<text :class="{ 'city-picker-placeholder': !formData.city }">{{ formData.city || (isCityPickerLoading ? '正在加载省市…' : '请选择省份和城市') }}</text>
										<text class="city-picker-arrow">›</text>
									</view>
								</picker>
							</view>
						</view>
					</view>

					<view class="custom-section">
						<view class="custom-section-heading">
							<view class="section-number">03</view>
							<view class="section-title-copy">
								<text class="custom-section-title">关系期待</text>
								<text class="custom-section-desc">帮助红娘更懂您想要的关系</text>
							</view>
							<text class="required-tip">* 必填</text>
						</view>
						<view class="form-card custom-requirements-card">
							<view class="textarea-field">
								<text class="field-label">希望认识怎样的人</text>
								<textarea
									class="field-textarea custom-textarea"
									:value="formData.requirements"
									placeholder="例如：年龄、城市、生活方式，以及您期待的相处模式"
									maxlength="300"
									@input="(e: any) => formData.requirements = e.detail.value"
								/>
								<view class="textarea-footer">
									<text class="field-tip">请勿填写他人的联系方式、住址等敏感隐私。</text>
									<text class="field-counter">{{ (formData.requirements || '').length }}/300</text>
								</view>
							</view>
						</view>
					</view>

					<view class="custom-flow-card">
						<view class="custom-flow-title-row">
							<text class="custom-flow-title">接下来会发生什么</text>
							<text class="custom-flow-caption">简单三步，安心开始</text>
						</view>
						<view class="flow-steps custom-flow-steps">
							<view class="flow-step"><view class="flow-dot active"><text>1</text></view><text class="flow-label active">填写资料</text></view>
							<view class="flow-line"></view>
							<view class="flow-step"><view class="flow-dot"><text>2</text></view><text class="flow-label">确认付款</text></view>
							<view class="flow-line"></view>
							<view class="flow-step"><view class="flow-dot"><text>3</text></view><text class="flow-label">红娘联系</text></view>
						</view>
					</view>

					<view class="custom-submit-area">
						<XsaButton class="custom-submit-button" variant="primary" size="large" :loading="isCustomSubmitting" @click="handleCustomSubmit">进入确认服务</XsaButton>
						<text class="submit-notice">确认服务与付款前会展示套餐、金额和服务周期。</text>
					</view>
				</view>

				<view v-else>
				<!-- Banner -->
				<view class="banner">
					<text class="banner-kicker">BECOME A MATCHMAKER</text>
					<text class="banner-title">红娘招募</text>
					<text class="banner-desc">平台认证 · 官方审核 · 帮助更多人认真找到幸福</text>
				</view>

				<!-- 基本信息 -->
				<view class="form-section">
					<text class="form-section-title">基本信息</text>
					<view class="form-card">
						<XsaInput
							label="真实姓名"
							placeholder="请输入真实姓名"
							:value="formData.name"
							@input="(e: any) => formData.name = e.detail.value"
						/>
						<XsaInput
							label="手机号"
							placeholder="请输入手机号"
							type="number"
							:value="formData.phone"
							@input="(e: any) => formData.phone = e.detail.value"
						/>
						<XsaInput
							label="微信号"
							placeholder="请输入微信号"
							:value="formData.wechat"
							@input="(e: any) => formData.wechat = e.detail.value"
						/>
					</view>
				</view>

				<!-- 红娘资料 -->
				<view class="form-section">
					<text class="form-section-title">红娘资料</text>
					<view class="form-card">
						<!-- 上传头像 -->
						<view class="avatar-upload" @click="handleUploadAvatar">
							<image
								v-if="formData.avatar"
								class="avatar-preview"
								:src="formData.avatar"
								mode="aspectFill"
							></image>
							<view v-else class="avatar-placeholder">
								<text class="avatar-plus">+</text>
								<text class="avatar-hint">上传头像</text>
							</view>
						</view>

						<view class="form-divider"></view>

						<view class="textarea-field">
							<text class="field-label">个人简介</text>
							<textarea
								class="field-textarea"
								:value="formData.bio"
								placeholder="介绍你的经历和做红娘的初衷…"
								maxlength="200"
								@input="(e: any) => formData.bio = e.detail.value"
							/>
							<text class="field-counter">{{ (formData.bio || '').length }}/200</text>
						</view>

						<view class="form-divider"></view>

						<view class="textarea-field">
							<text class="field-label">擅长领域</text>
							<textarea
								class="field-textarea"
								:value="formData.expertise"
								placeholder="如：高知青年、首次见面安排、关系澄清…"
								maxlength="100"
								@input="(e: any) => formData.expertise = e.detail.value"
							/>
						</view>

						<view class="form-divider"></view>

						<XsaInput
							label="服务价格（选填）"
							placeholder="如不填则默认平台统一标准"
							:value="formData.price"
							@input="(e: any) => formData.price = e.detail.value"
						/>
					</view>
				</view>

				<!-- 审核流程 -->
				<view class="flow-section">
					<text class="form-section-title">审核流程</text>
					<view class="flow-steps">
						<view class="flow-step">
							<view class="flow-dot active"></view>
							<text class="flow-label">填写申请</text>
						</view>
						<view class="flow-line"></view>
						<view class="flow-step">
							<view class="flow-dot"></view>
							<text class="flow-label">平台审核</text>
						</view>
						<view class="flow-line"></view>
						<view class="flow-step">
							<view class="flow-dot"></view>
							<text class="flow-label">审核通过</text>
						</view>
						<view class="flow-line"></view>
						<view class="flow-step">
							<view class="flow-dot"></view>
							<text class="flow-label">成为服务红娘</text>
						</view>
					</view>
				</view>

				<!-- 提交按钮 -->
				<view class="submit-area">
					<XsaButton variant="primary" block @click="handleSubmit">提交申请</XsaButton>
					<text class="submit-notice text-muted">提交后平台将在 3 个工作日内完成审核，请保持手机畅通。</text>
				</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import XsaInput from '@/components/XsaInput.uvue'
	import XsaButton from '@/components/XsaButton.uvue'
	import { createCustomServiceOrder, getRegionCities, getRegionProvinces } from '@/api'

	const formData = reactive({
		name: '',
		phone: '',
		wechat: '',
		city: '',
		requirements: '',
		avatar: '',
		bio: '',
		expertise: '',
		price: ''
	})

	const isCustomApplication = ref(false)
	const isCustomSubmitting = ref(false)
	const customPlan = reactive({
		id: 0,
		name: '',
		price: 0,
		originalPrice: 0,
		duration: '',
		description: '',
		benefits: [] as string[]
	})

	interface RegionOption {
		code: string
		name: string
	}

	const provinceOptions = ref<RegionOption[]>([])
	const cityOptions = ref<RegionOption[]>([])
	const cityPickerValue = ref<number[]>([0, 0])
	const isCityPickerLoading = ref(false)
	const cityPickerRange = computed((): string[][] => {
		return [
			provinceOptions.value.map((item: RegionOption) => item.name),
			cityOptions.value.map((item: RegionOption) => item.name)
		]
	})

	const customHeroTitle = computed((): string => {
		if (customPlan.price >= 9000) return '为长久关系，认真筛选'
		if (customPlan.price >= 5000) return '让相遇更有方向'
		if (customPlan.price > 0) return '从认真开始，靠近对的人'
		return '遇见认真相伴的那个人'
	})

	const customHeroDesc = computed((): string => {
		if (customPlan.price >= 9000) return '资深红娘团队深度筛选，打开高端会员资源。'
		if (customPlan.price >= 5000) return '从筛选、沟通到见面，金牌红娘全程跟进。'
		if (customPlan.price > 0) return '一位专属红娘，陪你完成资料梳理与精准匹配。'
		return '留下你的期待，专属红娘会为你认真筛选与跟进。'
	})

	const readRouteOption = (options: any, key: string): string => {
		if (options == null || options[key] == null) return ''
		const value = '' + options[key]
		try {
			return decodeURIComponent(value)
		} catch (e) {
			return value
		}
	}

	const normalizeRegionOptions = (source: any): RegionOption[] => {
		const items = source != null && source.items != null ? source.items as any[] : []
		return items.map((item: any): RegionOption => ({
			code: item.code != null ? String(item.code) : '',
			name: item.name != null ? String(item.name) : ''
		})).filter((item: RegionOption) => item.code.length > 0 && item.name.length > 0)
	}

	const loadCities = async (provinceIndex: number): Promise<void> => {
		const province = provinceOptions.value[provinceIndex]
		if (province == null) return
		const response = await getRegionCities(province.code)
		if (!response.success) throw new Error(response.message)
		cityOptions.value = normalizeRegionOptions(response.data)
		cityPickerValue.value = [provinceIndex, 0]
	}

	const loadCityPicker = async (): Promise<void> => {
		isCityPickerLoading.value = true
		try {
			const response = await getRegionProvinces()
			if (!response.success) throw new Error(response.message)
			provinceOptions.value = normalizeRegionOptions(response.data)
			if (provinceOptions.value.length == 0) throw new Error('暂无可选省市')
			await loadCities(0)
		} catch (e) {
			provinceOptions.value = []
			cityOptions.value = []
			uni.showToast({ title: '省市数据加载失败，请稍后重试', icon: 'none' })
		} finally {
			isCityPickerLoading.value = false
		}
	}

	const formatSelectedCity = (province: RegionOption, city: RegionOption): string => {
		return province.name == city.name ? province.name : province.name + ' · ' + city.name
	}

	const handleCityPickerColumnChange = async (event: any) => {
		const column = Number(event.detail.column)
		const value = Number(event.detail.value)
		if (column != 0 || value == cityPickerValue.value[0]) return
		isCityPickerLoading.value = true
		try {
			await loadCities(value)
		} catch (e) {
			uni.showToast({ title: '城市数据加载失败，请稍后重试', icon: 'none' })
		} finally {
			isCityPickerLoading.value = false
		}
	}

	const handleCityPickerChange = (event: any) => {
		const values = event.detail.value as number[]
		const province = provinceOptions.value[values[0]]
		const city = cityOptions.value[values[1]]
		if (province == null || city == null) return
		cityPickerValue.value = [values[0], values[1]]
		formData.city = formatSelectedCity(province, city)
	}

	onMounted(() => {
		try {
			const pages = getCurrentPages()
			const currentPage = pages[pages.length - 1]
			const options = currentPage != null ? currentPage.options : null
			isCustomApplication.value = readRouteOption(options, 'type') == 'custom'
			if (isCustomApplication.value) {
				try {
					uni.setNavigationBarTitle({ title: '申请私人定制' })
				} catch (e) {}
				customPlan.id = Number(readRouteOption(options, 'planId'))
				customPlan.name = readRouteOption(options, 'planName')
				customPlan.price = Number(readRouteOption(options, 'planPrice'))
				customPlan.originalPrice = Number(readRouteOption(options, 'planOriginalPrice'))
				customPlan.duration = readRouteOption(options, 'planDuration')
				customPlan.description = readRouteOption(options, 'planDescription')
				const benefitText = readRouteOption(options, 'planBenefits')
				customPlan.benefits = benefitText.length > 0 ? benefitText.split('|').filter((item: string) => item.length > 0) : []
			}
		} catch (e) {}
		if (isCustomApplication.value) loadCityPicker()
	})

	const handleUploadAvatar = () => {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res: any) => {
				formData.avatar = res.tempFilePaths[0]
			}
		})
	}

	const handleCustomSubmit = async () => {
		if (isCustomSubmitting.value) return
		if (customPlan.id <= 0 || customPlan.name.length == 0 || customPlan.price <= 0) {
			uni.showToast({ title: '请选择有效的私人定制套餐', icon: 'none' })
			return
		}
		if (formData.name.trim().length < 2) {
			uni.showToast({ title: '请填写真实姓名', icon: 'none' })
			return
		}
		if (!/^1[3-9]\d{9}$/.test(formData.phone.trim())) {
			uni.showToast({ title: '请填写正确的手机号', icon: 'none' })
			return
		}
		if (!formData.city.trim()) {
			uni.showToast({ title: '请填写所在城市', icon: 'none' })
			return
		}
		if (formData.requirements.trim().length < 10) {
			uni.showToast({ title: '请至少填写 10 个字的关系期待', icon: 'none' })
			return
		}
		isCustomSubmitting.value = true
		try {
			const result = await createCustomServiceOrder({
				planId: customPlan.id,
				planName: customPlan.name,
				planPrice: customPlan.price,
				planDuration: customPlan.duration,
				realName: formData.name.trim(),
				phone: formData.phone.trim(),
				city: formData.city.trim(),
				requirements: formData.requirements.trim()
			})
			if (!result.success || result.data == null) {
				uni.showToast({ title: result.message != null ? result.message : '资料保存失败', icon: 'none' })
				isCustomSubmitting.value = false
				return
			}
			uni.navigateTo({
				url: '/pagesSub/matchmaker/payment?orderNo=' + encodeURIComponent(String(result.data.order_no)),
				success: () => { isCustomSubmitting.value = false },
				fail: () => {
					isCustomSubmitting.value = false
					uni.showToast({ title: '暂时无法进入确认服务', icon: 'none' })
				}
			})
		} catch (e) {
			isCustomSubmitting.value = false
			uni.showToast({ title: '资料保存失败，请稍后重试', icon: 'none' })
		}
	}

	const handleSubmit = () => {
		if (!formData.name.trim()) {
			uni.showToast({ title: '请填写真实姓名', icon: 'none' })
			return
		}
		if (!formData.phone.trim()) {
			uni.showToast({ title: '请填写手机号', icon: 'none' })
			return
		}
		if (!formData.wechat.trim()) {
			uni.showToast({ title: '请填写微信号', icon: 'none' })
			return
		}
		if (!formData.bio.trim()) {
			uni.showToast({ title: '请填写个人简介', icon: 'none' })
			return
		}

		// Mock 提交
		uni.showToast({ title: '申请已提交，请等待审核', icon: 'success' })
		setTimeout(() => {
			uni.navigateBack()
		}, 1500)
	}
</script>

<style scoped>
	.apply-page {
		min-height: 100vh;
		background: var(--canvas);
	}

	.scroller {
		height: 100vh;
	}

	.page-pad {
		padding: 14px 14px 40px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.custom-application {
		display: flex;
		flex-direction: column;
		gap: 22px;
	}

	.custom-hero {
		position: relative;
		overflow: hidden;
		min-height: 0;
		padding: 22px 20px 17px;
		border-radius: 20px;
		background: var(--navy);
		box-sizing: border-box;
	}

	.custom-hero-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.custom-hero-orb {
		position: absolute;
		border-radius: 50%;
		background: rgba(121, 177, 169, 0.16);
	}

	.hero-orb-one {
		width: 160px;
		height: 160px;
		top: -76px;
		right: -42px;
	}

	.hero-orb-two {
		width: 76px;
		height: 76px;
		bottom: -42px;
		right: 48px;
		background: rgba(255, 255, 255, 0.08);
	}

	.hero-eyebrow {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 7px;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.13em;
		color: var(--soft);
	}

	.hero-eyebrow-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 4px rgba(56, 152, 141, 0.18);
	}

	.custom-hero-title {
		font-size: 25px;
		line-height: 1.32;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--paper);
	}

	.custom-hero-desc {
		max-width: 286px;
		font-size: 13px;
		line-height: 1.65;
		color: #D5E6E2;
	}

	.hero-privacy {
		position: relative;
		margin-top: 18px;
		padding-top: 10px;
		border-top: 1px solid rgba(194, 224, 207, 0.2);
		z-index: 1;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 6px;
		font-size: 10px;
		color: var(--soft);
	}

	.privacy-mark {
