<template>
	<view class="page">
		<view class="topbar" :style="{ paddingTop: statusBarHeight + 'px' }">
			<button class="back-button" @click="returnHome">‹</button>
			<text class="topbar-title">我的纸飞机</text>
			<view class="topbar-placeholder"></view>
		</view>

		<scroll-view class="content" scroll-y>
			<view class="list-header">
				<text class="list-title">聊天列表</text>
				<button class="sent-action" @click="openSentPage">我发出的</button>
			</view>
			<view class="intro-card">
				<view class="intro-icon"><text>✈</text></view>
				<view class="intro-copy">
					<text class="intro-title">纸飞机消息</text>
					<text class="intro-desc">从一架纸飞机开始的认真对话</text>
				</view>
			</view>

			<view v-if="conversations.length > 0" class="conversation-list">
				<button v-for="item in conversations" :key="item.id" class="conversation-card" @click="openConversation(item)">
					<image class="avatar" :src="item.avatar" mode="aspectFill" @click.stop="openPeerProfile(item)"></image>
					<view class="conversation-copy">
						<view class="conversation-head">
							<text class="conversation-name">{{ item.name }}</text>
							<text class="conversation-time">{{ item.timeText }}</text>
						</view>
						<view class="conversation-body">
							<text class="conversation-label">{{ item.planeType }}</text>
							<text class="conversation-message">{{ item.lastMessage }}</text>
						</view>
					</view>
					<text v-if="item.unreadCount > 0" class="conversation-unread">{{ unreadLabel(item.unreadCount) }}</text>
				</button>
			</view>

			<view v-else class="empty-state">
				<view class="empty-icon"><text>✈</text></view>
				<text class="empty-title">还没有聊天消息</text>
				<text class="empty-desc">回复一架纸飞机后，对话会出现在这里</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { getPaperPlaneConversations, markPaperPlaneConversationRead } from '@/api'

	const systemInfo = uni.getSystemInfoSync()
	const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
	const conversations = ref([] as any[])

	onMounted(() => {
		loadConversations()
	})

	onShow(() => {
		loadConversations()
	})

	const loadConversations = async () => {
		try {
			const res = await getPaperPlaneConversations()
			if (res != null && res.success && Array.isArray(res.data)) {
				conversations.value = res.data as any[]
			}
		} catch (e) {
			console.error(e)
		}
	}

	const unreadLabel = (count: number): string => {
		return count > 99 ? '99+' : '' + count
	}

	const openSentPage = () => {
		uni.navigateTo({ url: '/pagesSub/community/paper-plane-sent' })
	}

	const openPeerProfile = (item: any) => {
		if (item == null || item.userId == null || Number(item.userId) <= 0) {
			uni.showToast({ title: '暂时无法获取对方资料', icon: 'none' })
			return
		}
		uni.navigateTo({ url: '/pagesSub/userExtra/user/detail?userId=' + item.userId })
	}

	const returnHome = () => {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack()
			return
		}
		uni.switchTab({ url: '/pages/community/community' })
	}

	const openConversation = async (item: any) => {
		try {
			await markPaperPlaneConversationRead(item.id)
		} catch (e) {}
		item.unreadCount = 0
		uni.navigateTo({
			url: '/pagesSub/chat/detail?paperPlaneConversationId=' + item.id + '&paperPlaneLabel=' + encodeURIComponent(item.name)
		})
	}
</script>

<style scoped>
	.page { height: 100%; min-height: 0; width: 100vw; overflow: hidden; display: flex; flex-direction: column; background: #F4F0FF; }
	/* #ifdef H5 */
	.page { height: 100vh; }
	/* #endif */
	.topbar { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 10px 14px; background: rgba(255, 255, 255, 0.95); border-bottom: 1px solid #E6DDF5; }
	.back-button, .topbar-placeholder { width: 36px; height: 36px; }
	.back-button { border-radius: 18px; background: #EEE8FF; color: #5635A1; font-size: 26px; line-height: 29px; }
	.back-button::after { border: none; }
	.topbar-title { font-size: 18px; font-family: var(--serif); font-weight: 800; color: #24143E; }
	.list-header { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 13px; padding: 2px 1px 0; }
	.list-title { font-size: 19px; font-weight: 800; color: #2D1A4A; }
	.sent-action { min-width: 78px; height: 35px; padding: 0 13px; border-radius: 11px; background: #7450C8; color: #FFFFFF; font-size: 12px; font-weight: 800; }
	.sent-action::after { border: none; }
	.content { flex: 1; min-height: 0; padding: 18px 14px calc(20px + env(safe-area-inset-bottom)); box-sizing: border-box; }
	.intro-card { display: flex; flex-direction: row; align-items: center; gap: 11px; padding: 14px; border-radius: 18px; background: #FFFFFF; border: 1px solid #E2D5FF; box-shadow: 0 7px 18px rgba(82, 52, 145, 0.08); }
	.intro-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 14px; background: #EDE4FF; color: #7952CF; font-size: 21px; }
	.intro-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
	.intro-title { font-size: 14px; font-weight: 800; color: #281944; }
	.intro-desc { font-size: 11px; color: #938AA2; }
	.conversation-list { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
	.conversation-card { width: 100%; min-height: 76px; display: flex; flex-direction: row; align-items: center; gap: 11px; padding: 12px; border-radius: 17px; background: #FFFFFF; border: 1px solid #EAE4F3; text-align: left; }
	.conversation-card::after { border: none; }
	.avatar { width: 48px; height: 48px; border-radius: 16px; flex-shrink: 0; background: #EEE8FF; }
	.conversation-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
	.conversation-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 8px; }
	.conversation-name { font-size: 15px; font-weight: 800; color: #24143E; }
	.conversation-time { font-size: 10px; color: #A59BAE; flex-shrink: 0; }
	.conversation-body { display: flex; flex-direction: row; align-items: center; gap: 6px; min-width: 0; }
	.conversation-label { padding: 3px 6px; border-radius: 7px; background: #F0E9FF; color: #6E49BB; font-size: 9px; font-weight: 800; flex-shrink: 0; }
	.conversation-message { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #756C80; font-size: 12px; }
	.conversation-unread { min-width: 20px; height: 20px; padding: 0 5px; display: flex; align-items: center; justify-content: center; border-radius: 10px; background: #EE5F95; color: #FFFFFF; font-size: 10px; font-weight: 800; flex-shrink: 0; }
	.empty-state { min-height: 330px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; }
	.empty-icon { width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 20px; background: #EAE2FF; color: #8260CC; font-size: 28px; }
	.empty-title { margin-top: 3px; font-size: 16px; font-weight: 800; color: #4B3C62; }
	.empty-desc { font-size: 12px; color: #A49AAF; }
</style>
