	font-size: 22px;
	font-weight: 700;
	color: #2E2418;
	font-family: var(--serif, serif);
}
.mx-entry-sub {
	font-size: 13px;
	color: #9A8C77;
	margin-top: 4px;
}
.mx-entry-card {
	background: #FFFCF5;
	border: 1px solid #E6DAC4;
	border-radius: 12px;
	padding: 16px;
}
.mx-entry-card-title {
	font-size: 16px;
	font-weight: 700;
	color: #2E2418;
}
.mx-entry-card-body {
	font-size: 13px;
	color: #5C4F3D;
	line-height: 1.6;
	margin-top: 8px;
}
.mx-entry-card-actions {
	display: flex;
	flex-direction: row;
	margin-top: 14px;
	gap: 8px;
}
.mx-entry-btn {
	flex: 1;
	height: 38px;
	border-radius: 8px;
	background: #FFFCF5;
	border: 1px solid #E6DAC4;
	display: flex;
	align-items: center;
	justify-content: center;
}
.mx-entry-btn-primary {
	background: #B4762B;
	border-color: none;
}
.mx-entry-btn-text {
	font-size: 13px;
	color: #B4762B;
	font-weight: 700;
}
.mx-entry-btn-text-primary {
	color: #FFFCF5;
}
.mx-entry-meta {
	margin-top: 10px;
}
.mx-entry-meta-label {
	font-size: 11px;
	color: #9A8C77;
}
.mx-entry-meta-value {
	font-size: 13px;
	color: #2E2418;
	margin-top: 2px;
}
.mx-entry-error {
	margin-top: 14px;
	padding: 10px 12px;
	border-radius: 8px;
	background: rgba(201, 123, 87, 0.12);
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8px;
}
.mx-entry-error-text {
	flex: 1;
	font-size: 12px;
	color: #A05A3E;
}
.mx-entry-error-btn {
	padding: 4px 10px;
	border-radius: 6px;
	background: #A05A3E;
}
.mx-entry-error-btn-text {
	font-size: 11px;
	color: #FFFCF5;
	font-weight: 700;
}
</style>