<template>
	<!-- 字段卡:画像草稿字段的协商界面(AI 提出理解 → 用户确认/改写/否定/移出)。
	     所有操作都映射后端真实 PATCH action:confirm / replace / reject / delete。 -->
	<view class="pi-card" :class="'pi-' + status">
		<view class="pi-head">
			<text class="pi-label">{{ fieldLabel }}</text>
			<view v-if="statusBadgeText != ''" class="pi-badge" :class="'pi-badge-' + status">
				<text class="pi-badge-text">{{ statusBadgeText }}</text>
			</view>
		</view>
		<text class="pi-value">{{ displayValue }}</text>

			<!-- 把握(置信度)与来源 -->
			<view class="pi-meta">
				<view class="pi-purity">
					<view v-for="d in 3" :key="d" class="pi-dot" :class="{ on: d <= purityDots }"></view>
					<text class="pi-purity-text">把握{{ purityText }}</text>
				</view>
				<text class="pi-source">{{ sourceLabel }}</text>
			</view>

			<!-- 原话(AI 判断依据:引用原文) -->
			<view v-if="sourceQuote != ''" class="pi-note" @tap="noteExpanded = !noteExpanded">
				<text class="pi-note-toggle">{{ noteExpanded ? '收起原话' : '它为什么这样理解?查看你说过的原话' }}</text>
			<text class="pi-note-arrow" :class="{ expanded: noteExpanded }">›</text>
		</view>
		<view v-if="noteExpanded && sourceQuote != ''" class="pi-note-body">
			<text class="pi-note-quote">“{{ sourceQuote }}”</text>
		</view>

		<!-- 操作区 -->
		<view v-if="showActions" class="pi-actions">
			<view v-if="status == 'suggested'" class="pi-action-row">
				<view class="pi-btn pi-btn-fix" @tap="emitAction('confirm')">
					<text class="pi-btn-text pi-btn-text-fix">确认这一笔</text>
					</view>
					<view class="pi-btn" @tap="emitAction('edit')">
						<text class="pi-btn-text pi-btn-text-plain">改一改</text>
				</view>
				<view class="pi-btn" @tap="emitAction('reject')">
					<text class="pi-btn-text pi-btn-text-dim">不是这样</text>
				</view>
			</view>
			<view v-if="status == 'confirmed'" class="pi-action-row">
				<view class="pi-btn" @tap="emitAction('edit')">
					<text class="pi-btn-text pi-btn-text-plain">改一改</text>
					</view>
					<view class="pi-btn" @tap="emitAction('delete')">
						<text class="pi-btn-text pi-btn-text-dim">移出</text>
					</view>
				</view>
				<view v-if="status == 'rejected'" class="pi-action-row">
					<view class="pi-btn" @tap="emitAction('confirm')">
						<text class="pi-btn-text pi-btn-text-plain">重新确认</text>
					</view>
					<view class="pi-btn" @tap="emitAction('delete')">
						<text class="pi-btn-text pi-btn-text-dim">移出</text>
				</view>
			</view>
		</view>

		<!-- 内联调整(提交 replace) -->
		<view v-if="editing" class="pi-edit">
			<textarea
				class="pi-edit-input"
				:value="editValue"
				@input="onEditInput"
				maxlength="500"
				placeholder="写下更接近你的表达"
				placeholder-class="pi-ph"
				:show-confirm-bar="false"
				:disable-default-padding="true"
				:cursor-spacing="16"
			/>
			<view class="pi-edit-foot">
				<view class="pi-edit-cancel" @tap="cancelEdit">
					<text class="pi-edit-cancel-text">取消</text>
				</view>
				<view class="pi-edit-save" @tap="saveEdit">
						<text class="pi-edit-save-text">保存并确认</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { displayFieldValue } from '@/utils/profile-field-display.uts'

interface Props {
	field: any
	fieldLabel: string
}

const props = defineProps<Props>()
const emit = defineEmits<{
	confirm: [fieldKey: string]
	replace: [fieldKey: string, value: any]
	reject: [fieldKey: string]
	delete: [fieldKey: string]
}>()

const noteExpanded = ref(false)
const editing = ref(false)
const editValue = ref('')

const field = computed(() => props.field != null ? props.field : ({} as any))
const status = computed(() => String(field.value.confirmation_status != null ? field.value.confirmation_status : 'suggested'))

const displayValue = computed(() => {
	const raw = field.value.value
	const dv = field.value.display_value != null ? String(field.value.display_value) : ''
	const key = field.value.field_key != null ? String(field.value.field_key) : ''
	if (raw == null && dv == '') return '未填写'
	const shown = displayFieldValue(key, raw, dv)
	return shown != '' ? shown : '未填写'
})

const confidence = computed(() => Number(field.value.confidence != null ? field.value.confidence : 0))
const purityDots = computed(() => {
	const c = confidence.value
	if (c >= 0.85) return 3
	if (c >= 0.65) return 2
	return 1
})
const purityText = computed(() => {
	const c = confidence.value
	if (c >= 0.85) return '高'
	if (c >= 0.65) return '中'
	return '低'
})

const sourceQuote = computed(() => {
	const q = field.value.source_quote
	return q != null && q != '' ? String(q) : ''
})

const sourceLabel = computed(() => {
	const st = String(field.value.source_type != null ? field.value.source_type : 'ai_extract')
	if (st == 'user_input' || st == 'user_edited') return '来自你的修改'
		if (st == 'restored') return '来自往稿'
		return '来自你的回答'
	})

	const showActions = computed(() => status.value != 'deleted' && !editing.value)
	const statusBadgeText = computed(() => {
		if (status.value == 'suggested') return '待确认'
		if (status.value == 'confirmed') return '已确认'
		if (status.value == 'rejected') return '已否定'
	return ''
})

const emitAction = (action: string) => {
	if (action == 'confirm') {
		emit('confirm', String(field.value.field_key))
	} else if (action == 'edit') {
		editValue.value = displayValue.value
		editing.value = true
		noteExpanded.value = false
	} else if (action == 'reject') {
		emit('reject', String(field.value.field_key))
	} else if (action == 'delete') {
		emit('delete', String(field.value.field_key))
	}
}

const onEditInput = (e: any) => { editValue.value = e.detail.value }

const cancelEdit = () => {
	editing.value = false
	editValue.value = ''
}

const saveEdit = () => {
	const value = editValue.value.trim()
	if (value == '') {
		uni.showToast({ title: '内容不能为空', icon: 'none' })
		return
	}
	emit('replace', String(field.value.field_key), value)
	editing.value = false
	editValue.value = ''
}
</script>

<style scoped>
.pi-card {
	background: var(--at-card, #FFFCF5);
	border: 1px solid var(--at-line, #E6DAC4);
	border-radius: 14px;
	padding: 13px 15px;
	margin-bottom: 10px;
}
.pi-rejected { opacity: 0.66; }

.pi-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.pi-label { font-size: 13px; font-weight: 700; color: var(--at-ink2, #5C4F3D); }
.pi-badge { padding: 2px 9px; border-radius: 999px; }
.pi-badge-suggested { background: rgba(217, 164, 65, 0.18); }
.pi-badge-confirmed { background: rgba(78, 125, 91, 0.16); }
.pi-badge-rejected { background: rgba(154, 140, 119, 0.16); }
.pi-badge-text { font-size: 10px; font-weight: 700; }
.pi-badge-suggested .pi-badge-text { color: #9A6B1F; }
.pi-badge-confirmed .pi-badge-text { color: var(--at-fixed, #4E7D5B); }
.pi-badge-rejected .pi-badge-text { color: var(--at-mist, #9A8C77); }

.pi-value {
	font-size: 15px;
	color: var(--at-ink, #2E2418);
	line-height: 1.5;
	margin-top: 3px;
	font-family: var(--serif, serif);
}

	/* 把握与来源 */
.pi-meta {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-top: 6px;
}
.pi-purity { display: flex; flex-direction: row; align-items: center; gap: 4px; }
.pi-dot {
	width: 6px;
	height: 6px;
	border-radius: 999px;
	background: var(--at-line, #E6DAC4);
}
.pi-dot.on { background: var(--at-honey, #D9A441); }
.pi-purity-text { font-size: 11px; color: var(--at-mist, #9A8C77); margin-left: 4px; }
.pi-source { font-size: 11px; color: var(--at-mist, #9A8C77); }

	/* 原话 */
.pi-note {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 4px;
	margin-top: 8px;
}
.pi-note-toggle { font-size: 11px; color: var(--at-amber-deep, #8A5A1D); font-weight: 600; }
.pi-note-arrow {
	font-size: 13px;
	color: var(--at-amber-deep, #8A5A1D);
	transition: transform 0.18s ease-out;
}
.pi-note-arrow.expanded { transform: rotate(90deg); }
.pi-note-body {
	margin-top: 5px;
	padding: 8px 11px;
	border-radius: 8px;
	background: rgba(230, 218, 196, 0.35);
}
.pi-note-quote {
	font-size: 12px;
	color: var(--at-ink2, #5C4F3D);
	line-height: 1.7;
	font-style: italic;
	font-family: var(--serif, serif);
}

/* 操作区 */
.pi-actions { margin-top: 9px; }
.pi-action-row { display: flex; flex-direction: row; gap: 8px; }
.pi-btn {
	padding: 6px 14px;
	border-radius: 999px;
	border: 1px solid var(--at-line, #E6DAC4);
	background: rgba(255, 252, 245, 0.9);
}
.pi-btn:active { transform: scale(0.96); }
.pi-btn-fix { background: var(--at-amber, #B4762B); border-color: var(--at-amber, #B4762B); }
.pi-btn-text { font-size: 12px; font-weight: 700; }
.pi-btn-text-fix { color: #FFF6E8; }
.pi-btn-text-plain { color: var(--at-ink2, #5C4F3D); }
.pi-btn-text-dim { color: var(--at-mist, #9A8C77); }

/* 内联调整 */
.pi-edit { margin-top: 9px; }
.pi-edit-input {
	width: 100%;
	min-height: 58px;
	padding: 8px 10px;
	border: 1px solid var(--at-line, #E6DAC4);
	border-radius: 10px;
	font-size: 14px;
	color: var(--at-ink, #2E2418);
	background: #FFFEFA;
}
.pi-ph { color: var(--at-mist, #9A8C77); }
.pi-edit-foot {
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	gap: 8px;
	margin-top: 7px;
}
.pi-edit-cancel {
	padding: 6px 14px;
	border-radius: 999px;
	border: 1px solid var(--at-line, #E6DAC4);
}
.pi-edit-cancel-text { font-size: 12px; font-weight: 700; color: var(--at-mist, #9A8C77); }
.pi-edit-save { padding: 6px 14px; border-radius: 999px; background: var(--at-amber, #B4762B); }
.pi-edit-save-text { font-size: 12px; font-weight: 700; color: #FFF6E8; }
</style>
