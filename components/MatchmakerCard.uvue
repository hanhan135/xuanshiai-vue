<template>
	<view class="matchmaker-card" @click="handleDetail">
		<view class="card-body">
			<view class="card-profile">
				<view class="card-avatar">
					<MatchmakerAvatar :src="data.avatar" :name="data.name" variant="card" />
				</view>
				<view class="card-top-copy">
					<text class="card-name">{{ data.name }}</text>
				</view>
			</view>
			<text class="card-copy">{{ cardCopy }}</text>

			<view class="card-meta">
				<view class="meta-item">
					<text class="meta-value">{{ data.successCount }}</text>
					<text class="meta-label">牵线成功</text>
				</view>
				<view class="meta-item">
					<text class="meta-value">{{ data.serviceCount }}</text>
					<text class="meta-label">累计服务</text>
				</view>
			</view>

			<view class="card-footer">
				<view v-if="data.certification || data.badge" class="card-certification">
					<text class="certification-mark">✓</text>
					<text>已认证</text>
				</view>
				<view class="card-button" @click.stop="handleContact">
					<text>{{ actionText }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import MatchmakerAvatar from '@/components/MatchmakerAvatar.uvue';

interface Props {
	data: any;
	actionText?: string;
}

const props = withDefaults(defineProps<Props>(), {
	actionText: '联系她'
});

const emit = defineEmits<{
	detail: [item: any];
	contact: [item: any];
}>();

const cardCopy = computed(() => {
	if (props.data == null) return '';
	if (props.data.caseRecord != null && props.data.caseRecord.length > 0) return props.data.caseRecord;
	if (props.data.introduction != null && props.data.introduction.length > 0) return props.data.introduction;
	return props.data.description != null ? props.data.description : '';
});

const handleDetail = () => {
	emit('detail', props.data);
};

const handleContact = () => {
	emit('contact', props.data);
};
</script>

<style scoped>
	.matchmaker-card {
		width: 100%;
		min-width: 0;
		border-radius: 24rpx 14rpx 22rpx 14rpx;
		background: var(--match-paper);
		overflow: hidden;
		box-shadow: var(--match-shadow);
		border: 1px solid var(--match-line);
	}

	.card-body {
		min-height: 254rpx;
		padding: 18rpx;
		display: flex;
		flex-direction: column;
		gap: 14rpx;
	}

	.card-profile {
		min-width: 0;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 12rpx;
	}

	.card-avatar {
		width: 82rpx;
		height: 82rpx;
		border-radius: 50%;
		overflow: hidden;
		flex-shrink: 0;
		background: var(--match-sky);
		border: 2rpx solid var(--match-line);
	}

	.card-top-copy {
		min-width: 0;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.card-name {
		font-size: 29rpx;
		line-height: 1.2;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--ink);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.card-copy {
		height: 44rpx;
		font-size: 18rpx;
		line-height: 1.35;
		color: var(--ink2);
		overflow: hidden;
		white-space: normal;
	}

	.card-meta {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 10rpx;
		padding: 12rpx 0;
		border-top: 1px solid var(--match-line);
		border-bottom: 1px solid var(--match-line);
	}

	.meta-item {
		display: flex;
		flex-direction: column;
		gap: 3rpx;
	}

	.meta-item + .meta-item {
		padding-left: 14rpx;
		border-left: 1px solid var(--match-line);
	}

	.meta-value {
		font-size: 27rpx;
		line-height: 1;
		font-weight: 800;
		color: var(--match-deep);
	}

	.meta-label {
		font-size: 17rpx;
		color: var(--muted);
	}

	.card-footer {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		gap: 10rpx;
		min-height: 42rpx;
	}

	.card-certification {
		min-height: 26rpx;
		padding: 0 7rpx;
		border-radius: 999rpx;
		background: transparent;
		color: var(--muted);
		display: flex;
		align-items: center;
		gap: 3rpx;
	}

	.card-certification text {
		font-size: 14rpx;
		line-height: 1.25;
		font-weight: 600;
		white-space: nowrap;
	}

	.certification-mark {
		width: 16rpx;
		height: 16rpx;
		border-radius: 50%;
		background: var(--match-mist);
		color: var(--match-deep) !important;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 12rpx !important;
		font-weight: 800 !important;
	}

	.card-button {
		width: 88rpx;
		height: 40rpx;
		flex-shrink: 0;
		border-radius: 14rpx;
		background: var(--match-mist);
		border: 1px solid var(--match-line);
		color: var(--match-deep);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 19rpx;
		font-weight: 800;
	}
</style>
