<template>
	<!-- AI 画像底部输入栏:文字 / 语音 / 转写确认 / 抽取中 / 发布 -->
	<view class="pib-bar">
		<!-- 转写确认态(语音模式) -->
		<view v-if="voiceMode && transcribeText != ''" class="pib-transcribe-card">
			<text class="pib-transcribe-label">语音转写结果</text>
			<textarea
				class="pib-transcribe-input"
				:value="transcribeText"
				@input="emit('transcribeInput', $event)"
				maxlength="2000"
				:show-confirm-bar="false"
				:disable-default-padding="true"
				:cursor-spacing="16"
			/>
			<view class="pib-transcribe-foot">
				<view class="pib-transcribe-retry" @tap="emit('retryVoice')">
					<text class="pib-transcribe-retry-text">重新录音</text>
				</view>
				<view class="pib-transcribe-confirm" @tap="emit('confirmTranscribe')">
					<text class="pib-transcribe-confirm-text">确认回答</text>
				</view>
			</view>
		</view>

		<!-- 语音输入态 -->
		<view v-else-if="voiceMode && currentQuestion != null && !extracting && !publishing" class="pib-voice-area">
			<VoiceRecorder
				ref="voiceRecorderRef"
				:questionText="currentQuestionText"
				:questionFieldKey="currentQuestionFieldKey"
				:autoSpeak="false"
				@transcribed="emit('transcribed', $event)"
				@cancelled="emit('voiceCancelled')"
			/>
			<view class="pib-mode-switch" @tap="emit('switchToText')">
				<text class="pib-mode-switch-text">切换为文字模式</text>
			</view>
		</view>

		<!-- 文字输入态 -->
		<view v-else-if="!voiceMode && currentQuestion != null && !extracting && !publishing" class="pib-input-row">
			<input
				class="pib-input"
				:value="answerText"
				@input="emit('answerInput', $event)"
				:placeholder="inputPlaceholder"
				placeholder-class="pib-ph"
				maxlength="2000"
				:cursor-spacing="16"
			/>
			<view
				class="pib-send-btn"
				:class="{ 'pib-send-ready': answerText.trim().length > 0 }"
				@tap="emit('submitAnswer')"
			>
				<text class="pib-send-text">发送</text>
			</view>
			<view class="pib-mode-switch pib-mode-switch-inline" @tap="emit('switchToVoice')" v-if="!voiceMode">
				<text class="pib-mode-switch-glyph">⌒</text>
			</view>
		</view>

		<!-- 抽取中态 -->
		<view v-if="extracting" class="pib-input-row">
			<view class="pib-bar-status">
				<view class="pib-bar-spinner"></view>
				<text class="pib-bar-status-text">AI 正在整理你的回答...</text>
			</view>
		</view>

		<!-- 发布态 -->
		<view v-if="confirmedCount > 0 && !extracting" class="pib-input-row pib-publish-row">
			<text class="pib-publish-info">已确认 {{ confirmedCount }} 个字段</text>
			<view
				class="pib-publish-btn"
				:class="{ 'pib-publish-ready': !publishing }"
				@tap="emit('publishDraft')"
			>
				<text class="pib-publish-text">{{ publishing ? '发布中...' : '发布画像' }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * PortraitInputBar - AI 画像底部输入栏。
 * 承接文字 / 语音 / 转写确认 / 抽取中 / 发布五态,去 emoji,语音切换用 Unicode 字形。
 * VoiceRecorder ref 暴露给父组件(用于 reset 等)。
 */
import VoiceRecorder from './VoiceRecorder.uvue'

interface Props {
	voiceMode: boolean
	currentQuestion: any
	currentQuestionText: string
	currentQuestionFieldKey: string
	answerText: string
	transcribeText: string
	inputPlaceholder: string
	extracting: boolean
	publishing: boolean
	confirmedCount: number
}

const props = defineProps<Props>()
const emit = defineEmits<{
	answerInput: [e: any]
	submitAnswer: []
	switchToText: []
	switchToVoice: []
	transcribed: [text: string]
	voiceCancelled: []
	transcribeInput: [e: any]
	retryVoice: []
	confirmTranscribe: []
	publishDraft: []
}>()

const voiceRecorderRef = ref<any>(null)
defineExpose({
	getRecorderRef: () => voiceRecorderRef.value
})
</script>

<style scoped>
.pib-bar { padding: 10px 16px; padding-bottom: calc(10px + env(safe-area-inset-bottom)); background: var(--paper); border-top: 1px solid var(--line); }
.pib-input-row { display: flex; flex-direction: row; align-items: center; gap: 8px; }

/* 文字输入 */
.pib-input { flex: 1; height: 40px; padding: 0 12px; border: 1px solid var(--line); border-radius: 10px; font-size: 14px; color: var(--ink); background: var(--surface); }
.pib-ph { color: var(--muted); }
.pib-send-btn { padding: 0 18px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 10px; background: var(--bg-subtle); }
.pib-send-btn:active { transform: scale(0.98); }
.pib-send-ready { background: var(--accent); }
.pib-send-text { font-size: 14px; font-weight: 700; color: var(--text-invert); }

/* 语音切换:用 ⌒(话筒弧形)Unicode 字形替代 🎤 emoji */
.pib-mode-switch { display: flex; align-items: center; justify-content: center; }
.pib-mode-switch-inline { margin-left: 4px; padding: 0 10px; height: 40px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
.pib-mode-switch-glyph { font-size: 20px; color: var(--accent2); font-weight: 700; }
.pib-mode-switch-text { font-size: 12px; color: var(--accent2); font-weight: 600; }

/* 语音区 */
.pib-voice-area { display: flex; flex-direction: column; align-items: center; padding: 8px 0; }
.pib-voice-area .pib-mode-switch { margin-top: 8px; padding: 4px 12px; }

/* 转写确认卡片 */
.pib-transcribe-card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 12px; }
.pib-transcribe-label { font-size: 11px; color: var(--muted); font-weight: 600; margin-bottom: 6px; }
.pib-transcribe-input { width: 100%; min-height: 48px; font-size: 14px; color: var(--ink); line-height: 1.5; }
.pib-transcribe-foot { display: flex; flex-direction: row; justify-content: flex-end; gap: 8px; margin-top: 8px; }
.pib-transcribe-retry { padding: 7px 14px; border-radius: 9px; border: 1px solid var(--line); background: var(--surface); }
.pib-transcribe-retry:active { transform: scale(0.98); }
.pib-transcribe-retry-text { font-size: 12px; font-weight: 700; color: var(--muted); }
.pib-transcribe-confirm { padding: 7px 14px; border-radius: 9px; background: var(--accent); }
.pib-transcribe-confirm:active { transform: scale(0.98); }
.pib-transcribe-confirm-text { font-size: 12px; font-weight: 700; color: var(--text-invert); }

/* 抽取中 */
.pib-bar-status { flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 8px; height: 40px; }
.pib-bar-spinner { width: 16px; height: 16px; border: 2px solid var(--warm); border-top-color: var(--accent); border-radius: 50%; animation: pib-spin 0.6s linear infinite; }
@keyframes pib-spin { to { transform: rotate(360deg); } }
.pib-bar-status-text { font-size: 13px; color: var(--muted); }

/* 发布行 */
.pib-publish-row { justify-content: space-between; }
.pib-publish-info { font-size: 13px; color: var(--ink2); }
.pib-publish-btn { padding: 0 22px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 10px; background: var(--bg-subtle); }
.pib-publish-btn:active { transform: scale(0.98); }
.pib-publish-ready { background: var(--accent); }
.pib-publish-text { font-size: 14px; font-weight: 700; color: var(--text-invert); }
</style>
