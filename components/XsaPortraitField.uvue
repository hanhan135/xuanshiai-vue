<template>
	<view class="portrait-field" :class="statusClass">
		<!-- 字段头部:标签 + 状态 -->
		<view class="pf-head">
			<view class="pf-label-row">
				<text class="pf-label">{{ fieldLabel }}</text>
				<view v-if="statusBadge != ''" class="pf-badge" :class="'badge-' + statusBadge">
					<text class="pf-badge-text">{{ statusBadgeText }}</text>
				</view>
			</view>
			<text class="pf-value">{{ displayValue }}</text>
		</view>

		<!-- 来源信息 -->
		<view class="pf-source">
			<text class="pf-source-text">来源:{{ sourceLabel }}</text>
			<text v-if="confidence > 0" class="pf-confidence">置信度 {{ confidenceText }}</text>
		</view>

		<!-- 引用原文(折叠) -->
		<view v-if="sourceQuote != ''" class="pf-quote-section">
			<view class="pf-quote-toggle" @tap="quoteExpanded = !quoteExpanded">
				<text class="pf-quote-toggle-text">引用原文</text>
				<text class="pf-quote-arrow" :class="{ expanded: quoteExpanded }">›</text>
			</view>
			<view v-if="quoteExpanded" class="pf-quote-content">
				<text class="pf-quote-text">"{{ sourceQuote }}"</text>
			</view>
		</view>

		<!-- 操作按钮 -->
		<view v-if="showActions" class="pf-actions">
			<view v-if="status == 'suggested'" class="pf-action-row">
				<view class="pf-btn pf-btn-confirm" @tap="emitAction('confirm')">
					<text class="pf-btn-text pf-btn-text-confirm">✓ 确认</text>
				</view>
				<view class="pf-btn pf-btn-edit" @tap="emitAction('edit')">
					<text class="pf-btn-text pf-btn-text-edit">✎ 修改</text>
				</view>
				<view class="pf-btn pf-btn-reject" @tap="emitAction('reject')">
					<text class="pf-btn-text pf-btn-text-reject">✕ 拒绝</text>
				</view>
			</view>
			<view v-if="status == 'confirmed'" class="pf-action-row">
				<view class="pf-btn pf-btn-edit" @tap="emitAction('edit')">
					<text class="pf-btn-text pf-btn-text-edit">✎ 修改</text>
				</view>
				<view class="pf-btn pf-btn-delete" @tap="emitAction('delete')">
					<text class="pf-btn-text pf-btn-text-delete">删除</text>
				</view>
			</view>
			<view v-if="status == 'rejected'" class="pf-action-row">
				<view class="pf-btn pf-btn-recover" @tap="emitAction('confirm')">
					<text class="pf-btn-text pf-btn-text-recover">恢复</text>
				</view>
				<view class="pf-btn pf-btn-delete" @tap="emitAction('delete')">
					<text class="pf-btn-text pf-btn-text-delete">删除</text>
				</view>
			</view>
		</view>

		<!-- 内联编辑输入 -->
		<view v-if="editing" class="pf-edit-section">
			<textarea
				class="pf-edit-input"
				:value="editValue"
				@input="onEditInput"
				maxlength="500"
				placeholder="输入修改后的内容"
				placeholder-class="pf-ph"
				:show-confirm-bar="false"
				:disable-default-padding="true"
				:cursor-spacing="16"
			/>
			<view class="pf-edit-foot">
				<view class="pf-edit-cancel" @tap="cancelEdit">
					<text class="pf-edit-cancel-text">取消</text>
				</view>
				<view class="pf-edit-save" @tap="saveEdit">
					<text class="pf-edit-save-text">保存</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
interface Props {
	field: any
	fieldLabel: string
}

const props = defineProps<Props>()
const emit = defineEmits<{
	confirm: [fieldKey: string]
	edit: [fieldKey: string, value: any]
	reject: [fieldKey: string]
	delete: [fieldKey: string]
}>()

const quoteExpanded = ref(false)
const editing = ref(false)
const editValue = ref('')

const field = computed(() => props.field != null ? props.field : ({} as any))
const status = computed(() => String(field.value.confirmation_status != null ? field.value.confirmation_status : 'suggested'))
const displayValue = computed(() => {
	const v = field.value.display_value
	if (v != null && v != '') return String(v)
	const raw = field.value.value
	if (raw == null) return '未填写'
	if (Array.isArray(raw)) return raw.join('、')
	return String(raw)
})
const confidence = computed(() => Number(field.value.confidence != null ? field.value.confidence : 0))
const confidenceText = computed(() => {
	const c = confidence.value
	if (c >= 0.85) return '高'
	if (c >= 0.65) return '中'
	return '低'
})
const sourceQuote = computed(() => {
	const q = field.value.source_quote
	return q != null && q != '' ? String(q) : ''
})
const sourceLabel = computed(() => {
	const st = String(field.value.source_type != null ? field.value.source_type : 'ai_extract')
	if (st == 'user_input' || st == 'user_edited') return '你的输入'
	if (st == 'restored') return '历史版本恢复'
	return '你的回答'
})
const statusClass = computed(() => 'pf-' + status.value)
const showActions = computed(() => status.value != 'deleted' && !editing.value)
const statusBadge = computed(() => {
	if (status.value == 'suggested') return 'suggested'
	if (status.value == 'confirmed') return 'confirmed'
	if (status.value == 'rejected') return 'rejected'
	return ''
})
const statusBadgeText = computed(() => {
	if (status.value == 'suggested') return '待确认'
	if (status.value == 'confirmed') return '已确认'
	if (status.value == 'rejected') return '已拒绝'
	return ''
})

const emitAction = (action: string) => {
	if (action == 'confirm') emit('confirm', String(field.value.field_key))
	else if (action == 'edit') {
		editValue.value = displayValue.value
		editing.value = true
	}
	else if (action == 'reject') emit('reject', String(field.value.field_key))
	else if (action == 'delete') emit('delete', String(field.value.field_key))
}

const onEditInput = (e: any) => { editValue.value = e.detail.value }

const cancelEdit = () => {
	editing.value = false
	editValue.value = ''
}

const saveEdit = () => {
	const value = editValue.value.trim()
	if (value == '') {
		uni.showToast({ title: '内容不能为空', icon: 'none' })
		return
	}
	emit('edit', String(field.value.field_key), value)
	editing.value = false
	editValue.value = ''
}
</script>

<style scoped>
.portrait-field {
	background: var(--surface);
	border-radius: 12px;
	padding: 13px 16px;
	margin-bottom: 8px;
	border: 1px solid var(--line);
}

.pf-rejected { opacity: 0.7; }

.pf-head { margin-bottom: 6px; }
.pf-label-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.pf-label { font-size: 13px; font-weight: 700; color: var(--ink); font-family: var(--sans); }
.pf-value { font-size: 15px; color: var(--ink2); margin-top: 2px; font-family: var(--sans); line-height: 1.5; }

.pf-badge { padding: 2px 8px; border-radius: 999px; }
.badge-suggested { background: rgba(56, 152, 141, 0.12); }
.badge-confirmed { background: rgba(51, 141, 107, 0.12); }
.badge-rejected { background: rgba(123, 130, 130, 0.12); }
.pf-badge-text { font-size: 10px; font-weight: 700; }
.badge-suggested .pf-badge-text { color: var(--accent2); }
.badge-confirmed .pf-badge-text { color: var(--sage); }
.badge-rejected .pf-badge-text { color: var(--muted); }

.pf-source { display: flex; flex-direction: row; align-items: center; gap: 8px; margin-top: 4px; }
.pf-source-text { font-size: 11px; color: var(--muted); }
.pf-confidence { font-size: 11px; color: var(--muted); }

.pf-quote-section { margin-top: 6px; }
.pf-quote-toggle { display: flex; flex-direction: row; align-items: center; gap: 4px; }
.pf-quote-toggle-text { font-size: 11px; color: var(--accent2); font-weight: 600; }
.pf-quote-arrow { font-size: 12px; color: var(--accent2); transform: rotate(0deg); transition: transform 0.18s ease-out; }
.pf-quote-arrow.expanded { transform: rotate(90deg); }
.pf-quote-content { margin-top: 4px; padding: 8px 10px; background: var(--warm); border-radius: 6px; }
.pf-quote-text { font-size: 12px; color: var(--ink2); line-height: 1.6; font-style: italic; }

.pf-actions { margin-top: 8px; }
.pf-action-row { display: flex; flex-direction: row; gap: 8px; }
.pf-btn { padding: 6px 12px; border-radius: 8px; border: 1px solid var(--line); }
.pf-btn-confirm { background: var(--accent); border-color: var(--accent); }
.pf-btn-edit { background: var(--surface); }
.pf-btn-reject { background: var(--surface); }
.pf-btn-delete { background: var(--surface); }
.pf-btn-recover { background: var(--surface); border-color: var(--accent); }
.pf-btn-text { font-size: 12px; font-weight: 700; }
.pf-btn-text-confirm { color: var(--text-invert); }
.pf-btn-text-edit { color: var(--ink2); }
.pf-btn-text-reject { color: var(--muted); }
.pf-btn-text-delete { color: var(--muted); }
.pf-btn-text-recover { color: var(--accent2); }

.pf-edit-section { margin-top: 8px; }
.pf-edit-input { width: 100%; min-height: 60px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 9px; font-size: 14px; color: var(--ink); background: var(--paper); }
.pf-ph { color: var(--muted); }
.pf-edit-foot { display: flex; flex-direction: row; justify-content: flex-end; gap: 8px; margin-top: 6px; }
.pf-edit-cancel { padding: 6px 14px; border-radius: 8px; border: 1px solid var(--line); }
.pf-edit-cancel-text { font-size: 12px; font-weight: 700; color: var(--muted); }
.pf-edit-save { padding: 6px 14px; border-radius: 8px; background: var(--accent); }
.pf-edit-save-text { font-size: 12px; font-weight: 700; color: var(--text-invert); }
</style>
