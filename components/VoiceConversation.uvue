<template>
	<view class="vc-area" :class="{ 'vc-atelier-dark': theme == 'atelier-dark' }">
		<!-- 听写纸:一行转写 + 一行回复,都常驻 -->
		<view class="vc-paper">
			<!-- 你说的(转写) -->
			<view v-if="finalText != '' || partialText != ''" class="vc-line vc-line-you">
				<text class="vc-line-who">你</text>
				<text v-if="partialText != ''" class="vc-line-text">{{ partialText }}</text>
				<text v-else class="vc-line-text">{{ finalText }}</text>
			</view>

			<!-- 它说的(回复) -->
			<view v-if="aiReplyText != ''" class="vc-line vc-line-model">
				<text class="vc-line-who">它</text>
				<view class="vc-line-body">
					<text class="vc-line-text">{{ aiReplyText }}</text>
				</view>
			</view>
		</view>

		<!-- 波形 -->
		<VoiceWaveform :state="waveformState" :theme="theme == 'atelier-dark' ? 'atelier-dark' : 'default'" />

		<!-- 状态文案 -->
		<view class="vc-status-zone">
			<text v-if="convState == 'idle'" class="vc-status-text">点击开始对话,像和朋友聊天一样回答</text>
			<text v-if="convState == 'listening'" class="vc-status-text vc-status-active">正在聆听... 点击停止</text>
			<text v-if="convState == 'processing'" class="vc-status-text">AI 正在落墨...</text>
			<text v-if="convState == 'speaking'" class="vc-status-text vc-status-active">AI 正在播报...</text>
			<text v-if="convState == 'reviewing'" class="vc-status-text vc-status-active">点听它读才出声</text>
		</view>

		<!-- 动作区:听它读(非播放态)/跳过播报(播放态) -->
		<view v-if="aiReplyText != '' && convState != 'speaking'" class="vc-action-zone">
			<view class="vc-listen-btn" @tap="listen">
				<text class="vc-listen-text">听它读</text>
			</view>
		</view>
		<view v-if="convState == 'speaking'" class="vc-action-zone">
			<view class="vc-skip" @tap="skipSpeaking">
				<text class="vc-skip-text">跳过播报</text>
			</view>
		</view>

		<!-- 对话按钮 -->
		<view
			class="vc-btn"
			:class="['vc-btn-' + convState, { 'vc-btn-disabled': convState == 'processing' }]"
			@tap="onButtonTap"
		>
			<view v-if="convState == 'idle'" class="vc-mic-zone">
				<text class="vc-ic vc-ic-yuyin"></text>
			</view>
			<view v-if="convState == 'listening'" class="vc-mic-zone vc-mic-zone-active">
				<view class="vc-pulse-ring"></view>
				<view class="vc-pulse-ring vc-pulse-ring-2"></view>
				<view class="vc-pulse-ring vc-pulse-ring-3"></view>
				<text class="vc-ic vc-ic-yuyin vc-mic-icon-active"></text>
			</view>
			<view v-if="convState == 'processing'" class="vc-mic-zone">
				<view class="vc-spinner"></view>
			</view>
			<view v-if="convState == 'speaking'" class="vc-mic-zone">
				<text class="vc-ic vc-ic-pinglun"></text>
			</view>
			<view v-if="convState == 'reviewing'" class="vc-mic-zone">
				<text class="vc-ic vc-ic-yuyin"></text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import VoiceWaveform from './VoiceWaveform.uvue'
	import { VoiceWS } from '@/api/voice-ws.uts'
	import { TTSPlayer } from '@/utils/tts-player.uts'

interface Props {
	sessionId?: string
	fieldKey?: string
	theme?: string
}

const props = withDefaults(defineProps<Props>(), {
	sessionId: '',
	fieldKey: '',
	theme: 'default'
})

const emit = defineEmits<{
	transcribed: [text: string]
	aiReply: [text: string, fieldKey: string]
	error: [code: string, message: string]
	sessionEnd: []
}>()

const convState = ref('idle')
const partialText = ref('')
const finalText = ref('')
const reasonText = ref('')
const aiReplyText = ref('')
let ws: VoiceWS | null = null
let recorderManager: any = null
let ttsPlayer: TTSPlayer | null = null
let chunkSeq = 0
let isRecording = false
let audioEndSent = false

const waveformState = computed(() => {
	if (convState.value == 'listening') return 'listening'
	if (convState.value == 'processing') return 'transcribing'
	if (convState.value == 'speaking') return 'speaking'
	return 'idle'
})

const onButtonTap = () => {
	if (convState.value == 'idle' || convState.value == 'reviewing') {
		startListening()
	} else if (convState.value == 'listening') {
		stopListening()
	}
}

const ensureWS = (): boolean => {
	if (ws != null && ws.isConnected()) return true
	if (props.sessionId == '') {
		emit('error', 'NO_SESSION', '缺少会话 ID')
		return false
	}
	ws = new VoiceWS({
		onPartialTranscript: (text: string) => {
			partialText.value = text
		},
		onFinalTranscript: (text: string) => {
			// 字幕常驻:finalText 留在纸上,不清掉
			finalText.value = text
			emit('transcribed', text)
			partialText.value = ''
		},
		onAIThinking: () => {
			convState.value = 'processing'
			reasonText.value = ''
			aiReplyText.value = ''
		},
		onAIReasoning: (text: string) => {
			// reasoning 是后台内部数据，不展示给用户
		},
		onAIContent: (text: string) => {
			aiReplyText.value += text
		},
		onAIReply: (text: string, fieldKey: string) => {
			// 增量流到齐后兜底:若前端没拼到完整正文,用后端给的整段
			if (aiReplyText.value == '') {
				aiReplyText.value = text
			}
			// 确认前静音:不进 speaking,不自动播报
			convState.value = 'reviewing'
			emit('aiReply', text, fieldKey)
		},
		onTTSAudio: (audioUrl: string, durationMs: number) => {
			// 回退整段路径（total=1）：单片即整段，复用同一队列
			if (ttsPlayer != null) ttsPlayer.enqueue(audioUrl, durationMs)
		},
		onTTSAudioChunk: (audioUrl: string, durationMs: number, seq: number, total: number) => {
			// 流式分片：逐句入队，TTSPlayer 顺序播放
			if (ttsPlayer != null) ttsPlayer.enqueue(audioUrl, durationMs)
		},
		onTTSAudioDone: (total: number) => {
			// 流结束：状态由 TTSPlayer.onStateChange(false) 在最后一片播完时驱动回 reviewing
		},
		onError: (code: string, message: string) => {
			convState.value = 'idle'
			partialText.value = ''
			emit('error', code, message)
		},
		onClose: () => {
			if (convState.value != 'idle') {
				convState.value = 'idle'
				partialText.value = ''
			}
			emit('sessionEnd')
		}
	})
	return ws.connect(props.sessionId, props.fieldKey)
}

const ensureRecorder = () => {
	if (recorderManager != null) return
	recorderManager = uni.getRecorderManager()
	recorderManager.onStart(() => {
		isRecording = true
		chunkSeq = 0
		convState.value = 'listening'
		partialText.value = ''
		// 新一轮:清掉上一轮的字
		finalText.value = ''
		reasonText.value = ''
		aiReplyText.value = ''
	})
	recorderManager.onFrameRecorded((res: any) => {
		if (!isRecording || ws == null || !ws.isConnected()) return
		const frameBuffer = res.frameBuffer
		if (frameBuffer == null) return
		const base64Data = arrayBufferToBase64(frameBuffer)
		if (base64Data != '') {
			chunkSeq++
			ws.sendAudioChunk(base64Data, chunkSeq)
		}
		// 微信小程序: isLastFrame=true 表示最后一帧,录音即将停止
		if (res.isLastFrame === true) {
			if (ws != null && ws.isConnected()) {
				ws.sendAudioEnd()
			}
		}
	})
	recorderManager.onStop(() => {
		isRecording = false
		if (ws != null && ws.isConnected() && !audioEndSent) {
			ws.sendAudioEnd()
			audioEndSent = true
		}
	})
	recorderManager.onError((err: any) => {
		isRecording = false
		convState.value = 'idle'
		partialText.value = ''
		uni.showToast({ title: '录音失败,请检查麦克风权限', icon: 'none' })
		emit('error', 'RECORDER_ERROR', '录音失败')
	})
}

const startListening = () => {
	if (!ensureWS()) return
	ensureRecorder()
	audioEndSent = false
	if (ws != null && ws.isConnected()) {
		ws.sendAudioStart()
	}
	recorderManager.start({
		format: 'pcm',
		sampleRate: 16000,
		numberOfChannels: 1,
		frameSize: 4
	})
}

const stopListening = () => {
	if (!isRecording) return
	if (recorderManager != null) {
		recorderManager.stop()
	}
}

const skipSpeaking = () => {
	if (ttsPlayer != null) ttsPlayer.stop()
	convState.value = 'reviewing'
}

const destroyTTSPlayer = () => {
	if (ttsPlayer != null) {
		ttsPlayer.stop()
		ttsPlayer = null
	}
}

	const arrayBufferToBase64 = (buffer: any): string => {
		try {
			return uni.arrayBufferToBase64(buffer)
		} catch (e) {
			console.error('[VoiceConversation] base64 encode failed', e)
			return ''
		}
	}

const listen = () => {
	if (ws != null && ws.isConnected() && aiReplyText.value != '') {
		// 本轮从干净状态开始：停掉上轮残留，建新播放器接 onStateChange 驱动状态
		destroyTTSPlayer()
		ttsPlayer = new TTSPlayer({
			onStateChange: (playing: boolean) => {
				convState.value = playing ? 'speaking' : 'reviewing'
			},
			onError: (code: string, message: string) => {
				emit('error', code, message)
			}
		})
		ws.sendListen()
	}
}

const revise = (text: string) => {
	if (ws == null || !ws.isConnected()) return
	reasonText.value = ''
	aiReplyText.value = ''
	convState.value = 'processing'
	ws.sendReviseText(text)
}

const reset = () => {
	stopListening()
	destroyTTSPlayer()
	convState.value = 'idle'
	partialText.value = ''
	finalText.value = ''
	reasonText.value = ''
	aiReplyText.value = ''
}

const start = () => {
	if (convState.value == 'idle' || convState.value == 'reviewing') {
		startListening()
	}
}

const stop = () => {
	if (convState.value == 'listening') {
		stopListening()
	} else if (convState.value == 'speaking') {
		skipSpeaking()
	}
}

onUnmounted(() => {
	stopListening()
	destroyTTSPlayer()
	if (ws != null) {
		ws.disconnect()
		ws = null
	}
})

defineExpose({ reset, start, stop, listen, revise })
</script>

<style scoped>
/* 单色描边图标(复用项目 iconfont 字库:社区互动与信息) */
@font-face {
	font-family: "iconfont-social";
	src: url('/static/婚恋小程序图标/社区互动与信息/iconfont.woff2') format('woff2'),
		url('/static/婚恋小程序图标/社区互动与信息/iconfont.woff') format('woff');
}
.vc-ic {
	font-family: "iconfont-social" !important;
	font-style: normal;
	-webkit-font-smoothing: antialiased;
	-moz-osx-font-smoothing: grayscale;
	font-size: 26px;
	color: var(--ink);
}
.vc-ic-yuyin:before { content: "\e888"; }
.vc-ic-pinglun:before { content: "\e679"; }

.vc-area {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 8px 0;
}

/* 听写纸 */
.vc-paper { width: 100%; display: flex; flex-direction: column; gap: 12px; margin-bottom: 14px; }
.vc-line { display: flex; gap: 10px; align-items: flex-start; }
.vc-line-who { font-size: 11px; color: var(--accent2); flex-shrink: 0; margin-top: 2px; letter-spacing: 0.1em; }
.vc-line-model .vc-line-who { color: var(--moss); }
.vc-line-text { font-size: 15px; line-height: 1.7; color: var(--ink); flex: 1; }
.vc-line-body { flex: 1; display: flex; flex-direction: column; gap: 4px; }
.vc-line-reason { font-size: 12px; line-height: 1.5; color: var(--ink2); }

/* 波形区 */
.vc-user-zone { height: 36px; display: flex; align-items: center; justify-content: center; margin-bottom: 8px; }

/* 状态文案 */
.vc-status-zone { height: 24px; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; }
.vc-status-text { font-size: 13px; color: var(--muted); }
.vc-status-active { color: var(--accent2); font-weight: 600; }

/* 动作区 */
.vc-action-zone { display: flex; gap: 12px; margin-bottom: 12px; }
.vc-listen-btn { padding: 8px 16px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); }
.vc-listen-text { font-size: 13px; color: var(--accent2); }
.vc-skip { padding: 8px 12px; }
.vc-skip-text { font-size: 11px; color: var(--accent2); }

/* 对话按钮:语音沉浸主控件,放大到 76px,主交互目标充分 */
.vc-btn {
	width: 76px; height: 76px; border-radius: 50%;
	display: flex; align-items: center; justify-content: center;
	background: var(--surface); border: 2px solid var(--line);
	transition: transform 0.18s ease-out, background 0.18s ease-out, border-color 0.18s ease-out;
	position: relative;
}
.vc-btn:active { transform: scale(0.98); }
.vc-btn-disabled { opacity: 0.5; }

.vc-btn-idle { background: var(--surface); border-color: var(--line); }
.vc-btn-speaking { background: var(--paper); border-color: var(--soft); }
.vc-btn-listening { background: var(--accent); border-color: var(--accent); transform: scale(1.08); }
.vc-btn-processing { background: var(--surface); border-color: var(--line); }
.vc-btn-reviewing { background: var(--surface); border-color: var(--line); }

.vc-mic-zone { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; position: relative; }
.vc-mic-icon-active { color: var(--text-invert); }

/* 脉动光环:三层叠加,聆听感更足 */
.vc-pulse-ring { position: absolute; width: 76px; height: 76px; border-radius: 50%; border: 2px solid var(--accent); animation: vc-pulse 1.6s ease-out infinite; }
.vc-pulse-ring-2 { animation-delay: 0.53s; }
.vc-pulse-ring-3 { animation-delay: 1.06s; }
@keyframes vc-pulse { 0% { transform: scale(1); opacity: 0.55; } 100% { transform: scale(1.9); opacity: 0; } }

/* 加载旋转 */
.vc-spinner { width: 26px; height: 26px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; animation: vc-spin 0.6s linear infinite; }
@keyframes vc-spin { to { transform: rotate(360deg); } }

	/* 墨相 · 深色沉浸模式(实时对话层) */
.vc-atelier-dark .vc-line-who { color: #E8B54F; }
.vc-atelier-dark .vc-line-model .vc-line-who { color: #9DBFA8; }
.vc-atelier-dark .vc-line-text { color: #F6EEE0; font-size: 16px; line-height: 1.75; }
.vc-atelier-dark .vc-line-reason { color: rgba(246, 238, 224, 0.6); }
.vc-atelier-dark .vc-status-text { color: rgba(246, 238, 224, 0.78); font-size: 14px; }
.vc-atelier-dark .vc-status-active { color: #E8B54F; }
.vc-atelier-dark .vc-listen-btn { background: rgba(255, 252, 245, 0.1); border-color: rgba(246, 238, 224, 0.22); }
.vc-atelier-dark .vc-listen-text { color: #E8B54F; }
.vc-atelier-dark .vc-skip-text { color: #E8B54F; }
.vc-atelier-dark .vc-btn { background: rgba(255, 252, 245, 0.1); border-color: rgba(246, 238, 224, 0.28); }
.vc-atelier-dark .vc-btn-listening { background: #B4762B; border-color: #B4762B; }
.vc-atelier-dark .vc-btn-speaking { background: rgba(201, 123, 87, 0.25); border-color: rgba(224, 148, 104, 0.6); }
.vc-atelier-dark .vc-pulse-ring { border-color: #E8B54F; }
.vc-atelier-dark .vc-spinner { border-color: rgba(246, 238, 224, 0.22); border-top-color: #E8B54F; }
.vc-atelier-dark .vc-ic { color: #F6EEE0; }
.vc-atelier-dark .vc-ic.vc-mic-icon-active { color: #FFF6E8; }
</style>
