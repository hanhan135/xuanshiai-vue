<template>
	<view class="vc-area" :class="{ 'vc-atelier-dark': theme == 'atelier-dark' }">
		<!-- AI 播报区(speaking 态) -->
		<view v-if="convState == 'speaking'" class="vc-speak-zone">
			<view class="vc-reply-bubble">
				<text class="vc-reply-text">{{ aiReplyText }}</text>
			</view>
			<VoiceWaveform state="speaking" />
			<view class="vc-skip" @tap="skipSpeaking">
				<text class="vc-skip-text">跳过播报</text>
			</view>
		</view>

		<!-- 用户说话区(idle / listening / processing) -->
		<view v-if="convState != 'speaking'" class="vc-user-zone">
			<VoiceWaveform :state="waveformState" />
		</view>

		<!-- 实时转写文本 -->
		<view v-if="partialText != '' && convState == 'listening'" class="vc-text-zone">
			<text class="vc-partial-text">{{ partialText }}</text>
		</view>

		<!-- 状态文案 -->
		<view class="vc-status-zone">
			<text v-if="convState == 'idle'" class="vc-status-text">点击开始对话,像和朋友聊天一样回答</text>
			<text v-if="convState == 'listening'" class="vc-status-text vc-status-active">正在聆听... 点击停止</text>
			<text v-if="convState == 'processing'" class="vc-status-text">AI 正在思考...</text>
			<text v-if="convState == 'speaking'" class="vc-status-text vc-status-active">AI 正在播报...</text>
		</view>

		<!-- 对话按钮 -->
		<view
			class="vc-btn"
			:class="['vc-btn-' + convState, { 'vc-btn-disabled': convState == 'processing' }]"
			@tap="onButtonTap"
		>
			<view v-if="convState == 'idle'" class="vc-mic-zone">
				<text class="vc-mic-icon">🎤</text>
			</view>
			<view v-if="convState == 'listening'" class="vc-mic-zone vc-mic-zone-active">
				<view class="vc-pulse-ring"></view>
				<view class="vc-pulse-ring vc-pulse-ring-2"></view>
				<text class="vc-mic-icon vc-mic-icon-active">🎙</text>
			</view>
			<view v-if="convState == 'processing'" class="vc-mic-zone">
				<view class="vc-spinner"></view>
			</view>
			<view v-if="convState == 'speaking'" class="vc-mic-zone">
				<text class="vc-mic-icon">💬</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import VoiceWaveform from './VoiceWaveform.uvue'
import { VoiceWS } from '@/api/voice-ws.uts'
import { resolveMediaUrl } from '@/api/config.uts'

interface Props {
	sessionId?: string
	fieldKey?: string
	theme?: string
}

const props = withDefaults(defineProps<Props>(), {
	sessionId: '',
	fieldKey: '',
	theme: 'default'
})

const emit = defineEmits<{
	transcribed: [text: string]
	aiReply: [text: string, fieldKey: string]
	error: [code: string, message: string]
	sessionEnd: []
}>()

const convState = ref('idle')
const partialText = ref('')
const aiReplyText = ref('')
let ws: VoiceWS | null = null
let recorderManager: any = null
let audioContext: any = null
let chunkSeq = 0
let isRecording = false
let audioEndSent = false

const waveformState = computed(() => {
	if (convState.value == 'listening') return 'listening'
	if (convState.value == 'processing') return 'transcribing'
	return 'idle'
})

const onButtonTap = () => {
	if (convState.value == 'idle') {
		startListening()
	} else if (convState.value == 'listening') {
		stopListening()
	}
}

const ensureWS = (): boolean => {
	if (ws != null && ws.isConnected()) return true
	if (props.sessionId == '') {
		emit('error', 'NO_SESSION', '缺少会话 ID')
		return false
	}
	ws = new VoiceWS({
		onPartialTranscript: (text: string) => {
			partialText.value = text
		},
		onFinalTranscript: (text: string) => {
			partialText.value = ''
			emit('transcribed', text)
		},
		onAIThinking: () => {
			convState.value = 'processing'
		},
		onAIReply: (text: string, fieldKey: string) => {
			aiReplyText.value = text
			convState.value = 'speaking'
			emit('aiReply', text, fieldKey)
		},
		onTTSAudio: (audioUrl: string, durationMs: number) => {
			playTTS(audioUrl, durationMs)
		},
		onError: (code: string, message: string) => {
			convState.value = 'idle'
			partialText.value = ''
			emit('error', code, message)
		},
		onClose: () => {
			if (convState.value != 'idle') {
				convState.value = 'idle'
				partialText.value = ''
			}
			emit('sessionEnd')
		}
	})
	return ws.connect(props.sessionId, props.fieldKey)
}

const ensureRecorder = () => {
	if (recorderManager != null) return
	recorderManager = uni.getRecorderManager()
	recorderManager.onStart(() => {
		isRecording = true
		chunkSeq = 0
		convState.value = 'listening'
		partialText.value = ''
	})
	recorderManager.onFrameRecorded((res: any) => {
		if (!isRecording || ws == null || !ws.isConnected()) return
		const frameBuffer = res.frameBuffer
		if (frameBuffer == null) return
		const base64Data = arrayBufferToBase64(frameBuffer)
		if (base64Data != '') {
			chunkSeq++
			ws.sendAudioChunk(base64Data, chunkSeq)
		}
		// 微信小程序: isLastFrame=true 表示最后一帧,录音即将停止
		if (res.isLastFrame === true) {
			if (ws != null && ws.isConnected()) {
				ws.sendAudioEnd()
			}
		}
	})
	recorderManager.onStop(() => {
		// onStop 触发时所有帧已回调完成。若 isLastFrame 机制未触发 audio_end,
		// 此处兜底发送（去重:只在尚未发送 audio_end 时发送）。
		isRecording = false
		if (ws != null && ws.isConnected() && !audioEndSent) {
			ws.sendAudioEnd()
			audioEndSent = true
		}
	})
	recorderManager.onError((err: any) => {
		isRecording = false
		convState.value = 'idle'
		partialText.value = ''
		uni.showToast({ title: '录音失败,请检查麦克风权限', icon: 'none' })
		emit('error', 'RECORDER_ERROR', '录音失败')
	})
}

const startListening = () => {
	if (!ensureWS()) return
	ensureRecorder()
	audioEndSent = false
	if (ws != null && ws.isConnected()) {
		ws.sendAudioStart()
	}
	// PCM 16kHz 单声道。微信小程序支持 onFrameRecorded + frameSize 分帧回调。
	// 部分平台可能不支持 pcm 格式,失败时 onError 回调会提示。
	recorderManager.start({
		format: 'pcm',
		sampleRate: 16000,
		numberOfChannels: 1,
		frameSize: 4
	})
}

const stopListening = () => {
	if (!isRecording) return
	if (recorderManager != null) {
		recorderManager.stop()
	}
}

const playTTS = (audioUrl: string, durationMs: number) => {
	destroyAudioContext()
	const resolvedUrl = resolveMediaUrl(audioUrl)
	if (resolvedUrl == '') {
		// 无音频 URL:fallback 计时器模拟
		const duration = durationMs > 0 ? durationMs : estimateDuration(aiReplyText.value)
		setTimeout(() => {
			convState.value = 'idle'
		}, duration) as any
		return
	}
	audioContext = uni.createInnerAudioContext()
	audioContext.src = resolvedUrl
	audioContext.onEnded(() => {
		destroyAudioContext()
		convState.value = 'idle'
	})
	audioContext.onError(() => {
		destroyAudioContext()
		const duration = durationMs > 0 ? durationMs : estimateDuration(aiReplyText.value)
		setTimeout(() => {
			convState.value = 'idle'
		}, duration) as any
	})
	audioContext.play()
}

const skipSpeaking = () => {
	destroyAudioContext()
	convState.value = 'idle'
}

const destroyAudioContext = () => {
	if (audioContext != null) {
		try { audioContext.stop() } catch (e) {}
		try { audioContext.destroy() } catch (e) {}
		audioContext = null
	}
}

const estimateDuration = (text: string): number => {
	const len = text.length
	return Math.min(5000, Math.max(2000, len * 250))
}

const arrayBufferToBase64 = (buffer: any): string => {
	try {
		// UniApp 环境下使用 wx.arrayBufferToBase64 或手动编码
		// 微信小程序提供 uni.arrayBufferToBase64
		return uni.arrayBufferToBase64(buffer)
	} catch (e) {
		console.error('[VoiceConversation] base64 encode failed', e)
		return ''
	}
}

const reset = () => {
	stopListening()
	destroyAudioContext()
	convState.value = 'idle'
	partialText.value = ''
	aiReplyText.value = ''
}

const start = () => {
	if (convState.value == 'idle') {
		startListening()
	}
}

const stop = () => {
	if (convState.value == 'listening') {
		stopListening()
	} else if (convState.value == 'speaking') {
		skipSpeaking()
	}
}

onUnmounted(() => {
	stopListening()
	destroyAudioContext()
	if (ws != null) {
		ws.disconnect()
		ws = null
	}
})

defineExpose({ reset, start, stop })
</script>

<style scoped>
.vc-area {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 8px 0;
}

/* AI 播报区 */
.vc-speak-zone { display: flex; flex-direction: column; align-items: center; gap: 6px; width: 100%; }
.vc-reply-bubble { max-width: 88%; padding: 10px 14px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); border-bottom-left-radius: 4px; }
.vc-reply-text { font-size: 14px; line-height: 1.6; color: var(--ink); }
.vc-skip { margin-top: 4px; padding: 2px 10px; }
.vc-skip-text { font-size: 11px; color: var(--accent2); }

/* 用户说话区 */
.vc-user-zone { height: 36px; display: flex; align-items: center; justify-content: center; margin-bottom: 8px; }

/* 实时转写文本 */
.vc-text-zone { max-width: 88%; margin-bottom: 8px; padding: 6px 12px; border-radius: 8px; background: var(--bg-subtle); }
.vc-partial-text { font-size: 13px; color: var(--ink2); line-height: 1.5; }

/* 状态文案 */
.vc-status-zone { height: 20px; display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }
.vc-status-text { font-size: 12px; color: var(--muted); }
.vc-status-active { color: var(--accent2); font-weight: 600; }

/* 对话按钮 */
.vc-btn {
	width: 64px; height: 64px; border-radius: 50%;
	display: flex; align-items: center; justify-content: center;
	background: var(--surface); border: 2px solid var(--line);
	transition: transform 0.18s ease-out, background 0.18s ease-out, border-color 0.18s ease-out;
	position: relative;
}
.vc-btn:active { transform: scale(0.98); }
.vc-btn-disabled { opacity: 0.5; }

.vc-btn-idle { background: var(--surface); border-color: var(--line); }
.vc-btn-speaking { background: var(--paper); border-color: var(--soft); }
.vc-btn-listening { background: var(--accent); border-color: var(--accent); transform: scale(1.1); }
.vc-btn-processing { background: var(--surface); border-color: var(--line); }

.vc-mic-zone { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; position: relative; }
.vc-mic-icon { font-size: 28px; }
.vc-mic-icon-active { color: var(--text-invert); }

/* 脉动光环 */
.vc-pulse-ring { position: absolute; width: 64px; height: 64px; border-radius: 50%; border: 2px solid var(--accent); animation: vc-pulse 1.5s ease-out infinite; }
.vc-pulse-ring-2 { animation-delay: 0.5s; }
@keyframes vc-pulse { 0% { transform: scale(1); opacity: 0.6; } 100% { transform: scale(1.8); opacity: 0; } }

/* 加载旋转 */
.vc-spinner { width: 24px; height: 24px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; animation: vc-spin 0.6s linear infinite; }
@keyframes vc-spin { to { transform: rotate(360deg); } }

	/* 墨相 · 深色沉浸模式(实时对话层) */
.vc-atelier-dark .vc-reply-bubble {
	background: rgba(255, 252, 245, 0.1);
	border-color: rgba(246, 238, 224, 0.22);
	border-bottom-left-radius: 4px;
}
.vc-atelier-dark .vc-reply-text { color: #F6EEE0; }
.vc-atelier-dark .vc-skip-text { color: #E8B54F; }
.vc-atelier-dark .vc-partial-text { color: #D8CBB4; }
.vc-atelier-dark .vc-text-zone { background: rgba(255, 252, 245, 0.08); }
.vc-atelier-dark .vc-status-text { color: rgba(246, 238, 224, 0.5); }
.vc-atelier-dark .vc-status-active { color: #E8B54F; }
.vc-atelier-dark .vc-btn { background: rgba(255, 252, 245, 0.08); border-color: rgba(246, 238, 224, 0.25); }
.vc-atelier-dark .vc-btn-listening { background: #B4762B; border-color: #B4762B; }
.vc-atelier-dark .vc-btn-speaking { background: rgba(201, 123, 87, 0.25); border-color: rgba(224, 148, 104, 0.6); }
.vc-atelier-dark .vc-pulse-ring { border-color: #E8B54F; }
.vc-atelier-dark .vc-spinner { border-color: rgba(246, 238, 224, 0.22); border-top-color: #E8B54F; }
.vc-atelier-dark .vc-mic-icon-active { color: #FFF6E8; }
</style>
