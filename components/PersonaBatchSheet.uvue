<template>
	<!-- 往稿:画像 revision 元数据 + narrative history_observations 的诚实展示。
	     后端不提供历史版本字段明细,这里只展示真实返回的元数据与观察笔记。 -->
	<XsaSheet :visible="visible" title="往稿" @close="emit('close')">
		<view class="pbs-body">
			<text class="pbs-subtitle">每一稿只保留写下的时间和观察笔记,不保留该稿的完整字段明细。</text>

			<!-- 加载 -->
			<view v-if="loading" class="pbs-loading">
				<view class="pbs-spinner"></view>
				<text class="pbs-loading-text">加载中</text>
			</view>

			<!-- 空 -->
			<view v-else-if="items.length == 0" class="pbs-empty">
				<text class="pbs-empty-title">还没有往稿</text>
				<text class="pbs-empty-sub">在落笔中确认字段并写下成稿后,第一稿会出现在这里</text>
			</view>

			<!-- 时间线 -->
			<view v-else class="pbs-timeline">
				<view v-for="(rev, idx) in items" :key="rev.revision_id" class="pbs-node">
					<view class="pbs-rail">
						<view class="pbs-dot" :class="{ 'pbs-dot-latest': idx == 0 }"></view>
						<view v-if="idx < items.length - 1" class="pbs-line"></view>
					</view>

					<view class="pbs-content">
						<view class="pbs-row-head">
							<text class="pbs-time">{{ formatTime(rev.published_at) }}</text>
							<text v-if="idx == 0" class="pbs-current">当前稿</text>
						</view>
						<view v-if="getObs(rev.revision_id).keywords.length > 0" class="pbs-tags">
							<text
								v-for="(kw, ki) in getObs(rev.revision_id).keywords"
								:key="ki"
								class="pbs-tag"
							>{{ kw }}</text>
						</view>
						<text v-if="getObs(rev.revision_id).observation != ''" class="pbs-observation">
							{{ getObs(rev.revision_id).observation }}
						</text>
						<text class="pbs-meta">第 {{ rev.revision_no }} 稿 · 已确认 {{ rev.field_count }} 笔</text>
						<view class="pbs-restore" @tap="emit('restore', rev.revision_id)">
							<text class="pbs-restore-text">从这稿再写一版</text>
						</view>
					</view>
				</view>
			</view>
		</view>
	</XsaSheet>
</template>

<script setup lang="uts">
import XsaSheet from './XsaSheet.uvue'

interface Props {
	visible: boolean
	loading: boolean
	items: any[]
	subject: string
	observations?: any[]
}

const props = withDefaults(defineProps<Props>(), {
	observations: () => [] as any[]
})
const emit = defineEmits<{
	close: []
	restore: [revisionId: number]
}>()

function getObs(revisionId: number): any {
	const fallback: any = { revision_id: revisionId, keywords: [] as string[], observation: '' }
	if (props.observations == null || props.observations.length == 0) return fallback
	for (let i = 0; i < props.observations.length; i++) {
		const o = props.observations[i]
		if (o != null && o.revision_id == revisionId) {
			return {
				revision_id: revisionId,
				keywords: o.keywords != null ? o.keywords : [] as string[],
				observation: o.observation != null ? o.observation : ''
			}
		}
	}
	return fallback
}

function formatTime(iso: string): string {
	if (iso == '' || iso == null) return ''
	try {
		const d = new Date(iso)
		const y = d.getFullYear()
		const m = d.getMonth() + 1
		const day = d.getDate()
		return y + '年' + m + '月' + (day < 10 ? '0' + day : day) + '日'
	} catch (e) {
		return ''
	}
}
</script>

<style scoped>
.pbs-body { min-height: 240px; max-height: 60vh; padding-top: 4px; }
.pbs-subtitle {
	font-size: 12px;
	color: var(--at-mist, #9A8C77);
	line-height: 1.6;
	margin-bottom: 16px;
}

/* 加载 */
.pbs-loading {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 40px 0;
}
.pbs-spinner {
	width: 26px;
	height: 26px;
	border: 2.5px solid var(--at-line, #E6DAC4);
	border-top-color: var(--at-amber, #B4762B);
	border-radius: 50%;
	animation: pbs-spin 0.7s linear infinite;
	margin-bottom: 12px;
}
@keyframes pbs-spin { to { transform: rotate(360deg); } }
.pbs-loading-text { font-size: 13px; color: var(--at-mist, #9A8C77); }

/* 空 */
.pbs-empty {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 40px 0;
}
.pbs-empty-title { font-size: 15px; font-weight: 700; color: var(--at-mist, #9A8C77); }
.pbs-empty-sub { font-size: 12px; color: var(--at-mist, #9A8C77); margin-top: 6px; }

/* 时间线 */
.pbs-timeline { display: flex; flex-direction: column; }
.pbs-node { display: flex; flex-direction: row; }
.pbs-rail {
	display: flex;
	flex-direction: column;
	align-items: center;
	margin-right: 12px;
	padding-top: 5px;
}
.pbs-dot {
	width: 9px;
	height: 9px;
	border-radius: 999px;
	background: var(--at-honey, #D9A441);
	flex-shrink: 0;
}
.pbs-dot-latest { background: var(--at-amber, #B4762B); }
.pbs-line {
	width: 1px;
	flex: 1;
	background: var(--at-line, #E6DAC4);
	margin-top: 4px;
	min-height: 40px;
}

.pbs-content { flex: 1; display: flex; flex-direction: column; padding-bottom: 22px; }
.pbs-row-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.pbs-time {
	font-size: 15px;
	font-weight: 600;
	color: var(--at-ink, #2E2418);
	font-family: var(--serif, serif);
}
.pbs-current {
	font-size: 10px;
	font-weight: 700;
	color: var(--at-amber-deep, #8A5A1D);
	background: rgba(217, 164, 65, 0.18);
	padding: 2px 8px;
	border-radius: 999px;
}
.pbs-tags {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 6px;
	margin-top: 8px;
}
.pbs-tag {
	padding: 3px 10px;
	border-radius: 999px;
	background: rgba(180, 118, 43, 0.1);
	color: var(--at-amber-deep, #8A5A1D);
	font-size: 12px;
}
.pbs-observation {
	font-size: 13px;
	color: var(--at-ink2, #5C4F3D);
	line-height: 1.6;
	margin-top: 8px;
}
.pbs-meta { font-size: 11px; color: var(--at-mist, #9A8C77); margin-top: 6px; }
.pbs-restore {
	margin-top: 8px;
	align-self: flex-start;
	padding: 5px 13px;
	border-radius: 999px;
	border: 1px solid var(--at-line, #E6DAC4);
}
.pbs-restore:active { transform: scale(0.96); }
.pbs-restore-text { font-size: 12px; font-weight: 600; color: var(--at-ink2, #5C4F3D); }
</style>
