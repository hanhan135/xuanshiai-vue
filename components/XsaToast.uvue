<template>
		<view class="xsa-toast" :class="{ show: visible, 'large-text': largeText }">
		<text class="toast-text">{{ message }}</text>
	</view>
</template>

<script setup lang="uts">
/**
 * XsaToast - 宣誓爱提示消息组件
 * 遵循 DESIGN.md 设计规范
 */

interface Props {
	message: string;
	visible: boolean;
	duration?: number;
	largeText?: boolean;
}

const props = withDefaults(defineProps<Props>(), {
	duration: 1900,
	largeText: false
});

const emit = defineEmits<{
	hide: []
}>();

// 监听 visible 变化，自动隐藏
watch(() => props.visible, (newVal) => {
	if (newVal) {
		setTimeout(() => {
			emit('hide');
		}, props.duration);
	}
});
</script>

<style scoped>
/* Toast 提示 - 遵循 DESIGN.md */
.xsa-toast {
	position: fixed;
	z-index: 10100;
	left: 50%;
	top: 86px;
	transform: translate(-50%, -12px);
	max-width: 330px;
	padding: 10px 14px;
	border-radius: 8px;
	background: var(--ink);
	color: var(--paper);
	font-size: 12px;
	white-space: nowrap;
	opacity: 0;
	pointer-events: none;
	transition: 0.22s;
	box-shadow: var(--shadow-lg);
}

.xsa-toast.show {
	opacity: 1;
	transform: translate(-50%, 0);
}

.toast-text {
	display: block;
	color: var(--paper);
}

.xsa-toast.large-text {
	max-width: calc(100vw - 32px);
	font-size: 16px;
	white-space: normal;
	line-height: 1.5;
}
</style>
