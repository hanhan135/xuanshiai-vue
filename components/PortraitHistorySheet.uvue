<template>
	<!-- AI 画像历史版本 Sheet(包 XsaSheet),时间线叙事:时间 + 关键词 + AI 观察 -->
	<XsaSheet :visible="visible" title="我的变化" @close="emit('close')">
		<view class="phs-body">
			<text class="phs-subtitle">你不是一个固定的标签。</text>

			<!-- 加载 -->
			<view v-if="loading" class="phs-loading">
				<view class="phs-spinner"></view>
				<text class="phs-loading-text">加载中</text>
			</view>

			<!-- 空 -->
			<view v-else-if="items.length == 0" class="phs-empty">
				<text class="phs-empty-title">还没有发布过画像</text>
				<text class="phs-empty-sub">确认字段并发布后,版本会出现在这里</text>
			</view>

			<!-- 时间线列表 -->
			<view v-else class="phs-timeline">
				<view
					v-for="(rev, idx) in items"
					:key="rev.revision_id"
					class="phs-node"
				>
					<!-- 左侧时间线轴 -->
					<view class="phs-rail">
						<view class="phs-dot"></view>
						<view v-if="idx < items.length - 1" class="phs-line"></view>
					</view>

					<!-- 右侧内容 -->
					<view class="phs-content" @tap="emit('restore', rev.revision_id)">
						<text class="phs-time">{{ formatTime(rev.published_at) }}</text>
						<view v-if="getObs(rev.revision_id).keywords.length > 0" class="phs-tags">
							<text
								v-for="(kw, ki) in getObs(rev.revision_id).keywords"
								:key="ki"
								class="phs-tag"
							>{{ kw }}</text>
						</view>
						<text v-if="getObs(rev.revision_id).observation != ''" class="phs-observation">
							{{ getObs(rev.revision_id).observation }}
						</text>
						<text class="phs-meta">版本 {{ rev.revision_no }} · {{ rev.field_count }} 个字段</text>
					</view>
				</view>
			</view>
		</view>
	</XsaSheet>
</template>

<script setup lang="uts">
/**
 * PortraitHistorySheet - AI 画像历史时间线。
 * 升级为"时间 + 关键词 + AI 观察"叙事式,非日志列表。
 * observations 由父组件传入(按 revision_id 关联叙事层 mock 数据)。
 * 恢复操作交回父组件(emit restore)。
 */
import XsaSheet from './XsaSheet.uvue'

interface Observation {
	revision_id: number
	keywords: string[]
	observation: string
}

interface Props {
	visible: boolean
	loading: boolean
	items: any[]
	subject: string
	observations?: any[]
}

const props = withDefaults(defineProps<Props>(), {
	observations: () => [] as any[]
})
const emit = defineEmits<{
	close: []
	restore: [revisionId: number]
}>()

function getObs(revisionId: number): Observation {
	const fallback: Observation = { revision_id: revisionId, keywords: [] as string[], observation: '' }
	if (props.observations == null || props.observations.length == 0) return fallback
	for (let i = 0; i < props.observations.length; i++) {
		const o = props.observations[i]
		if (o.revision_id == revisionId) {
			return { revision_id: revisionId, keywords: o.keywords || [] as string[], observation: o.observation || '' }
		}
	}
	// revision_id 未对齐时,按序回退(mock 占位,后端待交付)
	const idx = revisionId - 1
	if (idx >= 0 && idx < props.observations.length) {
		const o = props.observations[idx]
		return { revision_id: revisionId, keywords: o.keywords || [] as string[], observation: o.observation || '' }
	}
	return fallback
}

function formatTime(iso: string): string {
	if (iso == '' || iso == null) return ''
	try {
		const d = new Date(iso)
		const y = d.getFullYear()
		const m = d.getMonth() + 1
		return y + '年' + m + '月'
	} catch (e) {
		return ''
	}
}
</script>

<style scoped>
.phs-body { min-height: 240px; max-height: 60vh; padding-top: 4px; }
.phs-subtitle { font-size: 12px; color: var(--muted); margin-bottom: 16px; }

/* 加载 */
.phs-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 0; }
.phs-spinner { width: 26px; height: 26px; border: 2.5px solid var(--warm); border-top-color: var(--accent); border-radius: 50%; animation: phs-spin 0.7s linear infinite; margin-bottom: 12px; }
@keyframes phs-spin { to { transform: rotate(360deg); } }
.phs-loading-text { font-size: 13px; color: var(--muted); }

/* 空 */
.phs-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 0; }
.phs-empty-title { font-size: 15px; font-weight: 700; color: var(--muted); }
.phs-empty-sub { font-size: 12px; color: var(--muted); margin-top: 6px; }

/* 时间线 */
.phs-timeline { display: flex; flex-direction: column; }
.phs-node { display: flex; flex-direction: row; }
.phs-rail { display: flex; flex-direction: column; align-items: center; margin-right: 12px; padding-top: 4px; }
.phs-dot { width: 8px; height: 8px; border-radius: 999px; background: var(--accent); flex-shrink: 0; }
.phs-line { width: 1px; flex: 1; background: var(--line); margin-top: 4px; min-height: 40px; }

.phs-content { flex: 1; display: flex; flex-direction: column; padding-bottom: 20px; }
.phs-content:active { opacity: 0.7; }
.phs-time { font-size: 15px; font-weight: 600; color: var(--ink); font-family: var(--serif); }
.phs-tags { display: flex; flex-direction: row; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.phs-tag { padding: 3px 10px; border-radius: 999px; background: rgba(45, 124, 114, 0.1); color: var(--accent2); font-size: 12px; }
.phs-observation { font-size: 13px; color: var(--ink2); line-height: 1.6; margin-top: 8px; }
.phs-meta { font-size: 11px; color: var(--muted); margin-top: 6px; }
</style>
