<template>
	<view class="pending-review-shell"><scroll-view scroll-y class="pending-review" :show-scrollbar="false"><view class="review-tabs"><view v-for="tab in tabs" :key="tab" class="review-tab" :class="{active:activeTab==tab}" @tap="selectTab(tab)"><text>{{tab}}</text></view></view><view class="review-content"><view class="search-bar"><text>搜</text><input placeholder="请输入昵称/编号/姓名/手机号" :value="keyword" @input="onKeywordInput"/><view @tap="runSearch"><text>搜索</text></view></view><view v-if="filteredMembers.length==0" class="empty"><text>暂无符合条件的会员资料</text></view><view v-for="member in filteredMembers" :key="member.id" class="review-card"><view class="card-head"><text class="category">{{member.category}}</text><text class="number">编号：{{member.id}}</text><text class="status" :class="{rejected:member.reviewStatus=='审核不通过'}" @tap="openStatus(member)">{{member.reviewStatus}} ></text></view><text v-if="member.reviewStatus=='审核不通过'" class="reason">未通过原因：{{member.reviewReason}}</text><view class="line"></view><view class="profile"><view class="avatar-wrap"><image :src="member.avatar" mode="aspectFill"></image><text>{{member.gender}}</text></view><view class="profile-copy"><view><text class="name">{{member.name}}</text><text class="verify" :class="{verified:member.certification=='已实名'}">认证 {{member.certification}}</text></view><text>{{member.marital}} · {{member.age}}岁 · {{member.education}} · {{member.height}}cm · {{member.job}}</text><text class="service">跟进服务：{{member.assignedMatchmaker}}</text><text class="time">登记：{{member.registeredAt}}</text></view></view><view class="actions"><view class="more" @tap="openMore(member)"><text>{{activeTab=='弃海'?'我要捞取':'更多'}}</text></view><view @tap="openContact(member)"><text>联系</text></view><view @tap="openFollow(member)"><text>跟进({{member.followUps.length}})</text></view><view @tap="openCopy(member)"><text>复制资料</text></view><view @tap="openEdit(member)"><text>编辑资料</text></view></view></view></view></scroll-view><view class="floats"><view @tap="openEntry"><text>＋</text><text>录入</text></view><view @tap="activePanel='filter'"><text>筛</text><text>筛选</text></view></view>
		<view v-if="moreMember!=null" class="more-menu"><view v-if="activeTab=='弃海'" @tap="rescueMember"><text>我要捞取</text></view><template v-else><view @tap="openIntroductions"><text>牵线({{moreMember.introductions.length}})</text></view><view @tap="openMatch"><text>匹配</text></view><view @tap="openNote"><text>红娘说</text></view><view @tap="openAssign"><text>修改红娘</text></view><view @tap="openSea"><text>放入弃海</text></view></template></view>
	</view>
	<view v-if="activePanel!=''" class="overlay"><view class="mask" @tap="closePanel"></view>
		<view v-if="activePanel=='status'&&selectedMember!=null" class="sheet"><view class="title"><text>审核状态</text><text @tap="closePanel">×</text></view><view class="fee"><text>审核费：</text><text>{{selectedMember.reviewFee}}</text><text>{{selectedMember.registeredAt}}</text></view><view class="options"><view v-for="status in statusOptions" :key="status" :class="{selected:statusDraft==status}" @tap="statusDraft=status"><text>{{status}}</text></view></view><textarea v-if="statusDraft=='审核不通过'" maxlength="30" placeholder="请输入审核不通过原因，限30个字" :value="reviewReasonDraft" @input="e=>reviewReasonDraft=e.detail.value"></textarea><view v-if="statusDraft=='审核不通过'" class="templates"><text>从模板选择：</text><view v-for="reason in rejectReasons" :key="reason" @tap="reviewReasonDraft=reason"><text>{{reason}}</text></view></view><view class="primary" @tap="submitStatus"><text>提交</text></view></view>
		<view v-else-if="activePanel=='introductions'&&selectedMember!=null" class="side"><view class="title"><text>会员 {{selectedMember.name}} 的牵线记录</text><text @tap="closePanel">×</text></view><view class="record-tabs"><text>主动牵线</text><text>被动牵线</text></view><view v-if="selectedMember.introductions.length==0" class="empty"><text>暂无牵线记录</text></view></view>
		<view v-else-if="activePanel=='match'&&selectedMember!=null" class="side"><view class="title"><text>匹配</text><text @tap="closePanel">×</text></view><view class="subject"><image :src="selectedMember.avatar" mode="aspectFill"></image><text>{{selectedMember.name}}（编号{{selectedMember.id}}）</text></view><text>根据该会员择偶要求：</text><view class="tags"><text v-for="tag in selectedMember.preference" :key="tag">{{tag}}</text></view><view class="notice"><text>⌾ 温馨提示</text><text>状态为“停止相亲”、“已经脱单”的会员资料不会显示在匹配结果中</text></view><view v-for="candidate in candidates" :key="candidate.id" class="candidate"><image :src="candidate.avatar" mode="aspectFill"></image><view><text>{{candidate.name}}</text><text>编号{{candidate.id}}</text><text>服务红娘：{{candidate.assignedMatchmaker}}</text></view><text>{{candidate.category}}</text></view></view>
		<view v-else-if="activePanel=='note'" class="sheet"><view class="title"><text>红娘说</text><text @tap="closePanel">×</text></view><textarea maxlength="200" placeholder="请输入一段红娘对该会员的评价，本信息公开显示，限制200汉字" :value="noteDraft" @input="e=>noteDraft=e.detail.value"></textarea><view class="primary" @tap="submitNote"><text>提交</text></view></view>
		<view v-else-if="activePanel=='assign'" class="sheet"><view class="title"><text>修改红娘</text><text @tap="closePanel">×</text></view><view v-for="name in matchmakers" :key="name" class="assign" :class="{selected:assignmentDraft==name}" @tap="assignmentDraft=name"><text>{{name}}</text><text v-if="assignmentDraft==name">✓</text></view><view class="primary" @tap="submitAssign"><text>确认</text></view></view>
		<view v-else-if="activePanel=='sea'" class="dialog"><text>放入弃海后该客源的红娘分派将被改为“待分派”，并生成弃海记录，所有红娘可以在“弃海客源”中进行捞取</text><view><text @tap="closePanel">取消</text><text @tap="confirmSea">确认</text></view></view>
		<view v-else-if="activePanel=='contact'&&selectedMember!=null" class="dialog"><view class="title"><text>⌾ 查看联系方式</text><text @tap="closePanel">×</text></view><text class="contact-name">{{selectedMember.name}}</text><view class="contact phone"><text>☎ {{selectedMember.phone}}</text><text @tap="copyText(selectedMember.phone)">复制</text><text @tap="callPhone(selectedMember.phone)">拨打</text></view><view class="contact wechat"><text>♧ {{selectedMember.wechat}}</text><text @tap="copyText(selectedMember.wechat)">复制</text></view><text class="hint">⌾ 温馨提示\n超级红娘可以查看所有会员的联系方式；普通红娘仅能查看所服务会员的联系方式</text><view class="primary" @tap="closePanel"><text>关闭</text></view></view>
		<view v-else-if="activePanel=='follow'&&selectedMember!=null" class="side"><view class="title"><text>会员 {{selectedMember.name}} 的跟进记录</text><text @tap="closePanel">×</text></view><view class="appointment"><text>预约下次跟进</text><text @tap="appointmentEditing=!appointmentEditing">设置时间 ✎</text></view><view v-if="appointmentEditing" class="appointment-edit"><input placeholder="预约下次跟进时间" :value="appointmentDraft" @input="e=>appointmentDraft=e.detail.value"/><text @tap="saveAppointment">确定预约</text><text>设置预约跟进时间后会在“有预约跟进”分类栏中显示，并会收到提醒通知。</text></view><view v-for="follow in selectedMember.followUps" :key="follow.id" class="follow"><text>{{follow.content}}</text><text>{{follow.createdAt}}｜{{follow.author}} 撰写</text></view><view v-if="selectedMember.followUps.length==0" class="empty"><text>暂无服务跟进</text></view><view class="bottom" @tap="openAddFollow"><text>＋ 添加服务跟进</text></view></view>
		<view v-else-if="activePanel=='add-follow'" class="side"><view class="title"><text>添加会员服务跟进</text><text @tap="closePanel">×</text></view><textarea maxlength="1000" placeholder="请输入" :value="followDraft" @input="e=>followDraft=e.detail.value"></textarea><view class="types"><view v-for="type in followTypes" :key="type" :class="{selected:followTypeDraft==type}" @tap="followTypeDraft=type"><text>{{type}}</text></view></view><view class="upload" @tap="uploadFollowImage"><text>＋\n上传图片</text></view><view class="primary" @tap="submitFollow"><text>确定提交</text></view></view>
		<view v-else-if="activePanel=='copy'&&selectedMember!=null" class="side"><view class="title"><text>复制资料</text><text @tap="closePanel">×</text></view><text class="copy">{{profileText(selectedMember)}}</text><view class="bottom" @tap="copyProfile"><text>一键复制</text></view></view>
		<view v-else-if="activePanel=='edit'&&selectedMember!=null" class="side"><view class="title"><text>编辑资料</text><text @tap="closePanel">×</text></view><view class="edit"><text>编号</text><text>{{selectedMember.id}}</text></view><view class="edit"><text>昵称</text><text>{{selectedMember.name}}</text></view><view class="edit"><text>性别</text><text>{{selectedMember.gender}}</text></view><view class="edit"><text>姓名</text><input :value="editDraft.name" @input="e=>editDraft.name=e.detail.value"/></view><view class="edit"><text>手机</text><input :value="editDraft.phone" @input="e=>editDraft.phone=e.detail.value"/></view><view class="edit"><text>微信</text><input :value="editDraft.wechat" @input="e=>editDraft.wechat=e.detail.value"/></view><view class="edit"><text>学历</text><input :value="editDraft.education" @input="e=>editDraft.education=e.detail.value"/></view><view class="edit"><text>工作</text><input :value="editDraft.job" @input="e=>editDraft.job=e.detail.value"/></view><view class="edit"><text>身高</text><input :value="String(editDraft.height)" @input="e=>editDraft.height=Number(e.detail.value)"/></view><view class="bottom" @tap="submitEdit"><text>完成</text></view></view>
		<view v-else-if="activePanel=='filter'" class="sheet"><view class="title"><text>筛选</text><text @tap="closePanel">×</text></view><text>认证状态</text><view class="options"><view v-for="item in certificationOptions" :key="item" :class="{selected:certificationFilter==item}" @tap="certificationFilter=item"><text>{{item}}</text></view></view><text>审核状态</text><view class="options"><view v-for="item in reviewFilterOptions" :key="item" :class="{selected:reviewFilter==item}" @tap="reviewFilter=item"><text>{{item}}</text></view></view><view class="primary" @tap="applyFilter"><text>确定</text></view></view>
		<view v-else-if="activePanel=='entry'" class="side"><view class="title"><text>录入会员</text><text @tap="closePanel">×</text></view><text class="hint">录入后资料会进入“待审”列表，完成审核后才会对外展示。</text><view class="edit"><text>昵称</text><input placeholder="请输入昵称" :value="entryDraft.name" @input="e=>entryDraft.name=e.detail.value"/></view><view class="edit"><text>手机</text><input placeholder="请输入手机号" :value="entryDraft.phone" @input="e=>entryDraft.phone=e.detail.value"/></view><view class="edit"><text>学历</text><input placeholder="请输入学历" :value="entryDraft.education" @input="e=>entryDraft.education=e.detail.value"/></view><view class="edit"><text>身高</text><input placeholder="请输入身高" :value="entryDraft.height" @input="e=>entryDraft.height=e.detail.value"/></view><view class="bottom" @tap="submitEntry"><text>保存并进入待审</text></view></view>
	</view>
</template>
<script setup lang="uts">
import { getMatchmakerReviewMembers, updateMatchmakerReviewMember } from '@/api'
const tabs=['全部','待审','我的','弃海','线上VIP','线下VIP'];const statusOptions=['待审核','审核通过','审核不通过','已到店核验'];const rejectReasons=['照片不符合要求，请上传真人照片','部分资料不真实，请修改后再次提交审核','未实名认证，请完成实名认证后再次提交审核','没有支付资料审核费'];const followTypes=['核实资料','邀约到店','到店面谈','服务交接'];const matchmakers=['芸希老师','依依','林知夏','周老师','未分派'];const certificationOptions=['不限','已实名','未实名'];const reviewFilterOptions=['不限','待审核','审核通过','审核不通过','已到店核验'];const members=ref<any[]>([]);const activeTab=ref('全部');const keyword=ref('');const searchedKeyword=ref('');const activePanel=ref('');const selectedMember=ref<any>(null);const moreMember=ref<any>(null);const statusDraft=ref('待审核');const reviewReasonDraft=ref('');const assignmentDraft=ref('');const noteDraft=ref('');const followDraft=ref('');const followTypeDraft=ref('核实资料');const appointmentEditing=ref(false);const appointmentDraft=ref('');const certificationFilter=ref('不限');const reviewFilter=ref('不限');const editDraft=ref<any>({});const entryDraft=ref<any>({name:'',phone:'',education:'',height:''});
const refresh=async()=>{const r=await getMatchmakerReviewMembers();if(r.success&&r.data!=null)members.value=r.data};onMounted(()=>{refresh()});const filteredMembers=computed(()=>{const r:any[]=[];const q=searchedKeyword.value.trim().toLowerCase();for(let i=0;i<members.value.length;i++){const m=members.value[i];if(activeTab.value=='待审'&&m.reviewStatus!='待审核')continue;if(activeTab.value=='我的'&&!m.isMine)continue;if(activeTab.value=='弃海'&&m.reviewStatus!='审核不通过')continue;if(activeTab.value=='线上VIP'&&m.vipType!='线上VIP')continue;if(activeTab.value=='线下VIP'&&m.vipType!='线下VIP')continue;if(certificationFilter.value!='不限'&&m.certification!=certificationFilter.value)continue;if(reviewFilter.value!='不限'&&m.reviewStatus!=reviewFilter.value)continue;if(q.length>0&&String(m.name).toLowerCase().indexOf(q)<0&&String(m.id).toLowerCase().indexOf(q)<0&&String(m.phone).indexOf(q)<0)continue;r.push(m)}return r});const candidates=computed(()=>{const r:any[]=[];for(let i=0;i<members.value.length;i++){const m=members.value[i];if(selectedMember.value!=null&&m.id!=selectedMember.value.id&&m.reviewStatus=='审核通过')r.push(m)}return r});const notify=(t:string)=>uni.showToast({title:t,icon:'none'});const selectTab=(t:string)=>{activeTab.value=t;moreMember.value=null};const onKeywordInput=(e:any)=>keyword.value=e.detail.value;const runSearch=()=>searchedKeyword.value=keyword.value;const set=(m:any)=>{selectedMember.value=m;moreMember.value=null};const closePanel=()=>{activePanel.value='';moreMember.value=null};const openMore=(m:any)=>moreMember.value=moreMember.value!=null&&moreMember.value.id==m.id?null:m;const openStatus=(m:any)=>{set(m);statusDraft.value=m.reviewStatus;reviewReasonDraft.value=m.reviewReason;activePanel.value='status'};const openIntroductions=()=>{set(moreMember.value);activePanel.value='introductions'};const openMatch=()=>{set(moreMember.value);activePanel.value='match'};const openNote=()=>{set(moreMember.value);noteDraft.value=selectedMember.value.matchmakerComment;activePanel.value='note'};const openAssign=()=>{set(moreMember.value);assignmentDraft.value=selectedMember.value.assignedMatchmaker;activePanel.value='assign'};const openSea=()=>{set(moreMember.value);activePanel.value='sea'};const openContact=(m:any)=>{set(m);activePanel.value='contact'};const openFollow=(m:any)=>{set(m);activePanel.value='follow'};const openAddFollow=()=>{followDraft.value='';activePanel.value='add-follow'};const openCopy=(m:any)=>{set(m);activePanel.value='copy'};const openEdit=(m:any)=>{set(m);editDraft.value=Object.assign({},m);activePanel.value='edit'};const openEntry=()=>{entryDraft.value={name:'',phone:'',education:'',height:''};activePanel.value='entry'};const persist=async(c:any)=>{if(selectedMember.value==null)return false;const r=await updateMatchmakerReviewMember(String(selectedMember.value.id),c);if(r.success){members.value=members.value.slice();return true}notify(r.message);return false};const submitStatus=async()=>{if(statusDraft.value=='审核不通过'&&reviewReasonDraft.value.trim().length==0){notify('请填写或选择未通过原因');return}const c:any={reviewStatus:statusDraft.value,reviewReason:statusDraft.value=='审核不通过'?reviewReasonDraft.value.trim():''};if(statusDraft.value=='审核不通过'){c.assignedMatchmaker='未分派';c.isMine=false}if(await persist(c)){notify('审核状态已更新');closePanel()}};const submitNote=async()=>{if(noteDraft.value.trim().length==0){notify('请填写红娘说');return}if(await persist({matchmakerComment:noteDraft.value.trim()})){notify('红娘说已公开保存');closePanel()}};const submitAssign=async()=>{if(await persist({assignedMatchmaker:assignmentDraft.value,isMine:assignmentDraft.value=='芸希老师'})){notify('跟进红娘已修改');closePanel()}};const confirmSea=async()=>{if(await persist({reviewStatus:'审核不通过',reviewReason:selectedMember.value.reviewReason||'资料审核不通过',assignedMatchmaker:'未分派',isMine:false})){notify('已放入弃海');closePanel()}};const rescueMember=async()=>{set(moreMember.value);if(await persist({reviewStatus:'审核通过',reviewReason:'',assignedMatchmaker:'芸希老师',isMine:true}))notify('恭喜，本会员已经成功捞取到您名下！');moreMember.value=null};const saveAppointment=async()=>{if(appointmentDraft.value.trim().length==0){notify('请填写预约时间');return}if(await persist({nextFollowAt:appointmentDraft.value.trim()})){appointmentEditing.value=false;notify('已预约下次跟进')}};const submitFollow=async()=>{if(followDraft.value.trim().length==0){notify('请填写服务跟进内容');return}const a:any[]=[];for(let i=0;i<selectedMember.value.followUps.length;i++)a.push(selectedMember.value.followUps[i]);a.unshift({id:'follow-'+Date.now(),content:followDraft.value.trim(),type:followTypeDraft.value,author:'芸希老师',createdAt:new Date().toISOString().substring(0,10),nextFollowAt:''});if(await persist({followUps:a})){notify('服务跟进已提交');activePanel.value='follow'}};const uploadFollowImage=()=>uni.chooseImage({count:1,sizeType:['compressed'],success:()=>notify('跟进图片已选择')});const submitEdit=async()=>{if(editDraft.value.phone.trim().length<6){notify('请填写有效手机号');return}if(await persist(editDraft.value)){notify('资料已保存');closePanel()}};const submitEntry=()=>{if(entryDraft.value.name.trim().length==0||entryDraft.value.phone.trim().length<6){notify('请填写昵称和手机号');return}members.value.unshift({id:'G'+String(Date.now()).substring(7),name:entryDraft.value.name.trim(),avatar:'/static/portraits/profile-woman-main.jpg',gender:'女',age:25,birthday:'',zodiac:'',marital:'未婚',education:entryDraft.value.education||'未填写',height:Number(entryDraft.value.height)||0,weight:0,job:'未填写',income:'未填写',hometown:'未填写',residence:'未填写',phone:entryDraft.value.phone.trim(),wechat:'',category:'公开相亲',certification:'未实名',reviewStatus:'待审核',reviewFee:'免审核费',assignedMatchmaker:'芸希老师',registeredAt:new Date().toISOString().replace('T',' ').substring(0,19),vipType:'',preference:[],followUps:[],introductions:[],matchmakerComment:'',reviewReason:'',isMine:true});notify('已录入，等待审核');closePanel()};const applyFilter=()=>{closePanel();notify('筛选已应用')};const profileText=(m:any)=>'编号：'+m.id+'\n昵称：'+m.name+'\n性别：'+m.gender+'\n出生：'+m.birthday+'\n属相：'+m.zodiac+'\n婚况：'+m.marital+'\n身高：'+m.height+'cm\n体重：'+m.weight+'kg\n学历：'+m.education+'\n工作：'+m.job+'\n收入：'+m.income+'\n家乡：'+m.hometown+'\n现居：'+m.residence;const copyText=(v:string)=>uni.setClipboardData({data:v,success:()=>notify('已复制')});const copyProfile=()=>copyText(profileText(selectedMember.value));const callPhone=(p:string)=>uni.makePhoneCall({phoneNumber:p,fail:()=>notify('当前设备无法发起电话')});
</script>
<style scoped>
.pending-review-shell,.pending-review{flex:1;min-height:0;background:var(--review-canvas)}.pending-review{height:0}.review-tabs{height:92rpx;padding:0 20rpx;display:flex;background:var(--surface)}.review-tab{flex:1;display:flex;align-items:center;justify-content:center;position:relative;font-size:25rpx;white-space:nowrap}.review-tab.active{font-weight:800}.review-tab.active:after{content:'';position:absolute;bottom:8rpx;width:44rpx;height:7rpx;border-radius:999rpx;background:var(--review-purple)}.review-content{padding:20rpx 24rpx 60rpx}.search-bar{height:70rpx;padding:0 6rpx 0 20rpx;border-radius:999rpx;background:var(--review-soft);display:flex;align-items:center;gap:12rpx;font-size:38rpx;color:var(--muted)}.search-bar input{flex:1;min-width:0;font-size:23rpx}.search-bar view{width:110rpx;height:58rpx;border-radius:999rpx;background:var(--review-purple);display:flex;justify-content:center;align-items:center;color:var(--surface);font-size:23rpx;font-weight:800}.review-card{margin-top:24rpx;padding:22rpx;border-radius:28rpx;background:var(--surface);box-shadow:var(--shadow-sm)}.card-head,.profile,.actions{display:flex;align-items:center}.card-head{gap:14rpx}.category{padding:5rpx 14rpx;border-radius:999rpx;background:var(--review-orange-soft);color:var(--review-orange);font-size:19rpx;font-weight:800}.number{flex:1;color:var(--muted);font-size:21rpx}.status{color:var(--review-orange);font-size:21rpx;font-weight:800}.rejected,.reason{color:var(--review-danger)}.reason{display:block;margin-top:13rpx;text-align:right;font-size:19rpx}.line{height:1px;margin:17rpx 0;background:var(--line)}.profile{align-items:flex-start;gap:17rpx}.avatar-wrap{position:relative;width:86rpx;height:86rpx}.avatar-wrap image{width:86rpx;height:86rpx;border-radius:50%}.avatar-wrap text{position:absolute;right:-4rpx;bottom:-2rpx;width:31rpx;height:31rpx;border-radius:50%;background:var(--review-pink);display:flex;justify-content:center;align-items:center}.profile-copy{flex:1;display:flex;flex-d